bool HT5SourceIsStructureFamily(int source)
{
   return (source==PYR_SOURCE_BOS_CONTINUATION || source==PYR_SOURCE_BOS_PULLBACK ||
           source==PYR_SOURCE_CONFIRMED_TREND_FLIP || source==PYR_SOURCE_U_SETUP || source==PYR_SOURCE_N_SETUP);
}
bool HT5SourceIsChannelFamily(int source)
{
   return (source==PYR_SOURCE_CHANNEL_BREAK || source==PYR_SOURCE_CHANNEL_BREAK_PULLBACK ||
           source==PYR_SOURCE_CHANNEL_BOUNCE || source==PYR_SOURCE_TRIGGER_RAIL_BREAK || source==PYR_SOURCE_TRIGGER_RAIL_BOUNCE);
}
bool HT5SourceIsLocationFamily(int source)
{
   return (source==PYR_SOURCE_FAILED_EXTREME || source==PYR_SOURCE_FAILED_LOW_LIQUIDITY_BUY ||
           source==PYR_SOURCE_FAILED_HIGH_LIQUIDITY_SELL || source==PYR_SOURCE_RECLAIM_AREA ||
           source==PYR_SOURCE_TRAIN_STATION || source==PYR_SOURCE_KINGDOM_MANNER);
}
bool HT5SourceIsMotionFamily(int source)
{
   return (source==PYR_SOURCE_RHYTHM_ACCELERATOR || source==PYR_SOURCE_ROUTE_ACCELERATOR ||
           source==PYR_SOURCE_MOTIV_V3 || source==PYR_SOURCE_CC_GROW || source==PYR_SOURCE_KINGDOM_SCALE);
}

//==============================================================================
// v5.05 AUDIT-DRIVEN SURVIVAL / PROBATION / DEFENSE / TRADE TELEMETRY
//==============================================================================
// The Sept-2..4 statement audit showed that the worst damage came from trades
// dying inside the first two minutes, while simply holding all losing trades
// longer usually made the average outcome worse. Therefore this layer does not
// widen risk blindly. It blocks entries whose thesis stop is buried inside
// ordinary market noise, learns setup+direction expectancy, merges duplicate
// signals into one campaign, freezes adds while a campaign is defending, and
// records exact future MFE/MAE + post-exit ghost stages for later autopsy.

string HT5TicketTelemetryKey(string suffix,int ticket)
{
   return HT5Key("T_"+suffix+"_"+IntegerToString(ticket));
}

double HT5SourceSideSamplesValue(int source,int dir)
{
   if(source<=PYR_SOURCE_NONE || source>=32) return 0.0;
   return (dir==DIR_BUY?gHT5SourceBuySamples[source]:gHT5SourceSellSamples[source]);
}

double HT5SourceSideExpectancyValue(int source,int dir)
{
   if(source<=PYR_SOURCE_NONE || source>=32) return 0.0;
   return (dir==DIR_BUY?gHT5SourceBuyExpectancyR[source]:gHT5SourceSellExpectancyR[source]);
}

double HT5SourceSideEarlyDeathValue(int source,int dir)
{
   if(source<=PYR_SOURCE_NONE || source>=32) return 0.0;
   return (dir==DIR_BUY?gHT5SourceBuyEarlyDeath[source]:gHT5SourceSellEarlyDeath[source]);
}

double HT5SourceSideStopRateValue(int source,int dir)
{
   if(source<=PYR_SOURCE_NONE || source>=32) return 0.0;
   return (dir==DIR_BUY?gHT5SourceBuyStopRate[source]:gHT5SourceSellStopRate[source]);
}

double HT5SourceSideReliability(int source,int dir)
{
   double n=HT5SourceSideSamplesValue(source,dir);
   if(n<3.0) return 0.50;
   double e=HT5SourceSideExpectancyValue(source,dir);
   double early=HT5SourceSideEarlyDeathValue(source,dir);
   double stopRate=HT5SourceSideStopRateValue(source,dir);
   return HT5Clamp(0.58+0.18*e-0.28*early-0.12*stopRate,0.10,0.95);
}

// Audit priors are temporary guard rails only. After enough local live samples,
// symbol+direction expectancy becomes the authority and these priors disappear.
int HT5AuditPriorPenalty(int source)
{
   if(source==PYR_SOURCE_KINGDOM_MANNER) return 2;
   if(source==PYR_SOURCE_BOS_CONTINUATION ||
      source==PYR_SOURCE_BOS_PULLBACK ||
      source==PYR_SOURCE_CHANNEL_BOUNCE ||
      source==PYR_SOURCE_CHANNEL_BREAK_PULLBACK ||
      source==PYR_SOURCE_RECLAIM_AREA) return 1;
   return 0;
}

int HT5SetupProbationLevel(int source,int dir)
{
   if(HowShouldLosingSetupFamiliesBeHandled==PROBATION_OBSERVE_ONLY) return 0;
   if(source<=PYR_SOURCE_NONE || source>=32 || dir==DIR_FLAT) return 0;
   double n=HT5SourceSideSamplesValue(source,dir);
   if(n<5.0) return HT5AuditPriorPenalty(source);

   double e=HT5SourceSideExpectancyValue(source,dir);
   double early=HT5SourceSideEarlyDeathValue(source,dir);
   double stopRate=HT5SourceSideStopRateValue(source,dir);
   if(e<=-0.45 || early>=0.68 || (stopRate>=0.78 && e<0.0)) return 3;
   if(e<=-0.20 || early>=0.52 || (stopRate>=0.68 && e<0.05)) return 2;
   if(e<0.00 || early>=0.38 || stopRate>=0.62) return 1;
   return 0;
}

double HT5SourceSideRiskScale(int source,int dir)
{
   if(HowShouldLosingSetupFamiliesBeHandled<PROBATION_EXTRA_WITNESS_AND_RISK_REDUCTION) return 1.0;
   int p=HT5SetupProbationLevel(source,dir);
   if(p<=0) return 1.0;
   if(p==1) return 0.82;
   if(p==2) return 0.62;
   return 0.42;
}

int HT5ProbationExtraWitnesses(int source,int dir)
{
   if(HowShouldLosingSetupFamiliesBeHandled<PROBATION_REQUIRE_EXTRA_WITNESS) return 0;
   int p=HT5SetupProbationLevel(source,dir);
   if(p<=0) return 0;
   if(p==1) return 1;
   return 2;
}

double HT5M1AverageRange()
{
   int bars=iBars(Symbol(),PERIOD_M1);
   if(bars<5) return 0.0;
   double sum=0.0; int n=0;
   for(int i=1;i<=4;i++)
   {
      double h=iHigh(Symbol(),PERIOD_M1,i),l=iLow(Symbol(),PERIOD_M1,i);
      if(h>l && h>0.0 && l>0.0){ sum+=h-l; n++; }
   }
   return (n>0?sum/n:0.0);
}

double HT5EntryNoiseEnvelope()
{
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double spread=MathMax(Point,SpreadPoints()*Point);
   double m1=HT5M1AverageRange();
   double tickNoise=MathMax(Point,MathAbs(gATRTickPulseEWMA));
   double wickNoise=MathAbs(gMDWickATR)*atr*0.40;
   double base=MathMax(spread*2.50,MathMax(atr*0.16,m1*0.55));
   base=MathMax(base,tickNoise*2.50);
   base=MathMax(base,wickNoise);
   double entropy=HT5Clamp(gHT5FlowEntropy,0.0,1.0);
   double vv=HT5Clamp(gHT5VolOfVol,0.0,1.5);
   gHT5NoiseEnvelopePrice=MathMax(Point,base*(1.0+0.25*entropy+0.12*vv));
   return gHT5NoiseEnvelopePrice;
}

bool HT5EntrySurvivalAllows(int source,int dir,double price,double stop,string &reason)
{
   reason="SURVIVAL OK";
   if(HowShouldEntriesProveTheyCanSurviveNormalNoise==SURVIVAL_FILTER_OFF) return true;
   if(dir==DIR_FLAT || price<=0.0 || stop<=0.0){ reason="INVALID SURVIVAL GEOMETRY"; return false; }

   // An earned SONIC stage has already proven survival through favorable R travel.
   if(gMDRLadderEntryOverrideActive)
   {
      if(gHT5DefenseMode){ reason="DEFENSE MODE OWNS CAMPAIGN"; return false; }
      return true;
   }

   double noise=MathMax(Point,HT5EntryNoiseEnvelope());
   double distance=MathAbs(price-stop);
   gHT5SurvivalRoom=distance/noise;
   int probation=HT5SetupProbationLevel(source,dir);
   double required=1.06;
   if(HowShouldEntriesProveTheyCanSurviveNormalNoise==SURVIVAL_NOISE_ENVELOPE_STRICT)
      required=1.42;
   else if(HowShouldEntriesProveTheyCanSurviveNormalNoise==SURVIVAL_ADAPTIVE_BY_TRAIN_AND_EXPECTANCY)
   {
      double support=HT5Clamp(0.55*gHT5TrainStrength+
                             0.25*MathMax(0.0,dir*gHT5FormulaArrowScore)+
                             0.20*(gHT5LiveThesis.active?gHT5LiveThesis.coherence:gHT5OrganConsensus),0.0,1.0);
      required=HT5Clamp(1.18+0.14*probation-0.22*support,0.90,1.65);
   }
   gHT5SurvivalRequired=required;

   if(gHT5SurvivalRoom<required)
   {
      reason="STOP INSIDE NORMAL NOISE "+DoubleToString(gHT5SurvivalRoom,2)+"<"+DoubleToString(required,2);
      gHT5EntrySurvivalState=reason+" • NOISE "+DoubleToString(noise/Point,1)+"pt";
      return false;
   }

   // A setup+side already in probation needs stronger train proof instead of more
   // stop room. This is what prevents repeated wrong-side campaigns.
   if(probation>=2)
   {
      double minTrain=0.42+0.05*probation;
      double arrowAligned=dir*gHT5FormulaArrowScore;
      if(gHT5TrainDirection!=dir || gHT5TrainStrength<minTrain || arrowAligned<0.10)
      {
         reason="PROBATION NEEDS STRONGER TRAIN / ARROW";
         gHT5EntrySurvivalState=reason+" • P"+IntegerToString(probation);
         return false;
      }
   }

   gHT5EntrySurvivalState="SURVIVAL PASS • ROOM "+DoubleToString(gHT5SurvivalRoom,2)+"x / "+
                           DoubleToString(required,2)+"x • P"+IntegerToString(probation);
   return true;
}

bool HT5StopSymbolSanityAllows(int dir,double referencePrice,double marketPrice,double stop,bool pendingReference,string &reason)
{
   reason="STOP SANITY OK";
   if(stop<=0.0) return true;
   if(dir==DIR_FLAT || referencePrice<=0.0 || marketPrice<=0.0)
   { reason="STOP SANITY NO REFERENCE"; return false; }

   double atr=MathMax(Point,HTProtectiveStopATR());
   double fromMarket=MathAbs(marketPrice-stop);
   double ratio=fromMarket/MathMax(Point,MathAbs(marketPrice));
   double dayRange=MathAbs(iHigh(Symbol(),PERIOD_D1,0)-iLow(Symbol(),PERIOD_D1,0));
   double maxPhysical=MathMax(atr*6.0,MathMax(dayRange*1.50,MathAbs(marketPrice-referencePrice)*1.50+atr*2.0));

   if(ratio>0.18)
   {
      reason="STOP PRICE REGIME MISMATCH "+DoubleToString(ratio*100.0,1)+"% FROM MARKET";
      return false;
   }
   if(fromMarket>maxPhysical)
   {
      reason="STOP TOO FAR FOR SYMBOL "+DoubleToString(fromMarket/atr,1)+" ATR";
      return false;
   }

   // For pending entries, validate against the pending entry price. For live
   // market orders/modifications, validate against Bid/Ask so earned profit-side
   // stops remain legal.
   double brokerGap=MathMax(Point,MarketInfo(Symbol(),MODE_STOPLEVEL)*Point);
   if(pendingReference)
   {
      if(dir==DIR_BUY && stop>=referencePrice-brokerGap){ reason="BUY PENDING STOP NOT BELOW ENTRY"; return false; }
      if(dir==DIR_SELL && stop<=referencePrice+brokerGap){ reason="SELL PENDING STOP NOT ABOVE ENTRY"; return false; }
   }
   else
   {
      if(dir==DIR_BUY && stop>=Bid-brokerGap){ reason="BUY STOP NOT BELOW LIVE BID"; return false; }
      if(dir==DIR_SELL && stop<=Ask+brokerGap){ reason="SELL STOP NOT ABOVE LIVE ASK"; return false; }
   }
   return true;
}

void HT5TelemetryInitTicket(int ticket,int dir,double entry,double softStop,double hardStop,int source)
{
   if(ticket<=0) return;
   double r0=MathMax(Point,MathAbs(entry-softStop));
   GlobalVariableSet(HT5TicketTelemetryKey("ENTRY",ticket),entry);
   GlobalVariableSet(HT5TicketTelemetryKey("R0",ticket),r0);
   GlobalVariableSet(HT5TicketTelemetryKey("MFE",ticket),0.0);
   GlobalVariableSet(HT5TicketTelemetryKey("MAE",ticket),0.0);
   GlobalVariableSet(HT5TicketTelemetryKey("BIRTH",ticket),(double)TimeCurrent());
   GlobalVariableSet(HT5TicketTelemetryKey("SRC",ticket),(double)source);
   GlobalVariableSet(HT5TicketTelemetryKey("DIR",ticket),(double)dir);
   GlobalVariableSet(HT5TicketTelemetryKey("PROOF",ticket),0.0);
   GlobalVariableSet(HT5TicketTelemetryKey("SOFT",ticket),softStop);
   GlobalVariableSet(HT5TicketTelemetryKey("HARD",ticket),hardStop);
}

double HT5TicketMFER(int ticket)
{
   string k=HT5TicketTelemetryKey("MFE",ticket);
   return (GlobalVariableCheck(k)?GlobalVariableGet(k):0.0);
}

double HT5TicketMAER(int ticket)
{
   string k=HT5TicketTelemetryKey("MAE",ticket);
   return (GlobalVariableCheck(k)?GlobalVariableGet(k):0.0);
}

bool HT5TicketProofOfLife(int ticket,int dir)
{
   string pk=HT5TicketTelemetryKey("PROOF",ticket);
   if(GlobalVariableCheck(pk) && GlobalVariableGet(pk)>0.5) return true;
   double mfe=HT5TicketMFER(ticket);
   bool reaccepted=(gHT5TrainDirection==dir &&
                    dir*gMDReclaimATR>=0.05 &&
                    dir*gMDRhythmScore>=0.04 &&
                    dir*gHT5FormulaArrowScore>=0.06);
   bool proof=(mfe>=0.12 || reaccepted);
   if(proof) GlobalVariableSet(pk,1.0);
   return proof;
}

void HT5PrunePendingForDefense()
{
   if(!gHT5DefenseMode) return;
   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;
      int t=OrderType();
      if(t!=OP_BUYLIMIT && t!=OP_BUYSTOP && t!=OP_SELLLIMIT && t!=OP_SELLSTOP) continue;
      int ticket=OrderTicket();
      if(HT5CommanderOrderDelete(ticket,clrNONE))
         gHT5DefenseState="DEFENSE • CANCELED PENDING #"+IntegerToString(ticket);
   }
}

void HT5UpdateOpenTicketTelemetry()
{
   bool nearNow=false;
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   RefreshRates();
   int nearCount=0;
   int openDir=DIR_FLAT;

   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;
      int type=OrderType(); if(type!=OP_BUY && type!=OP_SELL) continue;
      int dir=(type==OP_BUY?DIR_BUY:DIR_SELL),ticket=OrderTicket();
      if(openDir==DIR_FLAT) openDir=dir;
      double entry=OrderOpenPrice();
      double soft=0.0,hard=0.0;
      string sk=HT5SoftStopKey(ticket),hk=HT5HardStopKey(ticket);
      if(GlobalVariableCheck(sk)) soft=GlobalVariableGet(sk); else soft=OrderStopLoss();
      if(GlobalVariableCheck(hk)) hard=GlobalVariableGet(hk); else hard=soft;
      if(!GlobalVariableCheck(HT5TicketTelemetryKey("R0",ticket)))
      {
         int src=(int)gHT5CampaignEntrySource;
         HT5TelemetryInitTicket(ticket,dir,entry,soft,hard,src);
      }

      double r0=MathMax(Point,GlobalVariableGet(HT5TicketTelemetryKey("R0",ticket)));
      double market=(dir==DIR_BUY?Bid:Ask);
      double moveR=dir*(market-entry)/r0;
      double mfe=MathMax(HT5TicketMFER(ticket),MathMax(0.0,moveR));
      double mae=MathMax(HT5TicketMAER(ticket),MathMax(0.0,-moveR));
      GlobalVariableSet(HT5TicketTelemetryKey("MFE",ticket),mfe);
      GlobalVariableSet(HT5TicketTelemetryKey("MAE",ticket),mae);
      if(mfe>=0.12) GlobalVariableSet(HT5TicketTelemetryKey("PROOF",ticket),1.0);

      double currentSL=OrderStopLoss(); if(currentSL<=0.0) currentSL=SovStoredStop(ticket);
      if(currentSL<=0.0 || soft<=0.0) continue;
      bool forwardEarned=(dir==DIR_BUY?currentSL>soft+Point:currentSL<soft-Point);
      if(forwardEarned) continue;
      double rescue=MathMax(atr*gHT5StopRescueZoneATR,MathAbs(entry-soft)*0.30);
      double distance=MathAbs(market-currentSL);
      if(distance<=rescue)
      {
         nearNow=true;
         nearCount++;
         gHT5DefenseLatched=true;
         gHT5DefenseDirection=dir;
      }
   }

   if(TradeCount()<=0)
   {
      gHT5DefenseLatched=false;
      gHT5DefenseDirection=DIR_FLAT;
      gHT5DefenseMode=false;
      gHT5DefenseState="ATTACK MODE • FLAT";
      return;
   }

   // Once a campaign enters defense, breathing the stop farther away is not enough
   // to instantly re-enable growth. Re-attack requires a real directional reclaim.
   if(gHT5DefenseLatched && !nearNow)
   {
      int d=(gHT5DefenseDirection!=DIR_FLAT?gHT5DefenseDirection:openDir);
      HT5UpdateTrainDirection();
      bool reclaimed=(d!=DIR_FLAT &&
                      gHT5TrainDirection==d &&
                      d*gHT5FormulaArrowScore>=0.10 &&
                      d*gMDReclaimATR>=0.04 &&
                      d*gMDRhythmScore>=0.04);
      if(reclaimed)
      {
         gHT5DefenseLatched=false;
         gHT5DefenseDirection=DIR_FLAT;
         gHT5DefenseState="RECLAIM PROVEN • DEFENSE RELEASED • GROWTH MAY RESUME";
      }
   }

   gHT5DefenseMode=(nearNow || gHT5DefenseLatched);
   if(gHT5DefenseMode)
   {
      if(nearNow)
         gHT5DefenseState="DEFENSE MODE • "+IntegerToString(nearCount)+" TICKET(S) NEAR THESIS STOP • NO ADDS";
      else
         gHT5DefenseState="DEFENSE LATCHED • WAIT TRAIN + ARROW + RECLAIM • NO ADDS";
      HT5PrunePendingForDefense();
   }
   else if(StringFind(gHT5DefenseState,"RECLAIM PROVEN",0)<0)
      gHT5DefenseState="ATTACK MODE • NO TICKET IN STOP RESCUE ZONE";
}

int HT5GhostStageSeconds(int stage)
{
   if(stage==0) return 30;
   if(stage==1) return 60;
   if(stage==2) return 120;
   if(stage==3) return 180;
   if(stage==4) return 300;
   if(stage==5) return 600;
   if(stage==6) return 900;
   if(stage==7) return 1800;
   return 3600;
}

int HT5GhostAllocateSlot()
{
   int oldest=0;
   for(int i=0;i<HT5_GHOST_SLOTS;i++)
   {
      if(gHT5GhostTicket[i]<=0) return i;
      if(gHT5GhostCloseTime[i]<gHT5GhostCloseTime[oldest]) oldest=i;
   }
   return oldest;
}

double HT5ProjectedTicketNet(int dir,double entry,double lots,double market,double commission)
{
   double k=HT5MoneyPerPriceUnitPerLot();
   if(k<=0.0) return 0.0;
   return dir*(market-entry)*k*lots+commission;
}

string HT5TradeTelemetryFileName()
{
   return "HIGHTOWER_V505_"+IntegerToString(AccountNumber())+"_"+Symbol()+"_TRADE_LIFECYCLE.csv";
}

string HT5GhostTelemetryFileName()
{
   return "HIGHTOWER_V505_"+IntegerToString(AccountNumber())+"_"+Symbol()+"_GHOST_STAGES.csv";
}

void HT5UpdateSourceSideTradeStat(int source,int dir,double r,double holdSeconds,bool stopped)
{
   if(source<=PYR_SOURCE_NONE || source>=32 || dir==DIR_FLAT) return;
   bool early=(holdSeconds<120.0 && r<0.0);
   if(dir==DIR_BUY)
   {
      gHT5SourceBuySamples[source]+=1.0;
      double a=2.0/(MathMin(50.0,gHT5SourceBuySamples[source])+1.0);
      gHT5SourceBuyExpectancyR[source]=(1.0-a)*gHT5SourceBuyExpectancyR[source]+a*r;
      gHT5SourceBuyEarlyDeath[source]=(1.0-a)*gHT5SourceBuyEarlyDeath[source]+a*(early?1.0:0.0);
      gHT5SourceBuyStopRate[source]=(1.0-a)*gHT5SourceBuyStopRate[source]+a*(stopped?1.0:0.0);
   }
   else
   {
      gHT5SourceSellSamples[source]+=1.0;
      double a=2.0/(MathMin(50.0,gHT5SourceSellSamples[source])+1.0);
      gHT5SourceSellExpectancyR[source]=(1.0-a)*gHT5SourceSellExpectancyR[source]+a*r;
      gHT5SourceSellEarlyDeath[source]=(1.0-a)*gHT5SourceSellEarlyDeath[source]+a*(early?1.0:0.0);
      gHT5SourceSellStopRate[source]=(1.0-a)*gHT5SourceSellStopRate[source]+a*(stopped?1.0:0.0);
   }
}

void HT5RegisterGhostFromSelectedHistory(int source,int dir,double actualNet,double r0,double commission)
{
   if(HowDeepShouldEachTradeBeMeasuredAfterExit<TELEMETRY_GHOST_HOLD_STAGES) return;
   int slot=HT5GhostAllocateSlot();
   gHT5GhostTicket[slot]=OrderTicket();
   gHT5GhostDir[slot]=dir;
   gHT5GhostSource[slot]=source;
   gHT5GhostMask[slot]=0;
   gHT5GhostCloseTime[slot]=OrderCloseTime();
   gHT5GhostEntry[slot]=OrderOpenPrice();
   gHT5GhostLots[slot]=OrderLots();
   gHT5GhostActualNet[slot]=actualNet;
   gHT5GhostCommission[slot]=commission;
   gHT5GhostR0[slot]=MathMax(Point,r0);
}

void HT5WriteClosedTradeTelemetrySelected()
{
   int type=OrderType(); if(type!=OP_BUY && type!=OP_SELL) return;
   int ticket=OrderTicket(),dir=(type==OP_BUY?DIR_BUY:DIR_SELL);
   int source=PYR_SOURCE_NONE;
   string srcKey=HT5TicketTelemetryKey("SRC",ticket);
   if(GlobalVariableCheck(srcKey)) source=(int)GlobalVariableGet(srcKey);
   if(source<=PYR_SOURCE_NONE || source>=32)
   {
      string c=OrderComment();
      for(int s=1;s<32;s++)
         if(StringFind(c,"HT5_"+HT5SourceShortTag(s),0)>=0){ source=s; break; }
   }

   double net=OrderProfit()+OrderSwap()+OrderCommission();
   double reserve=0.0;
   string rk=HT5RiskReserveKey(ticket);
   if(GlobalVariableCheck(rk)) reserve=GlobalVariableGet(rk);
   if(reserve<=0.0)
   {
      double sl=OrderStopLoss();
      if(sl>0.0) reserve=OrderRiskMoneyFromPrices(OrderOpenPrice(),sl,OrderLots());
   }
   double r=(reserve>0.01?net/reserve:0.0);
   double hold=MathMax(0.0,(double)(OrderCloseTime()-OrderOpenTime()));
   double mfe=HT5TicketMFER(ticket),mae=HT5TicketMAER(ticket);
   bool stopped=(StringFind(OrderComment(),"[sl]",0)>=0);
   if(!stopped && OrderStopLoss()>0.0)
      stopped=(MathAbs(OrderClosePrice()-OrderStopLoss())<=MathMax(TickSizePrice()*4.0,SpreadPoints()*Point*2.0));

   HT5UpdateSourceSideTradeStat(source,dir,r,hold,stopped);

   int h=FileOpen(HT5TradeTelemetryFileName(),FILE_CSV|FILE_READ|FILE_WRITE|FILE_COMMON,',');
   if(h!=INVALID_HANDLE)
   {
      if(FileSize(h)==0)
         FileWrite(h,"closeTime","ticket","symbol","direction","source","sourceLabel","openTime","holdSec","entry","softSL","hardSL","close","lots","net","R","MFE_R","MAE_R","stopped","trainScore","arrowScore","campaignMesh");
      FileSeek(h,0,SEEK_END);
      double soft=GlobalVariableCheck(HT5SoftStopKey(ticket))?GlobalVariableGet(HT5SoftStopKey(ticket)):OrderStopLoss();
      double hard=GlobalVariableCheck(HT5HardStopKey(ticket))?GlobalVariableGet(HT5HardStopKey(ticket)):soft;
      FileWrite(h,TimeToString(OrderCloseTime(),TIME_DATE|TIME_SECONDS),ticket,Symbol(),dir,source,HT5SourceName(source),
                TimeToString(OrderOpenTime(),TIME_DATE|TIME_SECONDS),hold,OrderOpenPrice(),soft,hard,OrderClosePrice(),
                OrderLots(),net,r,mfe,mae,(stopped?1:0),gHT5TrainScore,gHT5FormulaArrowScore,
                (gHT5CampaignThesis.active?gHT5CampaignThesis.coherence:0.0));
      FileClose(h);
   }
   HT5RegisterGhostFromSelectedHistory(source,dir,net,MathMax(Point,MathAbs(OrderOpenPrice()-
      (GlobalVariableCheck(HT5SoftStopKey(ticket))?GlobalVariableGet(HT5SoftStopKey(ticket)):OrderStopLoss()))),OrderCommission());
   GlobalVariableSet(HT5TicketTelemetryKey("CLOSED",ticket),1.0);
}

void HT5TelemetryScanClosed()
{
   if(HowDeepShouldEachTradeBeMeasuredAfterExit==TELEMETRY_CAMPAIGN_ONLY) return;
   string lk=HT5Key("TEL_LAST_CLOSE");
   if(gHT5TelemetryLastCloseScan<=0)
   {
      if(GlobalVariableCheck(lk)) gHT5TelemetryLastCloseScan=(datetime)GlobalVariableGet(lk);
      else
      {
         gHT5TelemetryLastCloseScan=TimeCurrent();
         GlobalVariableSet(lk,(double)gHT5TelemetryLastCloseScan);
         return;
      }
   }

   datetime newest=gHT5TelemetryLastCloseScan;
   int total=OrdersHistoryTotal();
   int start=(int)MathMax(0,total-300);
   for(int i=start;i<total;i++)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_HISTORY)) continue;
      if(!OurOrder()) continue;
      if(OrderCloseTime()<gHT5TelemetryLastCloseScan-2) continue;
      if(OrderType()!=OP_BUY && OrderType()!=OP_SELL) continue;
      if(GlobalVariableCheck(HT5TicketTelemetryKey("CLOSED",OrderTicket()))) continue;
      HT5WriteClosedTradeTelemetrySelected();
      if(OrderCloseTime()>newest) newest=OrderCloseTime();
   }
   if(newest>gHT5TelemetryLastCloseScan)
   {
      gHT5TelemetryLastCloseScan=newest;
      GlobalVariableSet(lk,(double)newest);
      HT5SaveLivingMemory();
   }
}

void HT5UpdateGhostWatches()
{
   if(HowDeepShouldEachTradeBeMeasuredAfterExit<TELEMETRY_GHOST_HOLD_STAGES) return;
   RefreshRates();
   double marketBuy=Bid,marketSell=Ask;
   for(int i=0;i<HT5_GHOST_SLOTS;i++)
   {
      if(gHT5GhostTicket[i]<=0 || gHT5GhostCloseTime[i]<=0) continue;
      int elapsed=(int)(TimeCurrent()-gHT5GhostCloseTime[i]);
      for(int stage=0;stage<HT5_GHOST_STAGES;stage++)
      {
         int bit=(1<<stage);
         if((gHT5GhostMask[i]&bit)!=0) continue;
         int sec=HT5GhostStageSeconds(stage);
         if(elapsed<sec) continue;
         double market=(gHT5GhostDir[i]==DIR_BUY?marketBuy:marketSell);
         double ghost=HT5ProjectedTicketNet(gHT5GhostDir[i],gHT5GhostEntry[i],gHT5GhostLots[i],market,gHT5GhostCommission[i]);
         int h=FileOpen(HT5GhostTelemetryFileName(),FILE_CSV|FILE_READ|FILE_WRITE|FILE_COMMON,',');
         if(h!=INVALID_HANDLE)
         {
            if(FileSize(h)==0)
               FileWrite(h,"time","ticket","symbol","direction","source","sourceLabel","stageSec","actualNet","ghostNet","deltaVsActual","ghostR");
            FileSeek(h,0,SEEK_END);
            FileWrite(h,TimeToString(TimeCurrent(),TIME_DATE|TIME_SECONDS),gHT5GhostTicket[i],Symbol(),gHT5GhostDir[i],
                      gHT5GhostSource[i],HT5SourceName(gHT5GhostSource[i]),sec,gHT5GhostActualNet[i],ghost,
                      ghost-gHT5GhostActualNet[i],ghost/MathMax(0.01,gHT5GhostR0[i]*HT5MoneyPerPriceUnitPerLot()*gHT5GhostLots[i]));
            FileClose(h);
         }
         gHT5GhostMask[i]|=bit;
      }
      if(elapsed>HT5GhostStageSeconds(HT5_GHOST_STAGES-1)+120 && gHT5GhostMask[i]==((1<<HT5_GHOST_STAGES)-1))
         gHT5GhostTicket[i]=0;
   }
}

void HT5BootstrapRecentTradeStats()
{
   if(HowShouldLosingSetupFamiliesBeHandled==PROBATION_OBSERVE_ONLY) return;
   string bk=HT5Key("V505_RECENT_BOOT");
   if(GlobalVariableCheck(bk)) return;

   int total=OrdersHistoryTotal(),looked=0;
   double baseline=MathMax(0.01,AccountRiskBase()*MathMax(0.10,SovereignOxRiskPercent())/100.0);
   for(int i=total-1;i>=0 && looked<120;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_HISTORY)) continue;
      if(!OurOrder()) continue;
      int type=OrderType(); if(type!=OP_BUY && type!=OP_SELL) continue;
      string c=OrderComment();
      if(StringFind(c,"HT5_",0)<0) continue;
      int source=PYR_SOURCE_NONE;
      for(int s=1;s<32;s++)
         if(StringFind(c,"HT5_"+HT5SourceShortTag(s),0)>=0){ source=s; break; }
      if(source<=PYR_SOURCE_NONE || source>=32) continue;
      int dir=(type==OP_BUY?DIR_BUY:DIR_SELL);
      double net=OrderProfit()+OrderSwap()+OrderCommission();
      double r=HT5Clamp(net/baseline,-2.0,2.0);
      double hold=MathMax(0.0,(double)(OrderCloseTime()-OrderOpenTime()));
      bool stopped=(StringFind(c,"[sl]",0)>=0);
      HT5UpdateSourceSideTradeStat(source,dir,r,hold,stopped);
      looked++;
   }
   GlobalVariableSet(bk,(double)TimeCurrent());
   HT5SaveLivingMemory();
   gHT5TelemetryState="BOOTSTRAPPED "+IntegerToString(looked)+" RECENT HT5 TRADES FOR "+Symbol();
}

void HT5TelemetryTick()
{
   if(HowDeepShouldEachTradeBeMeasuredAfterExit>=TELEMETRY_MFE_MAE_PER_TICKET)
      HT5UpdateOpenTicketTelemetry();
   else
   {
      gHT5DefenseMode=false;
      gHT5DefenseState="TELEMETRY LIGHT / DEFENSE SENSOR OFF";
   }
   HT5TelemetryScanClosed();
   HT5UpdateGhostWatches();
   gHT5TelemetryState="TELEMETRY • "+gHT5DefenseState+" • "+gHT5EntrySurvivalState;
}

//==============================================================================
// v5.04 TRAIN DIRECTION + FORMULA ARROW + PRE-BUDGETED STOP BREATHING
//==============================================================================
double HT5SignedClamp(double v,double scale)
{
   return HT5Clamp(v/MathMax(0.000001,scale),-1.0,1.0);
}

void HT5UpdateFormulaArrow()
{
   double weightTerm=HT5Clamp(gWeight,-1.0,1.0);
   double slopeScale=MathMax(0.00005,MathMax(ArrowMinimumSlopeValue,0.00010));
   double slopeTerm=HT5SignedClamp(gArrowSlope,slopeScale*6.0);
   double angleTerm=HT5Clamp(gAngle/45.0,-1.0,1.0);
   double angleVelocityTerm=HT5Clamp(gAngleVelocity/18.0,-1.0,1.0);
   double structureTerm=HT5SignedClamp(0.58*gMDStructureATR+0.42*gMDBOSATR,0.32);
   double channelTerm=HT5SignedClamp(0.66*gMDChannelATR+0.20*gMDRouteATR+0.14*gMDReclaimATR,0.30);
   double flowTerm=HT5SignedClamp(0.42*gMDPressureATR+0.34*gMDRhythmScore+0.24*gMDRhythmForce,0.30);
   double wickTerm=HT5SignedClamp(gMDWickATR,0.24);
   double mtfTerm=HT5Clamp(gHT5StructureAtlasPotential/0.45,-1.0,1.0);
   double locationTerm=HT5Clamp(gHT5Location.netDirectionalField/0.50,-1.0,1.0);
   double score=0.0;
   if(HowShouldArrowDirectionBeCalculated==ARROW_FORMULA_WEIGHT_ONLY)
      score=0.50*weightTerm+0.30*slopeTerm+0.20*angleTerm;
   else if(HowShouldArrowDirectionBeCalculated==ARROW_FORMULA_STRUCTURE_PLUS_FLOW)
      score=0.28*structureTerm+0.22*channelTerm+0.24*flowTerm+0.12*weightTerm+0.08*slopeTerm+0.06*wickTerm;
   else if(HowShouldArrowDirectionBeCalculated==ARROW_FORMULA_FULL_CREATURE)
      score=0.20*structureTerm+0.16*channelTerm+0.18*flowTerm+0.10*locationTerm+0.09*mtfTerm+
            0.10*weightTerm+0.07*slopeTerm+0.04*angleTerm+0.03*angleVelocityTerm+0.03*wickTerm;
   else
      score=0.22*structureTerm+0.18*channelTerm+0.19*flowTerm+0.10*mtfTerm+0.08*locationTerm+
            0.09*weightTerm+0.06*slopeTerm+0.03*angleTerm+0.02*angleVelocityTerm+0.03*wickTerm;
   gHT5FormulaArrowScore=HT5Clamp(score,-1.0,1.0);
   int positiveFamilies=0,negativeFamilies=0;
   double family[7];
   family[0]=structureTerm; family[1]=channelTerm; family[2]=flowTerm; family[3]=mtfTerm;
   family[4]=weightTerm; family[5]=locationTerm; family[6]=wickTerm;
   for(int i=0;i<7;i++){ if(family[i]>0.08) positiveFamilies++; if(family[i]<-0.08) negativeFamilies++; }
   int dom=(int)MathMax(positiveFamilies,negativeFamilies);
   gHT5FormulaArrowConfidence=HT5Clamp(0.55*MathAbs(gHT5FormulaArrowScore)+0.45*((double)dom/7.0),0.0,1.0);
   int candidate=DIR_FLAT;
   if(gHT5FormulaArrowScore>=gHT5ArrowEnterThreshold && positiveFamilies>=3) candidate=DIR_BUY;
   if(gHT5FormulaArrowScore<=-gHT5ArrowEnterThreshold && negativeFamilies>=3) candidate=DIR_SELL;
   if(candidate==DIR_FLAT && gHT5FormulaArrowDirection!=DIR_FLAT)
   {
      double held=gHT5FormulaArrowDirection*gHT5FormulaArrowScore;
      if(held>=gHT5ArrowReleaseThreshold) candidate=gHT5FormulaArrowDirection;
   }
   gHT5FormulaArrowDirection=candidate;
   gHT5FormulaArrowState="ARROW "+(candidate==DIR_BUY?"BUY":(candidate==DIR_SELL?"SELL":"FLAT"))+
                         " • F="+DoubleToString(gHT5FormulaArrowScore,2)+" • C="+DoubleToString(gHT5FormulaArrowConfidence,2)+
                         " • FAMILIES "+IntegerToString(dom)+"/7";
}

void HT5UpdateTrainDirection()
{
   HT5UpdateFormulaArrow();
   double structure=HT5SignedClamp(0.58*gMDStructureATR+0.42*gMDBOSATR,0.34);
   double channel=HT5SignedClamp(0.58*gMDChannelATR+0.24*gMDRouteATR+0.18*gMDReclaimATR,0.32);
   double flow=HT5SignedClamp(0.40*gMDPressureATR+0.36*gMDRhythmScore+0.24*gMDRhythmForce,0.32);
   double mtf=HT5Clamp(gHT5StructureAtlasPotential/0.50,-1.0,1.0);
   double oracle=HT5SignedClamp(0.40*gMDOracleMicroTrendATR+0.34*gMDOracleOBFVGATR+0.26*gMDOraclePhaseATR,0.30);
   double location=HT5Clamp(gHT5Location.netDirectionalField/0.55,-1.0,1.0);
   double arrow=gHT5FormulaArrowScore;
   gHT5TrainScore=HT5Clamp(0.25*structure+0.20*channel+0.17*flow+0.12*mtf+0.08*oracle+0.06*location+0.12*arrow,-1.0,1.0);
   int pos=0,neg=0; double v[7];
   v[0]=structure;v[1]=channel;v[2]=flow;v[3]=mtf;v[4]=oracle;v[5]=location;v[6]=arrow;
   for(int i=0;i<7;i++){ if(v[i]>0.08) pos++; if(v[i]<-0.08) neg++; }
   int dir=DIR_FLAT;
   if(gHT5TrainScore>=gHT5TrainEnterThreshold && pos>=4) dir=DIR_BUY;
   if(gHT5TrainScore<=-gHT5TrainEnterThreshold && neg>=4) dir=DIR_SELL;
   gHT5TrainDirection=dir;
   gHT5TrainAgreement=(double)MathMax(pos,neg)/7.0;
   gHT5TrainStrength=HT5Clamp(0.62*MathAbs(gHT5TrainScore)+0.38*gHT5TrainAgreement,0.0,1.0);
   gHT5TrainState="TRAIN "+(dir==DIR_BUY?"BUY":(dir==DIR_SELL?"SELL":"FLAT"))+" • S="+
                  DoubleToString(gHT5TrainScore,2)+" • A="+DoubleToString(gHT5TrainAgreement,2)+" • "+gHT5FormulaArrowState;
}

bool HT5ReversalSource(int source)
{
   return (source==PYR_SOURCE_FAILED_EXTREME || source==PYR_SOURCE_FAILED_LOW_LIQUIDITY_BUY ||
           source==PYR_SOURCE_FAILED_HIGH_LIQUIDITY_SELL || source==PYR_SOURCE_U_SETUP || source==PYR_SOURCE_N_SETUP ||
           source==PYR_SOURCE_CONFIRMED_TREND_FLIP || source==PYR_SOURCE_INFLECTION_TRANSFER ||
           source==PYR_SOURCE_CHANNEL_BOUNCE || source==PYR_SOURCE_TRIGGER_RAIL_BOUNCE);
}

bool HT5ReversalTransferProven(int source,int dir)
{
   if(!HT5ReversalSource(source) || dir==DIR_FLAT) return false;
   double shift=dir*(0.46*gMDBOSATR+0.30*gMDReclaimATR+0.24*gMDPressureATR);
   double arrow=dir*gHT5FormulaArrowScore;
   bool accepted=(shift>=0.09 && arrow>=0.16);
   bool transfer=(gMDInflectionTransferReady && gMDInflectionDirection==dir) || gMDTransferHandoffDirection==dir;
   bool rail=(gMDTriggerRailBreakDirection==dir || gMDChannelBreakDirection==dir);
   return (accepted && (transfer || rail || dir*gMDRhythmScore>0.08));
}

bool HT5TrendFortificationAllows(int source,int dir,bool existingCampaign,string &reason)
{
   reason="TREND OK";
   if(dir==DIR_FLAT){ reason="NO DIRECTION"; return false; }
   HT5UpdateTrainDirection();
   if(HowStrictlyMustEveryEntryFollowTrainDirection==TREND_FORTIFY_CONTEXT_ONLY) return true;
   bool hardOpposite=(dir==DIR_BUY ?
      (gMDTriggerRailBreakDirection==DIR_SELL || gMDChannelBreakDirection==DIR_SELL || gMDTransferHandoffDirection==DIR_SELL) :
      (gMDTriggerRailBreakDirection==DIR_BUY || gMDChannelBreakDirection==DIR_BUY || gMDTransferHandoffDirection==DIR_BUY));
   if(hardOpposite){ reason="HARD OPPOSITE STRUCTURE"; return false; }
   if(existingCampaign)
   {
      if(gHT5TrainDirection==dir) return true;
      if(gHT5TrainDirection==DIR_FLAT && gHT5CampaignThesis.active && gHT5CampaignThesis.direction==dir &&
         dir*gHT5TrainScore>-0.05 && gHT5CampaignThesis.conflict<0.48) return true;
      reason="OPEN CAMPAIGN NOT SUPPORTED BY TRAIN"; return false;
   }
   if(HowStrictlyMustEveryEntryFollowTrainDirection==TREND_FORTIFY_TRAIN_DIRECTION_REQUIRED)
   { if(gHT5TrainDirection==dir) return true; reason="SETUP OPPOSES TRAIN DIRECTION"; return false; }
   if(HowStrictlyMustEveryEntryFollowTrainDirection==TREND_FORTIFY_TRAIN_PLUS_FORMULA_ARROW)
   { if(gHT5TrainDirection==dir && gHT5FormulaArrowDirection==dir) return true; reason="TRAIN + FORMULA ARROW NOT ALIGNED"; return false; }
   if(gHT5TrainDirection==dir && (gHT5FormulaArrowDirection==dir || dir*gHT5FormulaArrowScore>=0.10)) return true;
   if(gHT5TrainDirection!=dir && HT5ReversalTransferProven(source,dir))
   { reason="PROVEN REVERSAL TRANSFER OVERRIDES OLD TRAIN"; return true; }
   reason="ENTRY DOES NOT CORRESPOND TO TRAIN / ARROW"; return false;
}

void HT5PrunePendingAgainstTrain()
{
   if(HowStrictlyMustEveryEntryFollowTrainDirection==TREND_FORTIFY_CONTEXT_ONLY) return;
   HT5UpdateTrainDirection();
   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;
      int type=OrderType();
      if(type!=OP_BUYLIMIT && type!=OP_BUYSTOP && type!=OP_SELLLIMIT && type!=OP_SELLSTOP) continue;
      int dir=((type==OP_BUYLIMIT || type==OP_BUYSTOP)?DIR_BUY:DIR_SELL);
      bool opposite=(gHT5TrainDirection!=DIR_FLAT && gHT5TrainDirection!=dir);
      bool formulaOpposite=(dir*gHT5FormulaArrowScore<=-0.18 && gHT5FormulaArrowConfidence>=0.40);
      if(!(opposite || formulaOpposite)) continue;
      int ticket=OrderTicket();
      if(HT5CommanderOrderDelete(ticket,clrNONE))
         gHT5TrendFortificationState="CANCEL PENDING #"+IntegerToString(ticket)+" • NO LONGER MATCHES TRAIN";
   }
}

string HT5HardStopKey(int ticket){ return HT5Key("HARD_"+IntegerToString(ticket)); }
string HT5SoftStopKey(int ticket){ return HT5Key("SOFT_"+IntegerToString(ticket)); }
string HT5RiskReserveKey(int ticket){ return HT5Key("RSV_"+IntegerToString(ticket)); }

double HT5ResolveHardReserveStop(int dir,double openPrice,double softStop)
{
   // v6.08 direct stop means exactly that: risk sizing and broker SL use the
   // same user-selected stop distance on every trade.
   if(DirectInputsOwnExecution) return softStop;
   if(gHT6StructureHoldOrderContext || gHT6ContinuationAddOrderContext) return softStop;
   if(gHT6SequencePlanContext) return softStop; // exact sequence seed risk geometry
   if(HowShouldStopsBreatheWhenTrendIsStillRight==STOP_BREATHING_OFF || softStop<=0.0 || dir==DIR_FLAT) return softStop;
   double atr=MathMax(Point,HTProtectiveStopATR());
   double softDistance=MathAbs(openPrice-softStop); if(softDistance<=Point) return softStop;
   double extra=MathMax(atr*gHT5HardReserveExtraATR,softDistance*(gHT5HardReserveMultiplier-1.0));
   double hardDistance=MathMin(atr*gHT5StopMaxDistanceATR,softDistance+extra);
   double hard=openPrice-dir*hardDistance;
   if(HowShouldStopsBreatheWhenTrendIsStillRight>=STOP_BREATH_STRUCTURE_REANCHOR_WITHIN_RESERVE)
   {
      double structure=0.0;
      if(ProtectiveStructureAnchor(dir,structure) && structure>0.0)
      {
         double structured=structure-dir*atr*0.06; double d=MathAbs(openPrice-structured);
         if(d>softDistance && d<=atr*gHT5StopMaxDistanceATR)
            hard=(dir==DIR_BUY?MathMin(hard,structured):MathMax(hard,structured));
      }
   }
   return HT5RoundBrokerSafeStop(dir,openPrice,hard);
}

bool HT5TrendStillRightForStop(int ticket,int dir)
{
   if(dir==DIR_FLAT) return false;
   HT5UpdateTrainDirection();
   bool hardOpposite=(dir==DIR_BUY ?
      (gMDTriggerRailBreakDirection==DIR_SELL || gMDChannelBreakDirection==DIR_SELL || gMDTransferHandoffDirection==DIR_SELL) :
      (gMDTriggerRailBreakDirection==DIR_BUY || gMDChannelBreakDirection==DIR_BUY || gMDTransferHandoffDirection==DIR_BUY));
   if(hardOpposite) return false;

   bool train=(gHT5TrainDirection==dir && gHT5TrainStrength>=0.38);
   bool formula=(dir*gHT5FormulaArrowScore>=0.10 && gHT5FormulaArrowConfidence>=0.35);
   bool thesis=(gHT5CampaignThesis.active && gHT5CampaignThesis.direction==dir &&
                gHT5CampaignThesis.conflict<0.42 && gHT5CampaignThesis.coherence>=0.40);
   bool proof=HT5TicketProofOfLife(ticket,dir);

   // Statement audit: immediate losers rarely recovered simply by waiting. A stop
   // may breathe only after the trade has demonstrated favorable life or a genuine
   // reacceptance while the Train remains aligned.
   return (proof && train && (formula || thesis));
}

void HT5ManageTrendStopBreathing()
{
   if(HowShouldStopsBreatheWhenTrendIsStillRight==STOP_BREATHING_OFF || TradeCount()<=0) return;
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14)); RefreshRates(); bool anyNear=false;
   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;
      int type=OrderType(); if(type!=OP_BUY && type!=OP_SELL) continue;
      int dir=(type==OP_BUY?DIR_BUY:DIR_SELL),ticket=OrderTicket();
      string hk=HT5HardStopKey(ticket),sk=HT5SoftStopKey(ticket),rk=HT5RiskReserveKey(ticket);
      if(!GlobalVariableCheck(hk) || !GlobalVariableCheck(sk) || !GlobalVariableCheck(rk)) continue;
      double hard=GlobalVariableGet(hk),soft0=GlobalVariableGet(sk),budget=GlobalVariableGet(rk);
      double currentSL=OrderStopLoss(); if(currentSL<=0.0) currentSL=SovStoredStop(ticket);
      if(currentSL<=0.0 || hard<=0.0 || soft0<=0.0) continue;
      bool forwardEarned=(dir==DIR_BUY?currentSL>soft0+Point:currentSL<soft0-Point);
      if(forwardEarned) continue;
      double market=(dir==DIR_BUY?Bid:Ask);
      double rescue=MathMax(atr*gHT5StopRescueZoneATR,MathAbs(OrderOpenPrice()-soft0)*0.30);
      double distance=MathAbs(market-currentSL); if(distance>rescue) continue; anyNear=true;
      if(!HT5TrendStillRightForStop(ticket,dir)){ gHT5StopBreathingState="NEAR SL • NO PROOF-OF-LIFE / TREND NOT RIGHT • HOLD ORIGINAL STOP"; continue; }
      double stress=HT5Clamp(1.0-distance/MathMax(Point,rescue),0.0,1.0);
      double fraction=HT5Clamp(0.22+0.58*stress*gHT5TrainStrength,0.18,0.78);
      double candidate=currentSL+(hard-currentSL)*fraction;
      if(dir==DIR_BUY) candidate=MathMax(hard,MathMin(currentSL,candidate)); else candidate=MathMin(hard,MathMax(currentSL,candidate));
      candidate=HT5RoundBrokerSafeStop(dir,OrderOpenPrice(),candidate);
      double modeled=OrderRiskMoneyFromPrices(OrderOpenPrice(),candidate,OrderLots());
      if(modeled>budget+0.02 || MathAbs(candidate-currentSL)<TickSizePrice()) continue;
      ResetLastError();
      if(HT5CommanderOrderModify(ticket,OrderOpenPrice(),candidate,OrderTakeProfit(),OrderExpiration(),clrNONE))
      {
         GlobalVariableSet(SovStopKey(ticket),candidate);
         gHT5StopBreathingState="SL BREATH "+(dir==DIR_BUY?"BUY":"SELL")+" #"+IntegerToString(ticket)+" • "+
             DoubleToString(currentSL,Digits)+" -> "+DoubleToString(candidate,Digits)+" • HARD "+DoubleToString(hard,Digits)+
             " • TRAIN "+DoubleToString(gHT5TrainStrength,2);
      }
   }
   if(!anyNear) gHT5StopBreathingState="STOP BREATHING ARMED • WAIT NEAR SL";
}

//==============================================================================
// v5.03 THESIS MESH + SETUP-AWARE STOP LOSS
//==============================================================================
double HT5Support01(int dir,double value,double scale)
{
   if(dir==DIR_FLAT) return 0.0;
   return HT5Clamp(MathMax(0.0,dir*value)/MathMax(0.01,scale),0.0,1.0);
}

double HT5Opposition01(int dir,double value,double scale)
{
   if(dir==DIR_FLAT) return 0.0;
   return HT5Clamp(MathMax(0.0,-dir*value)/MathMax(0.01,scale),0.0,1.0);
}

void HT5ClearThesisCapsule(HT5_ThesisCapsule &t,string why)
{
   t.active=false; t.frozen=false; t.direction=DIR_FLAT; t.source=PYR_SOURCE_NONE; t.identity=0;
   t.trigger=0.0; t.rawInvalidation=0.0; t.stopPrice=0.0; t.targetR=0.0;
   t.agreement=0.0; t.quality=0.0; t.reliability=0.0;
   t.structureSupport=0.0; t.channelSupport=0.0; t.flowSupport=0.0; t.locationSupport=0.0;
   t.oracleSupport=0.0; t.mtfSupport=0.0; t.memorySupport=0.0; t.conflict=0.0; t.coherence=0.0;
   t.label="NONE"; t.witnesses="NONE"; t.stopReason="NONE"; t.state="THESIS IDLE"+(why==""?"":" | "+why);
}

double HT5SetupMeshCoherence(int source,double &conflict)
{
   conflict=0.0;
   if(source<=PYR_SOURCE_NONE || source>=32 || !gHT5SetupEvent[source].armed) return 0.0;
   int dir=gHT5SetupEvent[source].direction; if(dir==DIR_FLAT) return 0.0;

   double structRaw=0.45*gMDStructureATR+0.30*gMDBOSATR+0.25*gHT5StructureAtlasPotential;
   double channelRaw=0.62*gMDChannelATR+0.20*gMDRouteATR+0.18*gMDReclaimATR;
   double flowRaw=0.42*gMDRhythmScore+0.33*gMDRhythmForce+0.25*gMDPressureATR;
   double locationRaw=gHT5Location.netDirectionalField;
   double oracleRaw=0.36*gMDOracleMicroTrendATR+0.36*gMDOracleOBFVGATR+0.28*gMDOraclePhaseATR;

   double s=HT5Support01(dir,structRaw,0.22);
   double c=HT5Support01(dir,channelRaw,0.20);
   double f=HT5Support01(dir,flowRaw,0.20);
   double l=HT5Support01(dir,locationRaw,0.28);
   double o=HT5Support01(dir,oracleRaw,0.20);
   double mtf=(HT5Sign(gHT5StructureAtlasPotential)==dir?HT5Clamp(gHT5StructureAtlasAgreement,0.0,1.0):0.0);
   double mem=(gHT5DeepPredictionConfidence>=0.35?HT5Clamp(MathMax(0.0,dir*gHT5DeepPredictionR)*gHT5DeepPredictionConfidence/0.35,0.0,1.0):0.0);

   double os=HT5Opposition01(dir,structRaw,0.25);
   double oc=HT5Opposition01(dir,channelRaw,0.24);
   double of=HT5Opposition01(dir,flowRaw,0.24);
   double ol=HT5Opposition01(dir,locationRaw,0.34);
   double oo=HT5Opposition01(dir,oracleRaw,0.24);
   conflict=HT5Clamp(0.26*os+0.24*oc+0.22*of+0.14*ol+0.14*oo,0.0,1.0);

   double quality=HT5Clamp(gHT5SetupEvent[source].quality/1.60,0.0,1.0);
   double agreement=HT5Clamp(gHT5SetupEvent[source].agreementScore,0.0,1.0);
   double reliability=HT5Clamp(0.55*HT5SourceReliability(source)+0.45*HT5SourceSideReliability(source,dir),0.10,0.95);
   double context=0.24*s+0.20*c+0.20*f+0.14*l+0.10*o+0.07*mtf+0.05*mem;

   int families=0;
   if(s>=0.18) families++; if(c>=0.18) families++; if(f>=0.18) families++;
   if(l>=0.18) families++; if(o>=0.18) families++; if(mtf>=0.25) families++; if(mem>=0.20) families++;
   double synergy=HT5Clamp(0.68+0.055*families,0.68,1.0);

   // The setup remains dominant. Context can strengthen or oppose it, but cannot
   // average a clear setup direction into FLAT simply because one organ is quiet.
   double sourceCore=gHT5MeshSetupDominance*(0.46*quality+0.30*agreement+0.24*reliability);
   double contextCore=(1.0-gHT5MeshSetupDominance)*context;
   double coherence=(sourceCore+contextCore)*synergy*(1.0-gHT5MeshConflictPenalty*conflict);
   return HT5Clamp(coherence,0.0,1.0);
}

double HT5RequiredMeshCoherence(int source)
{
   if(HowTightlyShouldAllOrgansMesh==MESH_LOOSE_ORGANS_SHARE_CONTEXT) return 0.0;
   if(HowTightlyShouldAllOrgansMesh==MESH_ONE_SHARED_THESIS_BEFORE_ENTRY) return gHT5MeshCoherenceFloor;
   if(HowTightlyShouldAllOrgansMesh==MESH_LOCK_SETUP_TO_CAMPAIGN_THESIS) return gHT5MeshCoherenceFloor;
   int dir=(source>PYR_SOURCE_NONE && source<32?gHT5SetupEvent[source].direction:DIR_FLAT);
   double rel=HT5Clamp(0.55*HT5SourceReliability(source)+0.45*HT5SourceSideReliability(source,dir),0.10,0.95);
   double uncertainty=HT5Clamp(gMDUncertaintyATR,0.0,1.0);
   double probation=(double)HT5SetupProbationLevel(source,dir);
   return HT5Clamp(gHT5MeshCoherenceFloor+0.08*(0.55-rel)+0.05*uncertainty+0.025*probation,0.28,0.54);
}

void HT5BuildLiveThesis(int source)
{
   if(source<=PYR_SOURCE_NONE || source>=32 || !gHT5SetupEvent[source].armed)
   { HT5ClearThesisCapsule(gHT5LiveThesis,"NO READY SETUP"); return; }
   double conflict=0.0;
   double coherence=HT5SetupMeshCoherence(source,conflict);
   int dir=gHT5SetupEvent[source].direction;
   double structRaw=0.45*gMDStructureATR+0.30*gMDBOSATR+0.25*gHT5StructureAtlasPotential;
   double channelRaw=0.62*gMDChannelATR+0.20*gMDRouteATR+0.18*gMDReclaimATR;
   double flowRaw=0.42*gMDRhythmScore+0.33*gMDRhythmForce+0.25*gMDPressureATR;
   double oracleRaw=0.36*gMDOracleMicroTrendATR+0.36*gMDOracleOBFVGATR+0.28*gMDOraclePhaseATR;

   gHT5LiveThesis.active=true; gHT5LiveThesis.frozen=false;
   gHT5LiveThesis.direction=dir; gHT5LiveThesis.source=source; gHT5LiveThesis.identity=gHT5SetupEvent[source].identity;
   gHT5LiveThesis.trigger=gHT5SetupEvent[source].trigger; gHT5LiveThesis.rawInvalidation=gHT5SetupEvent[source].invalidation;
   gHT5LiveThesis.targetR=gHT5SetupEvent[source].targetR; gHT5LiveThesis.agreement=gHT5SetupEvent[source].agreementScore;
   gHT5LiveThesis.quality=HT5Clamp(gHT5SetupEvent[source].quality/1.60,0.0,1.0);
   gHT5LiveThesis.reliability=HT5Clamp(0.55*HT5SourceReliability(source)+0.45*HT5SourceSideReliability(source,dir),0.10,0.95);
   gHT5LiveThesis.structureSupport=HT5Support01(dir,structRaw,0.22);
   gHT5LiveThesis.channelSupport=HT5Support01(dir,channelRaw,0.20);
   gHT5LiveThesis.flowSupport=HT5Support01(dir,flowRaw,0.20);
   gHT5LiveThesis.locationSupport=HT5Support01(dir,gHT5Location.netDirectionalField,0.28);
   gHT5LiveThesis.oracleSupport=HT5Support01(dir,oracleRaw,0.20);
   gHT5LiveThesis.mtfSupport=(HT5Sign(gHT5StructureAtlasPotential)==dir?HT5Clamp(gHT5StructureAtlasAgreement,0.0,1.0):0.0);
   gHT5LiveThesis.memorySupport=(gHT5DeepPredictionConfidence>=0.35?HT5Clamp(MathMax(0.0,dir*gHT5DeepPredictionR)*gHT5DeepPredictionConfidence/0.35,0.0,1.0):0.0);
   gHT5LiveThesis.conflict=conflict; gHT5LiveThesis.coherence=coherence;
   gHT5LiveThesis.label=gHT5SetupEvent[source].label; gHT5LiveThesis.witnesses=gHT5SetupEvent[source].witnesses;
   gHT5LiveThesis.stopPrice=0.0; gHT5LiveThesis.stopReason="WAIT STOP SOLVER";
   gHT5LiveThesis.state="THESIS "+(dir==DIR_BUY?"BUY":"SELL")+" • "+gHT5LiveThesis.label+" • MESH "+DoubleToString(coherence,2)+" • CONFLICT "+DoubleToString(conflict,2);
}

void HT5FreezeCampaignThesis(int source)
{
   if(!gHT5LiveThesis.active || gHT5LiveThesis.source!=source) HT5BuildLiveThesis(source);
   if(!gHT5LiveThesis.active) return;
   gHT5CampaignThesis.active=true; gHT5CampaignThesis.frozen=true;
   gHT5CampaignThesis.direction=gHT5LiveThesis.direction; gHT5CampaignThesis.source=gHT5LiveThesis.source; gHT5CampaignThesis.identity=gHT5LiveThesis.identity;
   gHT5CampaignThesis.trigger=gHT5LiveThesis.trigger; gHT5CampaignThesis.rawInvalidation=gHT5LiveThesis.rawInvalidation;
   gHT5CampaignThesis.stopPrice=gHT5LiveThesis.stopPrice; gHT5CampaignThesis.targetR=gHT5LiveThesis.targetR;
   gHT5CampaignThesis.agreement=gHT5LiveThesis.agreement; gHT5CampaignThesis.quality=gHT5LiveThesis.quality; gHT5CampaignThesis.reliability=gHT5LiveThesis.reliability;
   gHT5CampaignThesis.structureSupport=gHT5LiveThesis.structureSupport; gHT5CampaignThesis.channelSupport=gHT5LiveThesis.channelSupport;
   gHT5CampaignThesis.flowSupport=gHT5LiveThesis.flowSupport; gHT5CampaignThesis.locationSupport=gHT5LiveThesis.locationSupport;
   gHT5CampaignThesis.oracleSupport=gHT5LiveThesis.oracleSupport; gHT5CampaignThesis.mtfSupport=gHT5LiveThesis.mtfSupport; gHT5CampaignThesis.memorySupport=gHT5LiveThesis.memorySupport;
   gHT5CampaignThesis.conflict=gHT5LiveThesis.conflict; gHT5CampaignThesis.coherence=gHT5LiveThesis.coherence;
   gHT5CampaignThesis.label=gHT5LiveThesis.label; gHT5CampaignThesis.witnesses=gHT5LiveThesis.witnesses;
   gHT5CampaignThesis.stopReason=gHT5LiveThesis.stopReason;
   gHT5CampaignThesis.state="FROZEN CAMPAIGN THESIS • "+gHT5LiveThesis.label+" • MESH "+DoubleToString(gHT5LiveThesis.coherence,2);
}

double HT5SourceStopBufferATR(int source)
{
   double b=gHT5StopBaseBufferATR;
   if(source==PYR_SOURCE_BOS_CONTINUATION || source==PYR_SOURCE_BOS_PULLBACK) b+=0.025;
   else if(source==PYR_SOURCE_CHANNEL_BREAK || source==PYR_SOURCE_CHANNEL_BREAK_PULLBACK || source==PYR_SOURCE_TRIGGER_RAIL_BREAK) b+=0.035;
   else if(source==PYR_SOURCE_FAILED_LOW_LIQUIDITY_BUY || source==PYR_SOURCE_FAILED_HIGH_LIQUIDITY_SELL || source==PYR_SOURCE_FAILED_EXTREME) b+=0.020;
   else if(source==PYR_SOURCE_MOTIV_V3 || source==PYR_SOURCE_CC_GROW) b+=0.035;
   else if(source==PYR_SOURCE_KINGDOM_MANNER || source==PYR_SOURCE_KINGDOM_SCALE) b+=0.020;
   if(HowShouldTheCreaturePlaceItsStopLoss==STOP_LOSS_ADAPTIVE_THESIS_INVALIDATION)
      b+=0.045*HT5Clamp(gMDUncertaintyATR,0.0,1.0)+0.035*HT5Clamp(gHT5FlowEntropy,0.0,1.0);
   return HT5Clamp(b,0.015,0.18);
}

double HT5RoundBrokerSafeStop(int dir,double openPrice,double stop)
{
   double brokerMin=MathMax(Point,MarketInfo(Symbol(),MODE_STOPLEVEL)*Point+Point);
   if(dir==DIR_BUY) stop=MathMin(stop,openPrice-brokerMin);
   else if(dir==DIR_SELL) stop=MathMax(stop,openPrice+brokerMin);
   double tick=TickSizePrice();
   if(tick>0.0)
   {
      if(dir==DIR_BUY) stop=MathFloor(stop/tick)*tick;
      else stop=MathCeil(stop/tick)*tick;
   }
   return NormalizeDouble(stop,Digits);
}

double HT5ResolveNamedSetupStop(int source,int dir,double openPrice,string &reason)
{
   reason="";
   if(source<=PYR_SOURCE_NONE || source>=32 || dir==DIR_FLAT || openPrice<=0.0)
   { reason="NO SETUP STOP CONTEXT"; return 0.0; }
   double atr=MathMax(Point,HTProtectiveStopATR());
   double base=gHT5SetupEvent[source].invalidation;
   if(base<=0.0 || (dir==DIR_BUY && base>=openPrice) || (dir==DIR_SELL && base<=openPrice))
      base=gHT5SetupEvent[source].trigger-dir*atr*0.18;
   if(base<=0.0) { reason="NO VALID SETUP INVALIDATION"; return 0.0; }

   double b=atr*HT5SourceStopBufferATR(source);
   double candidate=base;
   double swing=(dir==DIR_BUY?gPyrLow1:gPyrHigh1);
   bool swingValid=(swing>0.0 && (dir==DIR_BUY?swing<openPrice:swing>openPrice));
   double swingStop=(swingValid?swing-dir*b:base);

   // The setup invalidation is sacred: other stop modes may extend beyond it but
   // may never tighten inside the price that mathematically disproves the setup.
   if(HowShouldTheCreaturePlaceItsStopLoss==STOP_LOSS_SETUP_INVALIDATION_ONLY)
   {
      candidate=base;
      reason="SETUP INVALIDATION";
   }
   else if(HowShouldTheCreaturePlaceItsStopLoss==STOP_LOSS_BEYOND_LAST_STRUCTURE_SWING)
   {
      if(swingValid) candidate=(dir==DIR_BUY?MathMin(base,swingStop):MathMax(base,swingStop));
      reason=(swingValid?"SETUP + LAST STRUCTURE SWING":"SETUP INVALIDATION / NO SWING");
   }
   else if(HowShouldTheCreaturePlaceItsStopLoss==STOP_LOSS_HYBRID_SETUP_PLUS_STRUCTURE)
   {
      candidate=base-dir*b*0.45;
      if(swingValid)
      {
         double gap=MathAbs(swingStop-candidate);
         if(gap<=0.45*atr) candidate=(dir==DIR_BUY?MathMin(candidate,swingStop):MathMax(candidate,swingStop));
      }
      reason="HYBRID SETUP + NEAR STRUCTURE";
   }
   else
   {
      double adaptive=b;
      candidate=base-dir*adaptive;
      if(swingValid)
      {
         double structuralBeyond=(dir==DIR_BUY?candidate-swingStop:swingStop-candidate);
         if(structuralBeyond>=0.0 && structuralBeyond<=0.38*atr)
            candidate=(dir==DIR_BUY?MathMin(candidate,swingStop):MathMax(candidate,swingStop));
      }

      // If the setup is a break/retest, the broken rail itself is part of the
      // thesis. Keep the stop beyond the rail, not randomly inside the pullback.
      if(source==PYR_SOURCE_BOS_PULLBACK || source==PYR_SOURCE_CHANNEL_BREAK_PULLBACK ||
         source==PYR_SOURCE_CHANNEL_BREAK || source==PYR_SOURCE_TRIGGER_RAIL_BREAK)
      {
         double railStop=gHT5SetupEvent[source].trigger-dir*atr*(0.10+0.50*HT5SourceStopBufferATR(source));
         candidate=(dir==DIR_BUY?MathMin(candidate,railStop):MathMax(candidate,railStop));
      }

      // Liquidity-grab entries are invalid only when the swept extreme truly fails.
      if(source==PYR_SOURCE_FAILED_LOW_LIQUIDITY_BUY && gMDDayNearLow && gMDDayLow>0.0)
      {
         double dayStop=gMDDayLow-atr*0.06;
         if(openPrice-dayStop<=gHT5StopMaxDistanceATR*atr) candidate=MathMin(candidate,dayStop);
      }
      if(source==PYR_SOURCE_FAILED_HIGH_LIQUIDITY_SELL && gMDDayNearHigh && gMDDayHigh>0.0)
      {
         double dayStop=gMDDayHigh+atr*0.06;
         if(dayStop-openPrice<=gHT5StopMaxDistanceATR*atr) candidate=MathMax(candidate,dayStop);
      }
      reason="ADAPTIVE THESIS INVALIDATION";
   }

   // Existing campaigns have already earned protection. A new named add may not
   // reopen risk behind the most-forward common stop already protecting the train.
   if(TradeCount()>0)
   {
      double forward=0.0;
      for(int si=OrdersTotal()-1;si>=0;si--)
      {
         if(!OrderSelect(si,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;
         int ot=OrderType();
         if((dir==DIR_BUY && ot!=OP_BUY)||(dir==DIR_SELL && ot!=OP_SELL)) continue;
         double osl=OrderStopLoss(); if(osl<=0.0) osl=SovStoredStop(OrderTicket());
         if(osl<=0.0) continue;
         if(forward<=0.0) forward=osl;
         else if(dir==DIR_BUY) forward=MathMax(forward,osl);
         else forward=MathMin(forward,osl);
      }
      if(forward>0.0)
      {
         double minGap=MathMax(Point,MarketInfo(Symbol(),MODE_STOPLEVEL)*Point+Point);
         bool legal=(dir==DIR_BUY?forward<openPrice-minGap:forward>openPrice+minGap);
         if(legal) candidate=(dir==DIR_BUY?MathMax(candidate,forward):MathMin(candidate,forward));
      }
   }

   candidate=HT5RoundBrokerSafeStop(dir,openPrice,candidate);
   double distance=MathAbs(openPrice-candidate);
   if(distance<Point*2) { reason="STOP TOO TIGHT"; return 0.0; }
   if(distance>atr*gHT5StopMaxDistanceATR)
   {
      reason="THESIS STOP TOO WIDE "+DoubleToString(distance/atr,2)+" ATR";
      return 0.0;
   }
   return candidate;
}

bool HT5SetupSourceEnabled(int source)
{
   if(source<=PYR_SOURCE_NONE || source>=32) return false;
   if(WhichNamedSetupFamiliesMayCreateEntries==SETUP_LIBRARY_ALL_NAMED_CREATURE_SETUPS) return true;
   if(WhichNamedSetupFamiliesMayCreateEntries==SETUP_LIBRARY_STRUCTURE_AND_LIQUIDITY)
      return (source<=PYR_SOURCE_CHANNEL_BREAK_PULLBACK ||
              source==PYR_SOURCE_FAILED_LOW_LIQUIDITY_BUY || source==PYR_SOURCE_FAILED_HIGH_LIQUIDITY_SELL ||
              source==PYR_SOURCE_U_SETUP || source==PYR_SOURCE_N_SETUP);
   // CORE ONLY = the original Living Organism source family (0..13).
   return (source>PYR_SOURCE_NONE && source<=PYR_SOURCE_TRIGGER_RAIL_BREAK);
}

bool HT5BreakDirectAllowed(int dir)
{
   if(HowShouldBreakoutsAndBOSExecute==BREAK_ENTER_ON_PROVEN_BREAK_ONLY) return true;
   if(HowShouldBreakoutsAndBOSExecute==BREAK_WAIT_FOR_PULLBACK_ONLY) return false;
   if(HowShouldBreakoutsAndBOSExecute==BREAK_ALLOW_BREAK_AND_PULLBACK_ENTRIES) return true;
   // Adaptive: only chase a fresh break when live flow is already carrying price
   // away from the rail. Otherwise preserve the event for the pullback engine.
   double flow=dir*(0.55*gMDRhythmScore+0.30*gMDRhythmForce+0.15*gMDPressureATR);
   return flow>=0.10;
}

bool HT5BreakPullbackAllowed(int dir)
{
   if(HowShouldBreakoutsAndBOSExecute==BREAK_ENTER_ON_PROVEN_BREAK_ONLY) return false;
   if(HowShouldBreakoutsAndBOSExecute==BREAK_WAIT_FOR_PULLBACK_ONLY) return true;
   if(HowShouldBreakoutsAndBOSExecute==BREAK_ALLOW_BREAK_AND_PULLBACK_ENTRIES) return true;
   return !HT5BreakDirectAllowed(dir);
}

int HT5RequiredSetupAgreements(int source,int dir)
{
   int base=1;
   if(HowMuchIndependentAgreementMustASetupHave==AGREEMENT_TWO_INDEPENDENT_WITNESSES) base=2;
   else if(HowMuchIndependentAgreementMustASetupHave==AGREEMENT_THREE_STRONG_WITNESSES) base=3;
   else if(HowMuchIndependentAgreementMustASetupHave==AGREEMENT_ADAPTIVE_BY_SETUP_RELIABILITY)
   {
      double rel=HT5SourceReliability(source);
      if(gHT5SourceSamples[source]<3.0) base=1;
      else if(rel>=0.64) base=1;
      else if(rel>=0.46) base=2;
      else base=3;
   }
   int extra=HT5ProbationExtraWitnesses(source,dir);
   return MathMax(1,MathMin(3,base+extra));
}

int HT5IndependentAgreement(int source,int dir,string &witnesses,double &score)
{
   witnesses=""; score=0.0;
   if(dir==DIR_FLAT) return 0;
   int n=0;
   // A setup may not "confirm itself" through the same evidence family used to
   // detect it. CC GROW already consumes compression/structure; KINGDOM MANNER
   // already consumes Oracle OB/FVG location, so those categories are excluded.
   bool selfStruct=(HT5SourceIsStructureFamily(source) || source==PYR_SOURCE_CC_GROW);
   bool selfChannel=HT5SourceIsChannelFamily(source);
   bool selfLocation=HT5SourceIsLocationFamily(source);
   bool selfMotion=HT5SourceIsMotionFamily(source);
   bool selfOracle=(source==PYR_SOURCE_KINGDOM_MANNER);

   // STRUCTURE witness: local + multi-timeframe skeleton.
   double structV=dir*(0.55*gMDStructureATR+0.25*gMDBOSATR+0.20*gHT5StructureAtlasPotential);
   if(!selfStruct && structV>0.035)
   { n++; score+=MathMin(1.0,structV); witnesses+=(witnesses==""?"":"+")+"STRUCT"; }

   // CHANNEL witness: historical rails agree with direction or accepted break.
   double channelV=dir*gMDChannelATR;
   bool channelHard=(gMDChannelBreakDirection==dir || gMDChannelBounceDirection==dir || gMDTriggerRailBreakDirection==dir || gMDTriggerRailBounceDirection==dir);
   if(!selfChannel && (channelHard || channelV>0.035))
   { n++; score+=MathMin(1.0,MathMax(channelV,channelHard?0.35:0.0)); witnesses+=(witnesses==""?"":"+")+"CHANNEL"; }

   // FLOW witness: tick rhythm, pressure and force agree. One family gets one vote.
   double flowV=dir*(0.45*gMDRhythmScore+0.35*gMDRhythmForce+0.20*gMDPressureATR);
   if(!selfMotion && flowV>0.025)
   { n++; score+=MathMin(1.0,flowV); witnesses+=(witnesses==""?"":"+")+"FLOW"; }

   // LOCATION witness: directional field, FVG/OB/station/reclaim attraction.
   double locV=dir*gHT5Location.netDirectionalField;
   bool locHard=(gHT5Location.fvgField>0.28 || gHT5Location.obField>0.28 || gHT5Location.stationField>0.30 || gHT5Location.reclaimField>0.30);
   if(!selfLocation && (locV>0.035 || locHard))
   { n++; score+=MathMin(1.0,MathMax(locV,locHard?0.30:0.0)); witnesses+=(witnesses==""?"":"+")+"LOCATION"; }

   // ORACLE is independent except when the setup itself is defined by Oracle OB/FVG.
   double oracleV=dir*(0.36*gMDOracleMicroTrendATR+0.36*gMDOracleOBFVGATR+0.28*gMDOraclePhaseATR);
   if(!selfOracle && oracleV>0.035)
   { n++; score+=MathMin(1.0,oracleV); witnesses+=(witnesses==""?"":"+")+"ORACLE"; }

   // MULTI-TIMEFRAME witness prevents one timeframe from being the only story.
   bool mtf=(HT5Sign(gHT5StructureAtlasPotential)==dir && gHT5StructureAtlasAgreement>=0.34);
   if(mtf)
   { n++; score+=MathMin(1.0,0.35+gHT5StructureAtlasAgreement); witnesses+=(witnesses==""?"":"+")+"MTF"; }

   // Pattern memory is allowed to confirm but never to create direction by itself.
   if(gHT5DeepPredictionConfidence>=0.55 && dir*gHT5DeepPredictionR>0.05)
   { n++; score+=MathMin(1.0,gHT5DeepPredictionConfidence*MathAbs(gHT5DeepPredictionR)); witnesses+=(witnesses==""?"":"+")+"MEMORY"; }

   score=score/MathMax(1,n);
   return n;
}

bool HT5SetupHardSafety(int dir,string &reason)
{
   reason="OK";
   if(dir==DIR_FLAT){ reason="NO DIRECTION"; return false; }
   if(gCompoundEntryFreeze || gPyrPeakObservationActive){ reason=(gCompoundEntryFreeze?"COMPOUND FREEZE":"PEAK OBSERVATION"); return false; }
   if(MarketDNADayHLGuard && !MarketDNADayHLAllowsDirection(dir)){ reason="DAY HL FIREWALL"; return false; }
   bool oppositeHard=(dir==DIR_BUY ? (gMDTriggerRailBreakDirection==DIR_SELL || gMDChannelBreakDirection==DIR_SELL) :
                                      (gMDTriggerRailBreakDirection==DIR_BUY || gMDChannelBreakDirection==DIR_BUY));
   if(oppositeHard){ reason="OPPOSITE HARD BREAK"; return false; }
   int openDir=(int)DetectDirection();
   if(TradeCount()>0 && openDir!=DIR_FLAT && openDir!=dir){ reason="OPPOSITE CAMPAIGN OPEN"; return false; }
   return true;
}

void HT5ArmSetupEvent(int source,int dir,double trigger,double invalidation,double targetR,bool pullbackRequired,string label,double quality,datetime identity)
{
   if(source<=PYR_SOURCE_NONE || source>=32 || dir==DIR_FLAT || trigger<=0.0 || invalidation<=0.0) return;
   if(!HT5SetupSourceEnabled(source)) return;
   if(identity<=0) identity=iTime(Symbol(),SignalTF,0);
   // One market event may only become one setup event per source. Once that exact
   // identity is filled/consumed, subsequent ticks may not resurrect it. A new bar/
   // break identity must earn a fresh event.
   if(gHT5SetupEvent[source].armed && gHT5SetupEvent[source].identity==identity &&
      gHT5SetupEvent[source].direction==dir) return;
   gHT5SetupEvent[source].armed=true;
   gHT5SetupEvent[source].pullbackRequired=pullbackRequired;
   gHT5SetupEvent[source].consumed=false;
   gHT5SetupEvent[source].ready=false;
   gHT5SetupEvent[source].campaignWitnessed=false;
   gHT5SetupEvent[source].direction=dir;
   gHT5SetupEvent[source].source=source;
   gHT5SetupEvent[source].identity=identity;
   gHT5SetupEvent[source].expires=TimeCurrent()+MathMax(60,PeriodSeconds(SignalTF))*(pullbackRequired?18:6);
   gHT5SetupEvent[source].trigger=NormalizeDouble(trigger,Digits);
   gHT5SetupEvent[source].invalidation=NormalizeDouble(invalidation,Digits);
   gHT5SetupEvent[source].targetR=MathMax(0.50,targetR);
   gHT5SetupEvent[source].quality=HT5Clamp(quality,0.0,2.0);
   gHT5SetupEvent[source].agreementScore=0.0;
   gHT5SetupEvent[source].agreementCount=0;
   gHT5SetupEvent[source].label=label;
   gHT5SetupEvent[source].witnesses="";
   gHT5SetupEvent[source].state=label+" ARMED"+(pullbackRequired?" / WAIT PULLBACK":" / WAIT AGREEMENT");
}

bool HT5SetupRetestTouched(int source,double atr)
{
   if(source<=PYR_SOURCE_NONE || source>=32) return false;
   RefreshRates();
   double mid=(Bid+Ask)*0.5;
   double tol=atr*0.10;
   if(source==PYR_SOURCE_CHANNEL_BREAK_PULLBACK) tol=atr*0.14;
   if(source==PYR_SOURCE_BOS_PULLBACK) tol=atr*0.11;
   bool near=(MathAbs(mid-gHT5SetupEvent[source].trigger)<=tol);
   if(!near) return false;
   if(gHT5SetupEvent[source].direction==DIR_BUY)
      return (mid>=gHT5SetupEvent[source].trigger-tol && iClose(Symbol(),SignalTF,0)>=gHT5SetupEvent[source].trigger-tol);
   return (mid<=gHT5SetupEvent[source].trigger+tol && iClose(Symbol(),SignalTF,0)<=gHT5SetupEvent[source].trigger+tol);
}

void HT5CaptureLegacyBreakEvents(int bosTurn,int channelBreakTurn,int failedTurn)
{
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double b=atr*0.12;
   if(bosTurn!=DIR_FLAT)
   {
      double trigger=(bosTurn==DIR_BUY?gPyrHigh1:gPyrLow1);
      double invalid=(bosTurn==DIR_BUY?iLow(Symbol(),SignalTF,1)-b:iHigh(Symbol(),SignalTF,1)+b);
      if(HT5BreakDirectAllowed(bosTurn))
         HT5ArmSetupEvent(PYR_SOURCE_BOS_CONTINUATION,bosTurn,trigger,invalid,1.00,false,
                          (bosTurn==DIR_BUY?"BOS BREAK BUY":"BOS BREAK SELL"),1.15,gPyrActiveSignalIdentity);
      if(HT5BreakPullbackAllowed(bosTurn))
         HT5ArmSetupEvent(PYR_SOURCE_BOS_PULLBACK,bosTurn,trigger,
                          trigger-bosTurn*atr*0.24,1.25,true,
                          (bosTurn==DIR_BUY?"BOS BREAK -> PULLBACK BUY":"BOS BREAK -> PULLBACK SELL"),1.30,gPyrActiveSignalIdentity);
   }
   if(channelBreakTurn!=DIR_FLAT)
   {
      double rail=(channelBreakTurn==DIR_BUY?gMDChannelResistanceNow:gMDChannelSupportNow);
      if(rail<=0.0) rail=(channelBreakTurn==DIR_BUY?gPyrHigh1:gPyrLow1);
      double invalid=rail-channelBreakTurn*atr*0.26;
      if(HT5BreakDirectAllowed(channelBreakTurn))
         HT5ArmSetupEvent(PYR_SOURCE_CHANNEL_BREAK,channelBreakTurn,rail,invalid,1.10,false,
                          (channelBreakTurn==DIR_BUY?"CHANNEL ESCAPE BUY":"CHANNEL ESCAPE SELL"),1.25,gMDChannelBreakIdentity);
      if(HT5BreakPullbackAllowed(channelBreakTurn))
         HT5ArmSetupEvent(PYR_SOURCE_CHANNEL_BREAK_PULLBACK,channelBreakTurn,rail,invalid,1.35,true,
                          (channelBreakTurn==DIR_BUY?"CHANNEL BREAK -> PULLBACK BUY":"CHANNEL BREAK -> PULLBACK SELL"),1.45,gMDChannelBreakIdentity);
   }
   if(failedTurn==DIR_BUY)
   {
      double sweep=iLow(Symbol(),SignalTF,1);
      HT5ArmSetupEvent(PYR_SOURCE_FAILED_LOW_LIQUIDITY_BUY,DIR_BUY,
                       MathMax(gPyrLow1,iClose(Symbol(),SignalTF,1)),sweep-atr*0.08,1.45,false,
                       "FAILED LOW LIQUIDITY GRAB BUY",1.40,gPyrBreakIdentity);
   }
   else if(failedTurn==DIR_SELL)
   {
      double sweep=iHigh(Symbol(),SignalTF,1);
      HT5ArmSetupEvent(PYR_SOURCE_FAILED_HIGH_LIQUIDITY_SELL,DIR_SELL,
                       MathMin(gPyrHigh1,iClose(Symbol(),SignalTF,1)),sweep+atr*0.08,1.45,false,
                       "FAILED HIGH LIQUIDITY GRAB SELL",1.40,gPyrBreakIdentity);
   }
}

// Capture the rest of the original Living Organism entry vocabulary into the
// same universal tribunal. These are DETECTORS only; none may send orders.
void HT5CaptureExistingNamedEvents(int flipTurn,int retestTurn,int stationTurn,int reclaimTurn,
                                   int routeTurn,int transitionTurn,int channelBounceTurn,
                                   int triggerBounceTurn,int triggerBreakTurn)
{
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   RefreshRates(); double p=(Bid+Ask)*0.5;
   datetime bar0=iTime(Symbol(),SignalTF,0),bar1=iTime(Symbol(),SignalTF,1);

   if(flipTurn!=DIR_FLAT)
   {
      double trig=(flipTurn==DIR_BUY?MathMax(p,gPyrBullFlipTrigger):MathMin(p,gPyrBearFlipTrigger));
      double inv=(flipTurn==DIR_BUY?MathMin(gPyrLow1,iLow(Symbol(),SignalTF,1))-0.12*atr:
                                     MathMax(gPyrHigh1,iHigh(Symbol(),SignalTF,1))+0.12*atr);
      HT5ArmSetupEvent(PYR_SOURCE_CONFIRMED_TREND_FLIP,flipTurn,trig,inv,1.35,false,
                       (flipTurn==DIR_BUY?"CONFIRMED TREND FLIP BUY":"CONFIRMED TREND FLIP SELL"),1.35,
                       (gPyrActiveSignalIdentity>0?gPyrActiveSignalIdentity:bar1));
   }
   if(routeTurn!=DIR_FLAT && gPyrRouteLastStation>0.0)
   {
      double inv=gPyrRouteLastStation-routeTurn*0.28*atr;
      HT5ArmSetupEvent(PYR_SOURCE_ROUTE_ACCELERATOR,routeTurn,gPyrRouteLastStation,inv,1.15,false,
                       (routeTurn==DIR_BUY?"ROUTE ACCELERATOR BUY":"ROUTE ACCELERATOR SELL"),1.15,
                       (gPyrRouteStationIdentity>0?gPyrRouteStationIdentity:bar0));
   }
   if(retestTurn!=DIR_FLAT && gPyrRetestStation>0.0)
   {
      double inv=gPyrRetestStation-retestTurn*0.26*atr;
      HT5ArmSetupEvent(PYR_SOURCE_DIRECTIONAL_RETEST,retestTurn,gPyrRetestStation,inv,1.25,false,
                       (retestTurn==DIR_BUY?"PROFIT STATION RETEST BUY":"PROFIT STATION RETEST SELL"),1.25,bar1);
   }
   if(stationTurn!=DIR_FLAT)
   {
      double st=(stationTurn==DIR_BUY?gPyrBuyStation:gPyrSellStation);
      if(st>0.0)
      {
         double inv=st-stationTurn*0.26*atr;
         datetime sid=(stationTurn==DIR_BUY?gPyrBuyStationIdentity:gPyrSellStationIdentity);
         HT5ArmSetupEvent(PYR_SOURCE_TRAIN_STATION,stationTurn,st,inv,1.20,false,
                          (stationTurn==DIR_BUY?"IL TRAIN STATION BUY":"IL TRAIN STATION SELL"),1.20,(sid>0?sid:bar0));
      }
   }
   if(reclaimTurn!=DIR_FLAT && gPyrActiveReclaimLevel>0.0)
   {
      double inv=gPyrActiveReclaimLevel-reclaimTurn*0.25*atr;
      HT5ArmSetupEvent(PYR_SOURCE_RECLAIM_AREA,reclaimTurn,gPyrActiveReclaimLevel,inv,1.20,false,
                       (reclaimTurn==DIR_BUY?"TARGET RECLAIM BUY ":"TARGET RECLAIM SELL ")+gPyrActiveReclaimName,1.20,bar0);
   }
   if(transitionTurn!=DIR_FLAT)
   {
      double base=(gPyrCollectedStation>0.0?gPyrCollectedStation:p);
      double inv=base-transitionTurn*0.34*atr;
      HT5ArmSetupEvent(PYR_SOURCE_INFLECTION_TRANSFER,transitionTurn,base,inv,1.35,false,
                       (transitionTurn==DIR_BUY?"PEAK/INFLECTION TRANSFER BUY":"PEAK/INFLECTION TRANSFER SELL"),1.35,bar0);
   }
   if(channelBounceTurn!=DIR_FLAT)
   {
      double rail=(channelBounceTurn==DIR_BUY?gMDChannelSupportNow:gMDChannelResistanceNow);
      if(rail<=0.0) rail=p;
      HT5ArmSetupEvent(PYR_SOURCE_CHANNEL_BOUNCE,channelBounceTurn,rail,rail-channelBounceTurn*0.28*atr,1.30,false,
                       (channelBounceTurn==DIR_BUY?"HIST CHANNEL BOUNCE BUY":"HIST CHANNEL BOUNCE SELL"),1.35,bar0);
   }
   if(triggerBounceTurn!=DIR_FLAT && gMDTriggerRailNow>0.0)
      HT5ArmSetupEvent(PYR_SOURCE_TRIGGER_RAIL_BOUNCE,triggerBounceTurn,gMDTriggerRailNow,
                       gMDTriggerRailNow-triggerBounceTurn*0.24*atr,1.35,false,
                       (triggerBounceTurn==DIR_BUY?"BLACK RAIL BOUNCE BUY":"BLACK RAIL BOUNCE SELL"),1.40,
                       (gMDTriggerRailIdentity>0?gMDTriggerRailIdentity:bar0));
   if(triggerBreakTurn!=DIR_FLAT && gMDTriggerRailNow>0.0)
      HT5ArmSetupEvent(PYR_SOURCE_TRIGGER_RAIL_BREAK,triggerBreakTurn,gMDTriggerRailNow,
                       gMDTriggerRailNow-triggerBreakTurn*0.26*atr,1.40,false,
                       (triggerBreakTurn==DIR_BUY?"BLACK RAIL BREAK BUY":"BLACK RAIL BREAK SELL"),1.50,
                       (gMDTriggerRailIdentity>0?gMDTriggerRailIdentity:bar0));
}

// U/N are reconstructed structure-shape setups: U = failed/depressed low followed
// by a higher right side and neckline reclaim; N = mirrored distribution shape.
void HT5DetectUNSetups()
{
   if(WhichNamedSetupFamiliesMayCreateEntries<SETUP_LIBRARY_STRUCTURE_AND_LIQUIDITY) return;
   if(iBars(Symbol(),SignalTF)<8) return;
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double l5=iLow(Symbol(),SignalTF,5),l3=iLow(Symbol(),SignalTF,3),l1=iLow(Symbol(),SignalTF,1);
   double h5=iHigh(Symbol(),SignalTF,5),h3=iHigh(Symbol(),SignalTF,3),h1=iHigh(Symbol(),SignalTF,1);
   double c1=iClose(Symbol(),SignalTF,1),o1=iOpen(Symbol(),SignalTF,1);
   double uNeck=MathMax(iHigh(Symbol(),SignalTF,4),iHigh(Symbol(),SignalTF,2));
   double nNeck=MathMin(iLow(Symbol(),SignalTF,4),iLow(Symbol(),SignalTF,2));
   bool u=(l3<l5-0.05*atr && l1>l3+0.05*atr && c1>o1 && c1>uNeck);
   bool n=(h3>h5+0.05*atr && h1<h3-0.05*atr && c1<o1 && c1<nNeck);
   datetime id=iTime(Symbol(),SignalTF,1);
   if(u) HT5ArmSetupEvent(PYR_SOURCE_U_SETUP,DIR_BUY,uNeck,l3-0.10*atr,1.40,false,"U SETUP NECKLINE BUY",1.30,id);
   if(n) HT5ArmSetupEvent(PYR_SOURCE_N_SETUP,DIR_SELL,nNeck,h3+0.10*atr,1.40,false,"N SETUP NECKLINE SELL",1.30,id);
}

// MOTIV v3 reconstruction: impulse -> controlled pullback -> renewed motion.
void HT5DetectMotivV3()
{
   if(WhichNamedSetupFamiliesMayCreateEntries<SETUP_LIBRARY_ALL_NAMED_CREATURE_SETUPS) return;
   if(iBars(Symbol(),SignalTF)<10) return;
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double c6=iClose(Symbol(),SignalTF,6),c3=iClose(Symbol(),SignalTF,3),c1=iClose(Symbol(),SignalTF,1);
   double impulse=(c3-c6)/atr;
   double pull=(c1-c3)/atr;
   double body1=(iClose(Symbol(),SignalTF,1)-iOpen(Symbol(),SignalTF,1))/atr;
   datetime id=iTime(Symbol(),SignalTF,1);
   if(impulse>0.38 && pull>-0.45 && pull<0.05 && body1>0.16 && c1>iHigh(Symbol(),SignalTF,2))
   {
      double inv=MathMin(iLow(Symbol(),SignalTF,1),iLow(Symbol(),SignalTF,2))-0.08*atr;
      HT5ArmSetupEvent(PYR_SOURCE_MOTIV_V3,DIR_BUY,iHigh(Symbol(),SignalTF,2),inv,1.35,false,"MOTIV V3 IMPULSE-PULLBACK BUY",1.35,id);
   }
   if(impulse<-0.38 && pull<0.45 && pull>-0.05 && body1<-0.16 && c1<iLow(Symbol(),SignalTF,2))
   {
      double inv=MathMax(iHigh(Symbol(),SignalTF,1),iHigh(Symbol(),SignalTF,2))+0.08*atr;
      HT5ArmSetupEvent(PYR_SOURCE_MOTIV_V3,DIR_SELL,iLow(Symbol(),SignalTF,2),inv,1.35,false,"MOTIV V3 IMPULSE-PULLBACK SELL",1.35,id);
   }
}

// CC GROW reconstruction: compression stores energy, expansion releases it in
// the direction already supported by the skeleton/route.
void HT5DetectCCGrow()
{
   if(WhichNamedSetupFamiliesMayCreateEntries<SETUP_LIBRARY_ALL_NAMED_CREATURE_SETUPS) return;
   if(iBars(Symbol(),SignalTF)<8) return;
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double r2=iHigh(Symbol(),SignalTF,2)-iLow(Symbol(),SignalTF,2);
   double r3=iHigh(Symbol(),SignalTF,3)-iLow(Symbol(),SignalTF,3);
   double r4=iHigh(Symbol(),SignalTF,4)-iLow(Symbol(),SignalTF,4);
   double compression=(r2+r3+r4)/(3.0*atr);
   double body=(iClose(Symbol(),SignalTF,1)-iOpen(Symbol(),SignalTF,1))/atr;
   double hi=MathMax(iHigh(Symbol(),SignalTF,2),MathMax(iHigh(Symbol(),SignalTF,3),iHigh(Symbol(),SignalTF,4)));
   double lo=MathMin(iLow(Symbol(),SignalTF,2),MathMin(iLow(Symbol(),SignalTF,3),iLow(Symbol(),SignalTF,4)));
   datetime id=iTime(Symbol(),SignalTF,1);
   if(compression<0.85 && body>0.28 && iClose(Symbol(),SignalTF,1)>hi && (gPyrTrendDirection==DIR_BUY || gHT5StructureAtlasPotential>0.05))
      HT5ArmSetupEvent(PYR_SOURCE_CC_GROW,DIR_BUY,hi,lo-0.08*atr,1.30,false,"CC GROW COMPRESSION RELEASE BUY",1.30,id);
   if(compression<0.85 && body<-0.28 && iClose(Symbol(),SignalTF,1)<lo && (gPyrTrendDirection==DIR_SELL || gHT5StructureAtlasPotential<-0.05))
      HT5ArmSetupEvent(PYR_SOURCE_CC_GROW,DIR_SELL,lo,hi+0.08*atr,1.30,false,"CC GROW COMPRESSION RELEASE SELL",1.30,id);
}

// KINGDOM MANNER reconstruction: institutional location + acceptance. KINGDOM
// +SCALE is the continuation/add behavior after the first campaign has proven.
void HT5DetectKingdomSetups()
{
   if(WhichNamedSetupFamiliesMayCreateEntries<SETUP_LIBRARY_ALL_NAMED_CREATURE_SETUPS) return;
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   RefreshRates(); double p=(Bid+Ask)*0.5;
   datetime id=iTime(Symbol(),SignalTF,0);
   bool buyLoc=(gMDOracleBuyOBTop>gMDOracleBuyOBBot && p>=gMDOracleBuyOBBot-0.08*atr && p<=gMDOracleBuyOBTop+0.08*atr) ||
               (gMDOracleBuyFVGTop>gMDOracleBuyFVGBot && p>=gMDOracleBuyFVGBot-0.08*atr && p<=gMDOracleBuyFVGTop+0.08*atr);
   bool sellLoc=(gMDOracleSellOBTop>gMDOracleSellOBBot && p>=gMDOracleSellOBBot-0.08*atr && p<=gMDOracleSellOBTop+0.08*atr) ||
                (gMDOracleSellFVGTop>gMDOracleSellFVGBot && p>=gMDOracleSellFVGBot-0.08*atr && p<=gMDOracleSellFVGTop+0.08*atr);
   if(TradeCount()==0)
   {
      if(buyLoc && (gMDAcceptanceATR>0.03 || gMDReclaimATR>0.04))
      {
         double edge=(gMDOracleBuyOBBot>0.0?gMDOracleBuyOBBot:(gMDOracleBuyFVGBot>0.0?gMDOracleBuyFVGBot:p-0.35*atr));
         HT5ArmSetupEvent(PYR_SOURCE_KINGDOM_MANNER,DIR_BUY,p,edge-0.10*atr,1.55,false,"KINGDOM MANNER INSTITUTIONAL BUY",1.50,id);
      }
      if(sellLoc && (gMDAcceptanceATR<-0.03 || gMDReclaimATR< -0.04))
      {
         double edge=(gMDOracleSellOBTop>0.0?gMDOracleSellOBTop:(gMDOracleSellFVGTop>0.0?gMDOracleSellFVGTop:p+0.35*atr));
         HT5ArmSetupEvent(PYR_SOURCE_KINGDOM_MANNER,DIR_SELL,p,edge+0.10*atr,1.55,false,"KINGDOM MANNER INSTITUTIONAL SELL",1.50,id);
      }
   }
   else
   {
      int dir=(int)DetectDirection();
      if(dir!=DIR_FLAT && gPyrEntryAnchor>0.0 && gPyrInvalidation>0.0)
      {
         double R=MathAbs(gPyrEntryAnchor-gPyrInvalidation);
         double progress=(R>Point?dir*(p-gPyrEntryAnchor)/R:0.0);
         bool pullback=(dir==DIR_BUY ? (iLow(Symbol(),SignalTF,0)<=p+0.10*atr) : (iHigh(Symbol(),SignalTF,0)>=p-0.10*atr));
         bool reaccelerate=(dir*gMDRhythmScore>0.04 && dir*gMDPressureATR>0.01);
         if(progress>=0.18 && pullback && reaccelerate)
         {
            double inv=(dir==DIR_BUY?MathMin(gPyrInvalidation,p-0.30*atr):MathMax(gPyrInvalidation,p+0.30*atr));
            HT5ArmSetupEvent(PYR_SOURCE_KINGDOM_SCALE,dir,p,inv,1.00,false,
                             (dir==DIR_BUY?"KINGDOM +SCALE PROVEN BUY ADD":"KINGDOM +SCALE PROVEN SELL ADD"),1.25,id);
         }
      }
   }
}

void HT5SenseNamedSetupLibrary(int bosTurn,int channelBreakTurn,int failedTurn)
{
   HT5CaptureLegacyBreakEvents(bosTurn,channelBreakTurn,failedTurn);
   HT5DetectUNSetups();
   HT5DetectMotivV3();
   HT5DetectCCGrow();
   HT5DetectKingdomSetups();
}

int HT5SelectReadySetup()
{
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   int best=PYR_SOURCE_NONE; double bestScore=-999.0;
   for(int source=1;source<32;source++)
   {
      if(!gHT5SetupEvent[source].armed || gHT5SetupEvent[source].consumed || gHT5SetupEvent[source].direction==DIR_FLAT) continue;
      if(TradeCount()>0 && HowShouldMultipleSignalsJoinOneCampaign>=MERGE_SAME_DIRECTION_INTO_CAMPAIGN &&
         gHT5SetupEvent[source].campaignWitnessed) continue;
      if(gHT5SetupEvent[source].expires>0 && TimeCurrent()>gHT5SetupEvent[source].expires)
      { gHT5SetupEvent[source].armed=false; gHT5SetupEvent[source].state=gHT5SetupEvent[source].label+" EXPIRED"; continue; }
      string safety="";
      if(!HT5SetupHardSafety(gHT5SetupEvent[source].direction,safety))
      { gHT5SetupEvent[source].ready=false; gHT5SetupEvent[source].state=gHT5SetupEvent[source].label+" WAIT | "+safety; continue; }
      bool locationReady=(!gHT5SetupEvent[source].pullbackRequired || HT5SetupRetestTouched(source,atr));
      if(!locationReady)
      { gHT5SetupEvent[source].ready=false; gHT5SetupEvent[source].state=gHT5SetupEvent[source].label+" WAIT PULLBACK @ "+DoubleToString(gHT5SetupEvent[source].trigger,Digits); continue; }

      // A direct event is not a license to chase several ATR after the event. If
      // its immediate execution window is gone, the dedicated pullback variant
      // (BOS/channel) remains available and must earn the retest instead.
      if(!gHT5SetupEvent[source].pullbackRequired)
      {
         RefreshRates(); double now=(gHT5SetupEvent[source].direction==DIR_BUY?Ask:Bid);
         double chase=gHT5SetupEvent[source].direction*(now-gHT5SetupEvent[source].trigger)/atr;
         double maxChase=(source==PYR_SOURCE_TRIGGER_RAIL_BREAK?0.70:
                          (source==PYR_SOURCE_BOS_CONTINUATION || source==PYR_SOURCE_CHANNEL_BREAK?0.60:0.85));
         if(chase>maxChase)
         {
            gHT5SetupEvent[source].ready=false; gHT5SetupEvent[source].consumed=true;
            gHT5SetupEvent[source].state=gHT5SetupEvent[source].label+" DIRECT WINDOW PASSED / NO CHASE";
            continue;
         }
      }
      string witnesses=""; double agreeScore=0.0;
      int agreements=HT5IndependentAgreement(source,gHT5SetupEvent[source].direction,witnesses,agreeScore);
      int required=HT5RequiredSetupAgreements(source,gHT5SetupEvent[source].direction);
      gHT5SetupEvent[source].agreementCount=agreements;
      gHT5SetupEvent[source].agreementScore=agreeScore;
      gHT5SetupEvent[source].witnesses=witnesses;
      gHT5SetupEvent[source].ready=(agreements>=required);
      if(!gHT5SetupEvent[source].ready)
      { gHT5SetupEvent[source].state=gHT5SetupEvent[source].label+" WAIT AGREEMENT "+IntegerToString(agreements)+"/"+IntegerToString(required); continue; }
      double sideRel=HT5SourceSideReliability(source,gHT5SetupEvent[source].direction);
      double rel=HT5Clamp(0.55*HT5SourceReliability(source)+0.45*sideRel,0.10,0.95);
      int probation=HT5SetupProbationLevel(source,gHT5SetupEvent[source].direction);
      double meshConflict=0.0;
      double mesh=HT5SetupMeshCoherence(source,meshConflict);
      double meshFloor=HT5RequiredMeshCoherence(source);
      if(mesh<meshFloor)
      {
         gHT5SetupEvent[source].ready=false;
         gHT5SetupEvent[source].state=gHT5SetupEvent[source].label+" WAIT MESH "+DoubleToString(mesh,2)+"/"+DoubleToString(meshFloor,2)+" • CONFLICT "+DoubleToString(meshConflict,2);
         continue;
      }
      double pullbackBonus=(gHT5SetupEvent[source].pullbackRequired?0.18:0.0);
      double score=gHT5SetupEvent[source].quality+0.38*agreeScore+0.22*rel+0.36*mesh+pullbackBonus;
      gHT5SetupEvent[source].state=gHT5SetupEvent[source].label+" READY • "+witnesses+" • MESH "+DoubleToString(mesh,2)+" • SIDE REL "+DoubleToString(sideRel,2)+" • P"+IntegerToString(probation);
      if(score>bestScore){ bestScore=score; best=source; }
   }
   if(best!=PYR_SOURCE_NONE)
   {
      HT5BuildLiveThesis(best);
      gHT5SetupState=gHT5SetupEvent[best].state;
   }
   else
   {
      if(TradeCount()==0) HT5ClearThesisCapsule(gHT5LiveThesis,"WAIT SETUP + MESH");
      gHT5SetupState="SETUP LIBRARY SEARCHING / WAIT AGREEMENT + MESH";
   }
   return best;
}

bool HT5PrepareSetupExecution(int source)
{
   if(source<=PYR_SOURCE_NONE || source>=32) return false;
   RefreshRates(); double price=(gHT5SetupEvent[source].direction==DIR_BUY?Ask:Bid);
   if(!gHT5LiveThesis.active || gHT5LiveThesis.source!=source) HT5BuildLiveThesis(source);
   string stopReason="";
   double stop=HT5ResolveNamedSetupStop(source,gHT5SetupEvent[source].direction,price,stopReason);
   if(stop<=0.0)
   {
      gHT5SetupEntryStop=0.0; gHT5SetupEntryTarget=0.0;
      gHT5StopLossState="STOP BLOCK • "+gHT5SetupEvent[source].label+" • "+stopReason;
      gHT5SetupEvent[source].state=gHT5SetupEvent[source].label+" WAIT STOP • "+stopReason;
      return false;
   }
   double R=MathAbs(price-stop);
   if(R<Point*2)
   {
      gHT5StopLossState="STOP BLOCK • R TOO SMALL";
      return false;
   }
   string sanityReason="";
   if(!HT5StopSymbolSanityAllows(gHT5SetupEvent[source].direction,price,price,stop,false,sanityReason))
   {
      gHT5StopLossState="STOP SANITY BLOCK • "+sanityReason;
      gHT5SetupEvent[source].state=gHT5SetupEvent[source].label+" WAIT STOP SANITY • "+sanityReason;
      return false;
   }
   string survivalReason="";
   if(!HT5EntrySurvivalAllows(source,gHT5SetupEvent[source].direction,price,stop,survivalReason))
   {
      gHT5StopLossState="SURVIVAL BLOCK • "+survivalReason;
      gHT5SetupEvent[source].state=gHT5SetupEvent[source].label+" WAIT SURVIVAL • "+survivalReason;
      return false;
   }
   gHT5SetupEntryStop=NormalizeDouble(stop,Digits);
   gHT5SetupEntryTarget=NormalizeDouble(price+gHT5SetupEvent[source].direction*R*MathMax(0.50,gHT5SetupEvent[source].targetR),Digits);
   gHT5SetupEntryAgreement=gHT5SetupEvent[source].agreementScore;
   gHT5SetupEntryLabel=gHT5SetupEvent[source].label;
   gHT5SetupEntryWitnesses=gHT5SetupEvent[source].witnesses;
   gHT5StopLossState="SL "+DoubleToString(gHT5SetupEntryStop,Digits)+" • "+stopReason+" • "+DoubleToString(R/MathMax(Point,HTExecutionATR(SignalTF,14)),2)+" ATR";
   gHT5LiveThesis.stopPrice=gHT5SetupEntryStop;
   gHT5LiveThesis.stopReason=stopReason;
   gHT5LiveThesis.state+=" • SL "+stopReason;
   return true;
}

void HT5RegisterFilledSetupSource(int source,bool first)
{
   if(source<=PYR_SOURCE_NONE || source>=32) return;
   double riskWeight=1.0;
   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;
      int t=OrderType(); if(t!=OP_BUY && t!=OP_SELL) continue;
      double sl=OrderStopLoss(); if(sl<=0.0) sl=SovStoredStop(OrderTicket());
      if(sl>0.0) riskWeight=MathMax(0.01,OrderRiskMoneyFromPrices(OrderOpenPrice(),sl,OrderLots()));
      break;
   }
   if(first)
   {
      for(int k=0;k<32;k++) gHT5CampaignSourceWeight[k]=0.0;
      gHT5CampaignSourceTotalWeight=0.0;
      gHT5CampaignEntrySource=source;
      gHT5CampaignEntryLabel=HT5SourceName(source);
      gHT5CampaignEntryWitnesses=gHT5SetupEntryWitnesses;
      gHT5CampaignEntryAgreement=gHT5SetupEntryAgreement;
      gHT5CampaignEntryTime=TimeCurrent();
      HT5FreezeCampaignThesis(source);
   }
   gHT5CampaignSourceWeight[source]+=riskWeight;
   gHT5CampaignSourceTotalWeight+=riskWeight;
}

int HT5BestReadySetupForDirection(int dir)
{
   int best=PYR_SOURCE_NONE; double bestScore=-999.0;
   for(int source=1;source<32;source++)
   {
      if(!gHT5SetupEvent[source].armed || gHT5SetupEvent[source].consumed || !gHT5SetupEvent[source].ready) continue;
      if(gHT5SetupEvent[source].expires>0 && TimeCurrent()>gHT5SetupEvent[source].expires) continue;
      if(gHT5SetupEvent[source].direction!=dir) continue;
      double sideRel=HT5SourceSideReliability(source,dir);
      int probation=HT5SetupProbationLevel(source,dir);
      double score=gHT5SetupEvent[source].quality+0.40*gHT5SetupEvent[source].agreementScore+
                   0.12*HT5SourceReliability(source)+0.18*sideRel-0.12*probation;
      if(score>bestScore){ bestScore=score; best=source; }
   }
   return best;
}

bool HT5ExecuteBestSetupEntry()
{
   // v6.05: named sources are continuation POINTS only. They may never seed.
   if(HT6EinsteinEnabled()) return false;
   if(WhereMayFreshEntriesBegin!=ENTRY_ANY_NAMED_SETUP_WITH_AGREEMENT) return false;
   if(gMDEntryTickSerial==gHT5LastSetupAttemptSerial) return false;
   int source=HT5SelectReadySetup();
   if(source==PYR_SOURCE_NONE) return false;
   // v5.05 ONE CAMPAIGN / ONE THESIS: once a campaign exists, new same-direction
   // setup detections become witnesses and potential SONIC sponsors. They do not
   // fire independent seed orders at nearly the same price.
   if(TradeCount()>0 && HowShouldMultipleSignalsJoinOneCampaign>=MERGE_SAME_DIRECTION_INTO_CAMPAIGN)
   {
      int d=gHT5SetupEvent[source].direction;
      if(gHT5CampaignThesis.active && gHT5CampaignThesis.direction==d)
      {
         if(!gHT5SetupEvent[source].campaignWitnessed)
         {
            double witnessWeight=0.15+0.20*HT5Clamp(gHT5SetupEvent[source].quality/1.60,0.0,1.0);
            gHT5CampaignSourceWeight[source]+=witnessWeight;
            gHT5CampaignSourceTotalWeight+=witnessWeight;
            gHT5SetupEvent[source].campaignWitnessed=true;
         }
         gHT5SetupEvent[source].state=gHT5SetupEvent[source].label+" WITNESSING "+gHT5CampaignThesis.label+" • WAIT EARNED R-STAGE";
         gHT5SetupState=gHT5SetupEvent[source].state;
         gEntryStatus="SETUP MERGED INTO ACTIVE CAMPAIGN / NO DUPLICATE SEED";
         return false;
      }
   }

   if(gHT6DoctrineOwnsEntry)
   {
      string seqReason="";
      int seqKind=(TradeCount()==0?DOCTRINE_REQUEST_SEED:DOCTRINE_REQUEST_ADD);
      if(!HT6DoctrineAllowsRequest(gHT5SetupEvent[source].direction,seqKind,seqReason))
      {
         gHT5SetupEvent[source].state=gHT5SetupEvent[source].label+" SEQUENCE WAIT • "+seqReason;
         gHT5SetupState=gHT5SetupEvent[source].state;
         gEntryStatus=seqReason;
         return false;
      }
   }

   string trendReason="";
   if(!HT5TrendFortificationAllows(source,gHT5SetupEvent[source].direction,TradeCount()>0,trendReason))
   {
      gHT5TrendFortificationState=gHT5SetupEvent[source].label+" WAIT • "+trendReason+" • "+gHT5TrainState;
      gHT5SetupEvent[source].state=gHT5TrendFortificationState;
      return false;
   }
   gHT5TrendFortificationState=gHT5SetupEvent[source].label+" ALIGNED • "+gHT5TrainState;
   if(!HT5PrepareSetupExecution(source))
   {
      gEntryStatus="SETUP STOP WAIT: "+gHT5StopLossState;
      return false;
   }
   HT5BuildCommanderIntent();
   PyrSignalSource oldSource=gPyrSignalSource;
   datetime oldIdentity=gPyrActiveSignalIdentity;
   bool oldBurst=gMDBurstOverride;
   gPyrSignalSource=(PyrSignalSource)source;
   gPyrActiveSignalIdentity=gHT5SetupEvent[source].identity;
   gMDBurstOverride=true;
   gHT5SetupEntryContext=true;
   gHT5ActiveSetupSource=source;
   gHT5LastSetupAttemptSerial=gMDEntryTickSerial;
   gEntryStatus="SETUP ATTEMPT: "+gHT5SetupEvent[source].label+" • "+gHT5SetupEvent[source].witnesses;
   bool opened=PyrTryEntry(gHT5SetupEvent[source].direction);
   gHT5SetupEntryContext=false;
   gHT5ActiveSetupSource=PYR_SOURCE_NONE;
   gMDBurstOverride=oldBurst;
   gPyrSignalSource=oldSource;
   gPyrActiveSignalIdentity=oldIdentity;
   if(opened)
   {
      gHT5SetupEvent[source].consumed=true;
      gHT5SetupEvent[source].ready=false;
      gHT5SetupEvent[source].state=gHT5SetupEvent[source].label+" FILLED • "+gHT5SetupEvent[source].witnesses;

      // One underlying event must not create two immediate seed orders just because
      // several detectors described it. Preserve explicitly separate BOS/channel
      // pullback tickets, because those require price to leave and retest later.
      datetime filledIdentity=gHT5SetupEvent[source].identity;
      int filledDir=gHT5SetupEvent[source].direction;
      for(int sibling=1;sibling<32;sibling++)
      {
         if(sibling==source) continue;
         if(sibling==PYR_SOURCE_BOS_PULLBACK || sibling==PYR_SOURCE_CHANNEL_BREAK_PULLBACK) continue;
         if(gHT5SetupEvent[sibling].armed && !gHT5SetupEvent[sibling].consumed &&
            gHT5SetupEvent[sibling].identity==filledIdentity && gHT5SetupEvent[sibling].direction==filledDir)
         {
            gHT5SetupEvent[sibling].consumed=true;
            gHT5SetupEvent[sibling].ready=false;
            gHT5SetupEvent[sibling].state=gHT5SetupEvent[sibling].label+" MERGED INTO "+gHT5SetupEvent[source].label;
         }
      }
      gHT5SetupState=gHT5SetupEvent[source].state;
      return true;
   }
   gHT5SetupEvent[source].state=gHT5SetupEvent[source].label+" BLOCKED • "+gEntryStatus+" • "+gPyrState;
   gHT5SetupState=gHT5SetupEvent[source].state;
   return false;
}

//===============================================================================
// SIGNAL TRIBUNAL -- evidence is classified, not simply stacked as raw points.
// It does not open trades. It tells the FVG queue what created the setup.
//===============================================================================
struct HT5_SignalTribunal
{
   int proposedDirection;
   int hardAuthorityDirection;
   int structuralVotes;
   int motionVotes;
   int locationVotes;
   int opposingVotes;
   double displacementATR;
   double acceptance;
   double rhythmSupport;
   double locationSupport;
   double reliability;
   bool structuralAnchor;
   bool motionAnchor;
   bool locationAnchor;
   bool hardVeto;
   string state;
};
HT5_SignalTribunal gHT5Tribunal;

void HT5SignalTribunalSense()
{
   int hard=DIR_FLAT;
   if(gMDTriggerRailBreakDirection!=DIR_FLAT) hard=gMDTriggerRailBreakDirection;
   else if(gMDTriggerRailBounceDirection!=DIR_FLAT) hard=gMDTriggerRailBounceDirection;
   else if(gMDChannelBounceDirection!=DIR_FLAT) hard=gMDChannelBounceDirection;
   else if(gMDInflectionTransferReady && gMDInflectionDirection!=DIR_FLAT) hard=gMDInflectionDirection;

   int dir=((TradeCount()>0 && gHT5CampaignThesis.active)?gHT5CampaignThesis.direction:
            (gHT5LiveThesis.active?gHT5LiveThesis.direction:
             (hard!=DIR_FLAT?hard:(gMDDirectionalDirection!=DIR_FLAT?gMDDirectionalDirection:HT5Sign(gHT5StructureAtlasPotential)))));
   int sv=0,mv=0,lv=0,ov=0;
   if(dir*gMDStructureATR>0.03) sv++; else if(dir*gMDStructureATR<-0.03) ov++;
   if(dir*gMDBOSATR>0.03) sv++; else if(dir*gMDBOSATR<-0.03) ov++;
   if(dir*gMDChannelATR>0.03) sv++; else if(dir*gMDChannelATR<-0.03) ov++;
   if(dir*gHT5StructureAtlasPotential>0.05) sv++; else if(dir*gHT5StructureAtlasPotential<-0.05) ov++;
   if(dir*gMDPressureATR>0.02) mv++; else if(dir*gMDPressureATR<-0.05) ov++;
   if(dir*gMDRhythmScore>0.02) mv++; else if(dir*gMDRhythmScore<-0.12) ov++;
   if(dir*gMDRhythmForce>0.02) mv++; else if(dir*gMDRhythmForce<-0.12) ov++;
   if(dir*gHT5Location.netDirectionalField>0.04) lv++; else if(dir*gHT5Location.netDirectionalField<-0.20) ov++;
   if(gHT5Location.fvgField>0.25) lv++;
   if(gHT5Location.obField>0.25) lv++;
   if(gHT5Location.stationField>0.25 || gHT5Location.reclaimField>0.25) lv++;

   gHT5Tribunal.proposedDirection=dir;
   gHT5Tribunal.hardAuthorityDirection=hard;
   gHT5Tribunal.structuralVotes=sv; gHT5Tribunal.motionVotes=mv; gHT5Tribunal.locationVotes=lv; gHT5Tribunal.opposingVotes=ov;
   gHT5Tribunal.displacementATR=dir*gHT5Brain.expectedATR;
   gHT5Tribunal.acceptance=MathMax(0.0,dir*gMDAcceptanceATR);
   gHT5Tribunal.rhythmSupport=MathMax(0.0,dir*gMDRhythmScore);
   gHT5Tribunal.locationSupport=MathMax(0.0,dir*gHT5Location.netDirectionalField);
   gHT5Tribunal.reliability=HT5SourceReliability((int)gPyrSignalSource);
   gHT5Tribunal.structuralAnchor=(sv>=2 || hard!=DIR_FLAT);
   gHT5Tribunal.motionAnchor=(mv>=1 || hard!=DIR_FLAT);
   gHT5Tribunal.locationAnchor=(lv>=1 || gMDFVGReady);
   gHT5Tribunal.hardVeto=(hard==DIR_FLAT && ov>=4);
   gHT5Tribunal.state="TRIBUNAL "+(dir==DIR_BUY?"BUY":(dir==DIR_SELL?"SELL":"FLAT"))+" • S"+IntegerToString(sv)+" M"+IntegerToString(mv)+" L"+IntegerToString(lv)+" O"+IntegerToString(ov);
}

//===============================================================================
// REVERSAL COURT -- separates pullback, sweep, acceptance and true transfer.
//===============================================================================
struct HT5_ReversalCourt
{
   int oldDirection;
   int candidateDirection;
   double failureDepthATR;
   double reclaimATR;
   double acceptanceATR;
   double opposingFlowATR;
   double structureBreakATR;
   double locationExtreme;
   double evidence;
   bool transferReady;
   string verdict;
};
HT5_ReversalCourt gHT5ReversalCourt;

void HT5ReversalCourtSense()
{
   int old=(TradeCount()>0?(int)DetectDirection():(gPyrRouteActive?gPyrRouteDirection:gMDDesiredDirection));
   int cand=(gMDInflectionDirection!=DIR_FLAT?gMDInflectionDirection:(gMDAcceptanceATR>0?DIR_BUY:(gMDAcceptanceATR<0?DIR_SELL:DIR_FLAT)));
   if(cand==old) cand=DIR_FLAT;
   double failure=MathAbs(gMDSweepDepthATR);
   double reclaim=MathAbs(gMDReclaimDepthATR);
   double accept=(cand!=DIR_FLAT?MathMax(0.0,cand*gMDAcceptanceATR):0.0);
   double flow=(cand!=DIR_FLAT?MathMax(0.0,cand*gMDPressureATR):0.0);
   double bos=(cand!=DIR_FLAT?MathMax(0.0,cand*gMDBOSATR):0.0);
   double extreme=MathMax(gHT5Location.dayLowField,gHT5Location.dayHighField);
   double evidence=0.26*failure+0.18*reclaim+0.20*accept+0.16*flow+0.12*bos+0.08*extreme;
   bool ready=(cand!=DIR_FLAT && old!=DIR_FLAT && cand!=old && evidence>=0.20 && accept>=0.04 && (bos>=0.03 || failure>=0.12));
   if(HowShouldTheCreatureReverseDirection==REVERSAL_CONSERVATIVE_INFLECTION_ONLY) ready=ready && failure>=0.18 && accept>=0.10;
   if(HowShouldTheCreatureReverseDirection==REVERSAL_BLACK_CHANNEL_TRANSFER)
      ready=ready && (gMDTriggerRailBreakDirection==cand || gMDChannelBreakDirection==cand);
   if(HowShouldTheCreatureReverseDirection==REVERSAL_FULL_CREATURE_CONSENSUS)
      ready=ready && (gHT5Tribunal.structuralVotes+gHT5Tribunal.motionVotes>=3);
   gHT5ReversalCourt.oldDirection=old; gHT5ReversalCourt.candidateDirection=cand;
   gHT5ReversalCourt.failureDepthATR=failure; gHT5ReversalCourt.reclaimATR=reclaim; gHT5ReversalCourt.acceptanceATR=accept;
   gHT5ReversalCourt.opposingFlowATR=flow; gHT5ReversalCourt.structureBreakATR=bos; gHT5ReversalCourt.locationExtreme=extreme;
   gHT5ReversalCourt.evidence=evidence; gHT5ReversalCourt.transferReady=ready;
   gHT5ReversalCourt.verdict=(ready?"TRUE TRANSFER":(cand!=DIR_FLAT?"REVERSAL WATCH":"NO CASE"));
}

//===============================================================================
// THREE-WAY GEOMETRY PHYSICS -- RED/GOLD/BLACK relationships and triangle health
//===============================================================================
struct HT5_ThreeWayPhysics
{
   double gold;
   double red;
   double black;
   double channelWidthATR;
   double blackLocation;
   double priceLocation;
   double convergenceATRPerBar;
   double roomToRedATR;
   double roomToGoldATR;
   double triggerDistanceATR;
   double triangleMaturity;
   double breakoutEnergy;
   int trendDirection;
   string state;
};
HT5_ThreeWayPhysics gHT5ThreeWay;

void HT5ThreeWayPhysicsSense()
{
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double p=HT5Mid();
   gHT5ThreeWay.gold=gMDChannelSupportNow;
   gHT5ThreeWay.red=gMDChannelResistanceNow;
   gHT5ThreeWay.black=(gMDTriggerRailValid?gMDTriggerRailNow:0.0);
   double width=MathMax(Point,gHT5ThreeWay.red-gHT5ThreeWay.gold);
   gHT5ThreeWay.channelWidthATR=width/atr;
   gHT5ThreeWay.priceLocation=HT5Clamp((p-gHT5ThreeWay.gold)/width,0.0,1.0);
   gHT5ThreeWay.blackLocation=(gHT5ThreeWay.black>0.0?HT5Clamp((gHT5ThreeWay.black-gHT5ThreeWay.gold)/width,0.0,1.0):0.5);
   gHT5ThreeWay.roomToRedATR=(gHT5ThreeWay.red>0.0?(gHT5ThreeWay.red-p)/atr:0.0);
   gHT5ThreeWay.roomToGoldATR=(gHT5ThreeWay.gold>0.0?(p-gHT5ThreeWay.gold)/atr:0.0);
   gHT5ThreeWay.triggerDistanceATR=(gHT5ThreeWay.black>0.0?MathAbs(p-gHT5ThreeWay.black)/atr:99.0);
   gHT5ThreeWay.convergenceATRPerBar=MathAbs(gMDTriggerRailSlope)*MathMax(1,PeriodSeconds(SignalTF))/MathMax(60.0,atr);
   gHT5ThreeWay.triangleMaturity=HT5Clamp(1.0-MathMin(gHT5ThreeWay.roomToRedATR,gHT5ThreeWay.roomToGoldATR)/MathMax(0.5,gHT5ThreeWay.channelWidthATR),0.0,1.0);
   gHT5ThreeWay.breakoutEnergy=HT5Clamp(MathAbs(gMDRhythmForce)+0.50*MathAbs(gMDPressureATR)+0.30*MathAbs(gMDBOSATR),0.0,2.0);
   gHT5ThreeWay.trendDirection=(gMDTriggerRailTrendDirection!=DIR_FLAT?gMDTriggerRailTrendDirection:gMDDirectionalDirection);
   gHT5ThreeWay.state="3WAY P "+DoubleToString(gHT5ThreeWay.priceLocation,2)+" • B "+DoubleToString(gHT5ThreeWay.blackLocation,2)+" • E "+DoubleToString(gHT5ThreeWay.breakoutEnergy,2);
}

//===============================================================================
// GROWTH PHYSIOLOGY MAP -- dynamic earned R levels + protection + capital demand
//===============================================================================
struct HT5_GrowthStage
{
   double triggerR;
   double protectR;
   double riskReuse;
   double projectedMoney;
   double remainingCompoundAfter;
   bool reached;
   bool filled;
   bool allowed;
   string state;
};
HT5_GrowthStage gHT5GrowthStage[12];
int gHT5GrowthStageCount=0;
string gHT5GrowthMapState="GROWTH MAP IDLE";

void HT5BuildGrowthMap()
{
   int n=MathMax(2,MathMin(12,MarketDNARLadderStages));
   gHT5GrowthStageCount=n;
   int dir=(gMDRLadderActive?gMDRLadderDirection:gMDDesiredDirection);
   double entry=(gMDRLadderActive?gMDRLadderSeedEntry:HT5Mid());
   double R=(gMDRLadderActive?gMDRLadderR:MathMax(Point,HTExecutionATR(SignalTF,14)));
   double current=HT5Mid();
   double progress=(dir!=DIR_FLAT?dir*(current-entry)/MathMax(Point,R):0.0);
   for(int i=0;i<n;i++)
   {
      int stage=i+1;
      double tr=MarketDNARLadderStageR(stage);
      double pr=MarketDNARLadderProtectR(stage);
      double projectedPrice=entry+dir*R*MathMax(tr,1.0);
      double money=(dir!=DIR_FLAT?HT5ProjectedBasketAtPrice(dir,projectedPrice):0.0);
      double remain=MathMax(0.0,gCompoundLiveRemaining-MathMax(0.0,money));
      bool reached=(progress>=tr);
      bool filled=(gMDRLadderActive && (gMDRLadderStageFilledMask & (1<<i))!=0);
      bool allowed=(gHT5Immune.freeRiskMoney>0.01 && !gCompoundEntryFreeze && gHT5Broker.executionQuality>0.20);
      if(StopAddingNearUnprovenDayExtreme)
      {
         if(dir==DIR_BUY && gMDDayNearHigh && gMDChannelBreakDirection!=DIR_BUY && gMDTriggerRailBreakDirection!=DIR_BUY) allowed=false;
         if(dir==DIR_SELL && gMDDayNearLow && gMDChannelBreakDirection!=DIR_SELL && gMDTriggerRailBreakDirection!=DIR_SELL) allowed=false;
      }
      gHT5GrowthStage[i].triggerR=tr; gHT5GrowthStage[i].protectR=pr; gHT5GrowthStage[i].riskReuse=EvolutionRLadderRiskScale();
      gHT5GrowthStage[i].projectedMoney=money; gHT5GrowthStage[i].remainingCompoundAfter=remain;
      gHT5GrowthStage[i].reached=reached; gHT5GrowthStage[i].filled=filled; gHT5GrowthStage[i].allowed=allowed;
      gHT5GrowthStage[i].state=(filled?"FILLED":(reached?(allowed?"EARNED":"PROTECTED/WAIT"):"AHEAD"));
   }
   for(int j=n;j<12;j++) gHT5GrowthStage[j].state="OFF";
   gHT5GrowthMapState="GROWTH "+IntegerToString(n)+" STAGES • PROGRESS "+DoubleToString(progress,2)+"R • REUSE "+DoubleToString(EvolutionRLadderRiskScale(),2);
}

//===============================================================================
// ORGAN SUBUNIT MATRIX -- deeper health than a single top-level pulse
// 15 organs x 8 subunits; outcome correlation learns which organ conditions matter.
//===============================================================================
#define HT5_ORGAN_SUBUNITS 8
double gHT5SubunitHealth[ORGAN_COUNT][HT5_ORGAN_SUBUNITS];
double gHT5SubunitOutcomeCorr[ORGAN_COUNT][HT5_ORGAN_SUBUNITS];
double gHT5EntrySubunitHealth[ORGAN_COUNT][HT5_ORGAN_SUBUNITS];
string gHT5SubunitName[ORGAN_COUNT][HT5_ORGAN_SUBUNITS];

void HT5InitializeSubunitNames()
{
   string common[8]={"READINESS","STABILITY","DIRECTION","TIMING","LOCATION","RISK","MEMORY","ADAPTATION"};
   for(int o=0;o<ORGAN_COUNT;o++) for(int s=0;s<8;s++) gHT5SubunitName[o][s]=common[s];
   gHT5SubunitName[ORGAN_LUNGS][0]="ATR LIVE"; gHT5SubunitName[ORGAN_LUNGS][1]="ATR STABLE"; gHT5SubunitName[ORGAN_LUNGS][2]="EXPANSION"; gHT5SubunitName[ORGAN_LUNGS][3]="COMPRESSION"; gHT5SubunitName[ORGAN_LUNGS][4]="VOL-OF-VOL"; gHT5SubunitName[ORGAN_LUNGS][5]="SPREAD/ATR"; gHT5SubunitName[ORGAN_LUNGS][6]="MTF CONSISTENCY"; gHT5SubunitName[ORGAN_LUNGS][7]="BREATH ADAPT";
   gHT5SubunitName[ORGAN_HEART][0]="FLOW"; gHT5SubunitName[ORGAN_HEART][1]="VELOCITY"; gHT5SubunitName[ORGAN_HEART][2]="ACCELERATION"; gHT5SubunitName[ORGAN_HEART][3]="CADENCE"; gHT5SubunitName[ORGAN_HEART][4]="PULLBACK"; gHT5SubunitName[ORGAN_HEART][5]="ENTROPY"; gHT5SubunitName[ORGAN_HEART][6]="PERSISTENCE"; gHT5SubunitName[ORGAN_HEART][7]="JERK";
   gHT5SubunitName[ORGAN_SKELETON][0]="HH/HL LH/LL"; gHT5SubunitName[ORGAN_SKELETON][1]="BOS"; gHT5SubunitName[ORGAN_SKELETON][2]="ROUTE"; gHT5SubunitName[ORGAN_SKELETON][3]="CHANNEL"; gHT5SubunitName[ORGAN_SKELETON][4]="MTF AGREEMENT"; gHT5SubunitName[ORGAN_SKELETON][5]="INVALIDATION"; gHT5SubunitName[ORGAN_SKELETON][6]="PIVOT AGE"; gHT5SubunitName[ORGAN_SKELETON][7]="ACCEPTANCE";
   gHT5SubunitName[ORGAN_EYES][0]="SIGNAL FVG"; gHT5SubunitName[ORGAN_EYES][1]="ORDER BLOCK"; gHT5SubunitName[ORGAN_EYES][2]="DAY EXTREME"; gHT5SubunitName[ORGAN_EYES][3]="GOLD/RED"; gHT5SubunitName[ORGAN_EYES][4]="BLACK RAIL"; gHT5SubunitName[ORGAN_EYES][5]="STATION"; gHT5SubunitName[ORGAN_EYES][6]="RECLAIM"; gHT5SubunitName[ORGAN_EYES][7]="LIQUIDITY POOL";
   gHT5SubunitName[ORGAN_IMMUNE][0]="OPEN RISK"; gHT5SubunitName[ORGAN_IMMUNE][1]="PENDING RISK"; gHT5SubunitName[ORGAN_IMMUNE][2]="LOCKED PROFIT"; gHT5SubunitName[ORGAN_IMMUNE][3]="MARGIN"; gHT5SubunitName[ORGAN_IMMUNE][4]="BROKER COST"; gHT5SubunitName[ORGAN_IMMUNE][5]="AE"; gHT5SubunitName[ORGAN_IMMUNE][6]="STOP FORWARD"; gHT5SubunitName[ORGAN_IMMUNE][7]="EMERGENCY";
   gHT5SubunitName[ORGAN_METABOLISM][0]="BASE"; gHT5SubunitName[ORGAN_METABOLISM][1]="TARGET"; gHT5SubunitName[ORGAN_METABOLISM][2]="REMAINING"; gHT5SubunitName[ORGAN_METABOLISM][3]="PROJECTED 1R"; gHT5SubunitName[ORGAN_METABOLISM][4]="PROJECTED RED"; gHT5SubunitName[ORGAN_METABOLISM][5]="R REQUIRED"; gHT5SubunitName[ORGAN_METABOLISM][6]="EFFICIENCY"; gHT5SubunitName[ORGAN_METABOLISM][7]="REBASE";
}

void HT5SetSubunit(int organ,int sub,double health)
{
   if(organ<0||organ>=ORGAN_COUNT||sub<0||sub>=HT5_ORGAN_SUBUNITS) return;
   gHT5SubunitHealth[organ][sub]=HT5Clamp(health,0.0,1.0);
}

void HT5UpdateSubunitHealth()
{
   // CHRONOS
   HT5SetSubunit(ORGAN_CHRONOS,0,gHT5SessionQuality/1.20);
   HT5SetSubunit(ORGAN_CHRONOS,1,(gHT5Session==LIQUIDITY_ROLLOVER?0.30:0.85));
   HT5SetSubunit(ORGAN_CHRONOS,2,HT5LearnedHourQuality(TimeHour(TimeCurrent()))/1.20);
   HT5SetSubunit(ORGAN_CHRONOS,3,gHT5LiquidityQuality);
   HT5SetSubunit(ORGAN_CHRONOS,4,gHT5Broker.executionQuality);
   HT5SetSubunit(ORGAN_CHRONOS,5,1.0-gHT5SpreadATR/0.15);
   HT5SetSubunit(ORGAN_CHRONOS,6,MathMin(1.0,gHT5HourSamples[TimeHour(TimeCurrent())]/10.0));
   HT5SetSubunit(ORGAN_CHRONOS,7,(WhenShouldTheCreaturePreferToHunt>=SESSION_ADAPT_TO_LIQUIDITY_AND_SPREAD?0.90:0.70));

   // LUNGS
   HT5SetSubunit(ORGAN_LUNGS,0,HT5Clamp(gATRLive14/MathMax(Point,gATRStable14),0.0,1.0));
   HT5SetSubunit(ORGAN_LUNGS,1,1.0-HT5Clamp(gHT5VolOfVol/0.50,0.0,1.0));
   HT5SetSubunit(ORGAN_LUNGS,2,HT5Clamp(gHT5TF[1].expansion/1.50,0.0,1.0));
   HT5SetSubunit(ORGAN_LUNGS,3,HT5Clamp(gHT5TF[1].compression/1.50,0.0,1.0));
   HT5SetSubunit(ORGAN_LUNGS,4,1.0-HT5Clamp(gHT5VolOfVol/0.40,0.0,1.0));
   HT5SetSubunit(ORGAN_LUNGS,5,1.0-HT5Clamp(gHT5SpreadATR/0.12,0.0,1.0));
   HT5SetSubunit(ORGAN_LUNGS,6,gHT5StructureAtlasAgreement);
   HT5SetSubunit(ORGAN_LUNGS,7,0.5+0.5*gHT5OrganReliability[ORGAN_LUNGS]/1.28);

   // HEART
   HT5SetSubunit(ORGAN_HEART,0,HT5Clamp((gMDRhythmFlow+1.0)/2.0,0.0,1.0));
   HT5SetSubunit(ORGAN_HEART,1,HT5Clamp(MathAbs(gMDRhythmVelocity)/1.5,0.0,1.0));
   HT5SetSubunit(ORGAN_HEART,2,HT5Clamp(MathAbs(gMDRhythmAcceleration)/1.2,0.0,1.0));
   HT5SetSubunit(ORGAN_HEART,3,HT5Clamp(gMDRhythmCadence,0.0,1.0));
   HT5SetSubunit(ORGAN_HEART,4,1.0-HT5Clamp(gMDRhythmPullback/1.50,0.0,1.0));
   HT5SetSubunit(ORGAN_HEART,5,1.0-gHT5FlowEntropy);
   HT5SetSubunit(ORGAN_HEART,6,gHT5DirectionalPersistence);
   HT5SetSubunit(ORGAN_HEART,7,1.0-HT5Clamp(MathAbs(gHT5TickJerkATR)/2.0,0.0,1.0));

   // SKELETON
   HT5SetSubunit(ORGAN_SKELETON,0,HT5Clamp(MathAbs(gMDStructureATR)/0.50,0.0,1.0));
   HT5SetSubunit(ORGAN_SKELETON,1,HT5Clamp(MathAbs(gMDBOSATR)/0.50,0.0,1.0));
   HT5SetSubunit(ORGAN_SKELETON,2,HT5Clamp(MathAbs(gMDRouteATR)/0.50,0.0,1.0));
   HT5SetSubunit(ORGAN_SKELETON,3,HT5Clamp(MathAbs(gMDChannelATR)/0.50,0.0,1.0));
   HT5SetSubunit(ORGAN_SKELETON,4,gHT5StructureAtlasAgreement);
   HT5SetSubunit(ORGAN_SKELETON,5,(gPyrRouteInvalidTicks==0?1.0:0.35));
   HT5SetSubunit(ORGAN_SKELETON,6,HT5Clamp(gHT5StructureFrame[1].pivotCount/4.0,0.0,1.0));
   HT5SetSubunit(ORGAN_SKELETON,7,HT5Clamp(MathAbs(gMDAcceptanceATR)/0.30,0.0,1.0));

   // EYES
   HT5SetSubunit(ORGAN_EYES,0,gHT5Location.fvgField);
   HT5SetSubunit(ORGAN_EYES,1,gHT5Location.obField);
   HT5SetSubunit(ORGAN_EYES,2,MathMax(gHT5Location.dayLowField,gHT5Location.dayHighField));
   HT5SetSubunit(ORGAN_EYES,3,MathMax(gHT5Location.goldRailField,gHT5Location.redRailField));
   HT5SetSubunit(ORGAN_EYES,4,gHT5Location.blackRailField);
   HT5SetSubunit(ORGAN_EYES,5,gHT5Location.stationField);
   HT5SetSubunit(ORGAN_EYES,6,gHT5Location.reclaimField);
   HT5SetSubunit(ORGAN_EYES,7,HT5Clamp(gHT5Location.liquidityPoolField,0.0,1.0));

   // ORACLE
   HT5SetSubunit(ORGAN_ORACLE,0,HT5Clamp(MathAbs(gMDOracleMicroTrendATR)/0.50,0.0,1.0));
   HT5SetSubunit(ORGAN_ORACLE,1,HT5Clamp(MathAbs(gMDOracleOBFVGATR)/0.50,0.0,1.0));
   HT5SetSubunit(ORGAN_ORACLE,2,HT5Clamp(MathAbs(gMDOraclePhaseATR)/0.50,0.0,1.0));
   HT5SetSubunit(ORGAN_ORACLE,3,HT5Clamp(MathAbs(gMDOraclePatternATR)/0.50,0.0,1.0));
   HT5SetSubunit(ORGAN_ORACLE,4,gHT5ThreeWay.triangleMaturity);
   HT5SetSubunit(ORGAN_ORACLE,5,HT5Clamp(gHT5ThreeWay.breakoutEnergy/1.5,0.0,1.0));
   HT5SetSubunit(ORGAN_ORACLE,6,HT5Clamp(gHT5DeepPredictionConfidence,0.0,1.0));
   HT5SetSubunit(ORGAN_ORACLE,7,HT5Clamp(gHT5OrganReliability[ORGAN_ORACLE]/1.28,0.0,1.0));

   // BRAIN
   HT5SetSubunit(ORGAN_BRAIN,0,HT5Clamp(gHT5Tribunal.structuralVotes/4.0,0.0,1.0));
   HT5SetSubunit(ORGAN_BRAIN,1,HT5Clamp(gHT5Tribunal.motionVotes/3.0,0.0,1.0));
   HT5SetSubunit(ORGAN_BRAIN,2,HT5Clamp(gHT5Tribunal.locationVotes/4.0,0.0,1.0));
   HT5SetSubunit(ORGAN_BRAIN,3,HT5Clamp(1.0-gHT5Tribunal.opposingVotes/5.0,0.0,1.0));
   HT5SetSubunit(ORGAN_BRAIN,4,gHT5Brain.continuationProbability);
   HT5SetSubunit(ORGAN_BRAIN,5,1.0-HT5Clamp(gHT5Brain.uncertainty/1.5,0.0,1.0));
   HT5SetSubunit(ORGAN_BRAIN,6,gHT5DeepPredictionConfidence);
   HT5SetSubunit(ORGAN_BRAIN,7,HT5Clamp(gHT5CommanderIntentConfidence,0.0,1.0));

   // HANDS / MUSCLES
   for(int s=0;s<8;s++)
   {
      HT5SetSubunit(ORGAN_HANDS,s,(MarketDNAAllowLimitStacks?HT5Clamp(0.55+0.45*MathMax(gMDPulseStrength[0],gMDPulseStrength[1]),0.0,1.0):0.35));
      HT5SetSubunit(ORGAN_MUSCLES,s,(MarketDNASonicRLadder?HT5Clamp(0.50+0.50*gHT5LifeEnergy,0.0,1.0):0.40));
   }

   // IMMUNE
   double cap=MathMax(0.01,gHT5Immune.campaignRiskCap);
   HT5SetSubunit(ORGAN_IMMUNE,0,1.0-HT5Clamp(gHT5Immune.openRisk/cap,0.0,1.0));
   HT5SetSubunit(ORGAN_IMMUNE,1,1.0-HT5Clamp(gHT5Immune.pendingRisk/cap,0.0,1.0));
   HT5SetSubunit(ORGAN_IMMUNE,2,HT5Clamp(gHT5Immune.lockedProfit/MathMax(0.01,SelectedRiskMoney()),0.0,1.0));
   HT5SetSubunit(ORGAN_IMMUNE,3,1.0-HT5Clamp(gHT5Immune.marginUsedPct/80.0,0.0,1.0));
   HT5SetSubunit(ORGAN_IMMUNE,4,gHT5Broker.executionQuality);
   HT5SetSubunit(ORGAN_IMMUNE,5,1.0-HT5Clamp(gHT5Immune.adverseExcursionR/1.5,0.0,1.0));
   HT5SetSubunit(ORGAN_IMMUNE,6,(NeverLetProvenCampaignGoNegative?1.0:0.70));
   HT5SetSubunit(ORGAN_IMMUNE,7,(gHT5Immune.emergency?0.0:1.0));

   // METABOLISM
   HT5SetSubunit(ORGAN_METABOLISM,0,(gCompoundAnchor>0?1.0:0.3));
   HT5SetSubunit(ORGAN_METABOLISM,1,(gCompoundTarget>gCompoundAnchor?1.0:0.3));
   HT5SetSubunit(ORGAN_METABOLISM,2,1.0-HT5Clamp(gCompoundLiveRemaining/MathMax(0.01,gCompoundBaseGoalMoney),0.0,1.0));
   HT5SetSubunit(ORGAN_METABOLISM,3,HT5Clamp(gHT5Metabolism.projectedBasketAt1R/MathMax(0.01,gCompoundLiveRemaining),0.0,1.0));
   HT5SetSubunit(ORGAN_METABOLISM,4,HT5Clamp(gHT5Metabolism.projectedBasketAtRed/MathMax(0.01,gCompoundLiveRemaining),0.0,1.0));
   HT5SetSubunit(ORGAN_METABOLISM,5,1.0-HT5Clamp(gHT5Metabolism.requiredRMultiple/10.0,0.0,1.0));
   HT5SetSubunit(ORGAN_METABOLISM,6,HT5Clamp(gHT5Metabolism.capitalEfficiency,0.0,1.0));
   HT5SetSubunit(ORGAN_METABOLISM,7,(gCompoundPhase==CMP_REBASING||gCompoundPhase==CMP_PAUSED?1.0:0.80));

   // MEMORY / GENOME / HOSPITAL / COMMANDER generic but meaningful.
   for(int k=0;k<8;k++)
   {
      HT5SetSubunit(ORGAN_MEMORY,k,HT5Clamp(0.25+0.75*gHT5DeepPredictionConfidence,0.0,1.0));
      HT5SetSubunit(ORGAN_GENOME,k,HT5Clamp(0.55+0.15*gEvoFitnessR-0.10*gHT5GenomeMutationPressure,0.0,1.0));
      HT5SetSubunit(ORGAN_HOSPITAL,k,gHT5OrganHealth[ORGAN_HOSPITAL]);
      HT5SetSubunit(ORGAN_COMMANDER,k,HT5Clamp(gHT5CommanderIntentConfidence+0.20,0.0,1.0));
   }

   // Recompute top-level health as the average of learned-reliability weighted subunits.
   for(int o=0;o<ORGAN_COUNT;o++)
   {
      double sum=0.0;
      for(int q=0;q<8;q++) sum+=gHT5SubunitHealth[o][q];
      double raw=sum/8.0;
      gHT5OrganHealth[o]=HT5Clamp(raw*gHT5OrganReliability[o],0.0,1.0);
   }
}

void HT5CaptureEntrySubunits()
{
   for(int o=0;o<ORGAN_COUNT;o++) for(int s=0;s<8;s++) gHT5EntrySubunitHealth[o][s]=gHT5SubunitHealth[o][s];
}

void HT5UpdateSubunitOutcome(double r)
{
   for(int o=0;o<ORGAN_COUNT;o++)
      for(int s=0;s<8;s++)
      {
         double x=(gHT5EntrySubunitHealth[o][s]-0.50)*2.0;
         gHT5SubunitOutcomeCorr[o][s]=0.97*gHT5SubunitOutcomeCorr[o][s]+0.03*HT5Clamp(x*r,-4.0,4.0);
      }
}

//===============================================================================
// DEADLOCK PATH ANALYZER -- exposes exact route from signal to broker
//===============================================================================
struct HT5_EntryPath
{
   bool master;
   bool channel;
   bool day;
   bool fvgArmed;
   bool fvgReady;
   bool fvgTouched;
   bool direction;
   bool rhythm;
   bool risk;
   bool margin;
   bool broker;
   bool compound;
   int firstFailedGate;
   string state;
};
HT5_EntryPath gHT5EntryPath;

void HT5EntryPathSense()
{
   int dir=((TradeCount()>0 && gHT5CampaignThesis.active)?gHT5CampaignThesis.direction:
            (gHT5LiveThesis.active?gHT5LiveThesis.direction:
             (gMDFVGDirection!=DIR_FLAT?gMDFVGDirection:(gMDDesiredDirection!=DIR_FLAT?gMDDesiredDirection:gHT5Brain.direction))));
   gHT5EntryPath.master=IsMasterEnabled();
   gHT5EntryPath.channel=(!MarketDNARequireChannelReadyBeforeTrading || !EnableMarketDNAHistoricalChannels || gMDChannelReady || MarketDNAAllowDegradedChannelTrading);
   gHT5EntryPath.day=(dir==DIR_FLAT?true:MarketDNADayHLAllowsDirection(dir));
   gHT5EntryPath.fvgArmed=(!MarketDNASignalFVGOnly || gMDFVGArmed);
   gHT5EntryPath.fvgReady=(!MarketDNASignalFVGOnly || gMDFVGReady);
   gHT5EntryPath.fvgTouched=(!MarketDNASignalFVGOnly || gMDFVGInZone || gMDFVGTouchLatchUntilSerial>=gMDEntryTickSerial);
   gHT5EntryPath.direction=(dir!=DIR_FLAT);
   gHT5EntryPath.rhythm=(dir==DIR_FLAT?false:gMDRhythmScore>EvolutionQueuedRhythmFloor());
   gHT5EntryPath.risk=(SelectedRiskMoney()>0.0 && gHT5Immune.freeRiskMoney>=0.0);
   gHT5EntryPath.margin=(gHT5Broker.projectedMarginLevel>=MinimumProjectedMarginLevel || AccountMargin()<=0.0);
   gHT5EntryPath.broker=gHT5Broker.tradeAllowed;
   gHT5EntryPath.compound=!gCompoundEntryFreeze;
   bool vals[11];
   int gates[11];
   vals[0]=gHT5EntryPath.master;      gates[0]=GATE_MASTER;
   vals[1]=gHT5EntryPath.channel;     gates[1]=GATE_CHANNEL;
   vals[2]=gHT5EntryPath.day;         gates[2]=GATE_DAY_EXTREME;
   vals[3]=gHT5EntryPath.fvgArmed;    gates[3]=GATE_FVG;
   vals[4]=gHT5EntryPath.fvgReady;    gates[4]=GATE_FVG;
   vals[5]=gHT5EntryPath.fvgTouched;  gates[5]=GATE_FVG;
   vals[6]=gHT5EntryPath.direction;   gates[6]=GATE_DIRECTION;
   vals[7]=gHT5EntryPath.rhythm;      gates[7]=GATE_RHYTHM;
   vals[8]=gHT5EntryPath.risk;        gates[8]=GATE_RISK;
   vals[9]=gHT5EntryPath.margin;      gates[9]=GATE_MARGIN;
   vals[10]=gHT5EntryPath.broker;     gates[10]=GATE_BROKER;
   gHT5EntryPath.firstFailedGate=GATE_NONE;
   for(int i=0;i<11;i++) if(!vals[i]){ gHT5EntryPath.firstFailedGate=gates[i]; break; }
   if(gHT5EntryPath.firstFailedGate==GATE_NONE && !gHT5EntryPath.compound) gHT5EntryPath.firstFailedGate=GATE_COMPOUND;
   gHT5EntryPath.state=(gHT5EntryPath.firstFailedGate==GATE_NONE?"ENTRY PATH OPEN":"ENTRY PATH BLOCK G"+IntegerToString(gHT5EntryPath.firstFailedGate));
}

//===============================================================================
// DEEP ORGAN DASHBOARD EXTENSION
//===============================================================================
void HT5DrawDeepDiagnostics()
{
   if(HowMuchOfTheLivingDashboardShouldShow!=VISUAL_FULL_DIAGNOSTIC_ORGANS) return;
   int x=390,y=170;
   HT5Label("DEEP_TITLE","DEEP COLLECTION / PHYSIOLOGY",x,y,9,C'120,210,255');
   HT5Label("DEEP_ATLAS",gHT5LiquidityState+" | "+gHT5FVGAtlasState,x,y+18,7,C'210,210,210');
   HT5Label("DEEP_OB",gHT5OBAtlasState+" | "+gHT5StationAtlasState,x,y+34,7,C'210,210,210');
   HT5Label("DEEP_STRUCT",gHT5StructureAtlasState,x,y+50,7,C'210,210,210');
   HT5Label("DEEP_TRIB",gHT5Tribunal.state+" | "+gHT5ReversalCourt.verdict,x,y+66,7,C'255,215,90');
   HT5Label("DEEP_3WAY",gHT5ThreeWay.state,x,y+82,7,C'255,215,90');
   HT5Label("DEEP_GROW",gHT5GrowthMapState,x,y+98,7,C'80,230,160');
   HT5Label("DEEP_BROKER",gHT5Broker.state,x,y+114,7,HT5HealthColor(gHT5Broker.executionQuality));
   HT5Label("DEEP_ENTRY",gHT5EntryPath.state+" | "+gEntryStatus,x,y+130,7,HT5HealthColor(gHT5EntryPath.firstFailedGate==GATE_NONE?1.0:0.35));
   HT5Label("DEEP_THESIS",(gHT5LiveThesis.active?gHT5LiveThesis.state:(gHT5CampaignThesis.active?gHT5CampaignThesis.state:"THESIS WAITING")),x,y+146,7,C'120,210,255');
   HT5Label("DEEP_TRAIN",gHT5TrainState,x,y+162,7,(gHT5TrainDirection==DIR_FLAT?C'210,210,210':C'80,230,160'));
   HT5Label("DEEP_ARROW",gHT5FormulaArrowState,x,y+178,7,C'120,210,255');
   HT5Label("DEEP_STOP",gHT5StopLossState+" | "+gHT5StopBreathingState,x,y+194,7,C'255,180,90');
   HT5Label("DEEP_SURVIVE",gHT5EntrySurvivalState,x,y+210,7,C'255,210,90');
   HT5Label("DEEP_DEFENSE",gHT5DefenseState,x,y+226,7,(gHT5DefenseMode?C'255,120,80':C'80,230,160'));
   HT5Label("DEEP_MEM","DEEP MEM "+IntegerToString(gHT5DeepPatternCount)+" • "+DoubleToString(gHT5DeepPredictionR,2)+"R C"+DoubleToString(gHT5DeepPredictionConfidence,2),x,y+242,7,C'180,160,255');
   int best=HT5BestShadow();
   HT5Label("DEEP_SHADOW","SHADOW "+gHT5Shadow[best].name+" • "+DoubleToString(gHT5Shadow[best].fitnessR,2)+"R",x,y+258,7,C'180,160,255');
   for(int i=0;i<MathMin(8,gHT5GrowthStageCount);i++)
   {
      string t="R"+IntegerToString(i+1)+" "+DoubleToString(gHT5GrowthStage[i].triggerR,2)+" -> P "+DoubleToString(gHT5GrowthStage[i].protectR,2)+" • "+gHT5GrowthStage[i].state;
      HT5Label("DEEP_R"+IntegerToString(i),t,x,y+280+i*15,7,(gHT5GrowthStage[i].filled?C'60,230,140':C'200,200,200'));
   }
}

