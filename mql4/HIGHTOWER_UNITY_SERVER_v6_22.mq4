   RailGivebackPercentQuick=18.0; RailGivebackPercentBalanced=30.0; RailGivebackPercentMaximum=45.0;
   RailConfirmTicks=3;
   BasketTargetPercent=2.0; MinimumBasketTargetMoney=2.0;
   UsePeakGiveback=true; PeakArmPercent=1.0; PeakGivebackPercent=28.0; MinimumPeakGivebackMoney=1.0;
   CloseOnInvalidGeometry=false; CloseOnOppositeFVG=true; OppositeFVGRecentBars=5;
   CloseOnStructureBreak=true; StructureBreakBufferPoints=30.0;
}

void ApplyHoldControl()
{
   HoldUntilBrokerStopOrTarget=(TradeHoldControl==HOLD_UNTIL_SL_OR_TP);
   MinimumHoldBarsValue=(HoldUntilBrokerStopOrTarget ? 0 : (int)TradeHoldControl);
   MinimumHoldBarsValue=MathMax(0,MinimumHoldBarsValue);
}

void ApplyVisualControl()
{
   TriangleColor=HTGold; WeightLineColor=HTGoldBright;
   IchimokuBullCloudColor=HTGoldDark;
   IchimokuBearCloudColor=C'30,30,30';
   IchimokuSpanAColor=HTGoldBright;
   IchimokuSpanBColor=HTCharcoalLight;
   if(VisualControl==VISUAL_OFF)
   {
      DrawTriangle=false; ShowDashboard=false; EnableEntryDiagnostics=false; DrawIchimokuCloud=false;
      TriangleWidth=1; WeightLineWidth=1; EntryDiagnosticSeconds=60;
      return;
   }
   if(VisualControl==VISUAL_DIAGNOSTIC)
   {
      DrawTriangle=true; ShowDashboard=true; EnableEntryDiagnostics=true; DrawIchimokuCloud=true;
      TriangleWidth=3; WeightLineWidth=5; EntryDiagnosticSeconds=5;
      return;
   }
   DrawTriangle=true; ShowDashboard=true; EnableEntryDiagnostics=false; DrawIchimokuCloud=true;
   TriangleWidth=2; WeightLineWidth=4; EntryDiagnosticSeconds=15;
}

void ApplyUnityUserControls()
{
   // Pace controls confirmation and sensing speed; it does not create a second strategy.
   if(UnityPace==UNITY_PACE_FAST)
   {
      TradeFrequencyControl=TRADE_MORE_OFTEN;
      ArrowConfirmationTicks=ARROW_CONFIRM_2_TICKS;
      BOSCloseConfirmation=PYR_CONFIRM_2_FAST;
      PyramidGripCharacter=PYR_CONFIRM_2_FAST;
      PyramidStationBounceConfirmation=PYR_CONFIRM_2_FAST;
      PyramidReclaimConfirmation=PYR_CONFIRM_2_FAST;
      PyramidEntryRhythm=PYR_RHYTHM_3_FAST;
   }
   else if(UnityPace==UNITY_PACE_PATIENT)
   {
      TradeFrequencyControl=TRADE_SELECTIVE;
      ArrowConfirmationTicks=ARROW_CONFIRM_5_TICKS;
      BOSCloseConfirmation=PYR_CONFIRM_3_BALANCED;
      PyramidGripCharacter=PYR_CONFIRM_5_STRONG;
      PyramidStationBounceConfirmation=PYR_CONFIRM_3_BALANCED;
      PyramidReclaimConfirmation=PYR_CONFIRM_3_BALANCED;
      PyramidEntryRhythm=PYR_RHYTHM_15_PATIENT;
   }
   else
   {
      TradeFrequencyControl=TRADE_BALANCED;
      ArrowConfirmationTicks=ARROW_CONFIRM_3_TICKS;
      BOSCloseConfirmation=PYR_CONFIRM_2_FAST;
      PyramidGripCharacter=PYR_CONFIRM_3_BALANCED;
      PyramidStationBounceConfirmation=PYR_CONFIRM_2_FAST;
      PyramidReclaimConfirmation=PYR_CONFIRM_2_FAST;
      PyramidEntryRhythm=PYR_RHYTHM_8_BALANCED;
   }

   PyramidEntryPermissions=(HT_PyramidEntryPermissions)((int)UnityEntryLogic);
   PyramidEntryCharacter=(HT_PyramidEntryCharacter)((int)UnityPressure);
   PyramidRapidFire=((int)UnityPressure>1);
   gUnityMaxEntries=MathMax(1,MathMin(20,(int)UnityPressure));
   if(EnableMarketDNA) gUnityMaxEntries=MathMax(1,MathMin(20,MarketDNAMaxCars));

   if(gUnityMaxEntries<=1) MaximumArrowEntries=MAX_ARROW_ENTRIES_1;
   else if(gUnityMaxEntries<=2) MaximumArrowEntries=MAX_ARROW_ENTRIES_2;
   else if(gUnityMaxEntries<=3) MaximumArrowEntries=MAX_ARROW_ENTRIES_3;
   else if(gUnityMaxEntries<=6) MaximumArrowEntries=MAX_ARROW_ENTRIES_6;
   else if(gUnityMaxEntries<=10) MaximumArrowEntries=MAX_ARROW_ENTRIES_10;
   else MaximumArrowEntries=MAX_ARROW_ENTRIES_20;

   ProfitGrabMode=(HT_ProfitGrabMode)((int)UnityProfitPlan);
   StationDecisionMode=(HT_StationDecisionMode)((int)UnityStationMind);
   gUnityStationMode=(int)UnityStationMind;
   gUnityStationPartialPercent=MathMax(1.0,MathMin(99.0,StationPartialPercent));
   gUnityGainTargetPercent=MathMax(0.01,CampaignGainTargetPercent);
   PyramidBreakEvenProgress=MathMax(0.0,MathMin(1.0,ProvenAtRoutePercent/100.0));
   PyramidTrailGivebackPercent=MathMax(0.0,MathMin(100.0,TrailGivebackPercent));
   PyramidNeverLetProvenCampaignGoNegative=NeverLetProvenCampaignGoNegative;

   // One authority: legacy setup/exit personalities stay internal and inactive.
   SetupControl=SETUP_AUTO_ALL;
   ArrowEntryControl=ARROW_ENTRY_FIRST_ONLY;
   GridStopControl=GRID_CONTINUE_AFTER_ADDON_SL;
   ArrowReversalExit=ARROW_REVERSAL_EXIT_OFF;
   IchimokuTrendFilter=ICHIMOKU_FILTER_OFF;
   TakeProfitRatio=TP_RATIO_OFF;
   GravityTrailControl=GRAVITY_TRAIL_OFF;
   PyramidAdaptiveAdvantage=false;
   PyramidMinimumAdvantageRatio=0.0;
}

void ApplyAllControls()
{
   ApplyMasterControl();
   ApplyTradeFrequencyControl();
   ApplySetupControl();
   ApplyRiskControl();
   ApplyArrowEntryControl();
   ApplyMarginSafetyControl();
   ApplyStopControl();
   ApplyScaleInControl();
   ApplyExitControl();
   ApplyHoldControl();
   ApplyVisualControl();

   RiskPerEntryPercent=MathMax(1.0,MathMin(100.0,RiskPerEntryPercent));
   TakeProfitSLRatioValue=MathMax(0.0,MathMin(10.0,TakeProfitSLRatioValue));
   MaximumCampaignRiskPercent=MathMax(RiskPerEntryPercent,
                                       MathMin(100.0,MaximumCampaignRiskPercent));
   SafeMaximumEntries=MathMax(1,MathMin(20,SafeMaximumEntries));
   MinimumProjectedMarginLevel=MathMax(0.0,MinimumProjectedMarginLevel);
   MinimumFreeMarginReservePercent=MathMax(0.0,MathMin(100.0,MinimumFreeMarginReservePercent));
   StopATRPeriodValue=MathMax(1,StopATRPeriodValue);
   StopATRMultiplierValue=MathMax(0.10,StopATRMultiplierValue);
   MinimumStopDistancePointsValue=MathMax(1.0,MinimumStopDistancePointsValue);
   StructureStopBufferPointsValue=MathMax(0.0,StructureStopBufferPointsValue);
   FixedStopDistancePointsValue=MathMax(MinimumStopDistancePointsValue,FixedStopDistancePointsValue);
   MinimumStructureRangePoints=MathMax(1.0,MinimumStructureRangePoints);
   EntryMaximumDirectionalWeight=MathMax(EntryMinimumDirectionalWeight,EntryMaximumDirectionalWeight);
   RejectionCloseLocation=MathMax(0.0,MathMin(1.0,RejectionCloseLocation));
   AddRiskFraction=MathMax(0.0,MathMin(1.0,AddRiskFraction));
   MaximumOpenTrades=MathMax(SafeMaximumEntries,MathMax(1,MaximumOpenTrades));
   MaximumAddsPerCampaign=MathMax(0,MathMin(MaximumAddsPerCampaign,MaximumOpenTrades-1));
   EntryConfirmTicks=MathMax(1,EntryConfirmTicks);
   EntrySignalExpiryBars=MathMax(1,EntrySignalExpiryBars);
   EntryFallbackBars=MathMax(1,EntryFallbackBars);
   FVGScanBars=MathMax(1,FVGScanBars);
   LaunchBreakoutLookback=MathMax(3,LaunchBreakoutLookback);
   StructureLookbackBars=MathMax(10,StructureLookbackBars);
   StopLossLookbackBars=200;
   IchimokuCloudHistoryBars=MathMax(20,IchimokuCloudHistoryBars);
   AngleSampleBars=MathMax(1,AngleSampleBars);
   ModeConfirmTicks=MathMax(1,ModeConfirmTicks);
   MovementTPConfirmTicks=MathMax(1,MovementTPConfirmTicks);
   RailConfirmTicks=MathMax(1,RailConfirmTicks);
}

double MidPrice(){ RefreshRates(); return (Bid+Ask)*0.5; }
double SpreadPoints(){ RefreshRates(); return (Ask-Bid)/Point; }

bool OurOrder()
{
   return OrderSymbol()==Symbol() &&
          OrderMagicNumber()==MagicNumber &&
          (OrderType()==OP_BUY || OrderType()==OP_SELL);
}

int TradeCount()
{
   int n=0;
   for(int i=OrdersTotal()-1;i>=0;i--)
      if(OrderSelect(i,SELECT_BY_POS,MODE_TRADES) && OurOrder()) n++;
   return n;
}

int TradeCountByDirection(int dir)
{
   int n=0;
   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;
      if(dir==DIR_BUY && OrderType()==OP_BUY) n++;
      if(dir==DIR_SELL && OrderType()==OP_SELL) n++;
   }
   return n;
}

double LotsByDirection(int dir)
{
   double lots=0;
   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;
      if(dir==DIR_BUY && OrderType()!=OP_BUY) continue;
      if(dir==DIR_SELL && OrderType()!=OP_SELL) continue;
      lots+=OrderLots();
   }
   return lots;
}

Direction DetectDirection()
{
   double b=LotsByDirection(DIR_BUY),s=LotsByDirection(DIR_SELL);
   if(b>s && b>0) return DIR_BUY;
   if(s>b && s>0) return DIR_SELL;
   return DIR_FLAT;
}

double BasketProfit()
{
   double p=0;
   for(int i=OrdersTotal()-1;i>=0;i--)
      if(OrderSelect(i,SELECT_BY_POS,MODE_TRADES) && OurOrder())
         p+=OrderProfit()+OrderSwap()+OrderCommission();
   return p;
}


//====================================================================
// DEADSHOT SOVEREIGN SCALE / GRAVITY / YOKE ENGINE
//====================================================================
string SovKey(string suffix,int ticket)
{
   return "DSY_"+IntegerToString(AccountNumber())+"_"+Symbol()+"_"+
          IntegerToString(MagicNumber)+"_"+suffix+"_"+IntegerToString(ticket);
}

string SovGreenKey(int ticket){ return SovKey("GREEN",ticket); }
string SovStopKey(int ticket){ return SovKey("VSTOP",ticket); }

double SovTicketNetSelected()
{
   return OrderProfit()+OrderSwap()+OrderCommission();
}

double SovStoredStop(int ticket)
{
   string key=SovStopKey(ticket);
   if(GlobalVariableCheck(key)) return GlobalVariableGet(key);
   return 0.0;
}

bool SovTicketEverGreen(int ticket)
{
   return GlobalVariableCheck(SovGreenKey(ticket));
}

void SovUpdateTicketMemory()
{
   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;
      if(SovTicketNetSelected()>=MathMax(0.0,GreenLockMinimumProfit))
         GlobalVariableSet(SovGreenKey(OrderTicket()),1.0);
   }
}

double SovereignOxRiskPercent()
{
   // Unity risk covenant: RiskPerTrade is the exact requested risk of EACH entry
   // at its actual protective SL. The campaign cap blocks later entries; it never
   // silently divides or substitutes the user's selected per-entry percentage.
   return MathMax(0.01,RiskPerEntryPercent);
}

void SovRealizedWeights(double &profitWeight,double &lossWeight)
{
   profitWeight=0.0;
   lossWeight=0.0;

   for(int i=OrdersHistoryTotal()-1;i>=0;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_HISTORY)) continue;
      if(OrderSymbol()!=Symbol() || OrderMagicNumber()!=MagicNumber) continue;
      if(OrderType()!=OP_BUY && OrderType()!=OP_SELL) continue;

      double net=OrderProfit()+OrderSwap()+OrderCommission();
      if(net>0.0) profitWeight+=net;
      else if(net<0.0) lossWeight+=MathAbs(net);
   }
}

void SovFloatingWeights(double &greenWeight,double &redWeight)
{
   greenWeight=0.0;
   redWeight=0.0;

   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;
      double net=SovTicketNetSelected();
      if(net>0.0) greenWeight+=net;
      else if(net<0.0) redWeight+=MathAbs(net);
   }
}

void SovOxCounts(int &pulling,int &dragging,int &unproven)
{
   pulling=0; dragging=0; unproven=0;

   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;
      double net=SovTicketNetSelected();
      if(net>=MathMax(0.0,MinimumNetCloseProfit)) pulling++;
      else if(net<0.0) dragging++;
      else unproven++;
   }
}

string SovScaleState()
{
   double realizedProfit=0.0,realizedLoss=0.0;
   double liveGreen=0.0,liveRed=0.0;
   SovRealizedWeights(realizedProfit,realizedLoss);
   SovFloatingWeights(liveGreen,liveRed);

   double profitWeight=realizedProfit+liveGreen;
   double riskWeight=realizedLoss+liveRed;

   if(riskWeight<=0.01)
      return (profitWeight>0.0 ? "PROFIT DOMINANT" : "BALANCED");

   double hiddenWeightRatio=profitWeight/riskWeight;

   if(hiddenWeightRatio<0.75) return "RISK HEAVY";
   if(hiddenWeightRatio<1.25) return "RISK LOADED";
   if(hiddenWeightRatio<2.00) return "BALANCED";
   if(hiddenWeightRatio<4.00) return "PROFIT LIGHT";
   if(hiddenWeightRatio<7.00) return "PROFIT HEAVY";
   return "PROFIT DOMINANT";
}

string SovYokeState()
{
   int n=TradeCount();
   if(n<=0) return "UNYOKED";
   if(n<=3) return "YOKE FORMING";
   if(n<=6) return "TEAM BUILDING";
   if(n<MathMax(2,(int)YokeActivationCharacter)) return "FULL YOKE";

   double green=0.0,red=0.0;
   SovFloatingWeights(green,red);
   if(red<=0.01 || green>=red) return "EQUALLY YOKED OX TRAIN";
   return "OX TRAIN UNDER LOAD";
}

double SovGravityGivebackPercent()
{
   if(GravityTrailControl==GRAVITY_TRAIL_TIGHT) return 12.0;
   if(GravityTrailControl==GRAVITY_TRAIL_STRONG) return 18.0;
   return 25.0;
}

void SovResetGravity()
{
   gSovPeakPull=0.0;
   gSovGravityFloor=0.0;
   gSovGravityArmed=false;
   gSovGravityState="GROUND";
   gSovLastReleased=0;
}

double SovDirectLossFractionSelected()
{
   double net=SovTicketNetSelected();
   if(net>=0.0) return 0.0;

   double stop=OrderStopLoss();
   if(stop<=0.0) stop=SovStoredStop(OrderTicket());
   if(stop<=0.0) return 0.0;

   double originalRisk=OrderRiskMoneyFromPrices(OrderOpenPrice(),stop,OrderLots());
   if(originalRisk<=0.0) return 0.0;
   return MathAbs(net)/originalRisk;
}

// Only an explicit operator safety command may override the negative-hold covenant.
// Broker-side SL/TP executions never pass through this function and remain fully active.
bool UnifiedAuthorizedNegativeCloseOverride(string reason)
{
   if(EnableCompoundStaircase && CompoundAllowNetPositiveRedSettlement &&
      StringFind(reason,"COMPOUND TARGET SETTLEMENT")>=0) return true;
   if(MarketDNAChannelBounceTransferAllowNegative &&
      StringFind(reason,"HIST CHANNEL BOUNCE TRANSFER")>=0) return true;
   if(MarketDNATriggerRailTransferAllowNegative &&
      StringFind(reason,"TRIGGER RAIL TRANSFER")>=0) return true;
   if(!EmergencyCloseOverridesNegativeHold) return false;
   return StringFind(reason,"WISDO EMERGENCY")>=0 ||
          StringFind(reason,"WISDO CLOSE ALL")>=0 ||
          StringFind(reason,"WISDO COMMAND EMERGENCY")>=0 ||
          StringFind(reason,"WISDO COMMAND CLOSE ALL")>=0 ||
          StringFind(reason,"MANUAL EMERGENCY")>=0;
}

bool SovTicketSoftwareCloseAllowed(string reason)
{
   double net=SovTicketNetSelected();
   if(NeverSoftwareCloseNegativeCampaign && net<0.0 &&
      !UnifiedAuthorizedNegativeCloseOverride(reason))
   {
      gSovLastAction="NEGATIVE HOLD - BROKER SL OWNS #"+IntegerToString(OrderTicket());
      return false;
   }

   if(SovereignCloseMode==SOV_CLOSE_NORMAL)
      return true;

   double floor=MathMax(0.0,MinimumNetCloseProfit);

   if(net>=floor)
      return true;

   if(SovereignCloseMode==SOV_CLOSE_LOCK_AFTER_GREEN)
   {
      if(!SovTicketEverGreen(OrderTicket()))
         return true;

      gSovLastAction="GREEN LOCK HELD #"+IntegerToString(OrderTicket());
      return false;
   }

   if(SovereignCloseMode==SOV_CLOSE_DIRECT_LOSS_EXCEPTION)
   {
      if(!SovTicketEverGreen(OrderTicket()) &&
         SovDirectLossFractionSelected()>=MathMax(0.01,DirectLossExceptionR))
      {
         gSovLastAction="DIRECT LOSS EXCEPTION #"+IntegerToString(OrderTicket());
         return true;
      }
   }

   gSovLastAction="RED OX PROTECTED #"+IntegerToString(OrderTicket())+
                  " | "+reason;
   return false;
}

bool SovCloseSelectedTicket(string reason)
{
   if(!OurOrder()) return false;

   int ticket=OrderTicket();
   if(!SovTicketSoftwareCloseAllowed(reason))
   {
      Print("DEADSHOT SOVEREIGN HOLD ticket=",ticket,
            " net=",DoubleToString(SovTicketNetSelected(),2),
            " reason=",reason);
      return false;
   }

   RefreshRates();
   if(!OrderSelect(ticket,SELECT_BY_TICKET,MODE_TRADES)) return false;
   if(!OurOrder()) return false;

   if(!SovTicketSoftwareCloseAllowed(reason)) return false;

   double net=SovTicketNetSelected();
   double px=(OrderType()==OP_BUY ? Bid : Ask);

   ResetLastError();
   bool closed=HT5CommanderOrderClose(ticket,OrderLots(),px,SlippagePoints,clrNONE);
   int err=GetLastError();

   if(closed)
   {
      gSovLastAction="VAULTED #"+IntegerToString(ticket)+
                     " +$"+DoubleToString(net,2);
      Print("DEADSHOT SOVEREIGN VAULT ticket=",ticket,
            " net=",DoubleToString(net,2)," reason=",reason);
      return true;
   }

   Print("DEADSHOT SOVEREIGN close failed ticket=",ticket,
         " err=",err," reason=",reason);
   return false;
}

bool SovCanReleaseProfit(double candidateProfit)
{
   double liveGreen=0.0,liveRed=0.0;
   SovFloatingWeights(liveGreen,liveRed);

   if(liveRed<=0.01) return true;

   double remainingGreen=MathMax(0.0,liveGreen-candidateProfit);
   return remainingGreen>=liveRed*MathMax(0.0,YokeLiveReserveRatio);
}

int SovHeaviestGreenTicket(double &profitOut)
{
   int bestTicket=-1;
   profitOut=0.0;

   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;
      double net=SovTicketNetSelected();
      if(net<MathMax(0.0,MinimumNetCloseProfit)) continue;

      if(bestTicket<0 || net>profitOut)
      {
         bestTicket=OrderTicket();
         profitOut=net;
      }
   }

   return bestTicket;
}

void SovGravityHarvest(string trigger)
{
   if(TradeCount()<=0) return;

   int released=0;
   int maximum=MathMax(1,(int)GravityReleaseCharacter);

   for(int pass=0;pass<maximum;pass++)
   {
      double candidateProfit=0.0;
      int ticket=SovHeaviestGreenTicket(candidateProfit);
      if(ticket<0) break;

      if(!SovCanReleaseProfit(candidateProfit) && released>0)
         break;

      if(!OrderSelect(ticket,SELECT_BY_TICKET,MODE_TRADES)) break;
      if(!SovCloseSelectedTicket("GRAVITY TRAIL | "+trigger)) break;

      released++;
   }

   gSovLastReleased=released;

   if(released>0)
   {
      gSovLastAction="GRAVITY VAULT "+IntegerToString(released)+" OX";
      gSovPeakPull=MathMax(0.0,BasketProfit());
      gSovGravityFloor=0.0;
      gSovGravityArmed=false;
      gSovGravityState="REWEIGHING";
   }
   else
      gSovLastAction="GRAVITY HELD - NO GREEN OX RELEASED";
}

void SovManageGravity()
{
   if(TradeCount()<=0)
   {
      SovResetGravity();
      return;
   }

   double currentPull=BasketProfit();

   if(currentPull>gSovPeakPull)
      gSovPeakPull=currentPull;

   gSovScaleState=SovScaleState();
   gSovYokeState=SovYokeState();

   if(GravityTrailControl==GRAVITY_TRAIL_OFF)
   {
      gSovGravityState="OFF";
      return;
   }

   double armMoney=MathMax(GravityMinimumArmMoney,
                           AccountBalance()*MathMax(0.0,GravityArmBalancePercent)/100.0);

   if(!gSovGravityArmed &&
      TradeCount()>=MathMax(2,(int)YokeActivationCharacter) &&
      gSovPeakPull>=armMoney)
   {
      gSovGravityArmed=true;
      gSovGravityState="LIFTED";
   }

   if(!gSovGravityArmed)
   {
      if(currentPull>0.0) gSovGravityState="PULLING";
      else if(currentPull<0.0) gSovGravityState="DRAGGING";
      else gSovGravityState="GROUND";
      return;
   }

   double giveback=MathMax(GravityMinimumGivebackMoney,
                           gSovPeakPull*SovGravityGivebackPercent()/100.0);

   gSovGravityFloor=MathMax(0.0,gSovPeakPull-giveback);

   if(currentPull>gSovGravityFloor)
   {
      if(gSovPeakPull>=armMoney*2.0) gSovGravityState="DOMINANT PULL";
      else gSovGravityState="HEAVY PULL";
      return;
   }

   if(currentPull>0.0)
   {
      gSovGravityState="GRAVITY TRAIL BROKEN";
      SovGravityHarvest("TEAM PULL FELL BELOW GRAVITY FLOOR");
   }
}

bool SovYokeAllowsNextOx(int dir)
{
   if(!YokeGateNewRapidFireEntries) return true;

   int count=TradeCount();
   if(count<MathMax(2,(int)YokeActivationCharacter)) return true;

   double green=0.0,red=0.0;
   SovFloatingWeights(green,red);

   string scale=SovScaleState();

   if(scale=="RISK HEAVY" || scale=="RISK LOADED")
   {
      gSovLastAction="YOKE BLOCKED NEW OX - "+scale;
      return false;
   }

   if(red>0.0 && green<red)
   {
      gSovLastAction="YOKE BLOCKED - TEAM DRAG EXCEEDS PULL";
      return false;
   }

   if(BasketProfit()<=0.0)
   {
      gSovLastAction="YOKE BLOCKED - TEAM NOT MOVING";
      return false;
   }

   return true;
}

double SovVaultNet()
{
   double gp=0.0,gl=0.0;
   SovRealizedWeights(gp,gl);
   return gp-gl;
}

double NewestProfit()
{
   datetime newest=0; double p=0;
   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;
      if(OrderOpenTime()>=newest)
      {
         newest=OrderOpenTime();
         p=OrderProfit()+OrderSwap()+OrderCommission();
      }
   }
   return p;
}

double LastEntryPrice()
{
   datetime newest=0; double price=0;
   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;
      if(OrderOpenTime()>=newest){ newest=OrderOpenTime(); price=OrderOpenPrice(); }
   }
   return price;
}

double TotalLots()
{
   double lots=0.0;
   for(int i=OrdersTotal()-1;i>=0;i--)
      if(OrderSelect(i,SELECT_BY_POS,MODE_TRADES) && OurOrder()) lots+=OrderLots();
   return lots;
}

string WillGV(string field)
{
   return "HTWILL_"+IntegerToString(AccountNumber())+"_"+Symbol()+"_"+
          IntegerToString(MagicNumber)+"_"+field;
}

void WillSave()
{
   if(!EnableWillDNA) return;
   GlobalVariableSet(WillGV("N"),gWillCampaigns);
   GlobalVariableSet(WillGV("W"),gWillWins);
   GlobalVariableSet(WillGV("TARGETS"),gWillTargets);
   GlobalVariableSet(WillGV("CTU"),gWillLifetimeCTU);
   GlobalVariableSet(WillGV("AW"),gWillAvgWinCTU);
   GlobalVariableSet(WillGV("AL"),gWillAvgLossCTU);
   GlobalVariableSet(WillGV("SCORE"),gWillScoreEWMA);
   GlobalVariableSet(WillGV("TIME"),gWillTimeEWMA);
   GlobalVariableSet(WillGV("DD"),gWillDDEWMA);
   GlobalVariableSet(WillGV("PULSE"),gWillPulseATREWMA);
   GlobalVariableSet(WillGV("STREAK"),(double)gWillConsecutiveTargets);
   GlobalVariableSet(WillGV("BEST"),(double)gWillBestStreak);
   GlobalVariableSet(WillGV("FAST"),(double)gWillFastestTarget);
}

double WillLoadValue(string key,double fallback)
{ return GlobalVariableCheck(WillGV(key)) ? GlobalVariableGet(WillGV(key)) : fallback; }

void WillRecalculateEdge()
{
   double p=(gWillWins+1.0)/(gWillCampaigns+2.0); // Bayesian smoothing prevents one lucky trade becoming certainty.
   double raw=p*MathMax(0.0,gWillAvgWinCTU)-(1.0-p)*MathMax(0.0,gWillAvgLossCTU);
   gWillConfidence=gWillCampaigns/(gWillCampaigns+MathMax(1,WillConfidenceSamples));
   // Until trained, blend with a deliberately neutral prior rather than inventing an edge.
   gWillEdge=gWillConfidence*raw;
}

void WillLoad()
{
   if(!EnableWillDNA) return;
   gWillCampaigns=WillLoadValue("N",0.0); gWillWins=WillLoadValue("W",0.0);
   gWillTargets=WillLoadValue("TARGETS",0.0); gWillLifetimeCTU=WillLoadValue("CTU",0.0);
   gWillAvgWinCTU=WillLoadValue("AW",1.0); gWillAvgLossCTU=WillLoadValue("AL",1.0);
   gWillScoreEWMA=WillLoadValue("SCORE",0.0); gWillTimeEWMA=WillLoadValue("TIME",0.0);
   gWillDDEWMA=WillLoadValue("DD",0.0); gWillPulseATREWMA=WillLoadValue("PULSE",0.35);
   gWillConsecutiveTargets=(int)WillLoadValue("STREAK",0.0);
   gWillBestStreak=(int)WillLoadValue("BEST",0.0); gWillFastestTarget=(datetime)WillLoadValue("FAST",0.0);
   WillRecalculateEdge();
   gWillCampaignStartTime=TimeCurrent(); gWillCampaignStartBalance=AccountBalance();
   gWillCampaignPeakEquity=AccountEquity(); gWillCampaignMinEquity=AccountEquity();
   gWillCampaignMaxDD=0.0; gWillCampaignMaxEntries=TradeCount();
   gWillState=(gWillCampaigns<WillConfidenceSamples?"LEARNING":"EDGE ONLINE");
}

void WillTrackLiveCampaign()
{
   if(!EnableWillDNA) return;
   if(gWillCampaignStartTime<=0)
   { gWillCampaignStartTime=TimeCurrent(); gWillCampaignStartBalance=AccountBalance(); }
   gWillCampaignPeakEquity=MathMax(gWillCampaignPeakEquity,AccountEquity());
   if(gWillCampaignMinEquity<=0.0) gWillCampaignMinEquity=AccountEquity();
   gWillCampaignMinEquity=MathMin(gWillCampaignMinEquity,AccountEquity());
   gWillCampaignMaxDD=MathMax(gWillCampaignMaxDD,gWillCampaignPeakEquity-AccountEquity());
   gWillCampaignMaxEntries=MathMax(gWillCampaignMaxEntries,TradeCount());
}

void WillRecordCampaign(double resultMoney,double goalMoney)
{
   if(!EnableWillDNA || goalMoney<=0.0) return;
   double alpha=MathMax(0.01,MathMin(0.20,WillLearningRate));
   double ctu=resultMoney/goalMoney;
   double lossUnits=(ctu<0.0 ? MathAbs(ctu) : 0.0);
   double ddUnits=gWillCampaignMaxDD/MathMax(0.01,goalMoney);
   double seconds=MathMax(1.0,(double)(TimeCurrent()-gWillCampaignStartTime));
   double timeRatio=(gWillTimeEWMA>0.0 ? seconds/gWillTimeEWMA : 1.0);
   double over=(double)MathMax(0,gWillCampaignMaxEntries-PyrRuntimeMaxEntries())/
               MathMax(1,PyrRuntimeMaxEntries());
   double score=ctu-1.25*lossUnits-0.35*ddUnits-
                0.15*MathMax(0.0,timeRatio-1.0)-0.30*over;

   gWillCampaigns+=1.0; gWillLifetimeCTU+=ctu;
   if(ctu>0.0)
   {
      gWillWins+=1.0;
      gWillAvgWinCTU=(1.0-alpha)*gWillAvgWinCTU+alpha*ctu;
      int completed=(int)MathFloor(ctu+0.000001);
      gWillTargets+=completed;
      if(completed>0)
      {
         gWillConsecutiveTargets+=completed; gWillBestStreak=MathMax(gWillBestStreak,gWillConsecutiveTargets);
         if(gWillFastestTarget<=0 || seconds<(double)gWillFastestTarget) gWillFastestTarget=(datetime)seconds;
      }
   }
   else
   {
      gWillAvgLossCTU=(1.0-alpha)*gWillAvgLossCTU+alpha*MathAbs(ctu);
      gWillConsecutiveTargets=0;
   }
   gWillScoreEWMA=(1.0-alpha)*gWillScoreEWMA+alpha*score;
   gWillTimeEWMA=(gWillTimeEWMA<=0.0?seconds:(1.0-alpha)*gWillTimeEWMA+alpha*seconds);
   gWillDDEWMA=(1.0-alpha)*gWillDDEWMA+alpha*ddUnits;
   double atr=MathMax(Point,HTExecutionATR(SignalTF,StopATRPeriodValue));
   if(ctu>0.0 && gPyrEntryAnchor>0.0 && gPyrBestPrice>0.0 && atr>0.0)
   {
      double pulseATR=MathAbs(gPyrBestPrice-gPyrEntryAnchor)/atr;
      pulseATR=MathMax(0.05,MathMin(10.0,pulseATR));
      gWillPulseATREWMA=(1.0-alpha)*gWillPulseATREWMA+alpha*pulseATR;
   }
   WillRecalculateEdge();
   gWillLastLesson="CTU "+DoubleToString(ctu,2)+" | SCORE "+DoubleToString(score,2);
   gWillLastLearnTime=TimeCurrent();
   gWillState=(gWillEdge>=WillMinimumPositiveEdge && gWillConfidence>=0.50 ? "EDGE ACTIVE" : "LEARNING SAFELY");
   WillSave();

   gWillCampaignStartTime=TimeCurrent(); gWillCampaignStartBalance=AccountBalance();
   gWillCampaignPeakEquity=AccountEquity(); gWillCampaignMinEquity=AccountEquity();
   gWillCampaignMaxDD=0.0; gWillCampaignMaxEntries=0;
}

string CompoundGV(string field)
{
   // Keep the established namespace for account/chart continuity.  MODE32
   // performs a one-time migration away from the old loss-recovery lock.
   return "HT230_CMP_"+IntegerToString(AccountNumber())+"_"+
          IntegerToString(MagicNumber)+"_"+Symbol()+"_"+field;
}

string CompoundPhaseText()
{
   if(gCompoundPhase==CMP_GUARDING) return "GUARDING TARGET";
   if(gCompoundPhase==CMP_UNLOCKED) return "TARGET UNLOCKED";
   if(gCompoundPhase==CMP_COLLECTING) return "COLLECTING BASKET";
   if(gCompoundPhase==CMP_REBASING) return "REBASING";
   if(gCompoundPhase==CMP_PAUSED) return "POST-COLLECTION PAUSE";
   return "BUILDING";
}

void CompoundRecalculate()
{
   if(gCompoundAnchor<=0.0) gCompoundAnchor=MathMax(0.01,AccountBalance());
   double pct=MathMax(0.01,MathMin(1000.0,CompoundTargetPercent));
   gCompoundTarget=NormalizeDouble(gCompoundAnchor*(1.0+pct/100.0),2);
   double span=MathMax(0.01,gCompoundTarget-gCompoundAnchor);
   double settledBalance=MathMax(0.01,AccountBalance());
   // v6.05: compound metabolism collects continuation add-ons only.
   // Long-lived structure holds are excluded from the compound live-value target.
   double collectableProfit=(HT6EinsteinEnabled()?HT6ContinuationProfit(DIR_FLAT):BasketProfit());
   double liveValue=settledBalance+collectableProfit;

   // The target is fixed only for the active campaign.  Once a campaign is
   // flat, profit or loss is accepted and the next campaign compounds from
   // that new realized balance.  No prior loss is added to the next goal.
   gCompoundBaseGoalMoney=MathMax(0.0,gCompoundTarget-gCompoundAnchor);
   gCompoundRequiredMoney=MathMax(0.0,gCompoundTarget-settledBalance);
   gCompoundLiveRemaining=MathMax(0.0,gCompoundTarget-liveValue);
   gCompoundRequiredPercent=gCompoundRequiredMoney/settledBalance*100.0;
   gCompoundProgress=(liveValue-gCompoundAnchor)/span*100.0;
}

void CompoundSave()
{
   GlobalVariableSet(CompoundGV("ANCHOR"),gCompoundAnchor);
   GlobalVariableSet(CompoundGV("CYCLE"),(double)gCompoundCycle);
   GlobalVariableSet(CompoundGV("LAST"),gCompoundLastCollected);
   GlobalVariableSet(CompoundGV("TIME"),(double)gCompoundLastCollectionTime);
   GlobalVariableSet(CompoundGV("MODE32"),1.0);
}

void CompoundLoad()
{
   bool migrateToCurrentBalance=!GlobalVariableCheck(CompoundGV("MODE32"));
   bool reset=CompoundResetAnchorNow || migrateToCurrentBalance ||
              !GlobalVariableCheck(CompoundGV("ANCHOR"));
   if(reset)
   {
      gCompoundAnchor=MathMax(0.01,AccountBalance()); gCompoundCycle=1;
      gCompoundLastCollected=0.0; gCompoundLastCollectionTime=0;
      gCompoundReceipt=(migrateToCurrentBalance ? "V2.32 CURRENT-BALANCE MODE STARTED" :
                                                "BASE RESET AT REALIZED BALANCE");
   }
   else
   {
      gCompoundAnchor=MathMax(0.01,GlobalVariableGet(CompoundGV("ANCHOR")));
      if(GlobalVariableCheck(CompoundGV("CYCLE"))) gCompoundCycle=MathMax(1,(int)GlobalVariableGet(CompoundGV("CYCLE")));
      if(GlobalVariableCheck(CompoundGV("LAST"))) gCompoundLastCollected=GlobalVariableGet(CompoundGV("LAST"));
      if(GlobalVariableCheck(CompoundGV("TIME"))) gCompoundLastCollectionTime=(datetime)GlobalVariableGet(CompoundGV("TIME"));
      gCompoundReceipt="PERSISTENT STAIRCASE RESTORED";
   }
   gCompoundTargetLatched=false; gCompoundEntryFreeze=false; gCompoundUnlockTicks=0;
   CompoundRecalculate(); CompoundSave();
}

void CompoundRebaseFlatResult()
{
   double oldAnchor=gCompoundAnchor;
   double newBalance=MathMax(0.01,AccountBalance());
   double result=newBalance-oldAnchor;
   WillRecordCampaign(result,MathMax(0.01,gCompoundBaseGoalMoney));
   gCompoundLastCollected=result;
   gCompoundAnchor=newBalance; gCompoundCycle++;
   gCompoundTargetLatched=false; gCompoundUnlockTicks=0; gCompoundCloseAttempts=0;
   gCompoundEntryFreeze=false; gCompoundPhase=CMP_REBASING;
   CompoundRecalculate();
   if(result<0.0)
      gCompoundReceipt="LOSS ACCEPTED $"+DoubleToString(result,2)+
                       " | NEW BASE $"+DoubleToString(gCompoundAnchor,2);
   else
      gCompoundReceipt="PROFIT BANKED +$"+DoubleToString(result,2)+
                       " | NEW BASE $"+DoubleToString(gCompoundAnchor,2);
   gCompoundState="NEXT GOAL FROM CURRENT BALANCE";
   CompoundSave();
   Print("HT COMPOUND v3.03 FLAT REBASE old=",DoubleToString(oldAnchor,2),
         " result=",DoubleToString(result,2),
         " current=",DoubleToString(gCompoundAnchor,2),
         " next=",DoubleToString(gCompoundTarget,2));
}

void CompoundCompleteRebase(string receipt)
{
   double oldAnchor=gCompoundAnchor;
   gCompoundLastCollected=AccountBalance()-oldAnchor;
   WillRecordCampaign(gCompoundLastCollected,MathMax(0.01,gCompoundBaseGoalMoney));
   gCompoundAnchor=MathMax(0.01,AccountBalance()); gCompoundCycle++;
   gCompoundLastCollectionTime=TimeCurrent(); gCompoundTargetLatched=false;
   gCompoundUnlockTicks=0; gCompoundCloseAttempts=0; gCompoundEntryFreeze=true;
   gCompoundPhase=CMP_REBASING; CompoundRecalculate();
   // A verified compound target creates a new capital campaign. Keep learned
   // Route/SURF/WILL context, but discard the old campaign's execution lock.
   if(EnableMarketDNA) PyrReleasePeakObservationForMarketDNA("COMPOUND TARGET REBASED");
   gCompoundReceipt=receipt+" $"+DoubleToString(gCompoundLastCollected,2)+
                    " | NEXT $"+DoubleToString(gCompoundTarget,2);
   gCompoundState="REALIZED BALANCE VERIFIED"; CompoundSave();
   Print("HT COMPOUND REBASE v3.03 old=",DoubleToString(oldAnchor,2),
         " realized=",DoubleToString(gCompoundAnchor,2),
         " next=",DoubleToString(gCompoundTarget,2));
}

bool ManageCompoundStaircase()
{
   if(!EnableCompoundStaircase)
   { gCompoundEntryFreeze=false; gCompoundPhase=CMP_BUILDING; return false; }
   CompoundRecalculate();

   // v6.08 COMPOUND TAKE-PROFIT: add-ons may bank adaptive profit pockets while
   // the primary structure core remains untouched. Realized pockets accumulate
   // toward the SAME compound target and can recycle a new SONIC wave.
   if(HT6EinsteinEnabled()) HT6EinsteinManageSonicCompoundTakeProfit();

   int collectableTrades=(HT6EinsteinEnabled()?HT6ContinuationAddCount(DIR_FLAT):TradeCount());
   double collectableProfit=(HT6EinsteinEnabled()?HT6ContinuationProfit(DIR_FLAT):BasketProfit());

   // Any fully realized campaign outcome becomes the next campaign's base.
   // A $48 campaign closing at $32 therefore creates a new $35.20 target at 10%.
   bool einsteinFullyFlat=(HT6EinsteinEnabled() ? (collectableTrades==0 && HT6StructureHoldCount(DIR_FLAT)==0) : (collectableTrades==0));
   if(einsteinFullyFlat && MathAbs(AccountBalance()-gCompoundAnchor)>=0.005)
   {
      if(EnableMarketDNA && !HT6EinsteinEnabled()) MarketDNADeletePendingLimits("FLAT CAMPAIGN REBASE");
      CompoundRebaseFlatResult();
      CompoundRecalculate();
   }

   // If SONIC pockets have already REALIZED the full compound objective while
   // structure cores are still holding, advance the compound cycle without
   // touching those cores.
   if(HT6EinsteinEnabled() && collectableTrades==0 &&
      AccountBalance()>=gCompoundTarget+MathMax(0.0,CompoundSettlementSafetyMoney))
   {
      CompoundCompleteRebase("EINSTEIN SONIC TARGET REALIZED / CORE HOLDS");
      return false;
   }
   if(gCompoundLastCollectionTime>0 &&
      TimeCurrent()-gCompoundLastCollectionTime<MathMax(0,CompoundPostCollectionPauseSeconds))
   {
      gCompoundEntryFreeze=true; gCompoundPhase=CMP_PAUSED;
      if(EnableMarketDNA && !HT6EinsteinEnabled()) MarketDNADeletePendingLimits("COMPOUND PAUSE");
      gCompoundState="COLLECTED - ADD-ONS PAUSED / STRUCTURE FLOW STILL ALIVE";
      return (HT6EinsteinEnabled()?false:true);
   }

   if(!HT6EinsteinEnabled() && TradeCount()==0 &&
      AccountBalance()>=gCompoundTarget+MathMax(0.0,CompoundSettlementSafetyMoney))
   {
      if(EnableMarketDNA) MarketDNADeletePendingLimits("FLAT TARGET VERIFIED");
      CompoundCompleteRebase("FLAT TARGET VERIFIED"); return true;
   }

   double liveValue=AccountBalance()+collectableProfit;
   double safeTarget=gCompoundTarget+MathMax(0.0,CompoundSettlementSafetyMoney);
   bool redBasket=(collectableProfit<0.0);
   bool settlementAllowed=(!redBasket || CompoundAllowNetPositiveRedSettlement);
   bool targetSafe=(collectableTrades>0 && liveValue>=safeTarget && settlementAllowed);

   if(!gCompoundTargetLatched)
   {
      if(targetSafe) gCompoundUnlockTicks++; else gCompoundUnlockTicks=0;
      if(gCompoundUnlockTicks>=MathMax(1,CompoundUnlockConfirmationTicks))
      {
         gCompoundTargetLatched=true; gCompoundEntryFreeze=true; gCompoundPhase=CMP_UNLOCKED;
       if(EnableMarketDNA && !HT6EinsteinEnabled()) MarketDNADeletePendingLimits("TARGET UNLOCKED");
         gCompoundPreCloseValue=liveValue;
         gCompoundReceipt=(redBasket?"TARGET SAFE AFTER RED SETTLEMENT":"TARGET SAFELY UNLOCKED");
         Print("HT COMPOUND UNLOCK cycle=",gCompoundCycle,
               " anchor=",DoubleToString(gCompoundAnchor,2),
               " target=",DoubleToString(gCompoundTarget,2),
               " live=",DoubleToString(liveValue,2)," basket=",DoubleToString(BasketProfit(),2));
      }
   }

   if(gCompoundTargetLatched)
   {
      gCompoundEntryFreeze=true; gCompoundPhase=CMP_COLLECTING;
      if(EnableMarketDNA && !HT6EinsteinEnabled()) MarketDNADeletePendingLimits("TARGET COLLECTION");
      gCompoundState=(HT6EinsteinEnabled()?
                      "ENTRIES FROZEN - COLLECT CONTINUATION ADDS ONLY":
                      "ENTRIES FROZEN - FULL BASKET COLLECTION");
      if(collectableTrades>0)
      {
         gCompoundCloseAttempts++;
         bool closed=(HT6EinsteinEnabled()?
                      HT6EinsteinCloseContinuationAdds("COMPOUND TARGET SETTLEMENT"):
                      PyrCloseFullCampaign("COMPOUND TARGET SETTLEMENT"));
         if(!closed)
         {
            gCompoundReceipt="COLLECTION RETRY "+IntegerToString(gCompoundCloseAttempts);
            return (HT6EinsteinEnabled()?false:true);
         }
      }
      collectableTrades=(HT6EinsteinEnabled()?HT6ContinuationAddCount(DIR_FLAT):TradeCount());
      if(collectableTrades==0)
      {
         CompoundCompleteRebase("COMPOUND ADD-ONS COLLECTED");
         return (HT6EinsteinEnabled()?false:true);
      }
   }

   double guard=MathMax(0.0,MathMin(99.0,CompoundGuardAtPercent));
   bool guardOwns=(gCompoundProgress>=guard &&
                   (!MarketDNACompoundGuardOnlyWithOpenTrades || collectableTrades>0));
   if(guardOwns)
   {
      gCompoundEntryFreeze=true; gCompoundPhase=CMP_GUARDING;
      if(EnableMarketDNA && !HT6EinsteinEnabled()) MarketDNADeletePendingLimits("COMPOUND GUARD");
      gCompoundState="GUARD ZONE - NEW CARS FROZEN";
   }
   else
   {
      // v3.17: a flat account must always be able to hunt the next campaign.
      // Stored/realized progress is not allowed to deadlock entry while no market
      // position exists. The next target still comes from the current anchor.
      gCompoundEntryFreeze=false; gCompoundPhase=CMP_BUILDING;
      gCompoundState="BUILDING CYCLE "+IntegerToString(gCompoundCycle);
   }
   return false;
}

void ApplyDynamicMoodBackground()
{
   if(!UseDynamicMoodBackground) return;
   color mood=C'10,10,12';
   if(EnableMarketDNA)
   {
      if(StringFind(gMDAction,"TRANSFER")>=0) mood=C'30,8,42';
      else if(StringFind(gMDAction,"SUSPEND")>=0 || StringFind(gMDAction,"DEFEND")>=0) mood=C'31,18,5';
      else if(StringFind(gMDAction,"ATTACK")>=0) mood=C'4,22,28';
      else if(StringFind(gMDAction,"RECOVER")>=0) mood=C'28,8,30';
      else if(StringFind(gMDAction,"HARVEST")>=0 || StringFind(gMDAction,"VAULT")>=0) mood=C'26,21,5';
      else if(StringFind(gMDAction,"STACK")>=0) mood=C'8,20,26';
      else if(gMDDesiredDirection==DIR_BUY) mood=C'5,18,14';
      else if(gMDDesiredDirection==DIR_SELL) mood=C'24,8,12';
   }
   if(gPyrPeakObservationActive) mood=C'22,12,34';
   else if(gCompoundPhase==CMP_COLLECTING || gCompoundPhase==CMP_REBASING || gCompoundPhase==CMP_PAUSED) mood=C'7,20,38';
   else if(gCompoundPhase==CMP_GUARDING || gCompoundProgress>=100.0) mood=C'24,20,5';
   else if(BasketProfit()>0.0) mood=C'5,24,14';
   else if(BasketProfit()<0.0) mood=C'30,7,9';
   if(mood!=gLastMoodBackground)
   { ChartSetInteger(0,CHART_COLOR_BACKGROUND,mood); gLastMoodBackground=mood; ChartRedraw(0); }
}

double AccountRiskBase()
{
   HT_AccountBasis basis=(DirectInputsOwnExecution?DirectCompoundRiskBasis:RiskAccountBasis);
   double base=(basis==RISK_FROM_BALANCE ? AccountBalance() :
                (basis==RISK_FROM_FREE_MARGIN ? AccountFreeMargin() : AccountEquity()));
   if(!(DirectInputsOwnExecution && DirectCompoundEveryTradeFromCurrentAccount) &&
      EnableCompoundStaircase && gCompoundAnchor>0.0)
      base=MathMin(base,gCompoundAnchor);
   return MathMax(0.0,base);
}

double SelectedRiskMoney()
{
   return AccountRiskBase()*RiskPerEntryPercent/100.0;
}

double TickSizePrice()
{
   double tickSizePrice=MarketInfo(Symbol(),MODE_TICKSIZE);
   return (tickSizePrice>0.0?tickSizePrice:Point);
}

double CashLossPerLot(double openPrice,double stopPrice)
{
   double distance=MathAbs(openPrice-stopPrice);
   double tickValue=MarketInfo(Symbol(),MODE_TICKVALUE);
   double tickSizePrice=TickSizePrice();
   double contractSize=MarketInfo(Symbol(),MODE_LOTSIZE);

   gRiskBrokerLossPerLot=0.0;
   gRiskContractLossPerLot=0.0;
   gRiskChosenLossPerLot=0.0;
   gRiskValueSource="INVALID";
   if(distance<=0.0) return 0.0;

   if(tickValue>0.0 && tickSizePrice>0.0)
      gRiskBrokerLossPerLot=(distance/tickSizePrice)*tickValue;
   if(contractSize>0.0)
      gRiskContractLossPerLot=distance*contractSize;

   if(RiskValueMode==RISK_VALUE_BROKER_METADATA)
   {
      gRiskChosenLossPerLot=gRiskBrokerLossPerLot;
      gRiskValueSource="BROKER";
   }
   else if(RiskValueMode==RISK_VALUE_CONTRACT_SIZE)
   {
      gRiskChosenLossPerLot=gRiskContractLossPerLot;
      gRiskValueSource="CONTRACT";
   }
   else
   {
      // Some XAUUSD tester feeds report tick metadata one decimal place too small.
      // The hybrid mode never permits that metadata to understate contract cash loss.
      gRiskChosenLossPerLot=MathMax(gRiskBrokerLossPerLot,gRiskContractLossPerLot);
      gRiskValueSource=(gRiskContractLossPerLot>=gRiskBrokerLossPerLot ? "HYBRID-CONTRACT" : "HYBRID-BROKER");
   }

   gRiskChosenLossPerLot*=MathMax(1.0,RiskCashSafetyFactor);
   return gRiskChosenLossPerLot;
}

int LotDigitsFromStep(double step)
{
   if(step>=1.0) return 0;
   if(step>=0.1) return 1;
   if(step>=0.01) return 2;
   if(step>=0.001) return 3;
   return 4;
}

double NormalizeLotDown(double rawLot)
{
   double minLot=MarketInfo(Symbol(),MODE_MINLOT);
   double brokerMaxLot=MarketInfo(Symbol(),MODE_MAXLOT);
   double step=MarketInfo(Symbol(),MODE_LOTSTEP);
   if(step<=0.0) step=0.01;
   if(rawLot<minLot-0.0000001) return 0.0;
   rawLot=MathMin(rawLot,brokerMaxLot);
   double lot=MathFloor(rawLot/step+0.0000001)*step;
   if(lot<minLot-0.0000001) return 0.0;
   return NormalizeDouble(lot,LotDigitsFromStep(step));
}

bool ProtectiveStructureAnchor(int dir,double &anchor)
{
   anchor=0.0;
   int available=iBars(Symbol(),SignalTF)-2;
   int count=MathMin(StopLossLookbackBars,available);
   if(count<10) return false;

   int shift=(dir==DIR_BUY ?
              iLowest(Symbol(),SignalTF,MODE_LOW,count,1) :
              iHighest(Symbol(),SignalTF,MODE_HIGH,count,1));
   if(shift<0) return false;

   anchor=(dir==DIR_BUY ?
           iLow(Symbol(),SignalTF,shift) :
           iHigh(Symbol(),SignalTF,shift));
   return anchor>0.0;
}

double SelectedStopPrice(int dir,double openPrice)
{
   // v6.08 direct input authority overrides every legacy thesis-stop preset.
   if(DirectInputsOwnExecution) return HT6DirectInitialStopPrice(dir,openPrice);

   // ATR is mandatory minimum breathing room. A structural/station
   // invalidation may widen the stop, but it can never pull it closer.
   double minimumDistance=MathMax(MinimumStopDistancePointsValue*Point,
                                  MarketInfo(Symbol(),MODE_STOPLEVEL)*Point+Point);

   // An earned R-ladder add inherits the campaign's already-protected stop.
   // Do not widen it back to the original ATR breathing room and re-create risk.
   if(gMDRLadderEntryOverrideActive && gMDRLadderEntryStop>0.0)
   {
      double rs=gMDRLadderEntryStop, tick=TickSizePrice();
      if(tick>0.0){ if(dir==DIR_BUY) rs=MathFloor(rs/tick)*tick; else rs=MathCeil(rs/tick)*tick; }
      return NormalizeDouble(rs,Digits);
   }

   // v6.08 EINSTEIN FLOW: structure holds and continuation add-ons use the
   // exact opposite rail of the LL box as thesis invalidation. Do not widen or
   // replace it with legacy ATR/station geometry.
   if((gHT6StructureHoldOrderContext || gHT6ContinuationAddOrderContext) &&
      gPyrPendingPlan && gPyrPendingStop>0.0)
      return HT5RoundBrokerSafeStop(dir,openPrice,gPyrPendingStop);

   // v5.03 NAMED SETUP STOP AUTHORITY: once the thesis capsule has selected
   // its invalidation, the generic ATR stop may not overwrite it. Broker minimum
   // distance and tick alignment remain mandatory.
   if(gHT5SetupEntryContext && gHT5ActiveSetupSource!=PYR_SOURCE_NONE && gHT5SetupEntryStop>0.0)
   {
      return HT5RoundBrokerSafeStop(dir,openPrice,gHT5SetupEntryStop);
   }

   // v3.17 ENTRY RECOVERY: the FVG seed's planned invalidation is the
   // actual risk geometry. Do NOT silently widen it back to the ordinary 3x ATR
   // stop, which can push a small-account raw lot below the broker minimum and
   // also break the seed's 1R target relationship. Broker stop-level distance
   // remains mandatory.
   if(gMDFVGSeedOrderContext && gPyrPendingPlan && gPyrPendingStop>0.0)
   {
      double fs=gPyrPendingStop;
      double brokerMin=MarketInfo(Symbol(),MODE_STOPLEVEL)*Point+Point;
      if(dir==DIR_BUY) fs=MathMin(fs,openPrice-brokerMin);
      else fs=MathMax(fs,openPrice+brokerMin);
      double tick=TickSizePrice();
      if(tick>0.0){ if(dir==DIR_BUY) fs=MathFloor(fs/tick)*tick; else fs=MathCeil(fs/tick)*tick; }
      return NormalizeDouble(fs,Digits);
   }

   // Sequence fallback geometry is an actual thesis, not a suggestion.
   if(gHT6SequencePlanContext && gPyrPendingPlan && gPyrPendingStop>0.0)
      return HT5RoundBrokerSafeStop(dir,openPrice,gPyrPendingStop);

   double atr=HTProtectiveStopATR();
   double distance=(atr>0.0 ? atr*StopATRMultiplierValue : minimumDistance);
   distance=MathMax(minimumDistance,distance);

   double atrStop=(dir==DIR_BUY ? openPrice-distance : openPrice+distance);
   double stop=atrStop;
   // Legacy/non-tribunal entries still obey the selected stop philosophy. The
   // structural anchor can only widen beyond the existing invalidation, never
   // tighten risk inside it.
   double structureAnchor=0.0;
   bool haveStructure=ProtectiveStructureAnchor(dir,structureAnchor);
   if(haveStructure && HowShouldTheCreaturePlaceItsStopLoss>=STOP_LOSS_BEYOND_LAST_STRUCTURE_SWING)
   {
      double sb=MathMax(Point,atr*MathMax(0.03,gHT5StopBaseBufferATR));
      double structureStop=structureAnchor-dir*sb;
      stop=(dir==DIR_BUY?MathMin(stop,structureStop):MathMax(stop,structureStop));
   }
   if(UsePyramidDLSauce && gPyrPendingPlan && gPyrPendingStop>0.0)
   {
      if(dir==DIR_BUY) stop=MathMin(stop,gPyrPendingStop);
      else stop=MathMax(stop,gPyrPendingStop);
   }
   double tick=TickSizePrice();

   if(tick>0.0)
   {
      if(dir==DIR_BUY) stop=MathFloor(stop/tick)*tick;
      else stop=MathCeil(stop/tick)*tick;
   }

   return NormalizeDouble(stop,Digits);
}

double SelectedTakeProfitPrice(int dir,double openPrice,double stopPrice)
{
   // v6.08 direct input authority attaches a broker TP to every trade.
   if(DirectInputsOwnExecution) return HT6DirectTakeProfitPrice(dir,openPrice,stopPrice);

   // v6.05: primary structure holds have NO TP. Continuation add-ons also have
   // no individual TP; their normal profit exit is the compound collector.
   if(gHT6StructureHoldOrderContext || gHT6ContinuationAddOrderContext) return 0.0;

   // Partial-station and percentage modes use a virtual station so MT4 cannot
   // close the full campaign before the EA performs the selected partial grab.
   if(UsePyramidDLSauce &&
      (ProfitGrabMode==PROFIT_STATION_PARTIAL_PLUS_PERCENT ||
       ProfitGrabMode==PROFIT_STATION_PARTIAL_ONLY ||
       ProfitGrabMode==PROFIT_PERCENT_FULL_CLOSE))
      return 0.0;
   if(UsePyramidDLSauce && gPyrPendingPlan && gPyrPendingTarget>0.0)
      return NormalizeDouble(gPyrPendingTarget,Digits);
   if(TakeProfitSLRatioValue<=0.0 || stopPrice<=0.0) return 0.0;

   double stopDistance=MathAbs(openPrice-stopPrice);
   if(stopDistance<=0.0) return 0.0;

   // Preserve the selected R multiple. If the broker's minimum target distance
   // is larger, use the minimum valid distance rather than sending an invalid TP.
   double brokerMinimum=MarketInfo(Symbol(),MODE_STOPLEVEL)*Point+Point;
   double targetDistance=MathMax(stopDistance*TakeProfitSLRatioValue,brokerMinimum);
   double target=(dir==DIR_BUY ? openPrice+targetDistance : openPrice-targetDistance);
   double tick=TickSizePrice();
   if(tick>0.0)
   {
      if(dir==DIR_BUY) target=MathCeil(target/tick)*tick;
      else target=MathFloor(target/tick)*tick;
   }
   return NormalizeDouble(target,Digits);
}

double OrderRiskMoneyFromPrices(double openPrice,double stopPrice,double lots)
{
   return CashLossPerLot(openPrice,stopPrice)*lots;
}

double OpenCampaignRiskMoney()
{
   // v5.04: a ticket with stop-breathing authority consumes risk at its PRE-BUDGETED
   // hard reserve until earned protection has moved the stop forward beyond the
   // original soft stop. This prevents hidden risk from being reused by new cars.
   double risk=0.0;
   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;
      int t=OrderType(); if(t!=OP_BUY && t!=OP_SELL) continue;
      int ticket=OrderTicket();
      double riskStop=OrderStopLoss(); if(riskStop<=0.0) riskStop=SovStoredStop(ticket);
      if(riskStop<=0.0) return AccountRiskBase()*100.0;
      string hk=HT5HardStopKey(ticket),sk=HT5SoftStopKey(ticket);
      if(GlobalVariableCheck(hk) && GlobalVariableCheck(sk))
      {
         double hard=GlobalVariableGet(hk),soft0=GlobalVariableGet(sk);
         bool forwardEarned=(t==OP_BUY?riskStop>soft0+Point:riskStop<soft0-Point);
         if(!forwardEarned && hard>0.0) riskStop=hard;
      }
      bool lossSide=(t==OP_BUY ? riskStop<OrderOpenPrice()-Point*0.5 : riskStop>OrderOpenPrice()+Point*0.5);
      if(lossSide) risk+=OrderRiskMoneyFromPrices(OrderOpenPrice(),riskStop,OrderLots());
   }
   return MathMax(0.0,risk);
}

double CalculateRiskLot(double openPrice,double stopPrice,double riskFraction,bool enforceCampaignCap,bool logReason)
{
   if(H620Enabled()) return H620RiskLot(openPrice,stopPrice,riskFraction);
   // Sovereign Yoke can distribute the campaign cap across the rapid-fire team.
   double accountBase=AccountRiskBase();
   bool directEinstein=(DirectInputsOwnExecution && HT6EinsteinEnabled() &&
                        (gHT6StructureHoldOrderContext || gHT6ContinuationAddOrderContext));
   double maxFraction=(directEinstein ?
      MathMax(1.0,MathMax(0.01,DirectMaximumSingleTradeRiskPercent)/MathMax(0.01,SovereignOxRiskPercent())) : 1.0);
   double safeFraction=MathMax(0.0,MathMin(maxFraction,riskFraction));
   double requestedRiskPercent=SovereignOxRiskPercent()*safeFraction;
   if(directEinstein) requestedRiskPercent=MathMin(MathMax(0.01,DirectMaximumSingleTradeRiskPercent),requestedRiskPercent);
   double requestedRiskMoney=accountBase*requestedRiskPercent/100.0;
   double lossPerLot=CashLossPerLot(openPrice,stopPrice);
   if(accountBase<=0.0 || requestedRiskMoney<=0.0 || lossPerLot<=0.0)
   {
      if(logReason) Print("HT percentage sizing blocked: invalid account base, SL, risk fraction, or cash-value data");
      return 0.0;
   }

   if(enforceCampaignCap)
   {
      double campaignRiskCap=accountBase*MaximumCampaignRiskPercent/100.0;
      double openRisk=OpenCampaignRiskMoney();
      if(openRisk+requestedRiskMoney>campaignRiskCap+0.01)
      {
         if(logReason)
            Print("HT exact percentage order blocked by campaign cap. requestedRisk=",
                  DoubleToString(requestedRiskMoney,2)," openRisk=",
                  DoubleToString(openRisk,2)," cap=",DoubleToString(campaignRiskCap,2));
         return 0.0;
      }
   }

   double rawLot=requestedRiskMoney/lossPerLot;
   double lot=NormalizeLotDown(rawLot);
   if(lot<=0.0)
   {
      double minLot=MarketInfo(Symbol(),MODE_MINLOT);
      double minRisk=lossPerLot*minLot;
      double minRiskPercent=(accountBase>0.0 ? minRisk/accountBase*100.0 : 999.0);
      double microCap=MathMax(0.01,MathMin(5.0,MicroMaximumActualRiskPercent));
      double microCampaignCap=accountBase*MathMax(MaximumCampaignRiskPercent,microCap)/100.0;
      if(MicroAllowBrokerMinimumLot && AccountBalance()<=MathMax(1.0,MicroAccountThreshold) &&
         minLot>0.0 && minRiskPercent<=microCap+0.0001 &&
         (!enforceCampaignCap || OpenCampaignRiskMoney()+minRisk<=microCampaignCap+0.01))
      {
         gMicroRiskReceipt="MICRO MIN LOT "+DoubleToString(minLot,2)+
                           " = "+DoubleToString(minRiskPercent,2)+"% ACTUAL RISK";
         if(logReason) Print("HT MICRO AUTHORIZED | ",gMicroRiskReceipt);
         return NormalizeDouble(minLot,LotDigitsFromStep(MarketInfo(Symbol(),MODE_LOTSTEP)));
      }
      gMicroRiskReceipt="MICRO BLOCK: MIN LOT RISKS "+DoubleToString(minRiskPercent,2)+"%";
      if(logReason)
         Print("HT exact percentage lot is below broker minimum or invalid. selectedRisk=",
               DoubleToString(RiskPerEntryPercent,0),
               "% riskMoney=",
               DoubleToString(requestedRiskMoney,2),
               " rawLot=",
               DoubleToString(rawLot,4)," | ",gMicroRiskReceipt);
               
      return 0.0;
   }

   // Lot-step rounding is downward only, so actual SL risk never exceeds the
   // selected percentage. The EA never promotes the lot to the broker minimum.
   
   double actualRisk=lossPerLot*lot;
   if(actualRisk>requestedRiskMoney+0.01)
   {
      if(logReason) 
      {
         Print("HT RISK BLOCK | BALANCE=$", 
               DoubleToString(AccountBalance(),2),
               "Equity=", 
               DoubleToString(AccountEquity(),2),
               "SelectedRisk=", 
               DoubleToString(RiskPerEntryPercent,1),  
               "%",
               "RiskBudget=$", 
               DoubleToString(requestedRiskMoney,2),
               "  | LossPerLot=$",
               DoubleToString(lossPerLot,2),
               "RawLot=", 
               DoubleToString(rawLot,4),
               "FinalLot=", 
               DoubleToString(lot,2),
               "ActualRisk=$", 
               DoubleToString(actualRisk,2),
               "AcutalRisk%=", 
               DoubleToString((actualRisk/accountBase)*100.0,2), 
               "%");
     }
      return 0.0;
   }
   if(logReason)
      Print("HT RISK VALIDATED | source=",gRiskValueSource,
            " brokerLossPerLot=$",DoubleToString(gRiskBrokerLossPerLot,2),
            " contractLossPerLot=$",DoubleToString(gRiskContractLossPerLot,2),
            " chosenLossPerLot=$",DoubleToString(lossPerLot,2),
            " riskFraction=",DoubleToString(safeFraction,2),
            " budget=$",DoubleToString(requestedRiskMoney,2),
            " finalLot=",DoubleToString(lot,LotDigitsFromStep(MarketInfo(Symbol(),MODE_LOTSTEP))),
            " validatedSLRisk=$",DoubleToString(actualRisk,2));
   return lot;
}

double PreviewRiskLot(int dir,double riskFraction)
{
   RefreshRates();
   double price=(dir==DIR_BUY ? Ask : Bid);
   double stop=SelectedStopPrice(dir,price);
   return CalculateRiskLot(price,stop,riskFraction,true,false);
}

double PreviewStopDistancePoints(int dir)
{
   RefreshRates();
   double price=(dir==DIR_BUY ? Ask : Bid);
   double stop=SelectedStopPrice(dir,price);
   return MathAbs(price-stop)/Point;
}

bool SignalTimeIsFresh(datetime signalTime)
{
   if(signalTime<=0) return false;
   int maxAgeSeconds=MathMax(1,EntrySignalExpiryBars)*PeriodSeconds(SignalTF);
   return signalTime>=TimeCurrent()-maxAgeSeconds;
}


//---------------------------------------------------------
// FVG: completed candle 1 leaves a gap from completed candle 3.
bool EMAAllows(int dir)
{
   if(!RequireEMAAlignment) return true;
   double f=iMA(Symbol(),SignalTF,FastEMA,0,MODE_EMA,PRICE_CLOSE,1);
   double s=iMA(Symbol(),SignalTF,SlowEMA,0,MODE_EMA,PRICE_CLOSE,1);
   return dir==DIR_BUY ? f>s : f<s;
}

bool IchimokuAllows(int dir)
{
   if(IchimokuTrendFilter==ICHIMOKU_FILTER_OFF) return true;
   if(iBars(Symbol(),SignalTF)<IchimokuSpanBPeriod+IchimokuKijunPeriod+10) return false;

   int shift=1; // Use the last completed candle to avoid intrabar filter flicker.
   int cloudShift=shift+IchimokuKijunPeriod; // Align the forward-shifted cloud with this candle.
   double closePrice=iClose(Symbol(),SignalTF,shift);
   double spanA=iIchimoku(Symbol(),SignalTF,IchimokuTenkanPeriod,IchimokuKijunPeriod,
                         IchimokuSpanBPeriod,MODE_SENKOUSPANA,cloudShift);
   double spanB=iIchimoku(Symbol(),SignalTF,IchimokuTenkanPeriod,IchimokuKijunPeriod,
                         IchimokuSpanBPeriod,MODE_SENKOUSPANB,cloudShift);
   if(spanA==EMPTY_VALUE || spanB==EMPTY_VALUE || spanA<=0.0 || spanB<=0.0) return false;

   double cloudTop=MathMax(spanA,spanB);
   double cloudBottom=MathMin(spanA,spanB);
   bool pricePass=(dir==DIR_BUY ? closePrice>cloudTop : closePrice<cloudBottom);
   if(!pricePass) return false;
   if(IchimokuTrendFilter==ICHIMOKU_PRICE_OUTSIDE_CLOUD) return true;

   double tenkan=iIchimoku(Symbol(),SignalTF,IchimokuTenkanPeriod,IchimokuKijunPeriod,
                          IchimokuSpanBPeriod,MODE_TENKANSEN,shift);
   double kijun=iIchimoku(Symbol(),SignalTF,IchimokuTenkanPeriod,IchimokuKijunPeriod,
                         IchimokuSpanBPeriod,MODE_KIJUNSEN,shift);
   bool linePass=(dir==DIR_BUY ? tenkan>kijun : tenkan<kijun);
   bool cloudPass=(dir==DIR_BUY ? spanA>spanB : spanA<spanB);
   return linePass && cloudPass;
}

bool ZeroDegreeBreakSignal(int dir)
{
   if(EarlyEntryControl!=EARLY_ENTRY_ZERO_DEGREE_BREAK || !gLiveWeightReady) return false;

   // The red WEIGHT arrow starts at the triangle midpoint. Its slope is
   // positive above gMid and negative below gMid, so a zero-degree break is
   // represented by the normalized weight crossing zero.
   if(dir==DIR_BUY) return gPreviousLiveWeight<=0.0 && gWeight>0.0;
   return gPreviousLiveWeight>=0.0 && gWeight<0.0;
}

bool FindFVG(int dir,double &top,double &bottom,datetime &when)
{
   int bars=MathMin(FVGScanBars,iBars(Symbol(),SignalTF)-4);
   for(int n=1;n<=bars;n++)
   {
      int old=n+2;
      if(dir==DIR_BUY)
      {
         double newerLow=iLow(Symbol(),SignalTF,n);
         double olderHigh=iHigh(Symbol(),SignalTF,old);
         if(newerLow>olderHigh && (newerLow-olderHigh)/Point>=MinimumFVGPoints)
         {
            top=newerLow; bottom=olderHigh; when=iTime(Symbol(),SignalTF,n);
            return true;
         }
      }
      else
      {
         double newerHigh=iHigh(Symbol(),SignalTF,n);
         double olderLow=iLow(Symbol(),SignalTF,old);
         if(newerHigh<olderLow && (olderLow-newerHigh)/Point>=MinimumFVGPoints)
         {
            top=olderLow; bottom=newerHigh; when=iTime(Symbol(),SignalTF,n);
            return true;
         }
      }
   }
   return false;
}

bool TouchesFVG(int dir,double top,double bottom)
{
   double p=MidPrice(),tol=FVGTouchTolerancePoints*Point;
   double trigger=EnterAtFVGHalf?(top+bottom)*0.5:(dir==DIR_BUY?top:bottom);
   if(dir==DIR_BUY) return p<=trigger+tol && p>=bottom-tol;
   return p>=trigger-tol && p<=top+tol;
}


bool FVGRejectionPasses(int dir,double top,double bottom)
{
   if(!RequireFVGRejectionCandle) return true;

   double o=iOpen(Symbol(),SignalTF,1);
   double c=iClose(Symbol(),SignalTF,1);
   double h=iHigh(Symbol(),SignalTF,1);
   double l=iLow(Symbol(),SignalTF,1);
   double range=MathMax(h-l,Point);
   double closeLocation=(c-l)/range;
   double midpoint=(top+bottom)*0.5;

   if(dir==DIR_BUY)
      return c>o && c>=midpoint && closeLocation>=RejectionCloseLocation;

   return c<o && c<=midpoint &&
          closeLocation<=(1.0-RejectionCloseLocation);
}

double DirectionalAngle(int dir)
{
   return dir==DIR_BUY ? gAngle : -gAngle;
}

double DirectionalWeight(int dir)
{
   return dir==DIR_BUY ? gWeight : -gWeight;
}

double DirectionalAngleVelocity(int dir)
{
   return dir==DIR_BUY ? gAngleVelocity : -gAngleVelocity;
}

double DirectionalAngleAcceleration(int dir)
{
   return dir==DIR_BUY ? gAngleAcceleration : -gAngleAcceleration;
}

bool TriangleMovementEntryPasses(int dir)
{
   if(!RequireTriangleMovementEntry) return true;
   if(gHigh<=gLow) return false;

   double a=DirectionalAngle(dir);
   double w=DirectionalWeight(dir);
   double v=DirectionalAngleVelocity(dir);
   double accel=DirectionalAngleAcceleration(dir);

   if(a<EntryAngleDegrees) return false;
   if(w<EntryMinimumDirectionalWeight ||
      w>EntryMaximumDirectionalWeight) return false;
   if(v<EntryMinimumAngleVelocity) return false;
   if(RequirePositiveEntryAcceleration && accel<=0.0) return false;

   return true;
}

bool ConfirmEntryMovement(int dir,datetime fvgTime)
{
   int needed=MathMax(1,EntryConfirmTicks);
   if(gEntryCandidateDirection!=dir || gEntryCandidateFVGTime!=fvgTime)
   {
      gEntryCandidateDirection=dir;
      gEntryCandidateFVGTime=fvgTime;
      gEntryCandidateTicks=1;
      return (needed<=1);
   }

   gEntryCandidateTicks++;
   return gEntryCandidateTicks>=needed;
}

void ResetEntryMovement()
{
   gEntryCandidateDirection=DIR_FLAT;
   gEntryCandidateTicks=0;
   gEntryCandidateFVGTime=0;
}


bool FindTradableFVG(int dir,double &top,double &bottom,datetime &when)
{
   int bars=MathMin(FVGScanBars,iBars(Symbol(),SignalTF)-4);
   for(int n=1;n<=bars;n++)
   {
      int old=n+2;
      double t=0,b=0;
      bool gap=false;
      if(dir==DIR_BUY)
      {
         double newerLow=iLow(Symbol(),SignalTF,n);
         double olderHigh=iHigh(Symbol(),SignalTF,old);
         if(newerLow>olderHigh && (newerLow-olderHigh)/Point>=MinimumFVGPoints)
         { t=newerLow; b=olderHigh; gap=true; }
      }
      else
      {
         double newerHigh=iHigh(Symbol(),SignalTF,n);
         double olderLow=iLow(Symbol(),SignalTF,old);
         if(newerHigh<olderLow && (olderLow-newerHigh)/Point>=MinimumFVGPoints)
         { t=olderLow; b=newerHigh; gap=true; }
      }
      if(!gap) continue;
      if(!TouchesFVG(dir,t,b)) continue;
      if(!FVGRejectionPasses(dir,t,b)) continue;
      top=t; bottom=b; when=iTime(Symbol(),SignalTF,n);
      return true;
   }
   return false;
}

bool OppositeRecentFVG()
{
   if(gDirection==DIR_FLAT) return false;
   double t,b; datetime when;
   if(!FindFVG(-gDirection,t,b,when)) return false;
   return when>=TimeCurrent()-PeriodSeconds(SignalTF)*MathMax(1,OppositeFVGRecentBars);
}

bool HightowerLaunchSignal(int dir)
{
   if(!AllowHightowerLaunchEntry) return false;
   int bars=MathMax(3,LaunchBreakoutLookback);
   double priorHigh=iHigh(Symbol(),SignalTF,2);
   double priorLow=iLow(Symbol(),SignalTF,2);
   for(int i=3;i<3+bars;i++)
   {
      priorHigh=MathMax(priorHigh,iHigh(Symbol(),SignalTF,i));
      priorLow=MathMin(priorLow,iLow(Symbol(),SignalTF,i));
   }
   double o=iOpen(Symbol(),SignalTF,1), c=iClose(Symbol(),SignalTF,1);
   double body=MathAbs(c-o)/Point;
   if(RequireLaunchCandleBody && body<MinimumLaunchBodyPoints) return false;
   double buffer=LaunchBreakBufferPoints*Point;
   if(dir==DIR_BUY) return c>priorHigh+buffer && c>o && EMAAllows(dir);
   return c<priorLow-buffer && c<o && EMAAllows(dir);
}

bool MomentumSignal(int dir)
{
   if(!AllowMomentumEntry || dir==DIR_FLAT) return false;
   HT5UpdateFormulaArrow();
   return (gHT5FormulaArrowDirection==dir && dir*gHT5FormulaArrowScore>=gHT5ArrowEnterThreshold);
}

int RawWeightArrowDirection()
{
   if(!gLiveWeightReady || gHigh<=gLow) return DIR_FLAT;
   HT5UpdateFormulaArrow();
   return gHT5FormulaArrowDirection;
}

void ResetArrowDirectionConfirmation()
{
   gRawArrowDirection=DIR_FLAT;
   gArrowCandidateDirection=DIR_FLAT;
   gArrowCandidateTicks=0;
   gConfirmedArrowDirection=DIR_FLAT;
}

void UpdateArrowDirectionConfirmation()
{
   HT5UpdateFormulaArrow();
   gRawArrowDirection=gHT5FormulaArrowDirection;
   gArrowCandidateDirection=gHT5FormulaArrowDirection;
   gArrowCandidateTicks=(int)MathRound(gHT5FormulaArrowConfidence*100.0);
   gConfirmedArrowDirection=gHT5FormulaArrowDirection;
}

int WeightArrowDirection()
{
   return gConfirmedArrowDirection;
}

double ArithmeticGridWeight(int index)
{
   return MathMax(0.0,1.0+MathMax(0,index)*ArithmeticSpacingStepValue);
}

double ArithmeticGridWeightSum(int entries)
{
   entries=MathMax(1,entries);
   double sum=0.0;
   for(int i=0;i<entries;i++) sum+=ArithmeticGridWeight(i);
   return MathMax(sum,1.0);
}

double ArrowArithmeticRiskFraction(int dir)
{
   // Every arrow order uses exactly the percentage selected in RiskPerTrade.
   return 1.0;
}

double ArithmeticGridThreshold(int openedEntries)
{
   // First entry is at 0% progress. Every later slot is placed strictly before
   // the first TP, so the final permitted add-on is not stranded at 100%.
   int spacingSlots=MathMax(1,SafeMaximumEntries);
   int completed=MathMax(0,MathMin(openedEntries,SafeMaximumEntries-1));
   if(completed<=0) return 0.0;

   double total=0.0,cumulative=0.0;
   for(int i=0;i<spacingSlots;i++)
   {
      double weight=ArithmeticGridWeight(i);
      total+=weight;
      if(i<completed) cumulative+=weight;
   }
   if(total<=0.0) return (double)completed/(double)spacingSlots;
   return MathMin(0.999999,cumulative/total);
}

bool ProjectedMarginMetrics(int type,double lot,double &freeAfter,double &marginLevelAfter,double &freeReservePercent)
{
   freeAfter=0.0; marginLevelAfter=0.0; freeReservePercent=0.0;
   if(lot<=0.0) return false;

   ResetLastError();
   freeAfter=AccountFreeMarginCheck(Symbol(),type,lot);
   int err=GetLastError();
   if(freeAfter<=0.0 || err==134) return false;

   double equity=MathMax(0.0,AccountEquity());
   double additionalMargin=MathMax(0.0,AccountFreeMargin()-freeAfter);
   double projectedMargin=MathMax(0.0,AccountMargin()+additionalMargin);
   marginLevelAfter=(projectedMargin>0.0 ? equity/projectedMargin*100.0 : 999999.0);
   freeReservePercent=(equity>0.0 ? freeAfter/equity*100.0 : 0.0);
   return true;
}

bool MarginSafetyPasses(int type,double lot,bool recordMetrics)
{
   if(!UseMarginSafeGrid) return true;
   double freeAfter=0.0,levelAfter=0.0,reservePercent=0.0;
   bool valid=ProjectedMarginMetrics(type,lot,freeAfter,levelAfter,reservePercent);
   if(recordMetrics)
   {
      gLastProjectedMarginLevel=levelAfter;
      gLastProjectedFreeMarginPercent=reservePercent;
   }
   if(!valid) return false;
   return levelAfter>=MinimumProjectedMarginLevel &&
          reservePercent>=MinimumFreeMarginReservePercent;
}

double FitLotToMarginSafety(int type,double requestedLot)
{
   requestedLot=NormalizeLotDown(requestedLot);
   if(requestedLot<=0.0) return 0.0;
   if(!UseMarginSafeGrid) return requestedLot;

   // Percentage authority rule: margin safety may block the exact order, but it
   // may never reduce the lot and thereby substitute a different percentage.
   if(MarginSafetyPasses(type,requestedLot,true)) return requestedLot;
   return 0.0;
}

int ArrowSequenceFromComment(string comment,int dir)
{
   string marker=TradeComment+"_"+(dir==DIR_BUY?"ARROW_BUY_":"ARROW_SELL_");
   int pos=StringFind(comment,marker,0);
   if(pos<0) return 0;
   return (int)StringToInteger(StringSubstr(comment,pos+StringLen(marker)));
}

int HighestArrowSequenceSince(int dir,datetime sinceTime)
{
   int highest=0;
   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;
      if(dir==DIR_BUY && OrderType()!=OP_BUY) continue;
      if(dir==DIR_SELL && OrderType()!=OP_SELL) continue;
      if(sinceTime>0 && OrderOpenTime()<sinceTime) continue;
      highest=(int)MathMax(highest,ArrowSequenceFromComment(OrderComment(),dir));
   }
   for(int h=OrdersHistoryTotal()-1;h>=0;h--)
   {
      if(!OrderSelect(h,SELECT_BY_POS,MODE_HISTORY) || !OurOrder()) continue;
      if(dir==DIR_BUY && OrderType()!=OP_BUY) continue;
      if(dir==DIR_SELL && OrderType()!=OP_SELL) continue;
      if(sinceTime>0 && OrderOpenTime()<sinceTime) continue;
      highest=(int)MathMax(highest,ArrowSequenceFromComment(OrderComment(),dir));
   }
   return highest;
}

int HighestOpenArrowSequence(int dir)
{
   return HighestArrowSequenceSince(dir,gArrowCampaignStartTime);
}

bool ClosedAtProtectiveStop()
{
   if(OrderStopLoss()<=0.0 || OrderCloseTime()<=0) return false;
   double tolerance=MathMax(TickSizePrice()*2.0,Point*3.0);
   return MathAbs(OrderClosePrice()-OrderStopLoss())<=tolerance;
}

void RefreshArrowCampaignHistoryState()
{
   if(gArrowCampaignDirection==DIR_FLAT || gArrowCampaignStartTime<=0) return;
   int highest=HighestArrowSequenceSince(gArrowCampaignDirection,gArrowCampaignStartTime);
   if(highest>gArrowSequenceIndex) gArrowSequenceIndex=highest;

   if(!StopGridAfterFirstAddonSL || gGridStoppedAfterSL) return;
   for(int h=OrdersHistoryTotal()-1;h>=0;h--)
   {
      if(!OrderSelect(h,SELECT_BY_POS,MODE_HISTORY) || !OurOrder()) continue;
      if(OrderOpenTime()<gArrowCampaignStartTime) continue;
      if(gArrowCampaignDirection==DIR_BUY && OrderType()!=OP_BUY) continue;
      if(gArrowCampaignDirection==DIR_SELL && OrderType()!=OP_SELL) continue;
      int sequence=ArrowSequenceFromComment(OrderComment(),gArrowCampaignDirection);
      if(sequence<2) continue;
      if(ClosedAtProtectiveStop())
      {
         gGridStoppedAfterSL=true;
         gSafetyBlockReason="GRID FROZEN AFTER ADD-ON SL #"+IntegerToString(sequence);
         Print("HT grid additions frozen: arrow add-on #",sequence," closed at SL");
         return;
      }
   }
}

bool RebuildArrowCampaignGrid(int dir)
{
   // Preserve the original campaign entry-to-TP route while the EA remains
   // attached. Rebuilding from open orders is only a restart/recovery fallback.
   if(gArrowCampaignDirection==dir && gArrowCampaignAnchorPrice>0.0 &&
      gArrowCampaignTargetPrice>0.0)
   {
      RefreshArrowCampaignHistoryState();
      int highest=HighestArrowSequenceSince(dir,gArrowCampaignStartTime);
      gArrowSequenceIndex=MathMax(gArrowSequenceIndex,highest);
      return true;
   }

   datetime firstTime=0;
   double anchor=0.0,target=0.0;
   int count=0;
   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;
      if(dir==DIR_BUY && OrderType()!=OP_BUY) continue;
      if(dir==DIR_SELL && OrderType()!=OP_SELL) continue;
      count++;
      if(firstTime==0 || OrderOpenTime()<firstTime)
      {
         firstTime=OrderOpenTime();
         anchor=OrderOpenPrice();
         target=OrderTakeProfit();
      }
   }
   if(count<=0 || anchor<=0.0) return false;

   if(target<=0.0)
   {
      double stop=SelectedStopPrice(dir,anchor);
      target=SelectedTakeProfitPrice(dir,anchor,stop);
   }
   if(target<=0.0) return false;

   gArrowCampaignDirection=dir;
   gArrowCampaignAnchorPrice=anchor;
   gArrowCampaignTargetPrice=target;
   gArrowCampaignStartTime=firstTime;
   int highest=HighestArrowSequenceSince(dir,gArrowCampaignStartTime);
   gArrowSequenceIndex=MathMax(gArrowSequenceIndex,MathMax(count,highest));
   RefreshArrowCampaignHistoryState();
   return true;
}

void ResetArrowCampaignGrid()
{
   gArrowSequenceIndex=0;
   gArrowCampaignDirection=DIR_FLAT;
   gArrowCampaignAnchorPrice=0.0;
   gArrowCampaignTargetPrice=0.0;
   gArrowCampaignStartTime=0;
   gGridStoppedAfterSL=false;
   gSafetyBlockReason="";
}

double ArrowGridProgress(int dir)
{
   if(gArrowCampaignDirection!=dir || gArrowCampaignAnchorPrice<=0.0 ||
      gArrowCampaignTargetPrice<=0.0) return 0.0;
   double path=MathAbs(gArrowCampaignTargetPrice-gArrowCampaignAnchorPrice);
   if(path<=Point) return 0.0;
   RefreshRates();
   double exitPrice=(dir==DIR_BUY ? Bid : Ask);
   double favorable=(dir==DIR_BUY ? exitPrice-gArrowCampaignAnchorPrice :
                                   gArrowCampaignAnchorPrice-exitPrice);
   return favorable/path;
}

bool ArrowGridAllowsNextEntry(int dir)
{
   RefreshArrowCampaignHistoryState();
   if(gGridStoppedAfterSL)
   {
      if(gSafetyBlockReason=="") gSafetyBlockReason="GRID FROZEN AFTER ADD-ON SL";
      return false;
   }
   int sameDirection=TradeCountByDirection(dir);
   if(sameDirection<=0) return true;
   if(sameDirection>=SafeMaximumEntries || gArrowSequenceIndex>=SafeMaximumEntries)
   {
      gSafetyBlockReason="MAX GRID ENTRIES";
      return false;
   }
   if(!SovYokeAllowsNextOx(dir))
   {
      gSafetyBlockReason=gSovLastAction;
      return false;
   }
   if(!RebuildArrowCampaignGrid(dir))
   {
      gSafetyBlockReason="GRID ANCHOR UNAVAILABLE";
      return false;
   }
   double progress=ArrowGridProgress(dir);
   double nextThreshold=ArithmeticGridThreshold(gArrowSequenceIndex);
   if(progress>=1.0)
   {
      gSafetyBlockReason="FIRST TARGET REACHED";
      return false;
   }
   if(progress+0.0000001<nextThreshold)
   {
      gSafetyBlockReason="WAIT GRID "+DoubleToString(nextThreshold*100.0,1)+"%";
      return false;
   }
   return true;
}

double PreviewArrowRiskLot(int dir)
{
   RefreshRates();
   double price=(dir==DIR_BUY ? Ask : Bid);
   double stop=SelectedStopPrice(dir,price);
   return CalculateRiskLot(price,stop,1.0,true,false);
}

//---------------------------------------------------------
// Geometry
bool UpdateStructure()
{
   int count=MathMin(StructureLookbackBars,iBars(Symbol(),SignalTF)-2);
   if(count<10) return false;
   int hs=iHighest(Symbol(),SignalTF,MODE_HIGH,count,1);
   int ls=iLowest(Symbol(),SignalTF,MODE_LOW,count,1);
   if(hs<0 || ls<0) return false;
   double h=iHigh(Symbol(),SignalTF,hs),l=iLow(Symbol(),SignalTF,ls);
   if(h<=l) return false;
   // Every-tick arrow mode needs the midpoint even during quiet ranges.
   // The legacy setup engine may still require its preset minimum range.
   if(ArrowEntryControl==ARROW_ENTRY_OFF_USE_SETUPS &&
      (h-l)/Point<MinimumStructureRangePoints) return false;
   gHigh=h; gLow=l; gMid=(h+l)*0.5;
   gHighTime=iTime(Symbol(),SignalTF,hs);
   gLowTime=iTime(Symbol(),SignalTF,ls);
   return true;
}

void CalculateGeometry()
{
   double previousLiveWeight=gWeight;
   bool hadLiveWeight=gLiveWeightReady;

   gPrice=MidPrice();
   double half=MathMax((gHigh-gLow)*0.5,Point);
   gWeight=(gPrice-gMid)/half;

   int sample=MathMax(1,AngleSampleBars);
   double oldNow=iClose(Symbol(),SignalTF,sample);
   double oldPrev=iClose(Symbol(),SignalTF,sample+1);
   double closePrev=iClose(Symbol(),SignalTF,1);
   double closePrev2=iClose(Symbol(),SignalTF,2);

   double newAngle=MathArctan((gPrice-oldNow)/half)*180.0/3.141592653589793;
   double priorAngle=MathArctan((closePrev-oldPrev)/half)*180.0/3.141592653589793;
   double priorPriorAngle=MathArctan((closePrev2-iClose(Symbol(),SignalTF,sample+2))/half)*180.0/3.141592653589793;

   double priorWeight=(closePrev-gMid)/half;
   gPreviousLiveWeight=(hadLiveWeight ? previousLiveWeight : priorWeight);
   gArrowSlope=gWeight-gPreviousLiveWeight;
   gLiveWeightReady=true;

   gPrevAngle=priorAngle;
   gAngle=newAngle;
   gAngleVelocity=newAngle-priorAngle;
   gAngleAcceleration=gAngleVelocity-(priorAngle-priorPriorAngle);
}

GeoMode ClassifyGeometry()
{
   if(gDirection==DIR_FLAT) return GEO_HOLD;
   double favorableAngle=(gDirection==DIR_BUY?gAngle:-gAngle);
   double favorableWeight=(gDirection==DIR_BUY?gWeight:-gWeight);
   if(favorableWeight>=ExtremeExtensionWeight) return GEO_EXHAUSTION;
   if(favorableWeight>=ExtensionWeight && favorableAngle>0) return GEO_EXHAUSTION;
   if(favorableAngle>=StrongLadderAngleDegrees) return GEO_STRONG_LADDER;
   if(favorableAngle>=LadderAngleDegrees) return GEO_LADDER;
   if(favorableAngle<=-StrongDrawdownAngleDegrees) return GEO_STRONG_DRAWDOWN;
   if(favorableAngle<=-DrawdownAngleDegrees) return GEO_DRAWDOWN;
   return GEO_HOLD;
}

void UpdateMode()
{
   GeoMode request=ClassifyGeometry();
   if(request!=gCandidate){ gCandidate=request; gCandidateTicks=1; return; }
   gCandidateTicks++;
   if(gCandidateTicks>=MathMax(1,ModeConfirmTicks)) gMode=request;
}

string ModeText()
{
   if(gMode==GEO_HOLD) return "HOLD";
   if(gMode==GEO_LADDER) return "LADDER";
   if(gMode==GEO_STRONG_LADDER) return "STRONG LADDER";
   if(gMode==GEO_DRAWDOWN) return "DRAWDOWN";
   if(gMode==GEO_STRONG_DRAWDOWN) return "STRONG DRAWDOWN";
   if(gMode==GEO_EXHAUSTION) return "EXHAUSTION";
   if(gMode==GEO_INVALID) return "INVALID";
   return "OFF";
}

void UpdateCampaignState()
{
   int n=TradeCount();
   if(n<=0){ gCampaignState=CS_FLAT; gDecision="SEARCH ENTRY"; return; }
   if(gMode==GEO_INVALID){ gCampaignState=CS_INVALID; gDecision="CLOSE INVALID"; return; }
   if(gMode==GEO_STRONG_LADDER){ gCampaignState=CS_STRONG_LADDER; gDecision="PRESS ADVANTAGE"; return; }
   if(gMode==GEO_LADDER){ gCampaignState=(n==1?CS_PROVING:CS_LADDER); gDecision="LADDER"; return; }
   if(gMode==GEO_EXHAUSTION){ gCampaignState=CS_EXHAUSTION; gDecision="FREEZE + WATCH HARVEST"; return; }
   if(gMode==GEO_STRONG_DRAWDOWN){ gCampaignState=CS_STRONG_DRAWDOWN; gDecision="DEFEND / INVALIDATE"; return; }
   if(gMode==GEO_DRAWDOWN){ gCampaignState=CS_DRAWDOWN; gDecision="CONTROLLED DEFENSE"; return; }
   gCampaignState=(n==1?CS_ANCHOR:CS_HOLD);
   gDecision="HOLD";
}

string CampaignStateText()
{
   if(gCampaignState==CS_FLAT) return "FLAT";
   if(gCampaignState==CS_ARMED) return "ARMED";
   if(gCampaignState==CS_ANCHOR) return "ANCHOR";
   if(gCampaignState==CS_PROVING) return "PROVING";
   if(gCampaignState==CS_LADDER) return "LADDER";
   if(gCampaignState==CS_STRONG_LADDER) return "STRONG LADDER";
   if(gCampaignState==CS_HOLD) return "HOLD";
   if(gCampaignState==CS_EXHAUSTION) return "EXHAUSTION";
   if(gCampaignState==CS_DRAWDOWN) return "DRAWDOWN";
   if(gCampaignState==CS_STRONG_DRAWDOWN) return "STRONG DRAWDOWN";
   if(gCampaignState==CS_INVALID) return "INVALID";
   return "FLIP ARMED";
}

//---------------------------------------------------------
bool SendOrder(int dir,double riskFraction,string action,bool enforceCampaignCap)
{
   if(gWisdoPaused || gWisdoEmergencyLatched || gWisdoDirectionMode==3)
   { gEntryStatus="WISDO PAUSED / MANAGE ONLY"; return false; }
   if(gWisdoDirectionMode==1 && dir!=DIR_BUY)
   { gEntryStatus="WISDO BUY ONLY"; return false; }
   if(gWisdoDirectionMode==2 && dir!=DIR_SELL)
   { gEntryStatus="WISDO SELL ONLY"; return false; }
   // Central failsafe: no entry path may bypass the selected broker-time start.
   if(!EntryStartTimeGatePasses(true)) return false;
   if(!IsTradeAllowed()){ gEntryStatus="AUTOTRADING NOT ALLOWED"; return false; }
   if(IsTradeContextBusy()){ gEntryStatus="TRADE CONTEXT BUSY"; return false; }
   if(DirectInputsOwnExecution && TradeCount()>=MathMax(1,DirectMaximumTotalOpenTrades))
   { gEntryStatus="DIRECT MAX OPEN TRADES REACHED"; return false; }

   int type=(dir==DIR_BUY ? OP_BUY : OP_SELL);
   RefreshRates();
   double price=(type==OP_BUY ? Ask : Bid);
   double stop=SelectedStopPrice(dir,price);
   if(H620Enabled() && gHT6StructureHoldOrderContext && h620Phase==1) stop=h620Rail;
   string h620Gate="";
   if(!H620EntryAllows(dir,price,stop,h620Gate)) {gEntryStatus="H620 "+h620Gate;return false;}
   double takeProfit=SelectedTakeProfitPrice(dir,price,stop);
   if(H620Enabled() && gHT6StructureHoldOrderContext) takeProfit=0.0;
   if(!DirectInputsOwnExecution && (gHT6StructureHoldOrderContext || gHT6ContinuationAddOrderContext)) takeProfit=0.0;
   bool sonicRSeed=(MarketDNASonicRLadder && !gMDRLadderEntryOverrideActive && TradeCount()==0 && gPyrSignalSource==PYR_SOURCE_TRIGGER_RAIL_BREAK);
   if(sonicRSeed && stop>0.0)
   {
      double actualR=MathAbs(price-stop);
      if(actualR>Point) takeProfit=NormalizeDouble(price+dir*actualR*MathMax(0.10,MarketDNARLadderTargetR),Digits);
   }
   double stopLevel=MarketInfo(Symbol(),MODE_STOPLEVEL)*Point;
   bool invalidStop=(dir==DIR_BUY && (stop<=0.0 || price-stop<stopLevel)) ||
                    (dir==DIR_SELL && (stop-price<stopLevel));
   if(invalidStop)
   {
      gEntryStatus="INVALID PROTECTIVE STOP";
      Print("HT order blocked: valid protective stop could not be placed");
      return false;
   }

   bool virtualPyramidTarget=(UsePyramidDLSauce && gPyrPendingPlan && gPyrPendingTarget>0.0 &&
                              (ProfitGrabMode==PROFIT_STATION_PARTIAL_PLUS_PERCENT ||
                               ProfitGrabMode==PROFIT_STATION_PARTIAL_ONLY ||
                               ProfitGrabMode==PROFIT_PERCENT_FULL_CLOSE));
   bool einsteinNoTP=((H620Enabled() && gHT6StructureHoldOrderContext) || (!DirectInputsOwnExecution && (gHT6StructureHoldOrderContext || gHT6ContinuationAddOrderContext)));
   bool invalidTarget=(!einsteinNoTP && !virtualPyramidTarget && TakeProfitSLRatioValue>0.0) &&
                      ((dir==DIR_BUY && (takeProfit<=price || takeProfit-price<stopLevel)) ||
                       (dir==DIR_SELL && (takeProfit>=price || price-takeProfit<stopLevel)));
   if(invalidTarget)
   {
      gEntryStatus="INVALID TAKE PROFIT";
      Print("HT order blocked: selected SL ratio produced an invalid take profit");
      return false;
   }

   double riskReserveStop=HT5ResolveHardReserveStop(dir,price,stop);
   string softSanity="",hardSanity="";
   if(!HT5StopSymbolSanityAllows(dir,price,price,stop,false,softSanity))
   {
      gEntryStatus="SOFT STOP SANITY BLOCK: "+softSanity;
      return false;
   }
   if(!HT5StopSymbolSanityAllows(dir,price,price,riskReserveStop,false,hardSanity))
   {
      gEntryStatus="HARD RESERVE SANITY BLOCK: "+hardSanity;
      return false;
   }
   double lot=CalculateRiskLot(price,riskReserveStop,riskFraction,enforceCampaignCap,true);
   if(lot<=0.0)
   {
      gEntryStatus="SELECTED PERCENTAGE CANNOT PRODUCE A VALID LOT";
      return false;
   }

   double requestedLot=lot;
   lot=FitLotToMarginSafety(type,lot);
   if(lot<=0.0)
   {
      gEntryStatus="SELECTED PERCENTAGE FAILS MARGIN SAFETY";
      gSafetyBlockReason="EXACT PERCENTAGE LOT FAILS PROJECTED MARGIN RESERVE";
      Print("HT margin safety blocked order. requestedLot=",DoubleToString(requestedLot,2),
            " minMarginLevel=",DoubleToString(MinimumProjectedMarginLevel,0),
            "% minFreeReserve=",DoubleToString(MinimumFreeMarginReservePercent,0),"%");
      return false;
   }
   // Exact per-trade compound TP after broker lot normalization.
   takeProfit=HT6DirectCompoundTakeProfitAfterLot(dir,price,stop,lot,takeProfit);
   if(H620Enabled()) takeProfit=H620Target(dir,price,stop,lot);
   if(DirectInputsOwnExecution && DirectEveryTradeHasTakeProfit && !(H620Enabled() && gHT6StructureHoldOrderContext))
   {
      bool badTP=(dir==DIR_BUY ? (takeProfit<=price+stopLevel) : (takeProfit>=price-stopLevel));
      if(badTP)
      {
         gEntryStatus="DIRECT TP INVALID AFTER LOT SIZING";
         return false;
      }
   }

   if(AccountFreeMarginCheck(Symbol(),type,lot)<=0.0)
   {
      gEntryStatus="INSUFFICIENT FREE MARGIN";
      Print("HT order blocked: insufficient free margin for requested lot ",DoubleToString(lot,2));
      return false;
   }

   double brokerStop=stop;
   if(BrokerLossPolicy==BROKER_REMOVE_SL_SOFTWARE_PROFIT_ONLY && !H620Enabled())
      brokerStop=0.0;

   ResetLastError();
   string brokerComment="";
   if(gHT6StructureHoldOrderContext)
   {
      int coreLeg=(gHT6Flow.structureEntryPending && gHT6Flow.pendingStructureLeg>0 ?
                   gHT6Flow.pendingStructureLeg:gHT6Flow.leg);
      brokerComment="HT6_CORE_"+(dir==DIR_BUY?"BUY":"SELL")+"_L"+IntegerToString(MathMax(1,coreLeg));
   }
   else if(gHT6ContinuationAddOrderContext)
      brokerComment="HT6_ADD_"+(dir==DIR_BUY?"BUY":"SELL")+"_L"+IntegerToString(MathMax(2,gHT6Flow.leg));
   else
      brokerComment=(gHT5SetupEntryContext && gHT5ActiveSetupSource!=PYR_SOURCE_NONE ?
                     "HT5_"+HT5SourceShortTag(gHT5ActiveSetupSource) : TradeComment+"_"+action);
   int ticket=HT5CommanderOrderSend(Symbol(),type,lot,price,SlippagePoints,brokerStop,takeProfit,
                        brokerComment,MagicNumber,0,
                        type==OP_BUY?clrDodgerBlue:clrTomato);
   int err=gHT5CommanderLastError;
   if(ticket<0)
   {
      if(err>0) gEntryStatus="ORDER ERROR "+IntegerToString(err)+" • "+gHT5CommanderLastMutation;
      else if(StringLen(gEntryStatus)<=0) gEntryStatus="COMMANDER BLOCK • "+gHT5CommanderLastMutation;
      Print("HIGHTOWER TRIANGLE OrderSend failed err=",err,
            " lot=",DoubleToString(lot,2)," price=",DoubleToString(price,Digits),
            " stop=",DoubleToString(stop,Digits)," stopPoints=",
            DoubleToString(MathAbs(price-stop)/Point,1),
            " tp=",DoubleToString(takeProfit,Digits),
            " tpRatio=",DoubleToString(TakeProfitSLRatioValue,1),
            " risk=",DoubleToString(OrderRiskMoneyFromPrices(price,stop,lot),2),
            " spread=",DoubleToString(SpreadPoints(),1),
            " freeMargin=",DoubleToString(AccountFreeMargin(),2));
      return false;
   }

   if(H620Enabled()) H620Register(ticket,dir,stop,H620NextRole());
   GlobalVariableSet(SovStopKey(ticket),stop);
   GlobalVariableSet(HT5HardStopKey(ticket),riskReserveStop);
   GlobalVariableSet(HT5SoftStopKey(ticket),stop);
   GlobalVariableSet(HT5RiskReserveKey(ticket),OrderRiskMoneyFromPrices(price,riskReserveStop,lot));
   int telemetrySource=(gHT5SetupEntryContext && gHT5ActiveSetupSource!=PYR_SOURCE_NONE?
                        gHT5ActiveSetupSource:(int)gPyrSignalSource);
   HT5TelemetryInitTicket(ticket,dir,price,stop,riskReserveStop,telemetrySource);

   gEntryStatus=(dir==DIR_BUY?"BUY":"SELL")+" ORDER OPENED #"+IntegerToString(ticket)+
                " | "+DoubleToString(lot,2)+" LOT | SL "+DoubleToString(stop,Digits)+
                " | TP "+DoubleToString(takeProfit,Digits);
   gLastOpenedPrice=price;
   gLastOpenedTakeProfit=takeProfit;
   bool first=(TradeCount()==1);
   gLastAdd=TimeCurrent();
   if(first)
   {
      gCampaignStart=TimeCurrent();
      gPeakProfit=0;
   }
   return true;
}

bool CloseAllInternal(string reason,bool overrideStrictHold)
{
   bool sovereignActive=(SovereignCloseMode!=SOV_CLOSE_NORMAL);

   if(NeverSoftwareCloseNegativeCampaign && BasketProfit()<0.0 &&
      !UnifiedAuthorizedNegativeCloseOverride(reason))
   {
      gSovLastAction="NEGATIVE CAMPAIGN HELD - BROKER SL OWNS | "+reason;
      Print("HT UNITY HYBRID negative software close blocked. basket=",
            DoubleToString(BasketProfit(),2)," reason=",reason);
      return false;
   }

   if(HoldUntilBrokerStopOrTarget &&
      !overrideStrictHold &&
      !sovereignActive &&
      TradeCount()>0)
   {
      static datetime lastBlockedLog=0;
      static string lastBlockedReason="";
      if(reason!=lastBlockedReason || TimeCurrent()-lastBlockedLog>=60)
      {
         Print("DEADSHOT software close blocked by STRICT SL/TP ONLY: ",reason);
         lastBlockedReason=reason;
         lastBlockedLog=TimeCurrent();
      }
      return false;
   }

   int before=TradeCount();
   int closedCount=0;

   for(int pass=0;pass<3;pass++)
   {
      for(int i=OrdersTotal()-1;i>=0;i--)
      {
         if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;

         int ticket=OrderTicket();
         if(SovCloseSelectedTicket(reason))
            closedCount++;
         else if(!IsOurOpenTicket(ticket))
            closedCount++;
      }
   }

   int remaining=TradeCount();

   if(remaining==0)
   {
      Print("DEADSHOT SOVEREIGN campaign fully vaulted: ",reason,
            " released=",closedCount," starting=",before);
      gDirection=DIR_FLAT; gPeakProfit=0; gCampaignStart=0; gLastUsedFVGTime=0;
      gRailArmed=false; gRailExitTicks=0;
      ResetMovementTP();
      ResetEntryMovement();
      SovResetGravity();
      return true;
   }

   if(closedCount>0)
   {
      gSovLastAction="PARTIAL VAULT "+IntegerToString(closedCount)+
                     " | "+IntegerToString(remaining)+" OX STILL YOKED";
      Print("DEADSHOT SOVEREIGN partial harvest reason=",reason,
            " released=",closedCount," remaining=",remaining);
   }
   else
      gSovLastAction="CLOSE REQUEST HELD - NO ELIGIBLE GREEN OX";

   return false;
}

bool CloseAll(string reason)
{
   return CloseAllInternal(reason,false);
}

bool CloseAllForConfirmedArrowReversal(string reason)
{
   return CloseAllInternal(reason,true);
}

void ResetReversalExitConfirmation()
{
   gReversalExitCandidateDirection=DIR_FLAT;
   gReversalExitCandidateTicks=0;
}

void ManageConfirmedArrowReversalExit()
{
   if(DisableArrowReversalExit || TradeCount()<=0){ ResetReversalExitConfirmation(); return; }
   int positionDir=(int)DetectDirection(); if(positionDir==DIR_FLAT){ ResetReversalExitConfirmation(); return; }
   HT5UpdateTrainDirection();
   int opposite=(positionDir==DIR_BUY?DIR_SELL:DIR_BUY);
   bool trainTransferred=(gHT5TrainDirection==opposite && gHT5TrainStrength>=0.45);
   bool formulaReversal=(gHT5FormulaArrowDirection==opposite && opposite*gHT5FormulaArrowScore>=0.24 && gHT5FormulaArrowConfidence>=0.45);
   if(!(trainTransferred && formulaReversal)){ ResetReversalExitConfirmation(); return; }
   gEntryStatus="FORMULA ARROW REVERSAL PROVEN • "+gHT5TrainState;
   string reason=(positionDir==DIR_BUY?"formula arrow + train reversal BUY->SELL":"formula arrow + train reversal SELL->BUY");
   if(CloseAllForConfirmedArrowReversal(reason)){ ResetArrowCampaignGrid(); ResetArrowDirectionConfirmation(); gLastArrowDirection=DIR_FLAT; }
   ResetReversalExitConfirmation();
}

//---------------------------------------------------------
bool PermissiveMovementFallback(int dir)
{
   if(!UsePermissiveEntryFallback) return false;
   int bars=MathMax(1,EntryFallbackBars);
   double now=iClose(Symbol(),SignalTF,1);
   double old=iClose(Symbol(),SignalTF,1+bars);
   if(dir==DIR_BUY) return now>old && EMAAllows(DIR_BUY);
   return now<old && EMAAllows(DIR_SELL);
}

void TryArrowTickEntry()
{
   if(gHT6DoctrineOwnsEntry){ gEntryStatus="ARROW IS WITNESS ONLY / SEQUENCE OWNS ENTRY"; return; }
   if(ArrowEntryControl==ARROW_ENTRY_OFF_USE_SETUPS) return;
   if(!AllowNewEntries)
   {
      gEntryStatus=(MasterControl==MASTER_OFF?"MASTER OFF":"MANAGE ONLY");
      return;
   }
   if(!EntryStartTimeGatePasses(true)) return;

   int dir=WeightArrowDirection();
   string arrowTrendReason="";
   if(dir!=DIR_FLAT && !HT5TrendFortificationAllows(PYR_SOURCE_RHYTHM_ACCELERATOR,dir,TradeCount()>0,arrowTrendReason))
   { gEntryStatus="ARROW BLOCKED: "+arrowTrendReason; return; }
   if(dir==DIR_FLAT)
   {
      gEntryStatus="ARROW SLOPE FLAT - WAITING";
      return;
   }
   if(dir==DIR_BUY && !AllowBuy)
   {
      gEntryStatus="BUY ARROW BLOCKED BY MASTER";
      return;
   }
   if(dir==DIR_SELL && !AllowSell)
   {
      gEntryStatus="SELL ARROW BLOCKED BY MASTER";
      return;
   }
   if(!IchimokuAllows(dir))
   {
      gEntryStatus=(dir==DIR_BUY?"BUY ARROW BLOCKED BY ICHIMOKU":"SELL ARROW BLOCKED BY ICHIMOKU");
      gSafetyBlockReason="ICHIMOKU TREND FILTER";
      return;
   }
   if(ArrowEntryControl==ARROW_ENTRY_FIRST_ONLY && TradeCount()>0)
   {
      gEntryStatus="ARROW MANAGING FIRST ENTRY";
      return;
   }

   if(gLastArrowDirection==DIR_FLAT)
   {
      if(TradeCountByDirection(dir)>0) RebuildArrowCampaignGrid(dir);
      else ResetArrowCampaignGrid();
   }
   else if(dir!=gLastArrowDirection)
   {
      gLastArrowFlipTime=TimeCurrent();
      // Do not reset the active campaign while old positions remain. This keeps
      // completed/stopped grid slots permanent and prevents their reuse.
      if(TradeCount()==0 || !WaitForFlatOnArrowReversal)
         ResetArrowCampaignGrid();
      Print("HT WEIGHT ARROW REVERSAL: ",
            gLastArrowDirection==DIR_BUY?"BUY->SELL":"SELL->BUY",
            " weight=",DoubleToString(gWeight,4),
            " slope=",DoubleToString(gArrowSlope,5),
            " angle=",DoubleToString(gAngle,2));
   }
   gLastArrowDirection=dir;

   int oppositeDir=(dir==DIR_BUY?DIR_SELL:DIR_BUY);
   if(WaitForFlatOnArrowReversal && TradeCountByDirection(oppositeDir)>0)
   {
      gEntryStatus="REVERSAL WAITING FOR OLD TRADES TO CLOSE";
      gSafetyBlockReason="NO HEDGE WHILE OLD DIRECTION IS OPEN";
      return;
   }

   if(!ArrowGridAllowsNextEntry(dir))
   {
      gEntryStatus="MARGIN-SAFE GRID: "+gSafetyBlockReason;
      return;
   }

   gArrowEntryAttempts++;
   string action=(dir==DIR_BUY?"ARROW_BUY_":"ARROW_SELL_")+
                 IntegerToString(gArrowSequenceIndex+1);
   if(SendOrder(dir,1.0,action,true))
   {
      gArrowEntriesOpened++;
      if(UseMarginSafeGrid && gArrowSequenceIndex==0)
      {
         gArrowCampaignDirection=dir;
         gArrowCampaignAnchorPrice=gLastOpenedPrice;
         gArrowCampaignTargetPrice=gLastOpenedTakeProfit;
         gArrowCampaignStartTime=TimeCurrent();
         gGridStoppedAfterSL=false;
      }
      gEntryStatus=(dir==DIR_BUY?"SAFE GRID BUY OPENED ":"SAFE GRID SELL OPENED ")+
                   IntegerToString(gArrowSequenceIndex+1)+"/"+
                   IntegerToString(SafeMaximumEntries);
      gArrowSequenceIndex++;
      gSafetyBlockReason="";
   }
}

void TryInitialEntry()
{
   if(gHT6DoctrineOwnsEntry){ gEntryStatus="LEGACY INITIAL ENTRY DISABLED / SEQUENCE + FVG OWNS ENTRY"; return; }
   if(!AllowNewEntries)
   { gEntryStatus=(MasterControl==MASTER_OFF?"MASTER OFF":"MANAGE ONLY"); return; }
   if(!EntryStartTimeGatePasses(true)) return;
   if(TradeCount()>0)
   { gEntryStatus="MANAGING OPEN TRADE"; return; }

   // Informational only. Spread no longer blocks initial entries or additions.
   double spread=SpreadPoints();
   if(gMode==GEO_INVALID && !AllowEntryWithoutValidGeometry)
   { gEntryStatus="WAITING FOR VALID TRIANGLE"; return; }

   double bt=0,bb=0,st=0,sb=0;
   datetime btime=0,stime=0;

   bool buyCloud=IchimokuAllows(DIR_BUY);
   bool sellCloud=IchimokuAllows(DIR_SELL);
   bool buyEarly=AllowBuy && buyCloud && ZeroDegreeBreakSignal(DIR_BUY);
   bool sellEarly=AllowSell && sellCloud && ZeroDegreeBreakSignal(DIR_SELL);

   bool buyFVG=UseFVGEntry && AllowBuy && buyCloud && EMAAllows(DIR_BUY) &&
               FindTradableFVG(DIR_BUY,bt,bb,btime) && SignalTimeIsFresh(btime);
   bool sellFVG=UseFVGEntry && AllowSell && sellCloud && EMAAllows(DIR_SELL) &&
                FindTradableFVG(DIR_SELL,st,sb,stime) && SignalTimeIsFresh(stime);

   bool buyLaunch=AllowBuy && buyCloud && HightowerLaunchSignal(DIR_BUY);
   bool sellLaunch=AllowSell && sellCloud && HightowerLaunchSignal(DIR_SELL);
   bool buyMomentum=AllowBuy && buyCloud && MomentumSignal(DIR_BUY);
   bool sellMomentum=AllowSell && sellCloud && MomentumSignal(DIR_SELL);

   if((buyEarly || buyLaunch || buyMomentum) && btime==0) btime=iTime(Symbol(),SignalTF,0);
   if((sellEarly || sellLaunch || sellMomentum) && stime==0) stime=iTime(Symbol(),SignalTF,0);

   bool buySetup=buyEarly || buyFVG || buyLaunch || buyMomentum;
   bool sellSetup=sellEarly || sellFVG || sellLaunch || sellMomentum;
   bool buyStrict=TriangleMovementEntryPasses(DIR_BUY);
   bool sellStrict=TriangleMovementEntryPasses(DIR_SELL);
   bool buyFallback=buySetup && PermissiveMovementFallback(DIR_BUY);
   bool sellFallback=sellSetup && PermissiveMovementFallback(DIR_SELL);
   bool invalidGeometryBypass=(gMode==GEO_INVALID && AllowEntryWithoutValidGeometry);
   // Red-line zero-degree breaks are deliberately early and therefore bypass
   // the later angle threshold while respecting direction, risk and Ichimoku.
   bool buyMovement=buySetup && (buyEarly || buyStrict || buyFallback || invalidGeometryBypass);
   bool sellMovement=sellSetup && (sellEarly || sellStrict || sellFallback || invalidGeometryBypass);

   if(EnableEntryDiagnostics && TimeCurrent()-gLastEntryDiagnostic>=MathMax(1,EntryDiagnosticSeconds))
   {
      gLastEntryDiagnostic=TimeCurrent();
      Print("HT TRI ENTRY | status=",gEntryStatus,
            " mode=",ModeText()," structure=",DoubleToString((gHigh-gLow)/Point,0),
            " spread=",DoubleToString(spread,0)," (informational only)",
            " tickSize=",DoubleToString(TickSizePrice(),Digits),
            " tickValue=",DoubleToString(MarketInfo(Symbol(),MODE_TICKVALUE),4),
            " buyEarly=",buyEarly," buyCloud=",buyCloud,
            " buyFVG=",buyFVG," buyLaunch=",buyLaunch," buyMomentum=",buyMomentum,
            " buyMove=",buyMovement," buyLot=",DoubleToString(PreviewRiskLot(DIR_BUY,1.0),2),
            " sellEarly=",sellEarly," sellCloud=",sellCloud,
            " sellFVG=",sellFVG," sellLaunch=",sellLaunch," sellMomentum=",sellMomentum,
            " sellMove=",sellMovement," sellLot=",DoubleToString(PreviewRiskLot(DIR_SELL,1.0),2),
            " tradeAllowed=",IsTradeAllowed());
   }

   if(!buySetup && !sellSetup)
   { gEntryStatus="WAITING FOR SETUP"; ResetEntryMovement(); return; }
   if(!buyMovement && !sellMovement)
   { gEntryStatus="SETUP FOUND - WAITING FOR DIRECTION"; ResetEntryMovement(); return; }

   // A fresh zero-degree break has priority over later setup signals.
   if(buyEarly && !sellEarly) sellMovement=false;
   else if(sellEarly && !buyEarly) buyMovement=false;
   else if(buyMovement && sellMovement)
   {
      double buyStrength=DirectionalAngle(DIR_BUY)+DirectionalAngleVelocity(DIR_BUY)*2.0;
      double sellStrength=DirectionalAngle(DIR_SELL)+DirectionalAngleVelocity(DIR_SELL)*2.0;
      if(buyStrength>=sellStrength) sellMovement=false;
      else buyMovement=false;
   }

   if(buyMovement)
   {
      gEntryStatus=(buyEarly ? "ZERO DEGREE BUY BREAK" : "BUY SETUP READY");
      bool confirmed=(buyEarly || ConfirmEntryMovement(DIR_BUY,btime));
      if(confirmed)
      {
         gLastUsedFVGTime=btime;
         string action=(buyEarly ? "ZERO_DEG_BUY" :
                        (DirectionalAngle(DIR_BUY)>=StrongEntryAngleDegrees ? "STRONG_BUY" : "BUY"));
         string legacyTrendReason="";
         if(!HT5TrendFortificationAllows(PYR_SOURCE_RHYTHM_ACCELERATOR,DIR_BUY,false,legacyTrendReason))
         { gEntryStatus="LEGACY BUY BLOCKED: "+legacyTrendReason; return; }
         if(SendOrder(DIR_BUY,1.0,action,true))
         {
            if(buyEarly){ gLastZeroCrossDirection=DIR_BUY; gLastZeroCrossTime=TimeCurrent(); }
            gEntryStatus=(buyEarly ? "ZERO DEGREE BUY OPENED" : "BUY OPENED");
            ResetEntryMovement();
         }
      }
      else gEntryStatus="CONFIRMING BUY";
      return;
   }

   if(sellMovement)
   {
      gEntryStatus=(sellEarly ? "ZERO DEGREE SELL BREAK" : "SELL SETUP READY");
      bool confirmed=(sellEarly || ConfirmEntryMovement(DIR_SELL,stime));
      if(confirmed)
      {
         gLastUsedFVGTime=stime;
         string action=(sellEarly ? "ZERO_DEG_SELL" :
                        (DirectionalAngle(DIR_SELL)>=StrongEntryAngleDegrees ? "STRONG_SELL" : "SELL"));
         string legacyTrendReason="";
         if(!HT5TrendFortificationAllows(PYR_SOURCE_RHYTHM_ACCELERATOR,DIR_SELL,false,legacyTrendReason))
         { gEntryStatus="LEGACY SELL BLOCKED: "+legacyTrendReason; return; }
         if(SendOrder(DIR_SELL,1.0,action,true))
         {
            if(sellEarly){ gLastZeroCrossDirection=DIR_SELL; gLastZeroCrossTime=TimeCurrent(); }
            gEntryStatus=(sellEarly ? "ZERO DEGREE SELL OPENED" : "SELL OPENED");
            ResetEntryMovement();
         }
      }
      else gEntryStatus="CONFIRMING SELL";
      return;
   }

   gEntryStatus="WAITING";
   ResetEntryMovement();
}

bool FreshContinuationFVG()
{
   if(!UseFVGEntry || !EMAAllows(gDirection) || !IchimokuAllows(gDirection)) return false;
   double top,bottom; datetime when;
   if(!FindTradableFVG(gDirection,top,bottom,when)) return false;
   if(!SignalTimeIsFresh(when) || when<=gLastUsedFVGTime) return false;
   gLastUsedFVGTime=when;
   return true;
}

void TryAdd()
{
   if(gHT6DoctrineOwnsEntry){ gEntryStatus="LEGACY ADD DISABLED / SONIC + SEQUENCE OWNS GROWTH"; return; }
   if(!AllowNewEntries) return;
   if(!EntryStartTimeGatePasses(true)) return;
   int n=TradeCount();
   if(n<=0 || n>=MaximumOpenTrades || n-1>=MaximumAddsPerCampaign) return;
   if(gMode!=GEO_LADDER && gMode!=GEO_STRONG_LADDER) return;
   if(TimeCurrent()-gLastAdd<MinimumSecondsBetweenAdds) return;
   if(RequireNewestTradeWinning && NewestProfit()<=0) return;
   if(MathAbs(MidPrice()-LastEntryPrice())/Point<MinimumAddSpacingPoints) return;
   if(!FreshContinuationFVG()) return;
   string addTrendReason="";
   if(!HT5TrendFortificationAllows(PYR_SOURCE_RHYTHM_ACCELERATOR,gDirection,true,addTrendReason))
   { gEntryStatus="ADD BLOCKED: "+addTrendReason; return; }
   SendOrder(gDirection,AddRiskFraction,gMode==GEO_STRONG_LADDER?"STRONG_ADD":"ADD",true);
}

void ResetMovementTP()
{
   gMovementTPArmed=false;
   gMovementExitTicks=0;
   gPeakFavorableWeight=0.0;
   gPeakFavorableAngle=0.0;
   gPeakDirectionalPrice=0.0;
   gMovementExitReason="";
}

datetime CampaignFirstOpenTime()
{
   datetime first=0;
   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;
      if(first==0 || OrderOpenTime()<first) first=OrderOpenTime();
   }
   return first;
}

int CampaignAgeSignalBars()
{
   datetime first=CampaignFirstOpenTime();
   if(first<=0) return 0;
   int seconds=PeriodSeconds(SignalTF);
   if(seconds<=0) seconds=60;
   return (int)MathMax(0,(TimeCurrent()-first)/seconds);
}

bool DiscretionaryExitAllowed()
{
   if(HoldUntilBrokerStopOrTarget) return false;
   if(MinimumHoldBarsValue<=0) return true;
   return CampaignAgeSignalBars()>=MinimumHoldBarsValue;
}

string HoldPolicyText()
{
   if(HoldUntilBrokerStopOrTarget) return "STRICT SL/TP ONLY";
   if(MinimumHoldBarsValue<=0) return "NO MINIMUM";
   return IntegerToString(MinimumHoldBarsValue)+" BARS";
}

void UpdateMovementTakeProfitState()
{
   if(TradeCount()<=0 || gDirection==DIR_FLAT)
   {
      ResetMovementTP();
      return;
   }

   double profit=BasketProfit();
   double favorableWeight=DirectionalWeight(gDirection);
   double favorableAngle=DirectionalAngle(gDirection);
   double directionalPrice=(gDirection==DIR_BUY ? gPrice : -gPrice);

   if(favorableWeight>gPeakFavorableWeight)
      gPeakFavorableWeight=favorableWeight;
   if(favorableAngle>gPeakFavorableAngle)
      gPeakFavorableAngle=favorableAngle;
   if(gPeakDirectionalPrice==0.0 || directionalPrice>gPeakDirectionalPrice)
      gPeakDirectionalPrice=directionalPrice;

   double armMoney=MathMax(MovementTPMinimumMoney,
                           AccountBalance()*MovementTPArmPercent/100.0);

   if(!gMovementTPArmed &&
      profit>=armMoney &&
      favorableWeight>=MovementTPMinimumFavorableWeight)
   {
      gMovementTPArmed=true;
      gMovementExitTicks=0;
      Print("Triangle movement TP armed profit=",
            DoubleToString(profit,2),
            " weight=",DoubleToString(favorableWeight,3),
            " angle=",DoubleToString(favorableAngle,2));
   }
}

bool MovementExitCondition(string &reason)
{
   reason="";
   if(!UseTriangleMovementTakeProfit || !gMovementTPArmed) return false;
   if(BasketProfit()<=0.0) return false;

   double favorableWeight=DirectionalWeight(gDirection);
   double favorableAngle=DirectionalAngle(gDirection);
   double favorableVelocity=DirectionalAngleVelocity(gDirection);

   bool weightGiveback=
      favorableWeight<=gPeakFavorableWeight-MovementTPWeightGiveback;

   bool angleGiveback=
      favorableAngle<=gPeakFavorableAngle-MovementTPAngleGivebackDegrees;

   bool angleReversal=
      favorableAngle<=-MovementTPAngleReversalDegrees;

   bool profitableDrawdown=
      ExitOnProfitableDrawdownMode &&
      (gMode==GEO_DRAWDOWN || gMode==GEO_STRONG_DRAWDOWN);

   bool midpointLost=
      ExitOnMidpointLossAfterProfit && favorableWeight<=0.0;

   bool extensionStall=
      ExitOnExtremeExtensionStall &&
      gPeakFavorableWeight>=ExtensionWeight &&
      favorableVelocity<=ExtensionStallVelocity &&
      favorableAngle<gPeakFavorableAngle;

   if(angleReversal)
      reason="angle reversed";
   else if(profitableDrawdown && weightGiveback)
      reason="profitable drawdown with weight loss";
   else if(midpointLost)
      reason="midpoint lost after profit";
   else if(extensionStall && angleGiveback)
      reason="extended triangle stalled";
   else if(weightGiveback && angleGiveback)
      reason="triangle weight and angle gave back";
   else
      return false;

   return true;
}

bool ConfirmMovementExit(string reason)
{
   if(reason!=gMovementExitReason)
   {
      gMovementExitReason=reason;
      gMovementExitTicks=1;
      return false;
   }

   gMovementExitTicks++;
   return gMovementExitTicks>=MathMax(1,MovementTPConfirmTicks);
}

void ManageBasket()
{
   if(TradeCount()==0) return;

   double p=BasketProfit();
   if(p>gPeakProfit) gPeakProfit=p;
   UpdateMovementTakeProfitState();

   bool discretionaryExit=DiscretionaryExitAllowed();
   if(discretionaryExit)
   {
      if(CloseOnInvalidGeometry && gMode==GEO_INVALID)
      { CloseAll("invalid triangle geometry"); return; }

      string movementReason="";
      if(MovementExitCondition(movementReason))
      {
         if(ConfirmMovementExit(movementReason))
         {
            CloseAll("movement TP: "+movementReason);
            return;
         }
      }
      else
      {
         gMovementExitTicks=0;
         gMovementExitReason="";
      }

      double railArm=MathMax(MinimumBasketTargetMoney,AccountBalance()*RailArmPercent/100.0);
      if(UseCampaignProfitRail && p>=railArm) gRailArmed=true;
      if(gRailArmed && gPeakProfit>0)
      {
         double givePct=(TargetMode==HT_QUICK_CAPTURE?RailGivebackPercentQuick:
                        (TargetMode==HT_MAXIMUM_TREND?RailGivebackPercentMaximum:RailGivebackPercentBalanced));
         double railMoney=gPeakProfit*(1.0-givePct/100.0);
         bool railBroken=(p<=railMoney && p>0 &&
                          (gMode==GEO_EXHAUSTION || gMode==GEO_DRAWDOWN || gMode==GEO_STRONG_DRAWDOWN));
         if(railBroken) gRailExitTicks++; else gRailExitTicks=0;
         if(gRailExitTicks>=MathMax(1,RailConfirmTicks)){ CloseAll("campaign profit rail"); return; }
      }

      double target=MathMax(MinimumBasketTargetMoney,
                            AccountBalance()*BasketTargetPercent/100.0);
      if(TargetMode==HT_QUICK_CAPTURE && p>=target){ CloseAll("quick basket target"); return; }

      double peakArm=AccountBalance()*PeakArmPercent/100.0;
      double giveback=MathMax(MinimumPeakGivebackMoney,
                              gPeakProfit*PeakGivebackPercent/100.0);
      if(UsePeakGiveback && TargetMode!=HT_MAXIMUM_TREND &&
         gPeakProfit>=peakArm && p<=gPeakProfit-giveback &&
         (gMode==GEO_EXHAUSTION || gMode==GEO_DRAWDOWN || gMode==GEO_STRONG_DRAWDOWN))
      { CloseAll("confirmed peak giveback"); return; }

      if(CloseOnOppositeFVG && p>0 && OppositeRecentFVG())
      { CloseAll("opposite FVG"); return; }

      double buffer=StructureBreakBufferPoints*Point;
      if(CloseOnStructureBreak &&
         ((gDirection==DIR_BUY && Bid<gLow-buffer) ||
          (gDirection==DIR_SELL && Ask>gHigh+buffer)))
      { CloseAll("structure break"); return; }
   }
   else
   {
      // Do not let tick confirmations accumulate while the hold lock is active.
      gMovementExitTicks=0;
      gMovementExitReason="";
      gRailExitTicks=0;
   }

   // Account-level emergency protection remains active for timed-hold modes.
   // Strict SL/TP-only mode deliberately leaves closure to the broker SL or TP.
   double dd=(p<0?MathAbs(p)/MathMax(1.0,AccountBalance())*100.0:0);
   if(!HoldUntilBrokerStopOrTarget &&
      MaximumCampaignDrawdownPercent>0.0 && dd>=MaximumCampaignDrawdownPercent)
   { CloseAll("maximum campaign drawdown"); return; }
}

//---------------------------------------------------------
void DeleteObjectsWithPrefix(string prefix)
{
   for(int i=ObjectsTotal()-1;i>=0;i--)
   {
      string name=ObjectName(i);
      if(StringFind(name,prefix,0)==0) ObjectDelete(0,name);
   }
}


//---------------------------------------------------------
// BLACK GOLD GUARDIAN COMMAND CENTER
string UIName(string suffix){ return Pfx()+"UI_"+suffix; }

double UIClamp(double value,double minimum,double maximum)
{
   return MathMax(minimum,MathMin(maximum,value));
}

string UIShortText(string value,int maximumLength)
{
   if(maximumLength<4 || StringLen(value)<=maximumLength) return value;
   return StringSubstr(value,0,maximumLength-3)+"...";
}

void UISetPanel(string suffix,int x,int y,int width,int height,color background,color border)
{
   string name=UIName(suffix);
   if(ObjectFind(0,name)<0) ObjectCreate(0,name,OBJ_RECTANGLE_LABEL,0,0,0);
   ObjectSetInteger(0,name,OBJPROP_CORNER,CORNER_LEFT_UPPER);
   ObjectSetInteger(0,name,OBJPROP_XDISTANCE,x);
   ObjectSetInteger(0,name,OBJPROP_YDISTANCE,y);
   ObjectSetInteger(0,name,OBJPROP_XSIZE,width);
   ObjectSetInteger(0,name,OBJPROP_YSIZE,height);
   ObjectSetInteger(0,name,OBJPROP_BGCOLOR,background);
   ObjectSetInteger(0,name,OBJPROP_BORDER_COLOR,border);
   ObjectSetInteger(0,name,OBJPROP_BORDER_TYPE,BORDER_FLAT);
   ObjectSetInteger(0,name,OBJPROP_BACK,false);
   ObjectSetInteger(0,name,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,name,OBJPROP_SELECTED,false);
   ObjectSetInteger(0,name,OBJPROP_HIDDEN,true);
}

void UISetLabel(string suffix,string value,int x,int y,int fontSize,color textColor,
                string fontName,int anchor)
{
   string name=UIName(suffix);
   if(ObjectFind(0,name)<0) ObjectCreate(0,name,OBJ_LABEL,0,0,0);
   ObjectSetInteger(0,name,OBJPROP_CORNER,CORNER_LEFT_UPPER);
   ObjectSetInteger(0,name,OBJPROP_XDISTANCE,x);
   ObjectSetInteger(0,name,OBJPROP_YDISTANCE,y);
   ObjectSetInteger(0,name,OBJPROP_ANCHOR,anchor);
   ObjectSetInteger(0,name,OBJPROP_COLOR,textColor);
   ObjectSetInteger(0,name,OBJPROP_FONTSIZE,fontSize);
   ObjectSetString(0,name,OBJPROP_FONT,fontName);
   ObjectSetString(0,name,OBJPROP_TEXT,value);
   ObjectSetInteger(0,name,OBJPROP_BACK,false);
   ObjectSetInteger(0,name,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,name,OBJPROP_SELECTED,false);
   ObjectSetInteger(0,name,OBJPROP_HIDDEN,true);
}

void UIDelete(string suffix)
{
   ObjectDelete(0,UIName(suffix));
}

void UISetDivider(string suffix,int x,int y,int width,color dividerColor)
{
   UISetPanel(suffix,x,y,width,1,dividerColor,dividerColor);
}

void ApplyBlackGoldChartTheme()
{
   if(!UseBlackGoldTheme) return;
   ChartSetInteger(0,CHART_MODE,CHART_CANDLES);
   ChartSetInteger(0,CHART_SHOW_GRID,false);
   ChartSetInteger(0,CHART_COLOR_BACKGROUND,HTBlack);
   ChartSetInteger(0,CHART_COLOR_FOREGROUND,HTText);
   ChartSetInteger(0,CHART_COLOR_GRID,HTPanelSoft);
   ChartSetInteger(0,CHART_COLOR_CHART_UP,HTGoldBright);
   ChartSetInteger(0,CHART_COLOR_CHART_DOWN,HTCharcoalLight);
   ChartSetInteger(0,CHART_COLOR_CANDLE_BULL,HTGold);
   ChartSetInteger(0,CHART_COLOR_CANDLE_BEAR,C'5,5,5');
   ChartSetInteger(0,CHART_COLOR_CHART_LINE,HTGold);
   ChartSetInteger(0,CHART_COLOR_BID,HTGoldBright);
   ChartSetInteger(0,CHART_COLOR_ASK,HTGoldDark);
   ChartSetInteger(0,CHART_COLOR_STOP_LEVEL,HTAlert);
   ChartRedraw(0);
}

string GuardianKey(string suffix)
{
   return "HTG_"+IntegerToString(AccountNumber())+"_"+Symbol()+"_"+
          IntegerToString(MagicNumber)+"_"+suffix;
}

void InitializeGuardianEvolution()
{
   string startKey=GuardianKey("START");
   string levelKey=GuardianKey("LEVEL");
   if(GlobalVariableCheck(startKey))
      gGuardianStartBalance=MathMax(1.0,GlobalVariableGet(startKey));
   else
   {
      gGuardianStartBalance=MathMax(1.0,AccountBalance());
      GlobalVariableSet(startKey,gGuardianStartBalance);
   }

   if(GlobalVariableCheck(levelKey))
      gGuardianEvolution=(int)MathMax(1.0,MathMin(4.0,GlobalVariableGet(levelKey)));
   else
   {
      gGuardianEvolution=1;
      GlobalVariableSet(levelKey,1.0);
   }
}

void UpdateGuardianEvolution()
{
   if(gGuardianStartBalance<=0.0) gGuardianStartBalance=MathMax(1.0,AccountBalance());
   double growth=AccountBalance()/gGuardianStartBalance;
   int level=1;
   if(growth>=1.05) level=2;
   if(growth>=1.15) level=3;
   if(growth>=1.30) level=4;
   if(level>gGuardianEvolution)
   {
      gGuardianEvolution=level;
      GlobalVariableSet(GuardianKey("LEVEL"),(double)gGuardianEvolution);
   }
}

string DashboardStatusText()
{
   if(gWisdoEmergencyLatched) return "WISDO EMERGENCY";
   if(gWisdoPaused || gWisdoDirectionMode==3) return "WISDO PAUSED";
   if(!IsMasterEnabled()) return "MASTER DISABLED";
   if(!StartTradingTimeReached()) return "WAITING FOR SESSION";
   if(gSafetyBlockReason!="") return "RISK BLOCKED";
   if(TradeCount()>0)
   {
      if(BasketProfit()>0.0) return "PROFIT RUN";
      if(BasketProfit()<0.0) return "PROTECTING";
      return "POSITION ACTIVE";
   }
   int arrow=WeightArrowDirection();
   if(arrow==DIR_BUY && IchimokuAllows(DIR_BUY)) return "BUY READY";
   if(arrow==DIR_SELL && IchimokuAllows(DIR_SELL)) return "SELL READY";
   if(arrow!=DIR_FLAT) return "FILTER CHECK";
   return "SCANNING";
}

color DashboardStatusColor()
{
   string status=DashboardStatusText();
   if(status=="RISK BLOCKED" || status=="PROTECTING" || status=="WISDO EMERGENCY") return HTAlert;
   if(status=="BUY READY" || status=="SELL READY" || status=="PROFIT RUN") return HTGoldBright;
   return HTMuted;
}

double TrendGaugeValue()
{
   HT5UpdateTrainDirection();
   double arrow=100.0*gHT5FormulaArrowConfidence;
   double train=100.0*gHT5TrainStrength;
   double agreement=100.0*gHT5TrainAgreement;
   return UIClamp(0.42*arrow+0.43*train+0.15*agreement,0.0,100.0);
}

double RiskHealthGaugeValue()
{
   double accountBase=MathMax(1.0,AccountRiskBase());
   double capMoney=MathMax(1.0,accountBase*MaximumCampaignRiskPercent/100.0);
   double used=UIClamp(OpenCampaignRiskMoney()/capMoney,0.0,1.5);
   double exposureScore=UIClamp(100.0-used*100.0,0.0,100.0);
   double marginScore=100.0;
   if(gLastProjectedMarginLevel>0.0 && MinimumProjectedMarginLevel>0.0)
      marginScore=UIClamp(gLastProjectedMarginLevel/MinimumProjectedMarginLevel*70.0,0.0,100.0);
   double result=exposureScore*0.65+marginScore*0.35;
   if(gSafetyBlockReason!="") result=MathMin(result,20.0);
   return UIClamp(result,0.0,100.0);
}

double ProfitEnergyGaugeValue()
{
   double selectedRisk=MathMax(1.0,SelectedRiskMoney());
   if(TradeCount()>0)
      return UIClamp(50.0+(BasketProfit()/selectedRisk)*50.0,0.0,100.0);
   double growth=(AccountBalance()/MathMax(1.0,gGuardianStartBalance)-1.0)*200.0;
   return UIClamp(25.0+growth,0.0,100.0);
}

double MomentumGaugeValue()
{
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double o=iOpen(Symbol(),SignalTF,1),c=iClose(Symbol(),SignalTF,1);
   double body=MathAbs(c-o);
   double raw=UIClamp(body/atr*100.0,0.0,100.0);
   int dir=(gPyrTrendDirection!=DIR_FLAT?gPyrTrendDirection:gConfirmedArrowDirection);
   bool aligned=(dir==DIR_BUY?c>=o:(dir==DIR_SELL?c<=o:true));
   if(!aligned) raw*=0.35;
   return raw;
}

double GripGaugeValue()
{
   double req=MathMax(1.0,(double)((int)PyramidGripCharacter));
   return UIClamp((double)gPyrGripTicks/req*100.0,0.0,100.0);
}

double RSIRunwayGaugeValue()
{
   double r=MathMax(1.0,PyramidRSIHigh-PyramidRSILow);
   if(gPyrTrendDirection==DIR_BUY) return UIClamp((PyramidRSIHigh-gPyrRSI)/r*100.0,0.0,100.0);
   if(gPyrTrendDirection==DIR_SELL) return UIClamp((gPyrRSI-PyramidRSILow)/r*100.0,0.0,100.0);
   return 50.0;
}

double StationProgressGaugeValue()
{
   if(TradeCount()<=0 || gPyrCampaignDirection==DIR_FLAT) return 0.0;
   RefreshRates();
   double p=(gPyrCampaignDirection==DIR_BUY?Bid:Ask);
   return UIClamp(PyrDirectionalProgress(gPyrCampaignDirection,p)*100.0,0.0,100.0);
}

void UIDrawGauge(string id,int centerX,int centerY,int radius,double value,
                 string title,string subTitle,color activeColor)
{
   int segments=24;
   int active=(int)MathRound(UIClamp(value,0.0,100.0)/100.0*segments);
   for(int i=0;i<segments;i++)
   {
      double degrees=135.0+(270.0*i/MathMax(1,segments-1));
      double radians=degrees*3.14159265358979323846/180.0;
      int x=centerX+(int)MathRound(MathCos(radians)*radius);
      int y=centerY+(int)MathRound(MathSin(radians)*radius);
      UISetLabel("GAUGE_"+id+"_"+IntegerToString(i),"o",x,y,8,
                 (i<active?activeColor:HTCharcoal),"Arial",ANCHOR_CENTER);
   }
   UISetLabel("GAUGE_"+id+"_VALUE",IntegerToString((int)MathRound(value))+"%",
              centerX,centerY-2,12,HTText,"Arial Bold",ANCHOR_CENTER);
   UISetLabel("GAUGE_"+id+"_TITLE",title,centerX,centerY+48,9,HTGold,
              "Arial Bold",ANCHOR_CENTER);
   UISetLabel("GAUGE_"+id+"_SUB",subTitle,centerX,centerY+63,8,HTMuted,
              "Arial",ANCHOR_CENTER);
}


void UIDrawSovereignBalanceScale(int x,int y,int width,int height)
{
   double realizedProfit=0.0,realizedLoss=0.0;
   double liveGreen=0.0,liveRed=0.0;

   SovRealizedWeights(realizedProfit,realizedLoss);
   SovFloatingWeights(liveGreen,liveRed);

   double profitWeight=realizedProfit+liveGreen;
   double riskWeight=realizedLoss+liveRed;
   double total=MathMax(0.01,profitWeight+riskWeight);
   double bias=(profitWeight-riskWeight)/total;

   int tilt=(int)MathRound(UIClamp(bias,-1.0,1.0)*9.0);
   int centerX=x+width/2;
   int beamY=y+38;
   int leftY=beamY+tilt;
   int rightY=beamY-tilt;

   UISetLabel("SCALE_VIS_TITLE","LIVE WEIGHT SCALE",centerX,y+9,8,HTGold,
              "Arial Bold",ANCHOR_CENTER);

   UISetPanel("SCALE_STEM",centerX-1,beamY,2,48,HTGoldDark,HTGoldDark);
   UISetLabel("SCALE_PIVOT","/\\",centerX,beamY+46,12,HTGoldBright,
              "Consolas",ANCHOR_CENTER);

   UISetPanel("SCALE_BEAM_L",x+35,leftY,centerX-(x+35),2,HTGold,HTGold);
   UISetPanel("SCALE_BEAM_R",centerX,rightY,x+width-35-centerX,2,HTGold,HTGold);

   UISetPanel("SCALE_PAN_PROFIT",x+12,leftY+9,128,35,HTBlack,HTGoldDark);
   UISetLabel("SCALE_PAN_PROFIT_T","PROFIT WEIGHT",x+76,leftY+18,7,HTGold,
              "Arial Bold",ANCHOR_CENTER);
   UISetLabel("SCALE_PAN_PROFIT_V","$"+DoubleToString(profitWeight,2),
              x+76,leftY+33,9,HTGoldBright,"Arial Bold",ANCHOR_CENTER);

   UISetPanel("SCALE_PAN_RISK",x+width-140,rightY+9,128,35,HTBlack,
              (riskWeight>profitWeight?HTAlert:HTCharcoal));
   UISetLabel("SCALE_PAN_RISK_T","RISK WEIGHT",x+width-76,rightY+18,7,
              (riskWeight>profitWeight?HTAlert:HTMuted),
              "Arial Bold",ANCHOR_CENTER);
   UISetLabel("SCALE_PAN_RISK_V","$"+DoubleToString(riskWeight,2),
              x+width-76,rightY+33,9,
              (riskWeight>profitWeight?HTAlert:HTText),
              "Arial Bold",ANCHOR_CENTER);

   UISetLabel("SCALE_VIS_STATE",SovScaleState(),centerX,y+92,9,
              (StringFind(SovScaleState(),"RISK",0)>=0?HTAlert:HTGoldBright),
              "Arial Bold",ANCHOR_CENTER);
}

void UIDrawVaultVisual(int x,int y,int width,int height)
{
   double realizedProfit=0.0,realizedLoss=0.0;
   double liveGreen=0.0,liveRed=0.0;
   SovRealizedWeights(realizedProfit,realizedLoss);
   SovFloatingWeights(liveGreen,liveRed);

   double vaultNet=realizedProfit-realizedLoss;
   double denominator=realizedProfit+realizedLoss+liveRed;
   double strength=(denominator>0.0
                    ? UIClamp(realizedProfit/denominator,0.0,1.0)
                    : (realizedProfit>0.0 ? 1.0 : 0.0));

   UISetLabel("VAULT_VIS_TITLE","SOVEREIGN VAULT",x+width/2,y+9,8,HTGold,
              "Arial Bold",ANCHOR_CENTER);

   UISetPanel("VAULT_SAFE",x+12,y+23,width-24,height-31,HTBlack,HTGoldDark);

   int innerWidth=MathMax(1,width-36);
   int fillWidth=(int)MathRound(innerWidth*strength);

   UISetPanel("VAULT_TRACK",x+18,y+54,innerWidth,18,HTCharcoal,HTCharcoal);
   UISetPanel("VAULT_FILL",x+18,y+54,MathMax(1,fillWidth),18,HTGoldDark,HTGold);

   UISetLabel("VAULT_DOOR","[==== VAULT ====]",x+width/2,y+38,9,HTGoldBright,
              "Consolas",ANCHOR_CENTER);
   UISetLabel("VAULT_VALUE","$"+DoubleToString(vaultNet,2),
              x+width/2,y+65,10,(vaultNet>=0.0?HTGoldBright:HTAlert),
              "Arial Bold",ANCHOR_CENTER);
   UISetLabel("VAULT_STRENGTH","STRENGTH "+IntegerToString((int)MathRound(strength*100.0))+
              "%  | DRAG -$"+DoubleToString(liveRed,2),
              x+width/2,y+86,7,HTMuted,"Arial",ANCHOR_CENTER);
}

void UIDrawGravityVisual(int x,int y,int width)
{
   double peak=MathMax(0.0,gSovPeakPull);
   double current=MathMax(0.0,BasketProfit());
   double floor=MathMax(0.0,gSovGravityFloor);

   double currentRatio=(peak>0.0 ? UIClamp(current/peak,0.0,1.0) : 0.0);
   double floorRatio=(peak>0.0 ? UIClamp(floor/peak,0.0,1.0) : 0.0);

   UISetLabel("GRAV_VIS_TITLE","GRAVITY TRAIL",x,y,8,HTGold,
              "Arial Bold",ANCHOR_LEFT_UPPER);

   UISetPanel("GRAV_TRACK",x,y+18,width,13,HTCharcoal,HTCharcoal);
   UISetPanel("GRAV_FILL",x,y+18,MathMax(1,(int)MathRound(width*currentRatio)),13,
              HTGoldDark,HTGold);

   int floorX=x+(int)MathRound(width*floorRatio);
   UISetPanel("GRAV_FLOOR_MARK",floorX,y+14,2,21,HTAlert,HTAlert);

   UISetLabel("GRAV_VIS_TEXT",
              "NOW $"+DoubleToString(BasketProfit(),2)+
              "  PEAK $"+DoubleToString(gSovPeakPull,2)+
              "  FLOOR $"+DoubleToString(gSovGravityFloor,2),
              x,y+38,7,HTMuted,"Arial",ANCHOR_LEFT_UPPER);
}

void UIDrawOxTrain(int x,int y,int width)
{
   int slotWidth=12;
   int gap=2;
   int maxSlots=20;

   UISetLabel("OX_VIS_TITLE","EQUALLY YOKED OX TEAM",x,y,8,HTGold,
              "Arial Bold",ANCHOR_LEFT_UPPER);

   int slot=0;
   for(int i=OrdersTotal()-1;i>=0 && slot<maxSlots;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;

      double net=SovTicketNetSelected();
      string state="U";
      color cellColor=HTCharcoal;
      color textColor=HTMuted;

      if(net>=MathMax(0.0,MinimumNetCloseProfit))
      {
         state="P";
         cellColor=HTGoldDark;
         textColor=HTGoldBright;
      }
      else if(net<0.0)
      {
         state="D";
         cellColor=C'55,18,18';
         textColor=HTAlert;
      }

      int px=x+slot*(slotWidth+gap);
      UISetPanel("OX_SLOT_"+IntegerToString(slot),px,y+18,slotWidth,14,
                 cellColor,HTCharcoalLight);
      UISetLabel("OX_SLOT_T_"+IntegerToString(slot),state,px+slotWidth/2,y+25,7,
                 textColor,"Arial Bold",ANCHOR_CENTER);
      slot++;
   }

   int capacity=MathMin(maxSlots,MathMax(slot,SafeMaximumEntries));
   for(int empty=slot;empty<capacity;empty++)
   {
      int px=x+empty*(slotWidth+gap);
      UISetPanel("OX_SLOT_"+IntegerToString(empty),px,y+18,slotWidth,14,
                 HTBlack,HTCharcoal);
      UISetLabel("OX_SLOT_T_"+IntegerToString(empty),".",px+slotWidth/2,y+25,7,
                 HTCharcoalLight,"Consolas",ANCHOR_CENTER);
   }

   for(int cleanup=capacity;cleanup<maxSlots;cleanup++)
   {
      UIDelete("OX_SLOT_"+IntegerToString(cleanup));
      UIDelete("OX_SLOT_T_"+IntegerToString(cleanup));
   }

   UISetLabel("OX_LEGEND","P=PULL  D=DRAG  U=UNPROVEN  | "+SovYokeState(),
              x,y+41,7,HTMuted,"Arial",ANCHOR_LEFT_UPPER);
}

string GuardianMoodText()
{
   if(gSafetyBlockReason!="") return "ALERT";
   if(TradeCount()>0 && BasketProfit()>0.0) return "SMILING";
   if(TradeCount()>0 && BasketProfit()<0.0) return "GUARDING";
   if(gConfirmedArrowDirection!=DIR_FLAT) return "LOCKED IN";
   return "CALM";
}

void DrawGuardianMascot(int panelX,int panelY)
{
   UpdateGuardianEvolution();

   int centerX=panelX+77;
   int bob=(AnimateGuardian && (gUIFrame%2)==1 ? 2 : 0);
   bool blink=(AnimateGuardian && (gUIFrame%6)==0);
   bool positive=(BasketProfit()>0.0 || AccountEquity()>AccountBalance());
   bool negative=(BasketProfit()<0.0 || gSafetyBlockReason!="");

   UISetLabel("MASCOT_TITLE","DEADSHOT GUARDIAN",centerX,panelY+18,9,HTGold,
              "Arial Bold",ANCHOR_CENTER);

   string face="(o_o)";
   if(blink) face="(-_-)";
   if(positive && !blink) face="(^_^)";
   if(negative && !blink) face="(>_<)";

   UISetLabel("MASCOT_HEAD",face,centerX,panelY+73+bob,22,HTGoldBright,
              "Consolas",ANCHOR_CENTER);

   UIDelete("MASCOT_EYES");
   UIDelete("MASCOT_MOUTH");

   if(gGuardianEvolution>=2)
   {
      UISetPanel("MASCOT_BODY",centerX-23,panelY+105,46,50,HTBlack,HTGold);
      UISetLabel("MASCOT_BODY_TEXT","DS",centerX,panelY+130,11,HTGoldBright,
                 "Arial Bold",ANCHOR_CENTER);
   }
   else
   {
      UIDelete("MASCOT_BODY"); UIDelete("MASCOT_BODY_TEXT");
   }

   if(gGuardianEvolution>=3)
   {
      int armShift=(AnimateGuardian && positive ? (gUIFrame%2)*4 : 0);
      UISetLabel("MASCOT_ARM_L","/",centerX-33,panelY+119-armShift,24,HTGold,
                 "Consolas",ANCHOR_CENTER);
      UISetLabel("MASCOT_ARM_R","\\",centerX+33,panelY+119-armShift,24,HTGold,
                 "Consolas",ANCHOR_CENTER);
      UISetLabel("MASCOT_HAND_L","o",centerX-45,panelY+104-armShift,10,HTGoldBright,
                 "Consolas",ANCHOR_CENTER);
      UISetLabel("MASCOT_HAND_R","o",centerX+45,panelY+104-armShift,10,HTGoldBright,
                 "Consolas",ANCHOR_CENTER);
   }
   else
   {
      UIDelete("MASCOT_ARM_L"); UIDelete("MASCOT_ARM_R");
      UIDelete("MASCOT_HAND_L"); UIDelete("MASCOT_HAND_R");
   }

   if(gGuardianEvolution>=4)
   {
      int legShift=(AnimateGuardian ? (gUIFrame%2)*2 : 0);
      UISetLabel("MASCOT_LEG_L","/",centerX-12-legShift,panelY+165,24,HTGold,
                 "Consolas",ANCHOR_CENTER);
      UISetLabel("MASCOT_LEG_R","\\",centerX+12+legShift,panelY+165,24,HTGold,
                 "Consolas",ANCHOR_CENTER);
      UISetLabel("MASCOT_FOOT_L","_",centerX-23-legShift,panelY+178,13,HTGoldBright,
                 "Consolas",ANCHOR_CENTER);
      UISetLabel("MASCOT_FOOT_R","_",centerX+23+legShift,panelY+178,13,HTGoldBright,
                 "Consolas",ANCHOR_CENTER);
   }
   else
   {
      UIDelete("MASCOT_LEG_L"); UIDelete("MASCOT_LEG_R");
      UIDelete("MASCOT_FOOT_L"); UIDelete("MASCOT_FOOT_R");
   }

   UISetLabel("MASCOT_MOOD",GuardianMoodText(),centerX,panelY+190,9,
              (negative?HTAlert:HTGoldBright),"Arial Bold",ANCHOR_CENTER);
   UISetLabel("MASCOT_LEVEL","EVOLUTION "+IntegerToString(gGuardianEvolution)+" / 4",
              centerX,panelY+204,8,HTMuted,"Arial",ANCHOR_CENTER);
}

void UIDataRow(string id,string label,string value,int x,int y,color valueColor)
{
   UISetLabel("ROW_"+id+"_L",label,x,y,8,HTMuted,"Arial",ANCHOR_LEFT_UPPER);
   UISetLabel("ROW_"+id+"_V",value,x+142,y,9,valueColor,"Arial Bold",ANCHOR_LEFT_UPPER);
}

string DashboardFocusText(int focus)
{
   if(focus==DASH_FOCUS_FULL_COMMAND_CENTER) return "FULL COMMAND";
   if(focus==DASH_FOCUS_IL_TRAIN_STATION) return "IL TRAIN STATION";
   if(focus==DASH_FOCUS_MARKET_STRUCTURE) return "MARKET STRUCTURE";
   if(focus==DASH_FOCUS_ACTIVE_CAMPAIGN) return "ACTIVE CAMPAIGN";
   if(focus==DASH_FOCUS_VAULT_AND_RISK) return "VAULT + RISK";
   if(focus==DASH_FOCUS_MINIMAL) return "MINIMAL";
   if(focus==DASH_FOCUS_COMPOUND_STAIRCASE) return "COMPOUND STAIRCASE";
   return "AUTO";
}

int ResolveDashboardFocus()
{
   if(DashboardFocus!=DASH_FOCUS_AUTO) return (int)DashboardFocus;
   if(EnableCompoundStaircase && (gCompoundEntryFreeze || gCompoundProgress>=50.0 ||
      AccountBalance()<=MathMax(1.0,MicroAccountThreshold))) return DASH_FOCUS_COMPOUND_STAIRCASE;
   if(TradeCount()>0) return DASH_FOCUS_ACTIVE_CAMPAIGN;
   if(gPyrBuyStationArmed || gPyrSellStationArmed || gPyrStationCandidate!=DIR_FLAT)
      return DASH_FOCUS_IL_TRAIN_STATION;
   if(gSafetyBlockReason!="") return DASH_FOCUS_VAULT_AND_RISK;
   return DASH_FOCUS_MARKET_STRUCTURE;
}

void DrawPyramidFocusDashboard(int focus,int x,int y)
{
   int width=(focus==DASH_FOCUS_MINIMAL ? 500 : 650);
   int height=(focus==DASH_FOCUS_MINIMAL ? 150 : 430);
   UISetPanel("BASE",x,y,width,height,HTPanel,HTGoldDark);
   UISetPanel("HEADER",x+8,y+8,width-16,44,HTBlack,HTGold);
   UISetLabel("TITLE","HIGHTOWER PYRAMID • "+DashboardFocusText(focus),x+24,y+20,12,
              HTGoldBright,"Arial Bold",ANCHOR_LEFT_UPPER);
   UISetLabel("SUBTITLE",Symbol()+"  •  v3.16  •  MARKET DNA",
              x+24,y+40,8,HTMuted,"Arial",ANCHOR_LEFT_UPPER);

   double trainPrice=(gPyrCampaignDirection==DIR_BUY ? Bid : Ask);
   double progress=(TradeCount()>0 ? PyrDirectionalProgress(gPyrCampaignDirection,trainPrice)*100.0 : 0.0);
   color liveColor=(BasketProfit()>=0.0?HTGoldBright:HTAlert);

   if(focus==DASH_FOCUS_MINIMAL)
   {
      UIDataRow("MIN_STATE","STATE",UIShortText(gPyrState,48),x+24,y+67,HTText);
      UIDataRow("MIN_PNL","TRAIN P/L","$"+DoubleToString(BasketProfit(),2),x+24,y+91,liveColor);
      UIDataRow("MIN_TRAIL","TRAIL",gPyrCampaignProven?"ACTIVE":"LOCKED UNTIL 50%",x+24,y+115,
                gPyrCampaignProven?HTGoldBright:HTMuted);
      ChartRedraw(0); return;
   }

   UISetPanel("FOCUS_BODY",x+12,y+62,width-24,height-78,HTPanelSoft,HTCharcoal);
   if(focus==DASH_FOCUS_COMPOUND_STAIRCASE)
   {
      string micro=(AccountBalance()<=MathMax(1.0,MicroAccountThreshold)?
                    "MICRO "+IntegerToString(PyrRuntimeMaxEntries())+" CAR" : "STANDARD RAPID 6");
      UIDataRow("CP1","CYCLE / PHASE",IntegerToString(gCompoundCycle)+" / "+CompoundPhaseText(),x+28,y+82,HTGoldBright);
      UIDataRow("CP2","CAMPAIGN BASE -> TARGET","$"+DoubleToString(gCompoundAnchor,2)+" -> $"+
                DoubleToString(gCompoundTarget,2),x+28,y+108,HTText);
      UIDataRow("CP3","CAMPAIGN GOAL","$"+DoubleToString(gCompoundBaseGoalMoney,2),
                x+28,y+134,HTText);
      UIDataRow("CP4","BALANCE / MUST COLLECT","$"+DoubleToString(AccountBalance(),2)+" / $"+
                DoubleToString(gCompoundRequiredMoney,2)+" ("+DoubleToString(gCompoundRequiredPercent,2)+"%)",x+28,y+160,
                HTText);
      UIDataRow("CP5","LIVE / STILL NEEDED","$"+DoubleToString(AccountBalance()+BasketProfit(),2)+" / $"+
                DoubleToString(gCompoundLiveRemaining,2),x+28,y+186,gCompoundProgress>=100.0?HTGoldBright:HTText);
      UIDataRow("CP6","PROGRESS / UNLOCK",DoubleToString(gCompoundProgress,1)+"% / "+
                IntegerToString(gCompoundUnlockTicks)+" of "+IntegerToString(MathMax(1,CompoundUnlockConfirmationTicks)),x+28,y+212,HTText);
      UIDataRow("CP7","ENTRY / RECEIPT",micro+" | "+(gCompoundEntryFreeze?"FROZEN":"OPEN")+" | "+
                UIShortText(gCompoundReceipt,24),x+28,y+238,
                gCompoundEntryFreeze?HTAlert:HTGoldBright);
   }
   else if(focus==DASH_FOCUS_IL_TRAIN_STATION)
   {
      UIDataRow("FS1","PY HIGH BUY STATION",DoubleToString(gPyrBuyStation,Digits)+"  "+
                (gPyrBuyStationArmed?(gPyrBuyStationReady?"ARMED":"USED/RESET"):"WAIT RECLAIM"),x+28,y+82,HTGoldBright);
      UIDataRow("FS2","PY LOW SELL STATION",DoubleToString(gPyrSellStation,Digits)+"  "+
                (gPyrSellStationArmed?(gPyrSellStationReady?"ARMED":"USED/RESET"):"WAIT BREAKDOWN"),x+28,y+108,HTAlert);
      UIDataRow("FS3","STATION / RECLAIM",UIShortText(gPyrState,45),x+28,y+134,HTText);
      UIDataRow("FS4","TRAIN DIRECTION",(gPyrRouteActive ? (gPyrRouteDirection==DIR_BUY?"BUY ROUTE":"SELL ROUTE") : (gPyrCampaignDirection==DIR_BUY?"BUY":"IN STATION")),x+28,y+160,HTGoldBright);
      UIDataRow("FS5","DESTINATION",gPyrTarget>0.0?DoubleToString(gPyrTarget,Digits):"WAITING",x+28,y+186,HTText);
      UIDataRow("FS6","ROUTE PROGRESS",DoubleToString(progress,0)+"%",x+28,y+212,progress>=50.0?HTGoldBright:HTText);
      UIDataRow("FS7","TRAIL GATE",gPyrCampaignProven?"OPEN":"LOCKED UNTIL 50%",x+28,y+238,gPyrCampaignProven?HTGoldBright:HTMuted);
   }
   else if(focus==DASH_FOCUS_MARKET_STRUCTURE)
   {
      UIDataRow("ST1","PY HIGH",gPyrHighClass+"  "+DoubleToString(gPyrHigh1,Digits),x+28,y+82,HTAlert);
      UIDataRow("ST2","PY LOW",gPyrLowClass+"  "+DoubleToString(gPyrLow1,Digits),x+28,y+108,HTGoldBright);
      UIDataRow("ST3","CURRENT LEG",gPyrLeg,x+28,y+134,HTText);
      UIDataRow("ST4","RSI / STRETCH",DoubleToString(gPyrRSI,1)+" / "+DoubleToString(gPyrStretch*100.0,0)+"%",x+28,y+160,HTText);
      UIDataRow("ST5","WICK RATIO",DoubleToString(gPyrWickRatio,2),x+28,y+186,HTText);
      UIDataRow("ST6","ENTRY AUTHORITY","ARROW PERMISSION + BOS/TRAIN TRIGGER",x+28,y+212,HTGoldBright);
      UIDataRow("ST7","LAST ACTION",UIShortText(gPyrLastAction,44),x+28,y+238,HTMuted);
   }
   else if(focus==DASH_FOCUS_ACTIVE_CAMPAIGN)
   {
      UIDataRow("CA1","TRAIN",(gPyrRouteActive ? (gPyrRouteDirection==DIR_BUY?"BUY TRAIN":"SELL TRAIN") : "IN STATION"),x+28,y+82,HTGoldBright);
      UIDataRow("CA2","OPEN / LOTS",IntegerToString(TradeCount())+" / "+DoubleToString(TotalLots(),2),x+28,y+108,HTText);
      UIDataRow("CA3","CAMPAIGN P/L","$"+DoubleToString(BasketProfit(),2),x+28,y+134,liveColor);
      UIDataRow("CA4","ENTRY ? DEST",DoubleToString(gPyrEntryAnchor,Digits)+" ? "+DoubleToString(gPyrTarget,Digits),x+28,y+160,HTText);
      UIDataRow("CA5","PROGRESS",DoubleToString(progress,0)+"%",x+28,y+186,progress>=50.0?HTGoldBright:HTText);
      UIDataRow("CA6","TRAIL",gPyrCampaignProven?"ACTIVE":"NO TRAIL BEFORE 50%",x+28,y+212,gPyrCampaignProven?HTGoldBright:HTMuted);
      UIDataRow("CA7","INVALIDATION",DoubleToString(gPyrInvalidation,Digits),x+28,y+238,HTAlert);
   }
   else
   {
      double floating=AccountEquity()-AccountBalance();
      UIDataRow("VR1","BALANCE","$"+DoubleToString(AccountBalance(),2),x+28,y+82,HTText);
      UIDataRow("VR2","EQUITY","$"+DoubleToString(AccountEquity(),2),x+28,y+108,HTText);
      UIDataRow("VR3","FLOATING","$"+DoubleToString(floating,2),x+28,y+134,floating>=0?HTGoldBright:HTAlert);
      UIDataRow("VR4","RISK / CAP",DoubleToString(RiskPerEntryPercent,0)+"% / "+DoubleToString(MaximumCampaignRiskPercent,0)+"%",x+28,y+160,HTText);
      UIDataRow("VR5","STRUCTURE ROOM",DoubleToString(gPyrProjectedAdvantage,2)+"R INFO",x+28,y+186,HTGoldBright);
      UIDataRow("VR6","SPREAD",DoubleToString(SpreadPoints(),0)+" pts",x+28,y+212,HTText);
      UIDataRow("VR7","SAFETY",gSafetyBlockReason==""?"READY":UIShortText(gSafetyBlockReason,42),x+28,y+238,gSafetyBlockReason==""?HTGoldBright:HTAlert);
   }

   if(ShowUnityGauges)
   {
      UISetDivider("UNITY_GAUGE_DIV",x+25,y+284,width-50,HTCharcoal);
      int gaugeY=y+335;
      UIDrawGauge("U_TREND",x+75,gaugeY,25,TrendGaugeValue(),"TREND","ARROW",HTGoldBright);
      UIDrawGauge("U_MOM",x+200,gaugeY,25,MomentumGaugeValue(),"MOMENTUM","CANDLE",HTGoldBright);
      UIDrawGauge("U_GRIP",x+325,gaugeY,25,GripGaugeValue(),"GRIP","CONFIRM",HTGoldBright);
      UIDrawGauge("U_RSI",x+450,gaugeY,25,RSIRunwayGaugeValue(),"RSI RUNWAY",DoubleToString(gPyrRSI,0),HTGoldBright);
      UIDrawGauge("U_ROUTE",x+575,gaugeY,25,StationProgressGaugeValue(),"STATION","ROUTE",HTGoldBright);
      UISetLabel("WISDO_STATE","WISDO VOICE: "+(EnableWisdoVoiceControl?(gWisdoPaused?"PAUSED":"LIVE"):"OFF")+
                 "  | "+UIShortText(gWisdoLastAction,48),x+25,y+397,8,
                 gWisdoPaused?HTAlert:HTGoldBright,"Arial Bold",ANCHOR_LEFT_UPPER);
   }
   UISetLabel("FOCUS_HINT","FOCUS: "+DashboardFocusText(focus)+"  | One Mind: Arrow Permission + Structure Trigger",
              x+24,y+height-18,8,HTMuted,"Arial",ANCHOR_LEFT_UPPER);
   ChartRedraw(0);
}

color WillHealthColor(double health)
{
   if(health<25.0) return C'230,55,55';
   if(health<45.0) return C'255,128,32';
   if(health<65.0) return C'241,196,15';
   if(health<82.0) return C'62,210,125';
   return C'52,220,235';
}

double WillEdgeHealth()
{ return UIClamp(50.0+gWillEdge*50.0,0.0,100.0); }

double WillRecoveryHealth()
{
   if(TradeCount()<=0) return 75.0;
   double risk=RiskHealthGaugeValue();
   double pulse=(MomentumGaugeValue()+GripGaugeValue())*0.50;
   if(BasketProfit()>=0.0) return UIClamp(70.0+0.30*pulse,0.0,100.0);
   return UIClamp(0.60*risk+0.40*pulse,0.0,100.0);
}

double WillExecutionHealth()
{
   if(gSafetyBlockReason!="") return 10.0;
   double spreadHealth=100.0;
   double atr=MathMax(Point,HTExecutionATR(SignalTF,StopATRPeriodValue));
   if(atr>0.0) spreadHealth=UIClamp(100.0-(Ask-Bid)/atr*250.0,0.0,100.0);
   return UIClamp(0.55*RiskHealthGaugeValue()+0.45*spreadHealth,0.0,100.0);
}

void UIDrawDNAStrand(string id,string label,double health,int x,int y,int width)
{
   int cells=18,gap=2,cellW=MathMax(3,(width-(cells-1)*gap)/cells);
   int live=(int)MathRound(UIClamp(health,0.0,100.0)/100.0*cells);
   int pulse=(gUIFrame/MathMax(1,DNAAnimationSpeed))%cells;
   color flow=WillHealthColor(health);
   UISetLabel("DNA_"+id+"_L",label,x,y-1,7,HTMuted,"Arial Bold",ANCHOR_LEFT_UPPER);
   for(int i=0;i<cells;i++)
   {
      color c=(i<live?flow:HTCharcoal);
      if(i<live && i==pulse) c=HTText;
      UISetPanel("DNA_"+id+"_"+IntegerToString(i),x+76+i*(cellW+gap),y,cellW,7,c,c);
   }
   UISetLabel("DNA_"+id+"_V",IntegerToString((int)MathRound(health))+"%",x+width+82,y-2,7,flow,
              "Arial Bold",ANCHOR_RIGHT_UPPER);
}

void UIDrawEVACore(int centerX,int centerY,double health)
{
   color core=WillHealthColor(health);
   int frame=(gUIFrame/MathMax(1,DNAAnimationSpeed));
   int pulse=AnimateEVACore?(frame%6):2;
   int radius=17+pulse;
   UISetLabel("EVA_TITLE","EVA MARKET CORE",centerX,centerY-35,7,HTMuted,"Arial Bold",ANCHOR_CENTER);
   UISetLabel("EVA_CORE","?",centerX,centerY,25,core,"Arial",ANCHOR_CENTER);
   UISetLabel("EVA_INNER","•",centerX,centerY,12,HTText,"Arial",ANCHOR_CENTER);
   for(int i=0;i<8;i++)
   {
      double a=(frame*0.20+i*0.78539816339);
      int px=centerX+(int)MathRound(MathCos(a)*radius);
      int py=centerY+(int)MathRound(MathSin(a)*radius);
      UISetLabel("EVA_ORBIT_"+IntegerToString(i),"•",px,py,9,(i==frame%8?HTText:core),"Arial",ANCHOR_CENTER);
   }
}

void UIDrawSURFWave(int x,int y,int width,double health)
{
   int points=32;
   int frame=(gUIFrame/MathMax(1,DNAAnimationSpeed));
   color wave=WillHealthColor(health);
   UISetLabel("SURF_TITLE","SURF • LIVE MARKET ENERGY",x,y-15,7,HTMuted,"Arial Bold",ANCHOR_LEFT_UPPER);
   for(int i=0;i<points;i++)
   {
      double phase=(AnimateSURFWave?frame*0.35:0.0)+i*0.55;
      int px=x+(int)MathRound((double)i/(points-1)*width);
      int py=y+(int)MathRound(MathSin(phase)*7.0);
      UISetLabel("SURF_"+IntegerToString(i),"•",px,py,8,(i==frame%points?HTText:wave),"Arial",ANCHOR_CENTER);
   }
}

void DrawWillDNADashboard()
{
   int width=368,height=526;
   long chartWidth=0; ChartGetInteger(0,CHART_WIDTH_IN_PIXELS,0,chartWidth);
   int x=(DashboardDockRight?MathMax(0,(int)chartWidth-width-MathMax(0,DashboardRightMargin)):MathMax(0,DashboardX));
   int y=MathMax(0,DashboardY);
   double hRisk=RiskHealthGaugeValue(),hEdge=WillEdgeHealth(),hMomentum=MomentumGaugeValue();
   double hRecovery=WillRecoveryHealth(),hCompound=UIClamp(gCompoundProgress,0.0,100.0);
   double hExecution=WillExecutionHealth();
   double overall=0.24*hRisk+0.20*hEdge+0.16*hMomentum+0.16*hRecovery+0.14*hExecution+0.10*hCompound;
   color mood=WillHealthColor(overall);

   UISetPanel("WILL_BASE",x,y,width,height,C'5,9,15',mood);
   UISetPanel("WILL_HEADER",x+7,y+7,width-14,55,C'8,16,27',mood);
   UISetLabel("WILL_TITLE","HIGHTOWER • WILL / LEGACY DNA",x+18,y+18,12,HTText,"Arial Bold",ANCHOR_LEFT_UPPER);
   UISetLabel("WILL_SUB",Symbol()+"  v3.16  •  "+gWillState,x+18,y+41,8,mood,"Arial Bold",ANCHOR_LEFT_UPPER);
   UIDrawEVACore(x+width-52,y+34,overall);

   UISetLabel("WILL_HEALTH","DNA HEALTH  "+IntegerToString((int)MathRound(overall))+"%",x+18,y+76,10,mood,"Arial Bold",ANCHOR_LEFT_UPPER);
   UISetLabel("WILL_PULSE",(gUIFrame%2==0?"? PULSE":"? PULSE"),x+width-18,y+76,9,mood,"Arial Bold",ANCHOR_RIGHT_UPPER);
   UIDrawDNAStrand("RISK","RISK",hRisk,x+18,y+105,width-120);
   UIDrawDNAStrand("EDGE","EDGE",hEdge,x+18,y+124,width-120);
   UIDrawDNAStrand("MOM","MOMENTUM",hMomentum,x+18,y+143,width-120);
   UIDrawDNAStrand("REC","RECOVERY",hRecovery,x+18,y+162,width-120);
   UIDrawDNAStrand("CMP","COMPOUND",hCompound,x+18,y+181,width-120);
   UIDrawDNAStrand("EXEC","EXECUTION",hExecution,x+18,y+200,width-120);

   UISetDivider("WILL_DIV1",x+18,y+222,width-36,HTCharcoalLight);
   UIDataRow("W1","CYCLE / TARGET",IntegerToString(gCompoundCycle)+" / $"+DoubleToString(gCompoundBaseGoalMoney,2),x+18,y+236,mood);
   UIDataRow("W2","PROGRESS",DoubleToString(gCompoundProgress,1)+"%  •  $"+DoubleToString(gCompoundLiveRemaining,2)+" LEFT",x+18,y+258,hCompound>=80?HTGoldBright:HTText);
   UIDataRow("W3","BASKET ENERGY","$"+DoubleToString(BasketProfit(),2)+"  •  "+IntegerToString(TradeCount())+" CARS",x+18,y+280,BasketProfit()>=0?HTGoldBright:HTAlert);
   UIDataRow("W4","LEARNED EDGE",DoubleToString(gWillEdge,3)+" CTU  •  "+DoubleToString(gWillConfidence*100.0,0)+"% CONF",x+18,y+302,hEdge>=55?HTGoldBright:HTMuted);
   UIDataRow("W5","TARGET RECORD",DoubleToString(gWillTargets,0)+"  •  STREAK "+IntegerToString(gWillConsecutiveTargets),x+18,y+324,HTText);
   UIDataRow("W6","LIFETIME CTU",DoubleToString(gWillLifetimeCTU,2)+"  •  N "+DoubleToString(gWillCampaigns,0),x+18,y+346,HTText);
   UIDataRow("W7","AVG TARGET TIME",(gWillTimeEWMA>0?IntegerToString((int)gWillTimeEWMA)+"s":"LEARNING"),x+18,y+368,HTText);
   UIDataRow("W8","WILL STATE",UIShortText(gWillLastLesson,29),x+18,y+390,mood);

   UISetDivider("WILL_DIV2",x+18,y+416,width-36,HTCharcoalLight);
   UIDrawSURFWave(x+20,y+452,width-40,overall);
   UISetLabel("WILL_MODE",CompoundPhaseText()+"  •  "+DashboardStatusText(),x+18,y+474,8,mood,"Arial Bold",ANCHOR_LEFT_UPPER);
   UISetLabel("WILL_SAFETY","ATR "+ATRStopText()+"  •  SAFETY DNA IMMUTABLE",x+18,y+494,7,HTMuted,"Arial",ANCHOR_LEFT_UPPER);
   ChartRedraw(0);
}

void DrawProfessionalDashboard()
{
   if(!ShowDashboard)
   {
      DeleteObjectsWithPrefix(Pfx()+"UI_");
      return;
   }

   if(HT6EinsteinEnabled())
   {
      DrawEinsteinFlowDashboard();
      return;
   }

   if(ShowWillDNADashboard)
   {
      if(gLastDashboardFocus!=999) { DeleteObjectsWithPrefix(Pfx()+"UI_"); gLastDashboardFocus=999; }
      if(EnableMarketDNA) DrawMarketDNADashboard();
      else DrawWillDNADashboard();
      return;
   }

   int x=MathMax(0,DashboardX);
   int y=MathMax(0,DashboardY);
   gResolvedDashboardFocus=ResolveDashboardFocus();
   if(gResolvedDashboardFocus!=gLastDashboardFocus)
   {
      DeleteObjectsWithPrefix(Pfx()+"UI_");
      gLastDashboardFocus=gResolvedDashboardFocus;
   }
   if(gResolvedDashboardFocus!=DASH_FOCUS_FULL_COMMAND_CENTER)
   {
      DrawPyramidFocusDashboard(gResolvedDashboardFocus,x,y);
      return;
   }
   int width=920;
   int height=535;

   UISetPanel("BASE",x,y,width,height,HTPanel,HTGoldDark);
   UISetPanel("HEADER",x+8,y+8,width-16,45,HTBlack,HTGold);
   UISetLabel("TITLE","HIGHTOWER WISDO UNITY COMMAND CENTER",x+25,y+20,14,
              HTGoldBright,"Arial Bold",ANCHOR_LEFT_UPPER);
   UISetLabel("SUBTITLE",Symbol()+"  •  "+IntegerToString((int)SignalTF)+
              " MIN SIGNAL  •  v2.13",x+25,y+40,8,HTMuted,"Arial",ANCHOR_LEFT_UPPER);

   string status=DashboardStatusText();
   UISetPanel("STATUS_PILL",x+718,y+17,182,28,HTPanelSoft,DashboardStatusColor());
   UISetLabel("STATUS_TEXT",status,x+809,y+31,9,DashboardStatusColor(),
              "Arial Bold",ANCHOR_CENTER);

   UISetPanel("GAUGE_PANEL",x+12,y+62,390,220,HTPanelSoft,HTCharcoal);
   UISetLabel("GAUGE_HEADER","MARKET INTELLIGENCE",x+27,y+75,9,HTGold,
              "Arial Bold",ANCHOR_LEFT_UPPER);
   UISetDivider("GAUGE_DIV",x+25,y+94,362,HTCharcoal);

   int arrow=WeightArrowDirection();
   string arrowText=(arrow==DIR_BUY?"BUY":(arrow==DIR_SELL?"SELL":"FLAT"));
   color riskColor=(RiskHealthGaugeValue()<35.0?HTAlert:HTGoldBright);
   color profitColor=(ProfitEnergyGaugeValue()<40.0?HTAlert:HTGoldBright);
   UIDrawGauge("TREND",x+82,y+160,38,TrendGaugeValue(),"TREND POWER",arrowText,HTGoldBright);
   UIDrawGauge("RISK",x+207,y+160,38,RiskHealthGaugeValue(),"RISK HEALTH",
               gSafetyBlockReason==""?"READY":"BLOCKED",riskColor);
   UIDrawGauge("PROFIT",x+332,y+160,38,ProfitEnergyGaugeValue(),"PROFIT ENERGY",
               "$"+DoubleToString(BasketProfit(),2),profitColor);

   UISetPanel("MASCOT_PANEL",x+412,y+62,158,220,HTPanelSoft,HTGoldDark);
   DrawGuardianMascot(x+414,y+63);

   UISetPanel("DATA_PANEL",x+580,y+62,328,220,HTPanelSoft,HTCharcoal);
   UISetLabel("DATA_HEADER","LIVE ACCOUNT + SIGNAL DATA",x+596,y+75,9,HTGold,
              "Arial Bold",ANCHOR_LEFT_UPPER);
   UISetDivider("DATA_DIV",x+594,y+94,300,HTCharcoal);

   double floating=AccountEquity()-AccountBalance();
   color floatingColor=(floating<0.0?HTAlert:(floating>0.0?HTGoldBright:HTText));
   string confirmed=(gConfirmedArrowDirection==DIR_BUY?"BUY":
                    (gConfirmedArrowDirection==DIR_SELL?"SELL":"WAIT"));
   string ichi=(gConfirmedArrowDirection==DIR_BUY ?
                (IchimokuAllows(DIR_BUY)?"BUY PASS":"BUY BLOCK") :
                (gConfirmedArrowDirection==DIR_SELL ?
                 (IchimokuAllows(DIR_SELL)?"SELL PASS":"SELL BLOCK") : "WAIT"));

   UIDataRow("BAL","BALANCE","$"+DoubleToString(AccountBalance(),2),x+596,y+108,HTText);
   UIDataRow("EQ","EQUITY","$"+DoubleToString(AccountEquity(),2),x+596,y+130,HTText);
   UIDataRow("FLOAT","FLOATING","$"+DoubleToString(floating,2),x+596,y+152,floatingColor);
   UIDataRow("SPREAD","SPREAD",DoubleToString(SpreadPoints(),0)+" pts",x+596,y+174,HTText);
   UIDataRow("TRADES","OPEN TRADES",IntegerToString(TradeCount())+" / "+
             IntegerToString(SafeMaximumEntries),x+596,y+196,HTText);
   UIDataRow("RISK","RISK / CAP",DoubleToString(RiskPerEntryPercent,0)+"% / "+
             DoubleToString(MaximumCampaignRiskPercent,0)+"%",x+596,y+218,HTText);
   UIDataRow("ARROW","ARROW",confirmed+" F="+DoubleToString(gHT5FormulaArrowScore,2)+
             " C="+DoubleToString(gHT5FormulaArrowConfidence,2),x+596,y+240,HTGoldBright);
   UIDataRow("ICHI","CLOUD FILTER",ichi,x+596,y+262,(StringFind(ichi,"PASS",0)>=0?HTGoldBright:HTMuted));

   if(ShowSovereignScale)
   {
      UISetPanel("SOV_PANEL",x+12,y+292,width-24,160,HTPanelSoft,HTGoldDark);
      UISetLabel("SOV_TITLE","SOVEREIGN WEIGHT + VAULT COMMAND CENTER",
                 x+27,y+302,9,HTGoldBright,"Arial Bold",ANCHOR_LEFT_UPPER);

      UIDrawSovereignBalanceScale(x+25,y+316,315,118);
      UIDrawVaultVisual(x+350,y+316,210,118);
      UIDrawGravityVisual(x+575,y+323,305);
      UIDrawOxTrain(x+575,y+382,305);

      UISetLabel("SOV_RISK_CFG",
                 "ATR ONLY  "+ATRStopText()+
                 "  | SELECTED RISK "+DoubleToString(RiskPerEntryPercent,0)+"%"+
                 "  | EFFECTIVE OX "+DoubleToString(SovereignOxRiskPercent(),2)+"%"+
                 "  | MAX "+DoubleToString(MaximumCampaignRiskPercent,0)+"%",
                 x+27,y+439,8,HTText,"Arial",ANCHOR_LEFT_UPPER);
   }

   UISetPanel("EVENT_PANEL",x+12,y+462,width-24,55,HTBlack,HTGoldDark);
   UISetLabel("EVENT_TITLE","LIVE EVENT FEED",x+27,y+473,8,HTGold,"Arial Bold",ANCHOR_LEFT_UPPER);
   string eventText=UIShortText(gPyrPeakObservationActive?gPyrTransitionState:gEntryStatus,105);
   if(gSafetyBlockReason!="") eventText=UIShortText(gSafetyBlockReason,105);
   UISetLabel("EVENT_TEXT",eventText,x+27,y+493,9,
              (gSafetyBlockReason!=""?HTAlert:HTText),"Arial",ANCHOR_LEFT_UPPER);
   UISetLabel("BROKER_TIME","BROKER "+BrokerClockText()+"  |  START "+StartTradingTimeText()+
              "  |  LOTS "+DoubleToString(TotalLots(),2),x+894,y+493,8,HTMuted,
              "Arial",ANCHOR_RIGHT_UPPER);

   ChartRedraw(0);
}

bool IsOurOpenTicket(int ticket)
{
   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;
      if(OrderTicket()==ticket) return true;
   }
   return false;
}

void DrawStopLossLines()
{
   string prefix=Pfx()+"SL_";

   // Remove lines for positions that are no longer open.
   for(int n=ObjectsTotal()-1;n>=0;n--)
   {
      string objectName=ObjectName(n);
      if(StringFind(objectName,prefix,0)!=0) continue;
      int ticket=(int)StringToInteger(StringSubstr(objectName,StringLen(prefix)));
      if(ticket<=0 || !IsOurOpenTicket(ticket)) ObjectDelete(0,objectName);
   }

   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;
      if(OrderStopLoss()<=0.0) continue;

      string name=prefix+IntegerToString(OrderTicket());
      if(ObjectFind(0,name)<0) ObjectCreate(0,name,OBJ_HLINE,0,0,OrderStopLoss());
      ObjectSetDouble(0,name,OBJPROP_PRICE1,OrderStopLoss());
      ObjectSetInteger(0,name,OBJPROP_COLOR,clrRed);
      ObjectSetInteger(0,name,OBJPROP_STYLE,STYLE_SOLID);
      ObjectSetInteger(0,name,OBJPROP_WIDTH,3);
      ObjectSetInteger(0,name,OBJPROP_BACK,false);
      ObjectSetInteger(0,name,OBJPROP_SELECTABLE,false);
      ObjectSetInteger(0,name,OBJPROP_HIDDEN,true);
      ObjectSetString(0,name,OBJPROP_TOOLTIP,
                      "STOP LOSS #"+IntegerToString(OrderTicket())+
                      "  "+DoubleToString(OrderStopLoss(),Digits));
   }
}

datetime IchimokuCloudTime(int chartShift)
{
   if(chartShift>=0) return iTime(Symbol(),SignalTF,chartShift);
   datetime currentBar=iTime(Symbol(),SignalTF,0);
   return currentBar+(datetime)(-chartShift*PeriodSeconds(SignalTF));
}

bool IchimokuCloudValue(int chartShift,double &spanA,double &spanB)
{
   spanA=0.0; spanB=0.0;
   int sourceShift=chartShift+IchimokuKijunPeriod;
   if(sourceShift<0) return false;
   if(iBars(Symbol(),SignalTF)<=sourceShift+IchimokuSpanBPeriod+2) return false;

   spanA=iIchimoku(Symbol(),SignalTF,IchimokuTenkanPeriod,IchimokuKijunPeriod,
                   IchimokuSpanBPeriod,MODE_SENKOUSPANA,sourceShift);
   spanB=iIchimoku(Symbol(),SignalTF,IchimokuTenkanPeriod,IchimokuKijunPeriod,
                   IchimokuSpanBPeriod,MODE_SENKOUSPANB,sourceShift);
   if(spanA==EMPTY_VALUE || spanB==EMPTY_VALUE || spanA<=0.0 || spanB<=0.0) return false;
   return true;
}

void CloudRectangle(string name,datetime t1,datetime t2,double top,double bottom,color c)
{
   if(ObjectFind(0,name)<0) ObjectCreate(0,name,OBJ_RECTANGLE,0,t1,top,t2,bottom);
   ObjectSetInteger(0,name,OBJPROP_TIME1,t1);
   ObjectSetDouble(0,name,OBJPROP_PRICE1,top);
   ObjectSetInteger(0,name,OBJPROP_TIME2,t2);
   ObjectSetDouble(0,name,OBJPROP_PRICE2,bottom);
   ObjectSetInteger(0,name,OBJPROP_COLOR,c);
   ObjectSetInteger(0,name,OBJPROP_STYLE,STYLE_SOLID);
   ObjectSetInteger(0,name,OBJPROP_WIDTH,1);
   ObjectSetInteger(0,name,OBJPROP_FILL,true);
   ObjectSetInteger(0,name,OBJPROP_BACK,true);
   ObjectSetInteger(0,name,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,name,OBJPROP_HIDDEN,true);
}

void CloudLine(string name,datetime t1,double p1,datetime t2,double p2,color c)
{
   if(ObjectFind(0,name)<0) ObjectCreate(0,name,OBJ_TREND,0,t1,p1,t2,p2);
   ObjectSetInteger(0,name,OBJPROP_TIME1,t1);
   ObjectSetDouble(0,name,OBJPROP_PRICE1,p1);
   ObjectSetInteger(0,name,OBJPROP_TIME2,t2);
   ObjectSetDouble(0,name,OBJPROP_PRICE2,p2);
   ObjectSetInteger(0,name,OBJPROP_COLOR,c);
   ObjectSetInteger(0,name,OBJPROP_STYLE,STYLE_SOLID);
   ObjectSetInteger(0,name,OBJPROP_WIDTH,1);
   ObjectSetInteger(0,name,OBJPROP_RAY_RIGHT,false);
   ObjectSetInteger(0,name,OBJPROP_BACK,true);
   ObjectSetInteger(0,name,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,name,OBJPROP_HIDDEN,true);
}

void DrawIchimokuCloudObjects()
{
   string prefix=Pfx()+"ICHI_";
   if(!DrawIchimokuCloud)
   {
      DeleteObjectsWithPrefix(prefix);
      gLastCloudDrawBar=0;
      return;
   }

   datetime signalBar=iTime(Symbol(),SignalTF,0);
   if(signalBar<=0) return;
   if(signalBar==gLastCloudDrawBar && ObjectFind(0,prefix+"F_0")>=0) return;

   DeleteObjectsWithPrefix(prefix);
   int segment=0;
   int oldest=MathMin(IchimokuCloudHistoryBars,iBars(Symbol(),SignalTF)-IchimokuSpanBPeriod-IchimokuKijunPeriod-3);
   int newest=-IchimokuKijunPeriod;
   for(int shift=oldest;shift>newest;shift--)
   {
      int nextShift=shift-1;
      double a1=0.0,b1=0.0,a2=0.0,b2=0.0;
      if(!IchimokuCloudValue(shift,a1,b1) || !IchimokuCloudValue(nextShift,a2,b2)) continue;

      datetime t1=IchimokuCloudTime(shift);
      datetime t2=IchimokuCloudTime(nextShift);
      if(t1<=0 || t2<=0) continue;

      double top=MathMax(MathMax(a1,b1),MathMax(a2,b2));
      double bottom=MathMin(MathMin(a1,b1),MathMin(a2,b2));
      bool bullish=((a1+a2)*0.5>=(b1+b2)*0.5);
      string id=IntegerToString(segment);
      CloudRectangle(prefix+"F_"+id,t1,t2,top,bottom,
                     bullish?IchimokuBullCloudColor:IchimokuBearCloudColor);
      CloudLine(prefix+"A_"+id,t1,a1,t2,a2,IchimokuSpanAColor);
      CloudLine(prefix+"B_"+id,t1,b1,t2,b2,IchimokuSpanBColor);
      segment++;
   }
   gLastCloudDrawBar=signalBar;
   ChartRedraw(0);
}

void TrendLine(string name,datetime t1,double p1,datetime t2,double p2,
               color c,int style,int width)
{
   if(ObjectFind(0,name)<0) ObjectCreate(0,name,OBJ_TREND,0,t1,p1,t2,p2);
   ObjectSetInteger(0,name,OBJPROP_TIME1,t1);
   ObjectSetDouble(0,name,OBJPROP_PRICE1,p1);
   ObjectSetInteger(0,name,OBJPROP_TIME2,t2);
   ObjectSetDouble(0,name,OBJPROP_PRICE2,p2);
   ObjectSetInteger(0,name,OBJPROP_COLOR,c);
   ObjectSetInteger(0,name,OBJPROP_STYLE,style);
   ObjectSetInteger(0,name,OBJPROP_WIDTH,width);
   ObjectSetInteger(0,name,OBJPROP_RAY_RIGHT,false);
   ObjectSetInteger(0,name,OBJPROP_SELECTABLE,false);
}

void DrawWeightArrowHead(datetime when,double price,int dir)
{
   string name=Pfx()+"WEIGHT_HEAD";
   if(dir==DIR_FLAT)
   {
      ObjectDelete(0,name);
      return;
   }
   if(ObjectFind(0,name)<0) ObjectCreate(0,name,OBJ_ARROW,0,when,price);
   ObjectSetInteger(0,name,OBJPROP_TIME1,when);
   ObjectSetDouble(0,name,OBJPROP_PRICE1,price);
   ObjectSetInteger(0,name,OBJPROP_COLOR,WeightLineColor);
   ObjectSetInteger(0,name,OBJPROP_WIDTH,MathMax(2,WeightLineWidth));
   ObjectSetInteger(0,name,OBJPROP_ARROWCODE,dir==DIR_BUY?233:234);
   ObjectSetInteger(0,name,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,name,OBJPROP_HIDDEN,true);
   ObjectSetString(0,name,OBJPROP_TOOLTIP,
                   dir==DIR_BUY?"WEIGHT ARROW: BUY":"WEIGHT ARROW: SELL");
}

void DrawObjects()
{
   if(HT6EinsteinEnabled())
   {
      HT6EinsteinMinimalVisualCleanup();
      HT6EinsteinDrawBox();
      DrawProfessionalDashboard();
      return;
   }
   DrawIchimokuCloudObjects();
   DrawStopLossLines();

   if(DrawTriangle && gHigh>gLow)
   {
      datetime now=TimeCurrent();
      TrendLine(Pfx()+"HP",gHighTime,gHigh,now,gPrice,TriangleColor,STYLE_SOLID,TriangleWidth);
      TrendLine(Pfx()+"PL",now,gPrice,gLowTime,gLow,TriangleColor,STYLE_SOLID,TriangleWidth);
      TrendLine(Pfx()+"HL",gHighTime,gHigh,gLowTime,gLow,TriangleColor,STYLE_SOLID,TriangleWidth);
      datetime mt=(datetime)(((long)gHighTime+(long)gLowTime)/2);
      int arrowDir=WeightArrowDirection();
      TrendLine(Pfx()+"WEIGHT",mt,gMid,now,gPrice,WeightLineColor,STYLE_SOLID,WeightLineWidth);
      DrawWeightArrowHead(now,gPrice,arrowDir);
   }
   else ObjectDelete(0,Pfx()+"WEIGHT_HEAD");

   DrawProfessionalDashboard();
   DrawGlobalClockAndCandleTimer();
}

void DeleteObjects()
{
   ObjectDelete(0,Pfx()+"HP"); ObjectDelete(0,Pfx()+"PL");
   ObjectDelete(0,Pfx()+"HL"); ObjectDelete(0,Pfx()+"WEIGHT"); ObjectDelete(0,Pfx()+"WEIGHT_HEAD");
   ObjectDelete(0,Pfx()+"DASH");
   DeleteObjectsWithPrefix(Pfx()+"UI_");
   DeleteObjectsWithPrefix(Pfx()+"SL_");
   DeleteObjectsWithPrefix(Pfx()+"ICHI_");
   DeleteObjectsWithPrefix(Pfx()+"PYR_LBL_");
   DeleteObjectsWithPrefix(Pfx()+"PYR_RECLAIM_");
   DeleteObjectsWithPrefix(Pfx()+"CLOCK_");
   ObjectDelete(0,Pfx()+"PYR_HIGH"); ObjectDelete(0,Pfx()+"PYR_LOW");
   ObjectDelete(0,Pfx()+"PYR_TARGET"); ObjectDelete(0,Pfx()+"PYR_INVALID");
   ObjectDelete(0,Pfx()+"PYR_TRANSITION_LINE"); ObjectDelete(0,Pfx()+"PYR_TRANSITION_TEXT");
   ObjectDelete(0,Pfx()+"PYR_STATION_BUY_LABEL"); ObjectDelete(0,Pfx()+"PYR_STATION_SELL_LABEL");
   ObjectDelete(0,Pfx()+"PYR_50_GATE"); ObjectDelete(0,Pfx()+"PYR_TRAIN"); ObjectDelete(0,Pfx()+"PYR_TRACK");
}

//---------------------------------------------------------
// WISDO UNITY TRAIN
bool PyrPivotHigh(int shift,int depth)
{
   double value=iHigh(Symbol(),SignalTF,shift);
   if(value<=0.0) return false;
   for(int j=1;j<=depth;j++)
      if(iHigh(Symbol(),SignalTF,shift-j)>=value || iHigh(Symbol(),SignalTF,shift+j)>value) return false;
   return true;
}

bool PyrPivotLow(int shift,int depth)
{
   double value=iLow(Symbol(),SignalTF,shift);
   if(value<=0.0) return false;
   for(int j=1;j<=depth;j++)
      if(iLow(Symbol(),SignalTF,shift-j)<=value || iLow(Symbol(),SignalTF,shift+j)<value) return false;
   return true;
}

bool PyrUpdateSwingMap()
{
   int depth=MathMax(2,(int)PyramidSwingCharacter);
   int bars=iBars(Symbol(),SignalTF);
   int scan=MathMin(MathMax(30,(int)PyramidMapMemory),bars-depth-2);
   if(scan<=depth+5) return false;

   double h1=0.0,h2=0.0,l1=0.0,l2=0.0;
   datetime ht1=0,ht2=0,lt1=0,lt2=0;
   for(int s=depth+1;s<=scan;s++)
   {
      if(h1==0.0 && PyrPivotHigh(s,depth)){ h1=iHigh(Symbol(),SignalTF,s); ht1=iTime(Symbol(),SignalTF,s); }
      else if(h2==0.0 && PyrPivotHigh(s,depth)){ h2=iHigh(Symbol(),SignalTF,s); ht2=iTime(Symbol(),SignalTF,s); }
      if(l1==0.0 && PyrPivotLow(s,depth)){ l1=iLow(Symbol(),SignalTF,s); lt1=iTime(Symbol(),SignalTF,s); }
      else if(l2==0.0 && PyrPivotLow(s,depth)){ l2=iLow(Symbol(),SignalTF,s); lt2=iTime(Symbol(),SignalTF,s); }
      if(h2>0.0 && l2>0.0) break;
   }
   if(h2<=0.0 || l2<=0.0 || h1<=l1) return false;

   gPyrHigh1=h1; gPyrHigh2=h2; gPyrLow1=l1; gPyrLow2=l2;
   gPyrHighTime1=ht1; gPyrHighTime2=ht2; gPyrLowTime1=lt1; gPyrLowTime2=lt2;
   gPyrHighClass=(h1>h2 ? "HH" : "LH");
   gPyrLowClass=(l1>l2 ? "HL" : "LL");
   if(ht1>lt1) gPyrLeg="DOWN FROM "+gPyrHighClass;
   else gPyrLeg="UP FROM "+gPyrLowClass;
   gPyrLastMapBar=iTime(Symbol(),SignalTF,0);
   return true;
}

void PyrSeedTrendFromStructure()
{
   if(gPyrTrendDirection!=DIR_FLAT) return;
   // v3.07: the long-memory channel is the higher-time/long-history regime map.
   // A local LL inside a rising support rail is not allowed to seed SELL trend.
   if(EnableMarketDNAHistoricalChannels && gMDChannelDirection!=DIR_FLAT)
   {
      gPyrTrendDirection=gMDChannelDirection;
      return;
   }
   if(gPyrHighClass=="HH" && gPyrLowClass=="HL") gPyrTrendDirection=DIR_BUY;
   else if(gPyrHighClass=="LH" && gPyrLowClass=="LL") gPyrTrendDirection=DIR_SELL;
   else gPyrTrendDirection=(gPyrHighTime1>gPyrLowTime1 ? DIR_SELL : DIR_BUY);
}

int PyrUpdateConfirmedTrendFlip()
{
   if(PyramidEntryPermissions==ENTRY_BOS_CONTINUATION_ONLY) return DIR_FLAT;
   if(gPyrHigh1<=gPyrLow1) return DIR_FLAT;
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double buffer=atr*MathMax(0.0,BOSBreakBufferATR);
   datetime barTime=iTime(Symbol(),SignalTF,1);
   double o=iOpen(Symbol(),SignalTF,1),c=iClose(Symbol(),SignalTF,1);
   double h=iHigh(Symbol(),SignalTF,1),l=iLow(Symbol(),SignalTF,1);

   // The sweep only arms a possible flip. It never changes trend by itself.
   if(l<gPyrLow1-buffer && c>=gPyrLow1)
   {
      gPyrBullFlipArmed=true; gPyrBullFlipTrigger=h; gPyrBullFlipIdentity=barTime;
      gPyrState="FAILED LOW ARMED - WAIT BULL CANDLE BREAK SELLER STRUCTURE";
   }
   if(h>gPyrHigh1+buffer && c<=gPyrHigh1)
   {
      gPyrBearFlipArmed=true; gPyrBearFlipTrigger=l; gPyrBearFlipIdentity=barTime;
      gPyrState="FAILED HIGH ARMED - WAIT BEAR CANDLE BREAK BUYER STRUCTURE";
   }

   if(gPyrBullFlipArmed && barTime!=gPyrBullFlipIdentity &&
      c>o && c>gPyrBullFlipTrigger+buffer)
   {
      if(EnableMarketDNAHistoricalChannels && !MarketDNAHistoricalChannelAllowsDirection(DIR_BUY))
      { gPyrState="BULL MICRO FLIP BLOCKED BY FALLING RESISTANCE CHANNEL"; return DIR_FLAT; }
      gPyrTrendDirection=DIR_BUY;
      gPyrBullFlipArmed=false; gPyrBearFlipArmed=false;
      gPyrActiveSignalIdentity=barTime;
      gPyrStructureSignalName="CONFIRMED BULL TREND FLIP ";
      gPyrState="BULL TREND FLIP: SELLER MICRO HIGH BROKEN";
      return DIR_BUY;
   }
   if(gPyrBearFlipArmed && barTime!=gPyrBearFlipIdentity &&
      c<o && c<gPyrBearFlipTrigger-buffer)
   {
      if(EnableMarketDNAHistoricalChannels && !MarketDNAHistoricalChannelAllowsDirection(DIR_SELL))
      { gPyrState="BEAR MICRO FLIP BLOCKED BY RISING SUPPORT CHANNEL"; return DIR_FLAT; }
      gPyrTrendDirection=DIR_SELL;
      gPyrBullFlipArmed=false; gPyrBearFlipArmed=false;
      gPyrActiveSignalIdentity=barTime;
      gPyrStructureSignalName="CONFIRMED BEAR TREND FLIP ";
      gPyrState="BEAR TREND FLIP: BUYER MICRO LOW BROKEN";
      return DIR_SELL;
   }
   return DIR_FLAT;
}

int PyrUpdateBOSContinuationGate()
{
   if(PyramidEntryPermissions==ENTRY_CONFIRMED_REVERSALS_ONLY) return DIR_FLAT;
   PyrSeedTrendFromStructure();
   if(gPyrHigh1<=gPyrLow1) return DIR_FLAT;

   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double buffer=atr*MathMax(0.0,BOSBreakBufferATR);
   RefreshRates();
   int raw=DIR_FLAT;
   datetime identity=0;

   // v3.07 CHANNEL BOS: accepted escape from the historical rail outranks a
   // local HH/LL classification. The rail must already have multiple completed
   // closes beyond it; a wick or one-tick pierce is explicitly NOT a BOS.
   int channelBreak=MarketDNAHistoricalChannelBreakGate();
   if(channelBreak!=DIR_FLAT)
   {
      raw=channelBreak;
      identity=gMDChannelBreakIdentity;
      gPyrState=(raw==DIR_BUY ? "HISTORICAL RESISTANCE CHANNEL BROKEN - BULL BOS" :
                               "HISTORICAL SUPPORT CHANNEL BROKEN - BEAR BOS");
   }
   else
   {
      // Local continuation BOS remains valid only when the higher historical
      // channel does not classify it as a counter-channel false break.
      if(gPyrTrendDirection==DIR_BUY && Ask>gPyrHigh1+buffer)
      { raw=DIR_BUY; identity=gPyrHighTime1; }
      if(gPyrTrendDirection==DIR_SELL && Bid<gPyrLow1-buffer)
      { raw=DIR_SELL; identity=gPyrLowTime1; }

      if(raw!=DIR_FLAT && EnableMarketDNAHistoricalChannels &&
         !MarketDNAHistoricalChannelAllowsBOS(raw))
      {
         gPyrState=(raw==DIR_SELL ?
                    "LOCAL LL BREAK = RISING SUPPORT CHANNEL HOLD / FALSE BEAR BOS" :
                    "LOCAL HH BREAK = FALLING RESISTANCE CHANNEL HOLD / FALSE BULL BOS");
         raw=DIR_FLAT; identity=0;
      }
   }

   if(raw==DIR_FLAT || identity<=0)
   {
      gPyrBOSCandidate=DIR_FLAT; gPyrBOSTicks=0;
      return DIR_FLAT;
   }
   if(raw==DIR_BUY && identity==gPyrLastUsedBOSIdentity && channelBreak==DIR_FLAT) return DIR_FLAT;
   if(raw==DIR_SELL && identity==gPyrLastUsedBOSIdentity && channelBreak==DIR_FLAT) return DIR_FLAT;
   if(channelBreak!=DIR_FLAT && identity==gMDChannelLastUsedBreakIdentity) return DIR_FLAT;

   if(raw!=gPyrBOSCandidate || identity!=gPyrBOSIdentity)
   { gPyrBOSCandidate=raw; gPyrBOSIdentity=identity; gPyrBOSTicks=1; }
   else gPyrBOSTicks++;

   int required=MathMax(1,gUnityConfirmTicks);
   gPyrState=(channelBreak!=DIR_FLAT ?
              (raw==DIR_BUY?"CHANNEL BREAK BUY ":"CHANNEL BREAK SELL ") :
              (raw==DIR_BUY?"BULL BOS TRAIN HEAD ":"BEAR BOS TRAIN HEAD "))+
              IntegerToString(gPyrBOSTicks)+"/"+IntegerToString(required);
   if(gPyrBOSTicks<required) return DIR_FLAT;

   gPyrActiveSignalIdentity=identity;
   if(channelBreak!=DIR_FLAT)
   {
      gPyrTrendDirection=raw;
      gPyrStructureSignalName=(raw==DIR_BUY?"HIST CHANNEL BULL BOS ":"HIST CHANNEL BEAR BOS ");
   }
   else
      gPyrStructureSignalName=(raw==DIR_BUY?"BULL BOS TRAIN-HEAD ":"BEAR BOS TRAIN-HEAD ");
   return raw;
}

double PyrAverageOpenPrice(int dir)
{
   double lots=0.0,weighted=0.0;
   for(int i=OrdersTotal()-1;i>=0;i--)
      if(OrderSelect(i,SELECT_BY_POS,MODE_TRADES) && OurOrder())
      {
         if(dir==DIR_BUY && OrderType()!=OP_BUY) continue;
         if(dir==DIR_SELL && OrderType()!=OP_SELL) continue;
         lots+=OrderLots(); weighted+=OrderLots()*OrderOpenPrice();
      }
   return (lots>0.0 ? weighted/lots : 0.0);
}

double PyrAdaptiveRequiredAdvantage()
{
   double win=0.0,loss=0.0; int wins=0,losses=0,seen=0;
   for(int i=OrdersHistoryTotal()-1;i>=0 && seen<MathMax(5,(int)PyramidOutcomeMemory);i--)
      if(OrderSelect(i,SELECT_BY_POS,MODE_HISTORY) && OurOrder())
      {
         double net=OrderProfit()+OrderSwap()+OrderCommission();
         if(net>0.0){ win+=net; wins++; }
         else if(net<0.0){ loss+=MathAbs(net); losses++; }
         seen++;
      }
   double floor=MathMax(0.0,PyramidMinimumAdvantageRatio);
   if(!PyramidAdaptiveAdvantage || wins<=0 || losses<=0) return floor;
   double averageWin=win/wins,averageLoss=loss/losses;
   if(averageWin<=0.0) return floor;
   // If recent losses have outweighed wins, demand enough structural room to repair that imbalance.
   return MathMax(floor,(averageLoss/averageWin)*1.15);
}

double PyrDirectionalProgress(int dir,double price)
{
   if(gPyrEntryAnchor<=0.0 || gPyrTarget<=0.0) return 0.0;
   double path=MathAbs(gPyrTarget-gPyrEntryAnchor);
   if(path<Point) return 0.0;
   double favorable=(dir==DIR_BUY ? price-gPyrEntryAnchor : gPyrEntryAnchor-price);
   return MathMax(0.0,favorable/path);
}

int PyrEvaluateRawSignal()
{
   if(gPyrHigh1<=gPyrLow1) return DIR_FLAT;
   RefreshRates();
   double price=(Ask+Bid)*0.5;
   double range=gPyrHigh1-gPyrLow1;
   gPyrStretch=(price-gPyrLow1)/MathMax(Point,range);
   gPyrRSI=iRSI(Symbol(),SignalTF,MathMax(2,(int)PyramidRSICharacter),PRICE_CLOSE,1);

   double o=iOpen(Symbol(),SignalTF,1),c=iClose(Symbol(),SignalTF,1);
   double h=iHigh(Symbol(),SignalTF,1),l=iLow(Symbol(),SignalTF,1);
   double body=MathMax(Point,MathAbs(c-o));
   double upper=h-MathMax(o,c),lower=MathMin(o,c)-l;
   double upperRatio=upper/body,lowerRatio=lower/body;
   double midpoint=(h+l)*0.5;
   double zone=MathMax(5.0,MathMin(45.0,PyramidOuterZonePercent))/100.0;

   bool sellZone=(gPyrStretch>=1.0-zone || h>=gPyrHigh1-zone*range*0.20);
   bool buyZone=(gPyrStretch<=zone || l<=gPyrLow1+zone*range*0.20);
   bool sellWick=(upperRatio>=PyramidMinimumWickBodyRatio && c<midpoint && Bid<c+upper*0.25);
   bool buyWick=(lowerRatio>=PyramidMinimumWickBodyRatio && c>midpoint && Ask>c-lower*0.25);
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double velocity=iClose(Symbol(),SignalTF,1)-iClose(Symbol(),SignalTF,2);
   gPyrStrength=MathMin(3.0,MathAbs(velocity)/atr + MathAbs(c-o)/atr);

   // Candle direction is absolute: never BUY from a completed sell candle and
   // never SELL from a completed buy candle, regardless of a wick or line touch.
   bool sellStrength=(c<o);
   bool buyStrength=(c>o);
   if(sellZone && sellWick && sellStrength && gPyrRSI>=PyramidRSIHigh)
   { gPyrWickRatio=upperRatio; return DIR_SELL; }
   if(buyZone && buyWick && buyStrength && gPyrRSI<=PyramidRSILow)
   { gPyrWickRatio=lowerRatio; return DIR_BUY; }
   gPyrWickRatio=MathMax(upperRatio,lowerRatio);
   return DIR_FLAT;
}

int PyrUpdateGrip()
{
   int raw=PyrEvaluateRawSignal();
   gPyrRawSignal=raw;
   if(raw==DIR_FLAT)
   {
      gPyrStructureSignalName="NONE";
      gPyrGripDirection=DIR_FLAT; gPyrGripTicks=0;
      gPyrState="WAITING FOR OUTER WICK";
      return DIR_FLAT;
   }
   if(raw!=gPyrGripDirection){ gPyrGripDirection=raw; gPyrGripTicks=1; }
   else gPyrGripTicks++;
   gPyrState=(raw==DIR_BUY?"BUY":"SELL")+" GRIP "+IntegerToString(gPyrGripTicks)+"/"+IntegerToString(MathMax(1,(int)PyramidGripCharacter));
   return (gPyrGripTicks>=MathMax(1,(int)PyramidGripCharacter) ? raw : DIR_FLAT);
}

int PyrUpdateFailedExtremeGate()
{
   if(gPyrHigh1<=gPyrLow1) return DIR_FLAT;
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double sweepBuffer=atr*MathMax(0.0,PyramidBreakBufferATR);
   double o=iOpen(Symbol(),SignalTF,1),c=iClose(Symbol(),SignalTF,1);
   double h=iHigh(Symbol(),SignalTF,1),l=iLow(Symbol(),SignalTF,1);
   double body=MathMax(Point,MathAbs(c-o));
   double upper=h-MathMax(o,c),lower=MathMin(o,c)-l;
   double upperRatio=upper/body,lowerRatio=lower/body;
   int raw=DIR_FLAT;
   double level=0.0; datetime identity=0;

   // All four permissions require a COMPLETED rejection candle. A live line
   // touch or a full candle pushing in the opposite direction is never enough.
   bool failedHH=(h>gPyrHigh1+sweepBuffer && c<gPyrHigh1 && c<o &&
                  upperRatio>=PyramidMinimumWickBodyRatio && Bid<gPyrHigh1);
   bool failedLL=(l<gPyrLow1-sweepBuffer && c>gPyrLow1 && c>o &&
                  lowerRatio>=PyramidMinimumWickBodyRatio && Ask>gPyrLow1);
   bool rejectedLH=(gPyrHighClass=="LH" && h>=gPyrHigh1-sweepBuffer &&
                    c<gPyrHigh1 && c<o && upperRatio>=PyramidMinimumWickBodyRatio);
   bool rejectedHL=(gPyrLowClass=="HL" && l<=gPyrLow1+sweepBuffer &&
                    c>gPyrLow1 && c>o && lowerRatio>=PyramidMinimumWickBodyRatio);

   if(failedHH)
   { raw=DIR_SELL; level=gPyrHigh1; identity=iTime(Symbol(),SignalTF,1); gPyrWickRatio=upperRatio; }
   else if(failedLL)
   { raw=DIR_BUY; level=gPyrLow1; identity=iTime(Symbol(),SignalTF,1); gPyrWickRatio=lowerRatio; }
   else if(rejectedLH)
   { raw=DIR_SELL; level=gPyrHigh1; identity=iTime(Symbol(),SignalTF,1); gPyrWickRatio=upperRatio; }
   else if(rejectedHL)
   { raw=DIR_BUY; level=gPyrLow1; identity=iTime(Symbol(),SignalTF,1); gPyrWickRatio=lowerRatio; }

   if(raw==DIR_FLAT)
   {
      gPyrBreakCandidate=DIR_FLAT; gPyrBreakTicks=0; gPyrBreakDirection=DIR_FLAT;
      gPyrState="WAIT COMPLETED FAILED HH/LL OR REJECTED HL/LH WICK";
      return DIR_FLAT;
   }
   if(raw!=gPyrBreakCandidate || identity!=gPyrBreakIdentity)
   {
      gPyrBreakCandidate=raw; gPyrBreakTicks=1; gPyrBreakIdentity=identity;
   }
   else gPyrBreakTicks++;

   gPyrBreakLevel=level;
   int required=MathMax(1,(int)PyramidBreakConfirmation);
   string structureName=(raw==DIR_BUY ? (failedLL?"FAILED LL BUY ":"REJECTED HL BUY ")
                                      : (failedHH?"FAILED HH SELL ":"REJECTED LH SELL "));
   gPyrStructureSignalName=structureName;
   gPyrState=structureName+"WICK GRIP "+
             IntegerToString(gPyrBreakTicks)+"/"+IntegerToString(required);
   if(gPyrBreakTicks<required) return DIR_FLAT;

   gPyrBreakDirection=raw;
   // A flat campaign may use each confirmed structural break only once.
   if(TradeCount()==0 && identity==gPyrLastUsedBreakIdentity) return DIR_FLAT;
   return raw;
}

void PyrArmDirectionalRetest(int dir,double station,string reason)
{
   if(!PyramidDirectionalProfitRetest || dir==DIR_FLAT || station<=0.0) return;
   gPyrRetestDirection=dir;
   gPyrRetestStation=station;
   gPyrRetestReady=true;
   gPyrRetestCandidate=DIR_FLAT;
   gPyrRetestTicks=0;
   Print("PYRAMID DIRECTIONAL RETEST ARMED | ",dir==DIR_BUY?"BUY":"SELL",
         " station=",DoubleToString(station,Digits)," reason=",reason);
}


void PyrClearRoute(string reason)
{
   int oldDir=gPyrRouteDirection;
   if(oldDir!=DIR_FLAT)
   {
      gPyrLastInvalidatedRouteDirection=oldDir;
      gPyrRouteInvalidatedTime=TimeCurrent();
      Print("UNITY ROUTE ENDED | ",oldDir==DIR_BUY?"BUY":"SELL"," | ",reason);
   }
   gPyrRouteActive=false;
   gPyrRouteDirection=DIR_FLAT;
   gPyrTrendDirection=DIR_FLAT;
   gPyrRouteInvalidation=0.0;
   gPyrRouteLastStation=0.0;
   gPyrRouteStationIdentity=0;
   gPyrRouteStationIndex=0;
   gPyrRouteStartTime=0;
   gPyrRouteInvalidTicks=0;
   gPyrRouteStationDeparted=false;
   gPyrRouteStationReady=true;
   gPyrRouteStationCandidate=DIR_FLAT;
   gPyrRouteStationTicks=0;
   gPyrRouteStationProbePrice=0.0;
   gPyrBurstDirection=DIR_FLAT;
   gPyrBurstSource=PYR_SOURCE_NONE;
   gPyrBurstOrigin=0.0;
   gPyrBurstATR=0.0;
   gPyrBurstExpires=0;
   gPyrLastBankDirection=DIR_FLAT;
   gPyrLastBankStation=0.0;
   gPyrBankedStationDeparted=true;
}

void PyrStartOrContinueRoute(int dir,double structuralInvalidation,string reason)
{
   if(dir==DIR_FLAT) return;
   bool newRoute=(!gPyrRouteActive || gPyrRouteDirection!=dir);
   if(newRoute)
   {
      gPyrRouteActive=true;
      gPyrRouteDirection=dir;
      gPyrRouteInvalidation=0.0;
      gPyrRouteLastStation=0.0;
      gPyrRouteStationIdentity=0;
      gPyrRouteStationIndex=0;
      gPyrRouteStartTime=TimeCurrent();
      gPyrRouteInvalidTicks=0;
      gPyrRouteStationDeparted=false;
      gPyrRouteStationReady=true;
      gPyrRouteStationCandidate=DIR_FLAT;
      gPyrRouteStationTicks=0;
      gPyrRouteStationProbePrice=0.0;
      Print("UNITY ROUTE START | ",dir==DIR_BUY?"BUY":"SELL"," | ",reason);
   }

   if(structuralInvalidation>0.0)
   {
      if(dir==DIR_BUY)
      {
         if(gPyrRouteInvalidation<=0.0 || structuralInvalidation>gPyrRouteInvalidation)
            gPyrRouteInvalidation=structuralInvalidation;
      }
      else
      {
         if(gPyrRouteInvalidation<=0.0 || structuralInvalidation<gPyrRouteInvalidation)
            gPyrRouteInvalidation=structuralInvalidation;
      }
   }
   // While the route remains structurally alive it owns trend context.
   gPyrTrendDirection=dir;
}

void PyrBeginPeakObservation(int dir,double collectedStation,double peakPrice,string reason)
{
   if(dir==DIR_FLAT || collectedStation<=0.0) return;
   gPyrPeakObservationActive=true;
   gPyrPeakDirection=dir;
   gPyrCollectedStation=NormalizeDouble(collectedStation,Digits);
   gPyrCollectedPeak=(peakPrice>0.0 ? NormalizeDouble(peakPrice,Digits) : gPyrCollectedStation);
   if(dir==DIR_BUY && gPyrCollectedPeak<gPyrCollectedStation) gPyrCollectedPeak=gPyrCollectedStation;
   if(dir==DIR_SELL && gPyrCollectedPeak>gPyrCollectedStation) gPyrCollectedPeak=gPyrCollectedStation;
   gPyrPeakObservationStarted=TimeCurrent();
   gPyrTransitionCandidate=DIR_FLAT;
   gPyrTransitionTicks=0;
   gPyrTransitionState="PEAK COLLECTED - OBSERVING REVERSAL";

   // Collection ends the old accelerator. No same-direction refill is allowed
   // merely because the route is still remembered.
   gPyrBurstDirection=DIR_FLAT;
   gPyrBurstSource=PYR_SOURCE_NONE;
   gPyrBurstOrigin=0.0;
   gPyrBurstATR=0.0;
   gPyrBurstExpires=0;
   gPyrRouteStationReady=false;
   gPyrRetestReady=false;
   gPyrStationCandidate=DIR_FLAT;
   gPyrStationTicks=0;
   gPyrReclaimCandidateDirection=DIR_FLAT;
   gPyrReclaimCandidateIndex=-1;
   gPyrReclaimTicks=0;
   Print("PEAK TRANSITION OBSERVATION | ",dir==DIR_BUY?"BUY":"SELL",
         " station=",DoubleToString(gPyrCollectedStation,Digits),
         " peak=",DoubleToString(gPyrCollectedPeak,Digits)," | ",reason);
}

void PyrReleasePeakObservationForMarketDNA(string reason)
{
   bool wasActive=gPyrPeakObservationActive;
   gPyrPeakObservationActive=false;
   gPyrPeakDirection=DIR_FLAT;
   gPyrCollectedStation=0.0;
   gPyrCollectedPeak=0.0;
   gPyrPeakObservationStarted=0;
   gPyrTransitionCandidate=DIR_FLAT;
   gPyrTransitionTicks=0;
   gPyrTransitionState="MARKET DNA HUNT - FRESH CYCLE";
   gPyrBurstDirection=DIR_FLAT;
   gPyrBurstSource=PYR_SOURCE_NONE;
   gPyrBurstOrigin=0.0;
   gPyrBurstATR=0.0;
   gPyrBurstExpires=0;
   gPyrRetestReady=false;
   gPyrStationCandidate=DIR_FLAT;
   gPyrStationTicks=0;
   gPyrReclaimCandidateDirection=DIR_FLAT;
   gPyrReclaimCandidateIndex=-1;
   gPyrReclaimTicks=0;
   if(EnableMarketDNA)
   {
      gMDAction="HUNT / FRESH COMPOUND CYCLE";
      gMDDeployBlockReason="NONE";
   }
   gPyrState=gPyrTransitionState+" | "+reason;
   if(wasActive) Print("MARKET DNA PEAK LOCK RELEASED | ",reason);
}

int PyrUpdatePeakTransitionGate()
{
   if(!gPyrPeakObservationActive || gPyrPeakDirection==DIR_FLAT ||
      gPyrCollectedStation<=0.0) return DIR_FLAT;

   RefreshRates();
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double buffer=atr*MathMax(0.01,PeakTransitionBufferATR);
   int opposite=(gPyrPeakDirection==DIR_BUY ? DIR_SELL : DIR_BUY);

   // Market DNA v3.03: observation may inform the next campaign but cannot own
   // execution indefinitely while the account is flat.
   if(EnableMarketDNA && TradeCount()==0 && gPyrPeakObservationStarted>0)
   {
      int tfSeconds=MathMax(1,PeriodSeconds(SignalTF));
      int maxBars=MathMax(1,MarketDNAPeakObservationMaxBars);
      if(TimeCurrent()-gPyrPeakObservationStarted>=tfSeconds*maxBars)
      {
         PyrReleasePeakObservationForMarketDNA("PEAK OBSERVATION TIMEOUT");
         return DIR_FLAT;
      }
   }

   bool continuation=(gPyrPeakDirection==DIR_BUY ?
                      Ask>=gPyrCollectedPeak+buffer :
                      Bid<=gPyrCollectedPeak-buffer);
   bool breakoutFailed=(gPyrPeakDirection==DIR_BUY ?
                        Bid<=gPyrCollectedStation-buffer :
                        Ask>=gPyrCollectedStation+buffer);

   int raw=DIR_FLAT;
   if(continuation && gConfirmedArrowDirection==gPyrPeakDirection)
      raw=gPyrPeakDirection;
   else if(breakoutFailed && gConfirmedArrowDirection==opposite)
      raw=opposite;

   if(raw==DIR_FLAT)
   {
      gPyrTransitionCandidate=DIR_FLAT;
      gPyrTransitionTicks=0;
      if(breakoutFailed)
         gPyrTransitionState=(gPyrPeakDirection==DIR_BUY ?
                              "BUY BREAKOUT FAILED - WAIT SELL ARROW" :
                              "SELL BREAKOUT FAILED - WAIT BUY ARROW");
      else
         gPyrTransitionState=(gPyrPeakDirection==DIR_BUY ?
                              "BUY BREAKOUT UNDER TEST - BUYS LOCKED" :
                              "SELL BREAKOUT UNDER TEST - SELLS LOCKED");
      gPyrState=gPyrTransitionState;
      return DIR_FLAT;
   }

   if(raw!=gPyrTransitionCandidate)
   { gPyrTransitionCandidate=raw; gPyrTransitionTicks=1; }
   else gPyrTransitionTicks++;

   int required=MathMax(1,PeakTransitionConfirmTicks);
   gPyrTransitionState=(raw==gPyrPeakDirection ? "CONTINUATION PROOF " : "REVERSAL PROOF ")+
                       IntegerToString(gPyrTransitionTicks)+"/"+IntegerToString(required);
   gPyrState=gPyrTransitionState;
   if(gPyrTransitionTicks<required) return DIR_FLAT;

   int oldDirection=gPyrPeakDirection;
   gPyrTransitionCandidate=DIR_FLAT;
   gPyrTransitionTicks=0;

   if(raw==oldDirection)
   {
      gPyrPeakObservationActive=false;
      gPyrTransitionState=(oldDirection==DIR_BUY ?
                           "BUY BREAKOUT RECLAIMED - BUY ROUTE RESTORED" :
                           "SELL BREAKOUT RECLAIMED - SELL ROUTE RESTORED");
      gPyrRouteStationDeparted=true;
      gPyrRouteStationReady=true;
      gPyrState=gPyrTransitionState;
      return oldDirection;
   }

   // Reversal authority settles remaining old-direction riders before the new
   // campaign is permitted. The two directions never coexist as one campaign.
   if(TradeCount()>0 && !PyrCloseFullCampaign("CONFIRMED STRUCTURAL INVALIDATION - PEAK TRANSITION"))
   {
      gPyrTransitionState="REVERSAL CONFIRMED - WAIT OLD CAMPAIGN CLOSE";
      gPyrState=gPyrTransitionState;
      return DIR_FLAT;
   }

   PyrClearRoute("COLLECTED BREAKOUT FAILED");
   gPyrPeakObservationActive=false;
   gPyrPeakDirection=DIR_FLAT;
   gPyrTrendDirection=raw;
   gPyrActiveSignalIdentity=TimeCurrent();
   gPyrTransitionState=(raw==DIR_BUY ?
                        "SELL BREAKOUT FAILED - BUY TRANSITION CONFIRMED" :
                        "BUY BREAKOUT FAILED - SELL TRANSITION CONFIRMED");
   gPyrState=gPyrTransitionState;
   return raw;
}

void PyrRecordRouteStation(int dir,double station,datetime identity,string reason)
{
   if(dir==DIR_FLAT || station<=0.0) return;
   if(!gPyrRouteActive || gPyrRouteDirection!=dir)
      PyrStartOrContinueRoute(dir,0.0,"STATION MEMORY");

   double stationTolerance=MathMax(Point*2.0,
                                    HTExecutionATR(SignalTF,14)*MathMax(0.02,PyramidStationTouchATR));
   bool priceChanged=(gPyrRouteLastStation<=0.0 ||
                      MathAbs(station-gPyrRouteLastStation)>stationTolerance);
   bool identityChanged=(identity>0 && identity!=gPyrRouteStationIdentity && priceChanged);
   bool changed=(priceChanged || identityChanged);
   if(!changed) return;

   gPyrRouteLastStation=station;
   gPyrRouteStationIdentity=identity;
   gPyrRouteStationIndex++;
   gPyrRouteStationDeparted=false;
   gPyrRouteStationReady=true;
   gPyrRouteStationCandidate=DIR_FLAT;
   gPyrRouteStationTicks=0;
   gPyrRouteStationProbePrice=0.0;
   Print("UNITY STATION ",IntegerToString(gPyrRouteStationIndex)," | ",
         dir==DIR_BUY?"BUY ":"SELL ",DoubleToString(station,Digits)," | ",reason);
}

void PyrUpdateRouteStructureMemory()
{
   if(!gPyrRouteActive || gPyrRouteDirection==DIR_FLAT || gPyrHigh1<=gPyrLow1) return;
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double buffer=atr*MathMax(0.01,PyramidInvalidationATRBuffer);

   // The route's actual derail level ratchets with confirmed HL/LH structure.
   if(gPyrRouteDirection==DIR_BUY && gPyrLowClass=="HL")
   {
      double candidate=gPyrLow1-buffer;
      if(gPyrRouteInvalidation<=0.0 || candidate>gPyrRouteInvalidation)
         gPyrRouteInvalidation=candidate;
   }
   if(gPyrRouteDirection==DIR_SELL && gPyrHighClass=="LH")
   {
      double candidate=gPyrHigh1+buffer;
      if(gPyrRouteInvalidation<=0.0 || candidate<gPyrRouteInvalidation)
         gPyrRouteInvalidation=candidate;
   }
}

bool PyrUpdateRouteValidity()
{
   if(!gPyrRouteActive || gPyrRouteDirection==DIR_FLAT) return false;
   PyrUpdateRouteStructureMemory();
   RefreshRates();

   // Accepted historical channel break immediately derails the old route.
   if(EnableMarketDNAHistoricalChannels && gMDChannelBreakDirection!=DIR_FLAT &&
      gMDChannelBreakDirection!=gPyrRouteDirection)
   {
      string channelWhy=(gPyrRouteDirection==DIR_BUY ?
                         "BUY ROUTE ENDED: HIST SUPPORT CHANNEL ACCEPTED BELOW" :
                         "SELL ROUTE ENDED: HIST RESISTANCE CHANNEL ACCEPTED ABOVE");
      PyrClearRoute(channelWhy);
      return false;
   }

   bool broken=false;
   if(gPyrRouteInvalidation>0.0)
      broken=(gPyrRouteDirection==DIR_BUY ? Bid<gPyrRouteInvalidation : Ask>gPyrRouteInvalidation);

   // A local HL/LL invalidation inside a still-holding long support channel is
   // treated as a pullback/false break, not as enough information to reverse.
   if(broken && EnableMarketDNAHistoricalChannels)
   {
      if(gPyrRouteDirection==DIR_BUY && gMDChannelSupportArrow==DIR_BUY &&
         !gMDChannelSupportBreakAccepted)
      {
         broken=false;
         gPyrState="LOCAL LL/HL LOST BUT HISTORICAL SUPPORT CHANNEL HOLDS / WAIT CLOSE ACCEPTANCE";
      }
      if(gPyrRouteDirection==DIR_SELL && gMDChannelResistanceArrow==DIR_SELL &&
         !gMDChannelResistanceBreakAccepted)
      {
         broken=false;
         gPyrState="LOCAL HH/LH LOST BUT HISTORICAL RESISTANCE CHANNEL HOLDS / WAIT CLOSE ACCEPTANCE";
      }
   }

   if(broken) gPyrRouteInvalidTicks++;
   else gPyrRouteInvalidTicks=0;

   int required=MathMax(1,(int)PyramidInvalidationCharacter);
   if(gPyrRouteInvalidTicks>=required)
   {
      string why=(gPyrRouteDirection==DIR_BUY ? "BUY HL SUPPORT LOST" : "SELL LH RESISTANCE BROKEN");
      PyrClearRoute(why);
      return false;
   }

   gPyrTrendDirection=gPyrRouteDirection;
   return true;
}

void PyrArmBankedStationDeparture(int dir,double station)
{
   if(dir==DIR_FLAT || station<=0.0) return;
   gPyrLastBankDirection=dir;
   gPyrLastBankStation=station;
   gPyrBankedStationDeparted=false;
   // Banking riders ends the old accelerator burst. New cars must wait for
   // departure + a fresh station return/reclaim, not instantly refill.
   gPyrBurstDirection=DIR_FLAT;
   gPyrBurstSource=PYR_SOURCE_NONE;
   gPyrBurstExpires=0;
}

void PyrUpdateBankedStationDeparture()
{
   if(gPyrBankedStationDeparted || gPyrLastBankDirection==DIR_FLAT || gPyrLastBankStation<=0.0) return;
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double reset=atr*MathMax(PyramidStationResetATR,PyramidStationTouchATR);
   RefreshRates();
   if(gPyrLastBankDirection==DIR_BUY && Bid>=gPyrLastBankStation+reset)
      gPyrBankedStationDeparted=true;
   if(gPyrLastBankDirection==DIR_SELL && Ask<=gPyrLastBankStation-reset)
      gPyrBankedStationDeparted=true;
}

double PyrSignalStationLevel()
{
   if(gPyrSignalSource==PYR_SOURCE_TRIGGER_RAIL_BOUNCE || gPyrSignalSource==PYR_SOURCE_TRIGGER_RAIL_BREAK)
      return gMDTriggerRailNow;
   if(gPyrSignalSource==PYR_SOURCE_CHANNEL_BOUNCE)
      return (gPyrRouteDirection==DIR_SELL ? gMDChannelResistanceNow : gMDChannelSupportNow);
   if(gPyrSignalSource==PYR_SOURCE_CHANNEL_BREAK)
      return (gPyrRouteDirection==DIR_SELL ? gMDChannelSupportNow : gMDChannelResistanceNow);
   if(gPyrSignalSource==PYR_SOURCE_ROUTE_ACCELERATOR) return gPyrRouteLastStation;
   if(gPyrSignalSource==PYR_SOURCE_DIRECTIONAL_RETEST) return gPyrRetestStation;
   if(gPyrSignalSource==PYR_SOURCE_RECLAIM_AREA) return gPyrActiveReclaimLevel;
   if(gPyrSignalSource==PYR_SOURCE_TRAIN_STATION)
      return (gPyrRouteDirection==DIR_SELL ? gPyrSellStation : gPyrBuyStation);
   return 0.0;
}

bool PyrSameBankedStationRefillBlocked(int dir)
{
   PyrUpdateBankedStationDeparture();
   if(gPyrBankedStationDeparted || dir!=gPyrLastBankDirection || gPyrLastBankStation<=0.0) return false;
   if(gPyrSignalSource!=PYR_SOURCE_ROUTE_ACCELERATOR &&
      gPyrSignalSource!=PYR_SOURCE_DIRECTIONAL_RETEST &&
      gPyrSignalSource!=PYR_SOURCE_RECLAIM_AREA &&
      gPyrSignalSource!=PYR_SOURCE_TRAIN_STATION) return false;

   double level=PyrSignalStationLevel();
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double sameZone=atr*MathMax(PyramidStationResetATR,PyramidStationTouchATR);
   return (level>0.0 && MathAbs(level-gPyrLastBankStation)<=sameZone);
}

void PyrArmHotWheelBurst(int dir,double origin,string reason)
{
   if(!PyramidRapidFire || dir==DIR_FLAT || origin<=0.0) return;
   gPyrBurstDirection=dir;
   gPyrBurstSource=gPyrSignalSource;
   gPyrBurstOrigin=origin;
   gPyrBurstATR=MathMax(Point,HTExecutionATR(SignalTF,14));
   gPyrBurstExpires=TimeCurrent()+MathMax(1,PyramidAcceleratorWindowSeconds);
   Print("HOT WHEELS ACCELERATOR ARMED | ",dir==DIR_BUY?"BUY":"SELL",
         " origin=",DoubleToString(origin,Digits)," | ",reason);
}

bool PyrHotWheelBurstAllows(int dir)
{
   if(!PyramidRapidFire || gPyrBurstDirection!=dir || dir==DIR_FLAT) return false;
   if(TimeCurrent()>gPyrBurstExpires || gPyrBurstOrigin<=0.0 || gPyrBurstATR<=0.0)
   {
      gPyrBurstDirection=DIR_FLAT;
      gPyrBurstSource=PYR_SOURCE_NONE;
      return false;
   }
   if(gPyrRouteActive && gPyrRouteDirection!=dir) return false;
   RefreshRates();
   double price=(dir==DIR_BUY ? Ask : Bid);
   double favorable=(dir==DIR_BUY ? price-gPyrBurstOrigin : gPyrBurstOrigin-price);
   double adverse=(dir==DIR_BUY ? gPyrBurstOrigin-price : price-gPyrBurstOrigin);
   if(adverse>gPyrBurstATR*MathMax(0.20,PyramidStationResetATR))
   {
      gPyrBurstDirection=DIR_FLAT;
      gPyrBurstSource=PYR_SOURCE_NONE;
      return false;
   }
   return favorable<=gPyrBurstATR*MathMax(0.25,PyramidAcceleratorBurstATR);
}

int PyrUpdateRouteStationAcceleratorGate()
{
   if(!gPyrRouteActive || gPyrRouteDirection==DIR_FLAT || gPyrRouteLastStation<=0.0) return DIR_FLAT;
   RefreshRates();
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double touch=atr*MathMax(0.01,PyramidStationTouchATR);
   double reset=atr*MathMax(PyramidStationResetATR,PyramidStationTouchATR);
   double current=(gPyrRouteDirection==DIR_BUY ? Bid : Ask);

   // First price must actually leave a freshly-created/banked station in route direction.
   if(!gPyrRouteStationDeparted)
   {
      if(gPyrRouteDirection==DIR_BUY && Bid>=gPyrRouteLastStation+reset)
         gPyrRouteStationDeparted=true;
      if(gPyrRouteDirection==DIR_SELL && Ask<=gPyrRouteLastStation-reset)
         gPyrRouteStationDeparted=true;
      gPyrRouteStationProbePrice=current;
      return DIR_FLAT;
   }
   if(!gPyrRouteStationReady)
   {
      gPyrRouteStationProbePrice=current;
      return DIR_FLAT;
   }

   // Live-candle Hot Wheels accelerator: station was touched/reclaimed and price is
   // now moving AWAY from it in the route direction. No completed candle is required.
   bool currentBarTouched=(gPyrRouteDirection==DIR_BUY ?
                           iLow(Symbol(),SignalTF,0)<=gPyrRouteLastStation+touch :
                           iHigh(Symbol(),SignalTF,0)>=gPyrRouteLastStation-touch);
   bool inLaunchZone=(gPyrRouteDirection==DIR_BUY ?
                      Bid>=gPyrRouteLastStation && Bid<=gPyrRouteLastStation+reset :
                      Ask<=gPyrRouteLastStation && Ask>=gPyrRouteLastStation-reset);
   bool favorableTick=false;
   if(gPyrRouteStationProbePrice>0.0)
      favorableTick=(gPyrRouteDirection==DIR_BUY ?
                     current>gPyrRouteStationProbePrice :
                     current<gPyrRouteStationProbePrice);
   gPyrRouteStationProbePrice=current;

   int raw=(currentBarTouched && inLaunchZone && favorableTick ? gPyrRouteDirection : DIR_FLAT);
   if(raw==DIR_FLAT)
   {
      gPyrRouteStationCandidate=DIR_FLAT;
      gPyrRouteStationTicks=0;
      return DIR_FLAT;
   }

   if(raw!=gPyrRouteStationCandidate)
   {
      gPyrRouteStationCandidate=raw;
      gPyrRouteStationTicks=1;
   }
   else gPyrRouteStationTicks++;

   int required=MathMax(1,gUnityConfirmTicks);
   gPyrState=(raw==DIR_BUY?"HOT WHEELS BUY ACCELERATOR ":"HOT WHEELS SELL ACCELERATOR ")+
             "S"+IntegerToString(gPyrRouteStationIndex)+" "+
             IntegerToString(gPyrRouteStationTicks)+"/"+IntegerToString(required);
   if(gPyrRouteStationTicks<required) return DIR_FLAT;

   gPyrRouteStationReady=false;
   gPyrRouteStationCandidate=DIR_FLAT;
   gPyrRouteStationTicks=0;
   gPyrActiveSignalIdentity=gPyrRouteStationIdentity;
   return raw;
}

bool PyrLatestCloseInfo(int expectedDir,double &closePrice,double &net)
{
   datetime newest=0;
   closePrice=0.0; net=0.0;
   for(int i=OrdersHistoryTotal()-1;i>=0;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_HISTORY)) continue;
      if(OrderSymbol()!=Symbol() || OrderMagicNumber()!=MagicNumber) continue;
      if(OrderType()!=OP_BUY && OrderType()!=OP_SELL) continue;
      int dir=(OrderType()==OP_BUY ? DIR_BUY : DIR_SELL);
      if(expectedDir!=DIR_FLAT && dir!=expectedDir) continue;
      if(OrderCloseTime()>=newest)
      {
         newest=OrderCloseTime();
         closePrice=OrderClosePrice();
         net=OrderProfit()+OrderSwap()+OrderCommission();
      }
   }
   return newest>0;
}

void PyrResetTicketCampaignPreserveRoute()
{
   gPyrCampaignDirection=DIR_FLAT;
   gPyrTarget=0.0;
   gPyrInvalidation=0.0;
   gPyrEntryAnchor=0.0;
   gPyrBestPrice=0.0;
   gPyrInvalidTicks=0;
   gPyrCampaignProven=false;
   gPyrDestinationReached=false;
   gPyrPercentGrabDone=false;
   gPyrCampaignStartBalance=0.0;
   gPyrStationGrabCount=0;
}

bool PyrLatestCampaignCloseReachedTarget(int dir,double target)
{
   if(dir==DIR_FLAT || target<=0.0) return false;
   double tolerance=MathMax(Point,HTExecutionATR(SignalTF,14)*MathMax(0.05,PyramidStationTouchATR));
   datetime newest=0;
   double closePrice=0.0,net=0.0;
   for(int i=OrdersHistoryTotal()-1;i>=0;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_HISTORY)) continue;
      if(OrderSymbol()!=Symbol() || OrderMagicNumber()!=MagicNumber) continue;
      if(OrderType()!=OP_BUY && OrderType()!=OP_SELL) continue;
      if(OrderCloseTime()>=newest)
      {
         newest=OrderCloseTime(); closePrice=OrderClosePrice();
         net=OrderProfit()+OrderSwap()+OrderCommission();
      }
   }
   if(newest<=0 || net<=0.0) return false;
   return (dir==DIR_BUY ? closePrice>=target-tolerance : closePrice<=target+tolerance);
}

int PyrUpdateDirectionalRetestGate()
{
   if(!PyramidDirectionalProfitRetest || !gPyrRetestReady ||
      gPyrRetestDirection==DIR_FLAT || gPyrRetestStation<=0.0) return DIR_FLAT;

   RefreshRates();
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double touch=atr*MathMax(0.01,PyramidStationTouchATR);
   // Reclaim entries use only the last completed rejection candle.
   double o=iOpen(Symbol(),SignalTF,1),c=iClose(Symbol(),SignalTF,1);
   double h=iHigh(Symbol(),SignalTF,1),l=iLow(Symbol(),SignalTF,1);
   int raw=DIR_FLAT;

   // A sell TP becomes resistance: price returns from below and rejects down.
   if(gPyrRetestDirection==DIR_SELL && h>=gPyrRetestStation-touch &&
      Ask<=gPyrRetestStation && c<=o)
      raw=DIR_SELL;
   // A buy TP becomes support: price returns from above and rejects up.
   if(gPyrRetestDirection==DIR_BUY && l<=gPyrRetestStation+touch &&
      Bid>=gPyrRetestStation && c>=o)
      raw=DIR_BUY;

   if(raw==DIR_FLAT)
   {
      gPyrRetestCandidate=DIR_FLAT; gPyrRetestTicks=0;
      return DIR_FLAT;
   }
   if(raw!=gPyrRetestCandidate)
   { gPyrRetestCandidate=raw; gPyrRetestTicks=1; }
   else gPyrRetestTicks++;

   int required=MathMax(1,(int)PyramidStationBounceConfirmation);
   gPyrState=(raw==DIR_BUY?"BUY TP SUPPORT RETEST ":"SELL TP RESISTANCE RETEST ")+
             IntegerToString(gPyrRetestTicks)+"/"+IntegerToString(required);
   if(gPyrRetestTicks<required) return DIR_FLAT;

   gPyrRetestReady=false;
   gPyrRetestCandidate=DIR_FLAT; gPyrRetestTicks=0;
   return raw;
}

int PyrUpdateILTrainStationGate()
{
   if(gPyrHigh1<=gPyrLow1) return DIR_FLAT;
   RefreshRates();
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double touch=atr*MathMax(0.01,PyramidStationTouchATR);
   double reset=atr*MathMax(PyramidStationTouchATR,PyramidStationResetATR);

   if(gPyrBuyStationIdentity!=gPyrHighTime1)
   {
      gPyrBuyStationIdentity=gPyrHighTime1; gPyrBuyStation=gPyrHigh1;
      gPyrBuyStationArmed=false; gPyrBuyStationReady=true;
   }
   if(gPyrSellStationIdentity!=gPyrLowTime1)
   {
      gPyrSellStationIdentity=gPyrLowTime1; gPyrSellStation=gPyrLow1;
      gPyrSellStationArmed=false; gPyrSellStationReady=true;
   }

   // A PY HIGH reclaim and a PY LOW breakdown are live station events.  The
   // break itself must be allowed to launch the train; requiring a later return
   // touch caused strong one-way moves to display ARMED but never enter.
   if(Bid>gPyrBuyStation+reset)
   {
      gPyrBuyStationArmed=true;
      gPyrBuyStationReady=true;
   }
   // Support lost: PY LOW is now above price and becomes SELL resistance.
   if(Ask<gPyrSellStation-reset)
   {
      gPyrSellStationArmed=true;
      gPyrSellStationReady=true;
   }

   bool buyBreak=(gPyrBuyStationArmed && gPyrBuyStationReady &&
                  Bid>=gPyrBuyStation+reset &&
                  Bid<=gPyrBuyStation+atr*MathMax(PyramidStationResetATR,
                                                   PyramidStationBreakCatchupATR));
   bool sellBreak=(gPyrSellStationArmed && gPyrSellStationReady &&
                   Ask<=gPyrSellStation-reset &&
                   Ask>=gPyrSellStation-atr*MathMax(PyramidStationResetATR,
                                                    PyramidStationBreakCatchupATR));

   // Return-and-go remains valid too.  It is a second way to use the station,
   // not the only way to trigger it.
   bool buyTouch=(gPyrBuyStationArmed && gPyrBuyStationReady &&
                  iLow(Symbol(),SignalTF,0)<=gPyrBuyStation+touch &&
                  Bid>=gPyrBuyStation && Bid<=gPyrBuyStation+touch);
   bool sellTouch=(gPyrSellStationArmed && gPyrSellStationReady &&
                   iHigh(Symbol(),SignalTF,0)>=gPyrSellStation-touch &&
                   Ask<=gPyrSellStation && Ask>=gPyrSellStation-touch);
   int raw=((buyBreak || buyTouch) ? DIR_BUY :
           ((sellBreak || sellTouch) ? DIR_SELL : DIR_FLAT));

   if(raw==DIR_FLAT)
   {
      gPyrStationCandidate=DIR_FLAT; gPyrStationTicks=0;
      return DIR_FLAT;
   }
   if(raw!=gPyrStationCandidate)
   { gPyrStationCandidate=raw; gPyrStationTicks=1; }
   else gPyrStationTicks++;

   int required=MathMax(1,(int)PyramidStationBounceConfirmation);
   string stationEvent=(raw==DIR_BUY ?
                        (buyBreak?"IL BUY STATION BREAK ":"IL BUY STATION BOUNCE ") :
                        (sellBreak?"IL SELL STATION BREAK ":"IL SELL STATION BOUNCE "));
   gPyrState=stationEvent+
             IntegerToString(gPyrStationTicks)+"/"+IntegerToString(required);
   if(gPyrStationTicks<required) return DIR_FLAT;

   // Do not consume the station here. Arrow permission and the order send run
   // later in the tick. The station becomes USED only after SendOrder succeeds.
   gPyrStationCandidate=DIR_FLAT; gPyrStationTicks=0;
   return raw;
}

string PyrReclaimAreaName(int index)
{
   if(index==0) return "PREVIOUS HIGH";
   if(index==1) return "PREVIOUS LOW";
   if(index==2) return "DESTINATION";
   if(index==3) return "50% GATE";
   return "TARGET AREA";
}

void PyrRefreshReclaimAreas()
{
   gPyrReclaimLevel[0]=gPyrHigh2;
   gPyrReclaimLevel[1]=gPyrLow2;
   gPyrReclaimLevel[2]=gPyrTarget;
   gPyrReclaimLevel[3]=(gPyrEntryAnchor>0.0 && gPyrTarget>0.0 ?
                        (gPyrEntryAnchor+gPyrTarget)*0.5 : 0.0);
   for(int i=0;i<4;i++)
   {
      if(MathAbs(gPyrReclaimLevel[i]-gPyrReclaimPreviousLevel[i])>Point)
      {
         gPyrReclaimPreviousLevel[i]=gPyrReclaimLevel[i];
         gPyrReclaimBuyArmed[i]=false; gPyrReclaimSellArmed[i]=false;
         gPyrReclaimBuyReady[i]=true; gPyrReclaimSellReady[i]=true;
      }
   }
}

int PyrUpdateAllTargetReclaimGate()
{
   if(!PyramidReclaimAllTargetAreas) return DIR_FLAT;
   PyrRefreshReclaimAreas();
   RefreshRates();
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double touch=atr*MathMax(0.01,PyramidStationTouchATR);
   double reset=atr*MathMax(PyramidStationTouchATR,PyramidStationResetATR);
   int raw=DIR_FLAT,index=-1;

   for(int i=0;i<4;i++)
   {
      double level=gPyrReclaimLevel[i];
      if(level<=0.0) continue;
      // Do not duplicate the primary PY High/PY Low stations.
      if(MathAbs(level-gPyrHigh1)<=Point || MathAbs(level-gPyrLow1)<=Point) continue;

      if(Bid>level+reset)
      { gPyrReclaimBuyArmed[i]=true; gPyrReclaimBuyReady[i]=true; }
      if(Ask<level-reset)
      { gPyrReclaimSellArmed[i]=true; gPyrReclaimSellReady[i]=true; }

      bool buyBreak=(gPyrReclaimBuyArmed[i] && gPyrReclaimBuyReady[i] &&
                     Bid>=level+reset &&
                     Bid<=level+atr*MathMax(PyramidStationResetATR,
                                            PyramidStationBreakCatchupATR));
      bool sellBreak=(gPyrReclaimSellArmed[i] && gPyrReclaimSellReady[i] &&
                      Ask<=level-reset &&
                      Ask>=level-atr*MathMax(PyramidStationResetATR,
                                             PyramidStationBreakCatchupATR));
      bool buyReturn=(gPyrReclaimBuyArmed[i] && gPyrReclaimBuyReady[i] &&
                      iLow(Symbol(),SignalTF,0)<=level+touch && Bid>=level && Bid<=level+touch);
      bool sellReturn=(gPyrReclaimSellArmed[i] && gPyrReclaimSellReady[i] &&
                       iHigh(Symbol(),SignalTF,0)>=level-touch && Ask<=level && Ask>=level-touch);
      if(buyBreak || buyReturn || sellBreak || sellReturn)
      {
         raw=((buyBreak || buyReturn)?DIR_BUY:DIR_SELL); index=i; break;
      }
   }

   if(raw==DIR_FLAT)
   {
      gPyrReclaimCandidateDirection=DIR_FLAT; gPyrReclaimCandidateIndex=-1; gPyrReclaimTicks=0;
      return DIR_FLAT;
   }
   if(raw!=gPyrReclaimCandidateDirection || index!=gPyrReclaimCandidateIndex)
   {
      gPyrReclaimCandidateDirection=raw; gPyrReclaimCandidateIndex=index; gPyrReclaimTicks=1;
   }
   else gPyrReclaimTicks++;

   int required=MathMax(1,(int)PyramidReclaimConfirmation);
   gPyrState=(raw==DIR_BUY?"BUY RECLAIM ":"SELL RECLAIM ")+PyrReclaimAreaName(index)+" "+
             IntegerToString(gPyrReclaimTicks)+"/"+IntegerToString(required);
   if(gPyrReclaimTicks<required) return DIR_FLAT;

   gPyrActiveReclaimLevel=gPyrReclaimLevel[index];
   gPyrActiveReclaimName=PyrReclaimAreaName(index);
   gPyrActiveReclaimIndex=index;
   // Keep the reclaim ready until a matching arrow and successful order agree.
   gPyrReclaimCandidateDirection=DIR_FLAT; gPyrReclaimCandidateIndex=-1; gPyrReclaimTicks=0;
   return raw;
}

double PyrNextTargetBeyond(int dir,double price,double fallbackRange)
{
   double levels[6];
   levels[0]=gPyrHigh1; levels[1]=gPyrHigh2; levels[2]=gPyrLow1;
   levels[3]=gPyrLow2; levels[4]=gPyrTarget;
   levels[5]=(gPyrEntryAnchor>0.0 && gPyrTarget>0.0 ? (gPyrEntryAnchor+gPyrTarget)*0.5 : 0.0);
   double selected=0.0;
   for(int i=0;i<6;i++)
   {
      double level=levels[i];
      if(dir==DIR_BUY && level>price+Point && (selected<=0.0 || level<selected)) selected=level;
      if(dir==DIR_SELL && level<price-Point && level>0.0 && (selected<=0.0 || level>selected)) selected=level;
   }
   if(selected>0.0) return selected;
   return (dir==DIR_BUY ? price+fallbackRange : price-fallbackRange);
}

bool PyrBuildTradePlan(int dir,double &target,double &invalid,double &advantage)
{
   RefreshRates();
   double price=(dir==DIR_BUY ? Ask : Bid);
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double buffer=atr*MathMax(0.01,PyramidInvalidationATRBuffer);
   double swingRange=MathMax(atr,gPyrHigh1-gPyrLow1);
   if(gPyrSignalSource==PYR_SOURCE_TRIGGER_RAIL_BOUNCE && dir==DIR_BUY)
   {
      double rail=MathMax(Point,gMDTriggerRailNow);
      invalid=rail-buffer;
      target=(gMDChannelResistanceValid && gMDChannelResistanceNow>price+atr*0.10 ?
              gMDChannelResistanceNow : PyrNextTargetBeyond(dir,price,swingRange*MathMax(0.25,PyramidStationTargetRangeMultiple)));
      if(target<=price || invalid>=price) return false;
      advantage=(target-price)/MathMax(Point,price-invalid);
   }
   else if(gPyrSignalSource==PYR_SOURCE_TRIGGER_RAIL_BOUNCE && dir==DIR_SELL)
   {
      double rail=MathMax(Point,gMDTriggerRailNow);
      invalid=rail+buffer;
      target=(gMDChannelSupportValid && gMDChannelSupportNow<price-atr*0.10 ?
              gMDChannelSupportNow : PyrNextTargetBeyond(dir,price,swingRange*MathMax(0.25,PyramidStationTargetRangeMultiple)));
      if(target>=price || invalid<=price) return false;
      advantage=(price-target)/MathMax(Point,invalid-price);
   }
   else if(gPyrSignalSource==PYR_SOURCE_TRIGGER_RAIL_BREAK && dir==DIR_SELL)
   {
      double rail=MathMax(Point,gMDTriggerRailNow);
      invalid=rail+buffer;
      target=(gMDChannelSupportValid && gMDChannelSupportNow<price-atr*0.10 ?
              gMDChannelSupportNow : PyrNextTargetBeyond(dir,price,swingRange*MathMax(0.25,PyramidStationTargetRangeMultiple)));
      if(target>=price || invalid<=price) return false;
      advantage=(price-target)/MathMax(Point,invalid-price);
   }
   else if(gPyrSignalSource==PYR_SOURCE_TRIGGER_RAIL_BREAK && dir==DIR_BUY)
   {
      double rail=MathMax(Point,gMDTriggerRailNow);
      invalid=rail-buffer;
      target=(gMDChannelResistanceValid && gMDChannelResistanceNow>price+atr*0.10 ?
              gMDChannelResistanceNow : PyrNextTargetBeyond(dir,price,swingRange*MathMax(0.25,PyramidStationTargetRangeMultiple)));
      if(target<=price || invalid>=price) return false;
      advantage=(target-price)/MathMax(Point,price-invalid);
   }
   else if(gPyrSignalSource==PYR_SOURCE_CHANNEL_BOUNCE && dir==DIR_BUY)
   {
      double rail=(gMDChannelSupportValid?gMDChannelSupportNow:gPyrLow1);
      invalid=rail-buffer;
      target=(gMDChannelResistanceValid && gMDChannelResistanceNow>price+atr*0.25 ?
              gMDChannelResistanceNow : PyrNextTargetBeyond(dir,price,swingRange*MathMax(0.25,PyramidStationTargetRangeMultiple)));
      if(target<=price || invalid>=price) return false;
      advantage=(target-price)/MathMax(Point,price-invalid);
   }
   else if(gPyrSignalSource==PYR_SOURCE_CHANNEL_BOUNCE && dir==DIR_SELL)
   {
      double rail=(gMDChannelResistanceValid?gMDChannelResistanceNow:gPyrHigh1);
      invalid=rail+buffer;
      target=(gMDChannelSupportValid && gMDChannelSupportNow<price-atr*0.25 ?
              gMDChannelSupportNow : PyrNextTargetBeyond(dir,price,swingRange*MathMax(0.25,PyramidStationTargetRangeMultiple)));
      if(target>=price || invalid<=price) return false;
      advantage=(price-target)/MathMax(Point,invalid-price);
   }
   else if(gPyrSignalSource==PYR_SOURCE_CHANNEL_BREAK && dir==DIR_BUY)
   {
      double rail=(gMDChannelResistanceValid?gMDChannelResistanceNow:gPyrHigh1);
      invalid=rail-buffer;
      target=PyrNextTargetBeyond(dir,price,swingRange*MathMax(0.25,PyramidStationTargetRangeMultiple));
      if(target<=price || invalid>=price) return false;
      advantage=(target-price)/MathMax(Point,price-invalid);
   }
   else if(gPyrSignalSource==PYR_SOURCE_CHANNEL_BREAK && dir==DIR_SELL)
   {
      double rail=(gMDChannelSupportValid?gMDChannelSupportNow:gPyrLow1);
      invalid=rail+buffer;
      target=PyrNextTargetBeyond(dir,price,swingRange*MathMax(0.25,PyramidStationTargetRangeMultiple));
      if(target>=price || invalid<=price) return false;
      advantage=(price-target)/MathMax(Point,invalid-price);
   }
   else
   if((gPyrSignalSource==PYR_SOURCE_BOS_CONTINUATION ||
       gPyrSignalSource==PYR_SOURCE_CONFIRMED_TREND_FLIP ||
       gPyrSignalSource==PYR_SOURCE_INFLECTION_TRANSFER) && dir==DIR_BUY)
   {
      target=PyrNextTargetBeyond(dir,price,swingRange*MathMax(0.25,PyramidStationTargetRangeMultiple));
      invalid=(gPyrSignalSource==PYR_SOURCE_BOS_CONTINUATION ? gPyrHigh1-buffer
                                                              : MathMin(gPyrLow1,iLow(Symbol(),SignalTF,1))-buffer);
      if(target<=price || invalid>=price) return false;
      advantage=(target-price)/MathMax(Point,price-invalid);
   }
   else if((gPyrSignalSource==PYR_SOURCE_BOS_CONTINUATION ||
            gPyrSignalSource==PYR_SOURCE_CONFIRMED_TREND_FLIP ||
            gPyrSignalSource==PYR_SOURCE_INFLECTION_TRANSFER) && dir==DIR_SELL)
   {
      target=PyrNextTargetBeyond(dir,price,swingRange*MathMax(0.25,PyramidStationTargetRangeMultiple));
      invalid=(gPyrSignalSource==PYR_SOURCE_BOS_CONTINUATION ? gPyrLow1+buffer
                                                              : MathMax(gPyrHigh1,iHigh(Symbol(),SignalTF,1))+buffer);
      if(target>=price || invalid<=price) return false;
      advantage=(price-target)/MathMax(Point,invalid-price);
   }
   else if(gPyrSignalSource==PYR_SOURCE_DIRECTIONAL_RETEST && dir==DIR_BUY)
   {
      target=PyrNextTargetBeyond(dir,price,swingRange*MathMax(0.25,PyramidStationTargetRangeMultiple));
      invalid=gPyrRetestStation-buffer;
      if(target<=price || invalid>=price) return false;
      advantage=(target-price)/MathMax(Point,price-invalid);
   }
   else if(gPyrSignalSource==PYR_SOURCE_DIRECTIONAL_RETEST && dir==DIR_SELL)
   {
      target=PyrNextTargetBeyond(dir,price,swingRange*MathMax(0.25,PyramidStationTargetRangeMultiple));
      invalid=gPyrRetestStation+buffer;
      if(target>=price || invalid<=price) return false;
      advantage=(price-target)/MathMax(Point,invalid-price);
   }
   else if(gPyrSignalSource==PYR_SOURCE_RECLAIM_AREA && dir==DIR_BUY)
   {
      target=PyrNextTargetBeyond(dir,price,swingRange*MathMax(0.25,PyramidStationTargetRangeMultiple));
      invalid=gPyrActiveReclaimLevel-buffer;
      if(target<=price || invalid>=price) return false;
      advantage=(target-price)/MathMax(Point,price-invalid);
   }
   else if(gPyrSignalSource==PYR_SOURCE_RECLAIM_AREA && dir==DIR_SELL)
   {
      target=PyrNextTargetBeyond(dir,price,swingRange*MathMax(0.25,PyramidStationTargetRangeMultiple));
      invalid=gPyrActiveReclaimLevel+buffer;
      if(target>=price || invalid<=price) return false;
      advantage=(price-target)/MathMax(Point,invalid-price);
   }
   else if((gPyrSignalSource==PYR_SOURCE_ROUTE_ACCELERATOR || gPyrSignalSource==PYR_SOURCE_RHYTHM_ACCELERATOR) && dir==DIR_BUY)
   {
      target=PyrNextTargetBeyond(dir,price,swingRange*MathMax(0.25,PyramidStationTargetRangeMultiple));
      double fallbackInvalid=MathMin(gPyrLow1,iLow(Symbol(),SignalTF,1))-buffer;
      invalid=(gPyrRouteInvalidation>0.0 && gPyrRouteInvalidation<price ? gPyrRouteInvalidation :
              (gPyrRouteLastStation>0.0 && gPyrRouteLastStation<price ? gPyrRouteLastStation-buffer : fallbackInvalid));
      if(target<=price || invalid>=price) return false;
      advantage=(target-price)/MathMax(Point,price-invalid);
   }
   else if((gPyrSignalSource==PYR_SOURCE_ROUTE_ACCELERATOR || gPyrSignalSource==PYR_SOURCE_RHYTHM_ACCELERATOR) && dir==DIR_SELL)
   {
      target=PyrNextTargetBeyond(dir,price,swingRange*MathMax(0.25,PyramidStationTargetRangeMultiple));
      double fallbackInvalid=MathMax(gPyrHigh1,iHigh(Symbol(),SignalTF,1))+buffer;
      invalid=(gPyrRouteInvalidation>price ? gPyrRouteInvalidation :
              (gPyrRouteLastStation>price ? gPyrRouteLastStation+buffer : fallbackInvalid));
      if(target>=price || invalid<=price) return false;
      advantage=(price-target)/MathMax(Point,invalid-price);
   }
   else if(gPyrSignalSource==PYR_SOURCE_TRAIN_STATION && dir==DIR_BUY)
   {
      target=gPyrBuyStation+swingRange*MathMax(0.25,PyramidStationTargetRangeMultiple);
      invalid=gPyrBuyStation-buffer;
      if(target<=price || invalid>=price) return false;
      advantage=(target-price)/MathMax(Point,price-invalid);
   }
   else if(gPyrSignalSource==PYR_SOURCE_TRAIN_STATION && dir==DIR_SELL)
   {
      target=gPyrSellStation-swingRange*MathMax(0.25,PyramidStationTargetRangeMultiple);
      invalid=gPyrSellStation+buffer;
      if(target>=price || invalid<=price) return false;
      advantage=(price-target)/MathMax(Point,invalid-price);
   }
   else if(dir==DIR_BUY)
   {
      target=gPyrHigh1;
      invalid=MathMin(iLow(Symbol(),SignalTF,1),gPyrLow1)-buffer;
      if(target<=price || invalid>=price) return false;
      advantage=(target-price)/MathMax(Point,price-invalid);
   }
   else
   {
      target=gPyrLow1;
      invalid=MathMax(iHigh(Symbol(),SignalTF,1),gPyrHigh1)+buffer;
      if(target>=price || invalid<=price) return false;
      advantage=(price-target)/MathMax(Point,invalid-price);
   }
   gPyrRequiredAdvantage=0.0; // Informational only: valid structure, not a score, grants the plan.
   return true;
}

void PyrApplyStructuralTargetToNewest(int dir,double target)
{
   int ticket=-1; datetime newest=0;
   for(int i=OrdersTotal()-1;i>=0;i--)
      if(OrderSelect(i,SELECT_BY_POS,MODE_TRADES) && OurOrder())
      {
         if(dir==DIR_BUY && OrderType()!=OP_BUY) continue;
         if(dir==DIR_SELL && OrderType()!=OP_SELL) continue;
         if(OrderOpenTime()>=newest){ newest=OrderOpenTime(); ticket=OrderTicket(); }
      }
   if(ticket<0 || !OrderSelect(ticket,SELECT_BY_TICKET)) return;
   double stopLevel=MarketInfo(Symbol(),MODE_STOPLEVEL)*Point;
   RefreshRates();
   bool valid=(dir==DIR_BUY ? target>Ask+stopLevel : target<Bid-stopLevel);
   if(valid && MathAbs(OrderTakeProfit()-target)>Point)
      if(!HT5CommanderOrderModify(ticket,OrderOpenPrice(),OrderStopLoss(),NormalizeDouble(target,Digits),0,clrNONE))
         Print("PYRAMID target modification failed ticket=",ticket," err=",GetLastError());
}

double PyrSelectedGainPercent()
{
   return MathMax(0.01,gUnityGainTargetPercent);
}

double PyrSelectedPartialPercent()
{
   return MathMax(1.0,MathMin(99.0,gUnityStationPartialPercent));
}

bool PyrStationPartialMode()
{
   if(gHT6DoctrineOwnsEntry) return false; // v6 doctrine is full-basket collection/protection.
   if(EnableCompoundStaircase) return false; // Stations guide/collect whole campaigns; staircase owns partial-free compounding.
   return (ProfitGrabMode==PROFIT_STATION_PARTIAL_PLUS_PERCENT ||
           ProfitGrabMode==PROFIT_STATION_PARTIAL_ONLY);
}

bool PyrPercentageGainEnabled()
{
   if(EnableCompoundStaircase) return false; // Persistent cross-campaign target replaces one-shot campaign percentage grab.
   return (ProfitGrabMode==PROFIT_STATION_PARTIAL_PLUS_PERCENT ||
           ProfitGrabMode==PROFIT_PERCENT_FULL_CLOSE);
}

bool PyrPartialCloseCampaign(double percent,string reason)
{
   if(gHT6DoctrineOwnsEntry) return PyrCloseFullCampaign("SEQUENCE FULL-BASKET REFRAME: "+reason);
   double total=TotalLots();
   if(total<=0.0) return false;
   double remaining=total*MathMax(1.0,MathMin(99.0,percent))/100.0;
   double minLot=MarketInfo(Symbol(),MODE_MINLOT);
   double step=MarketInfo(Symbol(),MODE_LOTSTEP);
   if(step<=0.0) step=0.01;
   int closedTickets=0;

   for(int pass=0;pass<2 && remaining>=minLot-0.0000001;pass++)
   {
      for(int i=OrdersTotal()-1;i>=0 && remaining>=minLot-0.0000001;i--)
      {
         if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;
         double orderLots=OrderLots();
         double closeLots=MathMin(orderLots,remaining);
         closeLots=MathFloor(closeLots/step+0.0000001)*step;
         closeLots=NormalizeDouble(closeLots,LotDigitsFromStep(step));
         double leftover=orderLots-closeLots;
         if(leftover>0.0 && leftover<minLot-0.0000001)
            closeLots=NormalizeDouble(orderLots-minLot,LotDigitsFromStep(step));
         if(closeLots<minLot-0.0000001)
         {
            if(orderLots<=remaining+step*0.5) closeLots=orderLots;
            else continue;
         }

         RefreshRates();
         double px=(OrderType()==OP_BUY ? Bid : Ask);
         int ticket=OrderTicket();
         double selectedNet=OrderProfit()+OrderSwap()+OrderCommission();
         if(NeverSoftwareCloseNegativeCampaign && selectedNet<0.0)
         {
            Print("HT UNITY HYBRID partial close skipped negative ticket=",ticket,
                  " net=",DoubleToString(selectedNet,2));
            continue;
         }
         if(HT5CommanderOrderClose(ticket,closeLots,px,SlippagePoints,clrNONE))
         {
            remaining=MathMax(0.0,remaining-closeLots);
            closedTickets++;
         }
         else Print("PYRAMID partial grab failed ticket=",ticket," err=",GetLastError());
      }
   }
   if(closedTickets<=0)
   {
      gPyrLastAction="PARTIAL WAIT: LOTS TOO SMALL TO SPLIT";
      return false;
   }
   gPyrLastAction="PARTIAL GRAB "+DoubleToString(percent,0)+"% | "+reason;
   Print("PYRAMID PARTIAL PROFIT GRAB | percent=",DoubleToString(percent,0),
         " tickets=",closedTickets," reason=",reason);
   return true;
}

bool PyrStationConsensusAllowsHold(int dir)
{
   if(gUnityStationMode==2)
   { gPyrStationDecision="HOLD: USER FORCED EXTENSION"; return true; }
   if(gUnityStationMode==1)
   { gPyrStationDecision="BANK: USER FORCED PARTIAL"; return false; }

   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double o=iOpen(Symbol(),SignalTF,1),c=iClose(Symbol(),SignalTF,1);
   double h=iHigh(Symbol(),SignalTF,1),l=iLow(Symbol(),SignalTF,1);
   double previousClose=iClose(Symbol(),SignalTF,2);
   double body=MathAbs(c-o);
   double candleRange=MathMax(Point,h-l);
   double rsi=iRSI(Symbol(),SignalTF,MathMax(2,(int)PyramidRSICharacter),PRICE_CLOSE,1);
   double minimumBodyATR=(double)((int)StationStrengthRequirement)/100.0;

   bool trendAgreement=(gPyrTrendDirection==dir);
   bool momentumAgreement=(dir==DIR_BUY ? (c>o && c>previousClose)
                                         : (c<o && c<previousClose));
   bool strengthAgreement=(body>=atr*minimumBodyATR);
   bool gripAgreement=(dir==DIR_BUY ? (h-c<=candleRange*0.35)
                                     : (c-l<=candleRange*0.35));
   bool rsiRunway=(dir==DIR_BUY ? rsi<PyramidRSIHigh : rsi>PyramidRSILow);

   bool hold=(trendAgreement && momentumAgreement && strengthAgreement &&
              gripAgreement && rsiRunway);
   if(hold)
   {
      gPyrStationDecision="HOLD: TREND+MOMENTUM+STRENGTH+GRIP+RSI AGREE";
      return true;
   }

   gPyrStationDecision="BANK:";
   if(!trendAgreement) gPyrStationDecision+=" TREND";
   if(!momentumAgreement) gPyrStationDecision+=" MOMENTUM";
   if(!strengthAgreement) gPyrStationDecision+=" STRENGTH";
   if(!gripAgreement) gPyrStationDecision+=" GRIP";
   if(!rsiRunway) gPyrStationDecision+=" RSI-EXHAUSTED";
   return false;
}

void PyrAdvanceToNextStation(int dir,double collectedStation,string decision)
{
   double current=(dir==DIR_BUY ? Bid : Ask);
   double observedPeak=(gPyrBestPrice>0.0 ? gPyrBestPrice : current);
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double range=MathMax(atr,gPyrHigh1-gPyrLow1)*MathMax(0.25,NextStationExtensionRange);
   PyrRecordRouteStation(dir,collectedStation,TimeCurrent(),"STRUCTURAL PROFIT STATION");
   PyrArmBankedStationDeparture(dir,collectedStation);
   gPyrTarget=PyrNextTargetBeyond(dir,current,range);
   gPyrDestinationReached=false;
   gPyrStationGrabCount++;
   PyrBeginPeakObservation(dir,collectedStation,observedPeak,"PARTIAL PEAK COLLECTION");
   gPyrState=decision+" | PEAK COLLECTED - OBSERVE BEFORE NEXT CAMPAIGN";
}

bool PyrCloseFullCampaign(string reason)
{
   bool emergency=false;
   if(HT6EinsteinEnabled())
   {
      emergency=(StringFind(reason,"WISDO EMERGENCY")>=0 ||
                      StringFind(reason,"WISDO CLOSE ALL")>=0 ||
                      StringFind(reason,"WISDO COMMAND EMERGENCY")>=0 ||
                      StringFind(reason,"WISDO COMMAND CLOSE ALL")>=0 ||
                      StringFind(reason,"MANUAL EMERGENCY")>=0);
      if(!emergency)
      {
         gPyrState="EINSTEIN HOLD FIREWALL • CORE WAITS OPPOSITE STRUCTURE CLOSE";
         gPyrLastAction="FULL-BASKET CLOSE BLOCKED: "+reason;
         return false;
      }
   }
   if(EnableMarketDNA) MarketDNADeletePendingLimits("FULL CAMPAIGN REQUEST: "+reason);
   double liveNet=BasketProfit();
   if(NeverSoftwareCloseNegativeCampaign && liveNet<0.0 &&
      !UnifiedAuthorizedNegativeCloseOverride(reason))
   {
      gPyrState="NEGATIVE HOLD - ORIGINAL BROKER SL OWNS";
      gPyrLastAction="BLOCKED SOFTWARE LOSS CLOSE: "+reason;
      Print("HT UNITY HYBRID PYRAMID negative close blocked basket=",
            DoubleToString(liveNet,2)," reason=",reason,
            " | rapid-fire route preserved; broker SL remains active");
      return false;
   }

   int completedDirection=gPyrCampaignDirection;
   double completedTarget=gPyrTarget;
   double completedPeak=gPyrBestPrice;
   double completedNet=BasketProfit();
   RefreshRates();
   double completedPrice=(completedDirection==DIR_BUY ? Bid : (completedDirection==DIR_SELL ? Ask : 0.0));
   bool endRoute=(StringFind(reason,"INVALIDATION")>=0 ||
                  StringFind(reason,"MIXED")>=0 ||
                  StringFind(reason,"EMERGENCY")>=0 ||
                  StringFind(reason,"CLOSE ALL")>=0);
   bool compoundSettlement=(StringFind(reason,"COMPOUND TARGET SETTLEMENT")>=0 ||
                            StringFind(reason,"COMPOUND COLLECTED")>=0 ||
                            StringFind(reason,"FLAT TARGET VERIFIED")>=0);
   int before=TradeCount();
   bool priorEinCoreCloseAuthority=gHT6EinsteinCoreCloseAuthority;
   bool priorEinAddonCloseAuthority=gHT6EinsteinAddonCloseAuthority;
   if(HT6EinsteinEnabled() && emergency){ gHT6EinsteinCoreCloseAuthority=true; gHT6EinsteinAddonCloseAuthority=true; }
   for(int pass=0;pass<4 && TradeCount()>0;pass++)
   {
      RefreshRates();
      for(int i=OrdersTotal()-1;i>=0;i--)
         if(OrderSelect(i,SELECT_BY_POS,MODE_TRADES) && OurOrder())
         {
            double closePrice=(OrderType()==OP_BUY ? Bid : Ask);
            if(!HT5CommanderOrderClose(OrderTicket(),OrderLots(),closePrice,SlippagePoints,clrNONE))
               Print("PYRAMID full-campaign close retry ticket=",OrderTicket()," err=",GetLastError());
         }
   }
   if(TradeCount()>0)
   {
      gPyrLastAction="FULL CLOSE RETRY PENDING: "+reason;
      gHT6EinsteinCoreCloseAuthority=priorEinCoreCloseAuthority;
      gHT6EinsteinAddonCloseAuthority=priorEinAddonCloseAuthority;
      return false;
   }
   Print("PYRAMID campaign closed as one decision | reason=",reason," tickets=",before);
   gPyrLastAction="COLLECTED: "+reason;

   if(!endRoute && !compoundSettlement && completedDirection!=DIR_FLAT && completedNet>0.0)
   {
      double station=(StringFind(reason,"DESTINATION")>=0 && completedTarget>0.0 ?
                      completedTarget : completedPrice);
      if(station>0.0)
      {
         PyrRecordRouteStation(completedDirection,station,TimeCurrent(),"COLLECTED PEAK STATION: "+reason);
         PyrBeginPeakObservation(completedDirection,station,completedPeak,"FULL PEAK COLLECTION: "+reason);
      }
   }
   else if(compoundSettlement && EnableMarketDNA)
   {
      PyrReleasePeakObservationForMarketDNA("COMPOUND SETTLEMENT COMPLETE");
   }
   if(endRoute)
      PyrClearRoute(reason);

   PyrResetTicketCampaignPreserveRoute();
   ResetArrowCampaignGrid(); SovResetGravity(); ResetMovementTP();
   gHT6EinsteinCoreCloseAuthority=priorEinCoreCloseAuthority;
   gHT6EinsteinAddonCloseAuthority=priorEinAddonCloseAuthority;
   return true;
}

void PyrApplyHalfwayBrokerTrail(int dir)
{
   if(!gPyrCampaignProven || gPyrEntryAnchor<=0.0 || gPyrBestPrice<=0.0) return;

   double keepPercent=100.0-MathMax(0.0,MathMin(100.0,PyramidTrailGivebackPercent));
   double lockedTravel=MathAbs(gPyrBestPrice-gPyrEntryAnchor)*keepPercent/100.0;
   double campaignTrail=(dir==DIR_BUY ? gPyrEntryAnchor+lockedTravel : gPyrEntryAnchor-lockedTravel);
   double brokerGap=MarketInfo(Symbol(),MODE_STOPLEVEL)*Point+Point;
   RefreshRates();

   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;
      if(dir==DIR_BUY && OrderType()!=OP_BUY) continue;
      if(dir==DIR_SELL && OrderType()!=OP_SELL) continue;

      // Compression-style economic floor: broker trail must cover recorded costs,
      // not merely touch the visual open price and close slightly negative.
      double tickSize=MathMax(Point,MarketInfo(Symbol(),MODE_TICKSIZE));
      double tickValue=MathMax(0.0,MarketInfo(Symbol(),MODE_TICKVALUE));
      double moneyPerPrice=(tickSize>0.0 ? tickValue/tickSize*OrderLots() : 0.0);
      double knownCosts=MathAbs(MathMin(0.0,OrderCommission()+OrderSwap()));
      double costDistance=(moneyPerPrice>0.0 ? knownCosts/moneyPerPrice : 0.0)+Point*2.0;
      double economicFloor=(dir==DIR_BUY ? OrderOpenPrice()+costDistance
                                         : OrderOpenPrice()-costDistance);
      double desired=(dir==DIR_BUY ? MathMax(economicFloor,campaignTrail)
                                   : MathMin(economicFloor,campaignTrail));
      desired=MarketDNAOracleRatchetStop(dir,desired);
      bool valid=(dir==DIR_BUY ? desired<Bid-brokerGap : desired>Ask+brokerGap);
      double trailStep=MathMax(Point*2.0,
                               HTExecutionATR(SignalTF,14)*MathMax(0.01,PyramidTrailStepATR));
      bool tighter=(OrderStopLoss()<=0.0 ||
                    (dir==DIR_BUY ? desired>OrderStopLoss()+trailStep
                                  : desired<OrderStopLoss()-trailStep));
      if(!valid || !tighter) continue;

      double tick=TickSizePrice();
      if(tick>0.0)
      {
         if(dir==DIR_BUY) desired=MathFloor(desired/tick)*tick;
         else desired=MathCeil(desired/tick)*tick;
      }
      desired=NormalizeDouble(desired,Digits);
      if(!HT5CommanderOrderModify(OrderTicket(),OrderOpenPrice(),desired,OrderTakeProfit(),0,clrNONE))
         Print("PYRAMID 50% broker trail failed ticket=",OrderTicket()," err=",GetLastError());
   }
}

void PyrManageCampaign(int confirmedTurn)
{
   if(HT6EinsteinEnabled())
   {
      HT6EinsteinManageOrders();
      return;
   }
   if(TradeCount()<=0) return;
   int dir=(int)DetectDirection();
   if(dir==DIR_FLAT){ PyrCloseFullCampaign("MIXED DIRECTION EXPOSURE"); return; }
   if(gPyrCampaignDirection==DIR_FLAT) gPyrCampaignDirection=dir;
   if(!gPyrRouteActive || gPyrRouteDirection!=dir)
      PyrStartOrContinueRoute(dir,gPyrInvalidation,"LIVE CAMPAIGN RESTORE");
   if(gPyrTarget<=0.0 || gPyrInvalidation<=0.0)
   {
      double rebuiltAdvantage=0.0;
      RefreshRates();
      double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
      double buffer=atr*MathMax(0.01,PyramidInvalidationATRBuffer);
      double brokerTarget=0.0,brokerStop=0.0;
      for(int restoreIndex=OrdersTotal()-1;restoreIndex>=0;restoreIndex--)
         if(OrderSelect(restoreIndex,SELECT_BY_POS,MODE_TRADES) && OurOrder())
         {
            brokerTarget=OrderTakeProfit(); brokerStop=OrderStopLoss();
            if(brokerTarget>0.0 && brokerStop>0.0) break;
         }
      gPyrTarget=(brokerTarget>0.0 ? brokerTarget : (dir==DIR_BUY ? gPyrHigh1 : gPyrLow1));
      gPyrInvalidation=(brokerStop>0.0 ? brokerStop :
                        (dir==DIR_BUY ? gPyrLow1-buffer : gPyrHigh1+buffer));
      gPyrEntryAnchor=PyrAverageOpenPrice(dir);
      gPyrBestPrice=gPyrEntryAnchor;
      double current=(dir==DIR_BUY ? Bid : Ask);
      rebuiltAdvantage=MathAbs(gPyrTarget-current)/MathMax(Point,MathAbs(current-gPyrInvalidation));
      gPyrProjectedAdvantage=rebuiltAdvantage;
      gPyrLastAction="CAMPAIGN RESTORED FROM LIVE ORDERS";
   }
   RefreshRates();
   double price=(dir==DIR_BUY ? Bid : Ask);
   if(gPyrBestPrice<=0.0) gPyrBestPrice=price;
   if(dir==DIR_BUY) gPyrBestPrice=MathMax(gPyrBestPrice,Bid);
   else gPyrBestPrice=MathMin(gPyrBestPrice,Ask);

   double progress=PyrDirectionalProgress(dir,price);
   // Hard train rule: no profit floor/trailing behavior before 50% destination.
   if(progress>=MathMax(0.50,PyramidBreakEvenProgress)) gPyrCampaignProven=true;
   if(gPyrCampaignProven) PyrApplyHalfwayBrokerTrail(dir);

   double gainBase=(gPyrCampaignStartBalance>0.0 ? gPyrCampaignStartBalance : AccountBalance());
   double campaignGainPercent=(gainBase>0.0 ? BasketProfit()/gainBase*100.0 : 0.0);
   if(PyrPercentageGainEnabled() && !gPyrPercentGrabDone && BasketProfit()>0.0 &&
      campaignGainPercent>=PyrSelectedGainPercent())
   {
      gPyrPercentGrabDone=true;
      if(ProfitGrabMode==PROFIT_PERCENT_FULL_CLOSE)
      { PyrCloseFullCampaign("PERCENTAGE GAIN TARGET"); return; }
      if(PyrPartialCloseCampaign(PyrSelectedPartialPercent(),"PERCENTAGE GAIN TARGET"))
      {
         RefreshRates();
         PyrArmBankedStationDeparture(dir,(dir==DIR_BUY ? Bid : Ask));
         if(TradeCount()<=0) return;
         gPyrState="PERCENTAGE PROFIT BANKED - RUNNER HOLDS; SAME-PRICE REFILL BLOCKED";
      }
   }

   bool destination=(dir==DIR_BUY ? Bid>=gPyrTarget : Ask<=gPyrTarget);
   if(gPyrTarget>0.0 && destination && BasketProfit()>0.0)
   {
      gPyrDestinationReached=true;
      double oracleAtr=MathMax(Point,HTExecutionATR(SignalTF,14));
      if(MarketDNAOracleRedContinuationReady(dir,oracleAtr))
      {
         PyrRecordRouteStation(dir,gPyrTarget,TimeCurrent(),"ORACLE RED BREAKOUT CONTINUATION");
         PyrAdvanceToNextStation(dir,gPyrTarget,"ORACLE RED PEAK ACCEPTED / EXTEND DESTINATION");
         gPyrState=(dir==DIR_BUY?"RED PEAK BROKEN - BUY CONTINUATION":"RED PEAK BROKEN - SELL CONTINUATION");
         return;
      }
      PyrRecordRouteStation(dir,gPyrTarget,TimeCurrent(),"DESTINATION REACHED");
      if(PyrStationPartialMode())
      {
         double collectedStation=gPyrTarget;
         if(PyrStationConsensusAllowsHold(dir))
         {
            Print("PYRAMID STATION MIND | ",gPyrStationDecision,
                  " station=",DoubleToString(collectedStation,Digits));
            PyrAdvanceToNextStation(dir,collectedStation,gPyrStationDecision);
            return;
         }
         if(PyrPartialCloseCampaign(PyrSelectedPartialPercent(),"STRUCTURAL STATION"))
         {
            Print("PYRAMID STATION MIND | ",gPyrStationDecision,
                  " station=",DoubleToString(collectedStation,Digits));
            if(TradeCount()>0) PyrAdvanceToNextStation(dir,collectedStation,"PARTIAL BANKED");
            return;
         }
      }
      if(EnableMarketDNA)
      {
          // A station is evidence, not an automatic exit. The master equation decides whether
          // remaining expected profit still exceeds expected giveback.
          if(gMDDesiredDirection==dir && gMDDesiredLots>=TotalLots()*0.75 &&
             gMDExpectedFutureMoney>gMDExpectedGivebackMoney)
          {
             PyrAdvanceToNextStation(dir,gPyrTarget,"MARKET DNA HOLDS THROUGH STATION");
             return;
          }
          if(MarketDNAHarvestTowardDesired()) return;
       }
       PyrCloseFullCampaign("OPPOSITE STRUCTURAL DESTINATION");
       return;
    }

   bool invalid=(gPyrInvalidation>0.0 &&
                (dir==DIR_BUY ? Bid<gPyrInvalidation : Ask>gPyrInvalidation));
   if(invalid) gPyrInvalidTicks++; else gPyrInvalidTicks=0;
   if(gPyrInvalidTicks>=MathMax(1,(int)PyramidInvalidationCharacter))
   { PyrCloseFullCampaign("CONFIRMED STRUCTURAL INVALIDATION"); return; }

   // A temporary opposite arrow/wick inside a still-valid route is a pullback,
   // not permission to dismantle the train. Opposite closure is allowed only
   // after the persistent route itself has ended.
   if(confirmedTurn!=DIR_FLAT && confirmedTurn!=dir && BasketProfit()>0.0 &&
      (!gPyrRouteActive || gPyrRouteDirection!=dir))
   { PyrCloseFullCampaign("CONFIRMED OPPOSITE ROUTE AFTER DERAIL"); return; }

   if(PyramidNeverLetProvenCampaignGoNegative && gPyrCampaignProven &&
      BasketProfit()<=MathMax(0.01,MinimumNetCloseProfit))
   { PyrCloseFullCampaign("PROVEN CAMPAIGN FLOOR"); return; }

   gPyrState=(dir==DIR_BUY?"HOLD BUY TO ":"HOLD SELL TO ")+DoubleToString(gPyrTarget,Digits)+
             " | "+DoubleToString(progress*100.0,0)+"%";
}

int PyrRuntimeMaxEntries()
{
   if(EnableCompoundStaircase && AccountBalance()<=MathMax(1.0,MicroAccountThreshold))
      return MathMax(1,MathMin(3,MicroMaximumSimultaneousCars));
   if(EnableMarketDNA)
      return MathMax(1,MathMin(20,MarketDNAMaxCars));
   return MathMax(1,MathMin(20,gUnityMaxEntries));
}

double WillEntryRiskFraction(bool first)
{
   if(EnableMarketDNA) return MarketDNAEntryRiskFraction(first);
   if(first || !EnableWillDNA) return 1.0; // Legacy path: initial anchor obeys selected ATR risk.
   double edgeHealth=WillEdgeHealth()/100.0;
   double learned=0.35+0.65*(0.50*gWillConfidence+0.50*edgeHealth);
   if(gWillEdge>=WillMinimumPositiveEdge && gWillConfidence>=0.50) learned=1.0;
   // Profit-side energy receives more authority; drawdown energy must earn it from DNA.
   if(BasketProfit()>0.0) learned=MathMax(0.75,learned);
   else learned=MathMin(0.75,learned);
   return UIClamp(learned,0.25,1.0);
}

bool PyrTryEntry(int confirmedTurn)
{
   if(confirmedTurn==DIR_FLAT) return false;
   if(gHT6DoctrineOwnsEntry)
   {
      string seqReason="";
      int seqKind=(TradeCount()==0?DOCTRINE_REQUEST_SEED:DOCTRINE_REQUEST_ADD);
      if(!HT6DoctrineAllowsRequest(confirmedTurn,seqKind,seqReason))
      {
         gPyrState=seqReason; gEntryStatus=seqReason; HT5HospitalObserveBlock(seqReason); return false;
      }
   }
   // Final membrane against unlabelled first trades. In universal tribunal mode
   // EVERY fresh campaign must arrive through a named setup + independent witness.
   if(WhereMayFreshEntriesBegin==ENTRY_ANY_NAMED_SETUP_WITH_AGREEMENT && TradeCount()==0 &&
      !gHT5SetupEntryContext && !gMDRLadderEntryOverrideActive)
   {
      gPyrState="ENTRY BLOCKED: NAMED SETUP TRIBUNAL OWNS FRESH CAMPAIGN";
      gEntryStatus="WAIT NAMED SETUP + INDEPENDENT AGREEMENT";
      return false;
   }
   if(gCompoundEntryFreeze)
   { gPyrState="COMPOUND GUARD/COLLECTION - NEW CARS FROZEN"; return false; }
   if(gPyrPeakObservationActive)
   { gPyrState="PEAK TRANSITION ACTIVE - ALL RELOADS LOCKED"; return false; }
   if(!AllowNewEntries) { gPyrState="ENTRY BLOCKED: ALLOW NEW ENTRIES OFF"; return false; }
   if(!EntryStartTimeGatePasses(true)) { gPyrState="ENTRY BLOCKED: START TIME GATE"; return false; }
   if(confirmedTurn==DIR_BUY && !AllowBuy) { gPyrState="BUY STATION BLOCKED: ALLOW BUY OFF"; return false; }
   if(confirmedTurn==DIR_SELL && !AllowSell) { gPyrState="SELL STATION BLOCKED: ALLOW SELL OFF"; return false; }
   if(TradeCount()>0)
   {
      HT5UpdateOpenTicketTelemetry();
      if(gHT5DefenseMode)
      {
         gPyrState="ENTRY BLOCKED: "+gHT5DefenseState;
         gEntryStatus=gPyrState;
         return false;
      }
   }
   if(MarketDNASonicRLadder && gMDRLadderActive && !gMDRLadderEntryOverrideActive)
   { gPyrState="ENTRY BLOCKED: R-LADDER OWNS ADDS"; return false; }
   if(MarketDNADayHLGuard && !MarketDNADayHLAllowsDirection(confirmedTurn))
   { gPyrState="ENTRY BLOCKED: "+gMDDayHLState; return false; }
   string entryTrendReason="";
   int trendSource=(gHT5SetupEntryContext && gHT5ActiveSetupSource!=PYR_SOURCE_NONE?gHT5ActiveSetupSource:(int)gPyrSignalSource);
   if(!HT5TrendFortificationAllows(trendSource,confirmedTurn,TradeCount()>0,entryTrendReason))
   { gPyrState="ENTRY BLOCKED: TREND FORTIFICATION • "+entryTrendReason; gHT5TrendFortificationState=gPyrState; return false; }
   if(WhereMayFreshEntriesBegin==ENTRY_ONLY_AT_SIGNAL_FVG && !gMDRLadderEntryOverrideActive && !MarketDNASignalFVGEntryReady(confirmedTurn))
   { gPyrState="ENTRY BLOCKED: STRICT SIGNAL FVG • "+gMDFVGState; return false; }
   bool queuedFVGSeed=MarketDNASignalFVGQueuedSeedReady(confirmedTurn);
   int openDir=(int)DetectDirection();
   if(TradeCount()>0 && openDir!=confirmedTurn)
   { gPyrState="ENTRY BLOCKED: OPPOSITE CAMPAIGN OPEN"; return false; }
   // This is a SIMULTANEOUS-CAR limit, never a lifetime route/station limit.
   if(TradeCountByDirection(confirmedTurn)>=PyrRuntimeMaxEntries())
   { gPyrState="ENTRY BLOCKED: MAX SIMULTANEOUS CARS"; return false; }
   if(!queuedFVGSeed && PyrSameBankedStationRefillBlocked(confirmedTurn))
   {
      gPyrState="BANKED STATION - WAIT DEPARTURE BEFORE SAME-STATION REFILL";
      return false;
   }
   if(!PyramidRapidFire && TradeCount()>0)
   { gPyrState="ENTRY BLOCKED: RAPID FIRE OFF"; return false; }
   if(!gMDBurstOverride && gPyrLastEntryTime>0 && TimeCurrent()-gPyrLastEntryTime<MathMax(0,(int)PyramidEntryRhythm))
   { gPyrState="ENTRY BLOCKED: CAR RHYTHM COOLDOWN"; return false; }

   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   RefreshRates();
   double price=(confirmedTurn==DIR_BUY ? Ask : Bid);
   if(!gMDBurstOverride && TradeCount()>0 && gLastOpenedPrice>0.0 && MathAbs(price-gLastOpenedPrice)<atr*MathMax(0.0,PyramidAddSpacingATR))
   { gPyrState="ENTRY BLOCKED: CAR SPACING"; return false; }

   double target=0.0,invalid=0.0,advantage=0.0;
   bool sequenceFallbackPlan=false;
   if(gHT5SetupEntryContext && gHT5ActiveSetupSource!=PYR_SOURCE_NONE && gHT5SetupEntryStop>0.0 && gHT5SetupEntryTarget>0.0)
   {
      invalid=gHT5SetupEntryStop; target=gHT5SetupEntryTarget;
      if(confirmedTurn==DIR_BUY && (invalid>=price || target<=price))
      { gPyrState="NAMED SETUP PLAN INVALID BUY GEOMETRY"; return false; }
      if(confirmedTurn==DIR_SELL && (invalid<=price || target>=price))
      { gPyrState="NAMED SETUP PLAN INVALID SELL GEOMETRY"; return false; }
      advantage=MathAbs(target-price)/MathMax(Point,MathAbs(price-invalid));
      gPyrState="NAMED SETUP PLAN: "+gHT5SetupEntryLabel+" • "+gHT5SetupEntryWitnesses;
   }
   else if(gMDRLadderEntryOverrideActive)
   {
      invalid=gMDRLadderEntryStop; target=gMDRLadderEntryTarget;
      if(confirmedTurn==DIR_BUY && (invalid>=price || target<=price)) return false;
      if(confirmedTurn==DIR_SELL && (invalid<=price || target>=price)) return false;
      advantage=MathAbs(target-price)/MathMax(Point,MathAbs(price-invalid));
   }
   else if(queuedFVGSeed && MarketDNAFVGSeedDedicatedPlan)
   {
      // v3.17: a queued FVG seed NEVER inherits a stale station/route target.
      // The FVG that earned execution defines location; actual protective stop
      // distance defines R; seed target is 1R by default.
      double edge=(confirmedTurn==DIR_BUY?gMDFVGBot:gMDFVGTop);
      double minBreath=atr*MathMax(0.05,MarketDNAFVGSeedMinStopATR);
      double fvgBuffer=atr*MathMax(MathMax(0.08,MarketDNASignalFVGInvalidationATR),MarketDNAFVGSeedMinStopATR);
      invalid=NormalizeDouble(edge-confirmedTurn*fvgBuffer,Digits);
      double rr=MathAbs(price-invalid);
      double maxR=atr*MathMax(MathMax(MarketDNAFVGSeedMinStopATR,0.10),MarketDNAFVGSeedMaxStopATR);
      if(rr<minBreath)
      {
         invalid=NormalizeDouble(price-confirmedTurn*minBreath,Digits);
         rr=MathAbs(price-invalid);
      }
      if(rr<=Point || rr>maxR ||
         (confirmedTurn==DIR_BUY && invalid>=price) ||
         (confirmedTurn==DIR_SELL && invalid<=price))
      {
         gPyrState="SIGNAL FVG DIRECT PLAN INVALID / STOP GEOMETRY";
         return false;
      }
      double targetR=(MarketDNASonicRLadder?MathMax(0.10,MarketDNARLadderTargetR):1.0);
      target=NormalizeDouble(price+confirmedTurn*rr*targetR,Digits);
      advantage=targetR;
      gPyrState="QUEUED SIGNAL FVG -> DEDICATED 1R SEED PLAN";
   }
   else if(gHT6SequencePlanContext && gHT6Seq.active && gHT6Seq.direction==confirmedTurn)
   {
      // Sequence-owned deterministic risk geometry. Legacy route/station organs
      // remain context, but cannot silently replace the campaign's stop thesis.
      double brokerMin=MathMax(Point,MarketInfo(Symbol(),MODE_STOPLEVEL)*Point+Point);
      double minDist=MathMax(brokerMin,atr*0.60);
      double maxDist=MathMax(minDist,atr*2.20);
      double desiredDist=atr*1.20;
      double structuralAnchor=0.0;
      if(gHT6Seq.phase==SEQ_PHASE_ACCELERATE)
         structuralAnchor=(confirmedTurn==DIR_BUY?gHT6Seq.pauseLow:gHT6Seq.pauseHigh);
      if(structuralAnchor<=0.0)
         structuralAnchor=(confirmedTurn==DIR_BUY?gPyrLow1:gPyrHigh1);
      if(structuralAnchor>0.0)
      {
         double structuralStop=structuralAnchor-confirmedTurn*atr*0.06;
         bool validSide=(confirmedTurn==DIR_BUY?structuralStop<price:structuralStop>price);
         if(validSide)
         {
            double structuralDist=MathAbs(price-structuralStop);
            if(structuralDist>=minDist && structuralDist<=maxDist) desiredDist=structuralDist;
         }
      }
      desiredDist=MathMax(minDist,MathMin(maxDist,desiredDist));
      invalid=NormalizeDouble(price-confirmedTurn*desiredDist,Digits);
      double targetR=(gHT6Seq.phase==SEQ_PHASE_ACCELERATE?1.80:1.50);
      target=NormalizeDouble(price+confirmedTurn*desiredDist*targetR,Digits);
      advantage=targetR;
      sequenceFallbackPlan=true;
      gPyrState="SEQUENCE OWNED PLAN • "+DoubleToString(desiredDist/atr,2)+" ATR STOP • "+DoubleToString(targetR,2)+"R TARGET";
   }
   else if(!PyrBuildTradePlan(confirmedTurn,target,invalid,advantage))
   {
      bool sequencePlanAuthority=(gHT6DoctrineOwnsEntry && gHT6Seq.active && gHT6Seq.direction==confirmedTurn &&
                                  gHT6Seq.phase>=SEQ_PHASE_ATTACK && gHT6Seq.phase<=SEQ_PHASE_ACCELERATE);
      if(!queuedFVGSeed && sequencePlanAuthority)
      {
         // v6.01 SIMPLE safety fallback: sequence has already proved side/phase.
         // If a legacy route organ cannot construct geometry, use an ATR-normalized
         // broker-protected plan rather than deadlocking the entire creature.
         double stopR=atr*1.20;
         invalid=NormalizeDouble(price-confirmedTurn*stopR,Digits);
         target=NormalizeDouble(price+confirmedTurn*stopR*1.50,Digits);
         advantage=1.50;
         sequenceFallbackPlan=true;
         gPyrState="SEQUENCE FALLBACK PLAN • 1.20 ATR STOP • 1.50R TARGET";
      }
      else if(!queuedFVGSeed)
      {
         gPyrProjectedAdvantage=advantage;
         gPyrState="STRUCTURAL PLAN INVALID - WAIT NEXT VALID ROUTE";
         return false;
      }
      else
      {

      double fvgEdge=(confirmedTurn==DIR_BUY?gMDFVGBot:gMDFVGTop);
      invalid=NormalizeDouble(fvgEdge-confirmedTurn*atr*MathMax(0.08,MarketDNASignalFVGInvalidationATR),Digits);
      double rr=MathAbs(price-invalid);
      if(rr<=Point || (confirmedTurn==DIR_BUY && invalid>=price) || (confirmedTurn==DIR_SELL && invalid<=price))
      {
         gPyrState="SIGNAL FVG PLAN INVALID - WAIT SAFER RETEST";
         return false;
      }
      target=NormalizeDouble(price+confirmedTurn*rr*MathMax(0.50,MarketDNARLadderTargetR),Digits);
      advantage=MathAbs(target-price)/MathMax(Point,rr);
      gPyrState="QUEUED SIGNAL FVG -> FALLBACK 1R PLAN";
      }
   }
   // SONIC seed freezes a true 1R coordinate system from the original structural stop.
   if(!gMDRLadderEntryOverrideActive && MarketDNASonicRLadder && TradeCount()==0 &&
      gPyrSignalSource==PYR_SOURCE_TRIGGER_RAIL_BREAK)
   {
      double r=MathAbs(price-invalid);
      if(r>Point) target=NormalizeDouble(price+confirmedTurn*r*MathMax(0.10,MarketDNARLadderTargetR),Digits);
   }
   string survivalReason="";
   int survivalSource=(gHT5SetupEntryContext && gHT5ActiveSetupSource!=PYR_SOURCE_NONE?
                       gHT5ActiveSetupSource:(int)gPyrSignalSource);
   if(!HT5EntrySurvivalAllows(survivalSource,confirmedTurn,price,invalid,survivalReason))
   {
      gPyrState="ENTRY BLOCKED: SURVIVAL FIREWALL • "+survivalReason;
      gEntryStatus=gPyrState;
      return false;
   }

   gPyrProjectedAdvantage=advantage;
   bool first=(TradeCount()==0);
   string action=(confirmedTurn==DIR_BUY?"PYR_BUY_":"PYR_SELL_")+gPyrLowClass+"_"+gPyrHighClass;
   if(gHT5SetupEntryContext && gHT5ActiveSetupSource!=PYR_SOURCE_NONE)
      action="SETUP_"+HT5SourceShortTag(gHT5ActiveSetupSource);
   gPyrPendingPlan=true; gPyrPendingStop=invalid; gPyrPendingTarget=target;
   bool oldFVGSeedOrderContext=gMDFVGSeedOrderContext;
   bool oldSequencePlanContext=gHT6SequencePlanContext;
   if(queuedFVGSeed && !gMDRLadderEntryOverrideActive) gMDFVGSeedOrderContext=true;
   if(sequenceFallbackPlan) gHT6SequencePlanContext=true;
   double willRiskFraction=(gMDRLadderEntryOverrideActive?gMDRLadderEntryRiskFraction:WillEntryRiskFraction(first));
   int riskSource=(gHT5SetupEntryContext && gHT5ActiveSetupSource!=PYR_SOURCE_NONE?
                   gHT5ActiveSetupSource:(int)gPyrSignalSource);
   if(first && riskSource>PYR_SOURCE_NONE && riskSource<32)
      willRiskFraction*=HT5SourceSideRiskScale(riskSource,confirmedTurn);
   bool opened=SendOrder(confirmedTurn,willRiskFraction,action,true);
   gMDFVGSeedOrderContext=oldFVGSeedOrderContext;
   gHT6SequencePlanContext=oldSequencePlanContext;
   gPyrPendingPlan=false; gPyrPendingStop=0.0; gPyrPendingTarget=0.0;
   if(opened)
   {
      if(gHT6DoctrineOwnsEntry)
      {
         HT6CaptureEntrySequenceSnapshot();
         if(gHT6Seq.phase==SEQ_PHASE_ZONE_3_5) gHT6Seq.phase3AddConsumed=true;
      }
      if(gHT5SetupEntryContext && gHT5ActiveSetupSource!=PYR_SOURCE_NONE)
         HT5RegisterFilledSetupSource(gHT5ActiveSetupSource,first);
      else if(first)
      {
         // Legacy/FVG path still freezes its actual entry identity for learning.
         gHT5CampaignEntrySource=(int)gPyrSignalSource;
         gHT5CampaignEntryLabel=HT5SourceName(gHT5CampaignEntrySource);
         gHT5CampaignEntryWitnesses="LEGACY/FVG PIPELINE";
         gHT5CampaignEntryAgreement=0.0;
         gHT5CampaignEntryTime=TimeCurrent();
         for(int hs=0;hs<32;hs++) gHT5CampaignSourceWeight[hs]=0.0;
         gHT5CampaignSourceTotalWeight=0.0;
         if(gHT5CampaignEntrySource>0 && gHT5CampaignEntrySource<32)
         { gHT5CampaignSourceWeight[gHT5CampaignEntrySource]=1.0; gHT5CampaignSourceTotalWeight=1.0; }
      }
      if(first && MarketDNASonicRLadder && gPyrSignalSource==PYR_SOURCE_TRIGGER_RAIL_BREAK && gLastOpenedTakeProfit>0.0)
      { target=gLastOpenedTakeProfit; }
      gPyrLastEntryTime=TimeCurrent();
      if(gPyrSignalSource==PYR_SOURCE_BOS_CONTINUATION && gPyrActiveSignalIdentity>0)
         gPyrLastUsedBOSIdentity=gPyrActiveSignalIdentity;
      if(gPyrSignalSource==PYR_SOURCE_CHANNEL_BREAK && gPyrActiveSignalIdentity>0)
         gMDChannelLastUsedBreakIdentity=gPyrActiveSignalIdentity;
      if(first)
      {
         HT6CaptureEntrySequenceSnapshot();
         gPyrCampaignDirection=confirmedTurn; gPyrTarget=target;
         // v3.17: capture the ACTUAL broker stop before feeding the autopsy/route.
         // This keeps self-evolution, 1R measurement and structural invalidation on
         // the same geometry that is truly protecting the order.
         gPyrInvalidation=invalid;
         for(int riskIndex=OrdersTotal()-1;riskIndex>=0;riskIndex--)
            if(OrderSelect(riskIndex,SELECT_BY_POS,MODE_TRADES) && OurOrder() && OrderStopLoss()>0.0)
            { gPyrInvalidation=OrderStopLoss(); break; }
         EvolutionCaptureSeed(confirmedTurn,gLastOpenedPrice,gPyrInvalidation,target);
         PyrStartOrContinueRoute(confirmedTurn,gPyrInvalidation,"ENTRY ANCHOR");
         gPyrEntryAnchor=gLastOpenedPrice; gPyrBestPrice=gLastOpenedPrice;
         gPyrCampaignProven=false; gPyrInvalidTicks=0;
         gPyrCampaignStartBalance=AccountBalance();
         gPyrPercentGrabDone=false; gPyrStationGrabCount=0;
         if(gPyrSignalSource==PYR_SOURCE_FAILED_EXTREME &&
            gPyrBreakDirection==confirmedTurn && gPyrBreakIdentity>0)
            gPyrLastUsedBreakIdentity=gPyrBreakIdentity;
      }

      // v5.05: every fresh qualified seed can become the one campaign anchor.
      // All later growth is earned through SONIC/R-ladder rather than duplicate
      // near-identical seeds from neighboring detectors.
      if(first && MarketDNASonicRLadder && !gMDRLadderActive &&
         gLastOpenedPrice>0.0 && gPyrInvalidation>0.0)
         MarketDNARLadderArm(confirmedTurn,gLastOpenedPrice,gPyrInvalidation);

      // Every fresh BOS becomes a new remembered station, even if older cars
      // are still riding. This is how one route can traverse unlimited stations.
      if(gPyrSignalSource==PYR_SOURCE_BOS_CONTINUATION)
         PyrRecordRouteStation(confirmedTurn,
                               confirmedTurn==DIR_BUY ? gPyrHigh1 : gPyrLow1,
                               gPyrActiveSignalIdentity,"BOS STATION");

      // New cars may extend the destination; they never shrink an existing route target.
      if(!first && target>0.0)
      {
         if(confirmedTurn==DIR_BUY && (gPyrTarget<=0.0 || target>gPyrTarget)) gPyrTarget=target;
         if(confirmedTurn==DIR_SELL && (gPyrTarget<=0.0 || target<gPyrTarget)) gPyrTarget=target;
      }

      string entryName=gPyrStructureSignalName+"WICK -> ";
      if(gPyrSignalSource==PYR_SOURCE_TRIGGER_RAIL_BOUNCE)
         entryName=(confirmedTurn==DIR_BUY?"BLACK TRIGGER REJECT -> IMMEDIATE BUY -> ":"BLACK TRIGGER REJECT -> IMMEDIATE SELL -> ");
      else if(gPyrSignalSource==PYR_SOURCE_TRIGGER_RAIL_BREAK)
         entryName=(confirmedTurn==DIR_SELL?"BLACK TRIGGER BREAK -> SONIC SELL -> ":"BLACK TRIGGER BREAK -> SONIC BUY -> ");
      else if(gPyrSignalSource==PYR_SOURCE_CHANNEL_BOUNCE)
         entryName=(confirmedTurn==DIR_BUY?"HIST SUPPORT CHANNEL BUY BOUNCE -> ":"HIST RESISTANCE CHANNEL SELL BOUNCE -> ");
      else if(gPyrSignalSource==PYR_SOURCE_CHANNEL_BREAK)
         entryName=(confirmedTurn==DIR_BUY?"HIST RESISTANCE BREAK BUY BOS -> ":"HIST SUPPORT BREAK SELL BOS -> ");
      else if(gPyrSignalSource==PYR_SOURCE_INFLECTION_TRANSFER)
         entryName=(confirmedTurn==DIR_BUY?"INFLECTION TRANSFER BUY -> ":"INFLECTION TRANSFER SELL -> ");
      else if(gPyrSignalSource==PYR_SOURCE_RHYTHM_ACCELERATOR)
         entryName=(confirmedTurn==DIR_BUY?"RHYTHM RAPID BUY -> ":"RHYTHM RAPID SELL -> ");
      else if(gPyrSignalSource==PYR_SOURCE_ROUTE_ACCELERATOR)
         entryName=(confirmedTurn==DIR_BUY?"HOT WHEELS BUY STATION -> ":"HOT WHEELS SELL STATION -> ");
      else if(gPyrSignalSource==PYR_SOURCE_DIRECTIONAL_RETEST)
         entryName=(confirmedTurn==DIR_BUY?"BUY PROFIT-STATION RETEST -> ":"SELL PROFIT-STATION RETEST -> ");
      else if(gPyrSignalSource==PYR_SOURCE_RECLAIM_AREA)
         entryName=(confirmedTurn==DIR_BUY?"RECLAIM BUY ":"RECLAIM SELL ")+gPyrActiveReclaimName+" -> ";
      else if(gPyrSignalSource==PYR_SOURCE_TRAIN_STATION)
         entryName=(confirmedTurn==DIR_BUY?"IL STATION: BUY SUPPORT BOUNCE -> ":"IL STATION: SELL RESISTANCE BOUNCE -> ");
      else if((int)gPyrSignalSource>=PYR_SOURCE_BOS_PULLBACK)
         entryName=HT5SourceName((int)gPyrSignalSource)+" -> ";
      gPyrLastAction=entryName+
                     DoubleToString(target,Digits);
      gEntryStatus="PYRAMID "+gPyrLastAction;

      if(gPyrSignalSource==PYR_SOURCE_BOS_CONTINUATION ||
         gPyrSignalSource==PYR_SOURCE_TRIGGER_RAIL_BOUNCE ||
         gPyrSignalSource==PYR_SOURCE_TRIGGER_RAIL_BREAK ||
         gPyrSignalSource==PYR_SOURCE_CHANNEL_BOUNCE ||
         gPyrSignalSource==PYR_SOURCE_CHANNEL_BREAK ||
         gPyrSignalSource==PYR_SOURCE_ROUTE_ACCELERATOR ||
         gPyrSignalSource==PYR_SOURCE_RHYTHM_ACCELERATOR ||
         gPyrSignalSource==PYR_SOURCE_TRAIN_STATION ||
         gPyrSignalSource==PYR_SOURCE_RECLAIM_AREA ||
         gPyrSignalSource==PYR_SOURCE_DIRECTIONAL_RETEST)
      {
         RefreshRates();
         double burstOrigin=((gPyrSignalSource==PYR_SOURCE_TRIGGER_RAIL_BOUNCE ||
                              gPyrSignalSource==PYR_SOURCE_TRIGGER_RAIL_BREAK) ? gMDTriggerRailNow :
                             ((gPyrSignalSource==PYR_SOURCE_CHANNEL_BOUNCE) ?
                             (confirmedTurn==DIR_BUY?gMDChannelSupportNow:gMDChannelResistanceNow) :
                             ((gPyrSignalSource==PYR_SOURCE_ROUTE_ACCELERATOR && gPyrRouteLastStation>0.0) ?
                              gPyrRouteLastStation : (confirmedTurn==DIR_BUY ? Ask : Bid))));
         PyrArmHotWheelBurst(confirmedTurn,burstOrigin,entryName);
      }
      return true;
   }
   gPyrState=(confirmedTurn==DIR_BUY ? "BUY ORDER SEND FAILED - CHECK EXPERTS" :
                                         "SELL ORDER SEND FAILED - CHECK EXPERTS");
   return false;
}

void PyrDrawStructure()
{
   if(HT6EinsteinEnabled())
   {
      DeleteObjectsWithPrefix(Pfx()+"PYR_");
      Comment("");
      return;
   }
   HT6EinsteinDrawBox();
   MarketDNADrawHistoricalChannels();
   if(!PyramidShowStructure || gPyrHigh1<=gPyrLow1) return;
   string ph=Pfx()+"PYR_HIGH",pl=Pfx()+"PYR_LOW",pt=Pfx()+"PYR_TARGET",pi=Pfx()+"PYR_INVALID";
   if(ObjectFind(0,ph)<0) ObjectCreate(0,ph,OBJ_HLINE,0,0,gPyrHigh1);
   if(ObjectFind(0,pl)<0) ObjectCreate(0,pl,OBJ_HLINE,0,0,gPyrLow1);
   ObjectSetDouble(0,ph,OBJPROP_PRICE1,gPyrHigh1); ObjectSetInteger(0,ph,OBJPROP_COLOR,HTAlert);
   ObjectSetDouble(0,pl,OBJPROP_PRICE1,gPyrLow1); ObjectSetInteger(0,pl,OBJPROP_COLOR,HTGoldBright);
   ObjectSetInteger(0,ph,OBJPROP_STYLE,STYLE_DASH); ObjectSetInteger(0,pl,OBJPROP_STYLE,STYLE_DASH);
   if(gPyrTarget>0.0)
   {
      if(ObjectFind(0,pt)<0) ObjectCreate(0,pt,OBJ_HLINE,0,0,gPyrTarget);
      ObjectSetDouble(0,pt,OBJPROP_PRICE1,gPyrTarget); ObjectSetInteger(0,pt,OBJPROP_COLOR,HTGold);
   }
   if(gPyrInvalidation>0.0)
   {
      if(ObjectFind(0,pi)<0) ObjectCreate(0,pi,OBJ_HLINE,0,0,gPyrInvalidation);
      ObjectSetDouble(0,pi,OBJPROP_PRICE1,gPyrInvalidation); ObjectSetInteger(0,pi,OBJPROP_COLOR,HTAlert);
   }

   string transitionLine=Pfx()+"PYR_TRANSITION_LINE";
   string transitionText=Pfx()+"PYR_TRANSITION_TEXT";
   if(gPyrPeakObservationActive && gPyrCollectedStation>0.0)
   {
      datetime transitionTime=iTime(Symbol(),SignalTF,0);
      if(ObjectFind(0,transitionLine)<0) ObjectCreate(0,transitionLine,OBJ_HLINE,0,0,gPyrCollectedStation);
      ObjectSetDouble(0,transitionLine,OBJPROP_PRICE1,gPyrCollectedStation);
      ObjectSetInteger(0,transitionLine,OBJPROP_COLOR,HTAlert);
      ObjectSetInteger(0,transitionLine,OBJPROP_STYLE,STYLE_DASHDOT);
      ObjectSetInteger(0,transitionLine,OBJPROP_WIDTH,2);
      if(ObjectFind(0,transitionText)<0) ObjectCreate(0,transitionText,OBJ_TEXT,0,transitionTime,gPyrCollectedStation);
      ObjectMove(0,transitionText,0,transitionTime,gPyrCollectedStation);
      ObjectSetText(transitionText,"PEAK TRANSITION | "+
                    (gPyrPeakDirection==DIR_BUY?"BUYS LOCKED | ":"SELLS LOCKED | ")+
                    gPyrTransitionState,8,"Arial Bold",HTAlert);
   }
   else
   {
      ObjectDelete(0,transitionLine);
      ObjectDelete(0,transitionText);
   }
   if(PyramidShowILTrainStation)
   {
      datetime labelTime=iTime(Symbol(),SignalTF,0);
      string buyLabel=Pfx()+"PYR_STATION_BUY_LABEL";
      string sellLabel=Pfx()+"PYR_STATION_SELL_LABEL";
      if(ObjectFind(0,buyLabel)<0) ObjectCreate(0,buyLabel,OBJ_TEXT,0,labelTime,gPyrHigh1);
      if(ObjectFind(0,sellLabel)<0) ObjectCreate(0,sellLabel,OBJ_TEXT,0,labelTime,gPyrLow1);
      ObjectMove(0,buyLabel,0,labelTime,gPyrHigh1);
      ObjectMove(0,sellLabel,0,labelTime,gPyrLow1);
      ObjectSetText(buyLabel,"IL BUY STATION | PY HIGH | "+
                    (gPyrBuyStationArmed?(gPyrBuyStationReady?"ARMED":"USED - RESETTING"):"WAIT RECLAIM"),
                    8,"Arial Bold",gPyrBuyStationArmed?HTGoldBright:HTMuted);
      ObjectSetText(sellLabel,"IL SELL STATION | PY LOW | "+
                    (gPyrSellStationArmed?(gPyrSellStationReady?"ARMED":"USED - RESETTING"):"WAIT BREAKDOWN"),
                    8,"Arial Bold",gPyrSellStationArmed?HTAlert:HTMuted);

      string halfLine=Pfx()+"PYR_50_GATE",trainText=Pfx()+"PYR_TRAIN",track=Pfx()+"PYR_TRACK";
      if(TradeCount()>0 && gPyrEntryAnchor>0.0 && gPyrTarget>0.0)
      {
         double halfPrice=(gPyrEntryAnchor+gPyrTarget)*0.5;
         double trainPrice=(gPyrCampaignDirection==DIR_BUY ? Bid : Ask);
         if(ObjectFind(0,halfLine)<0) ObjectCreate(0,halfLine,OBJ_HLINE,0,0,halfPrice);
         ObjectSetDouble(0,halfLine,OBJPROP_PRICE1,halfPrice);
         ObjectSetInteger(0,halfLine,OBJPROP_COLOR,HTGoldBright);
         ObjectSetInteger(0,halfLine,OBJPROP_STYLE,STYLE_DOT);
         if(ObjectFind(0,trainText)<0) ObjectCreate(0,trainText,OBJ_TEXT,0,labelTime,trainPrice);
         ObjectMove(0,trainText,0,labelTime,trainPrice);
         double trainProgress=PyrDirectionalProgress(gPyrCampaignDirection,trainPrice)*100.0;
         ObjectSetText(trainText,(gPyrCampaignDirection==DIR_BUY?"[ TRAIN BUY >> ] ":"[ << TRAIN SELL ] ")+
                       DoubleToString(trainProgress,0)+"%",
                       9,"Arial Bold",gPyrCampaignProven?HTGoldBright:HTText);
         if(ObjectFind(0,track)<0)
            ObjectCreate(0,track,OBJ_TREND,0,gCampaignStart,gPyrEntryAnchor,labelTime,gPyrTarget);
         ObjectMove(0,track,0,gCampaignStart,gPyrEntryAnchor);
         ObjectMove(0,track,1,labelTime,gPyrTarget);
         ObjectSetInteger(0,track,OBJPROP_COLOR,HTGoldDark);
         ObjectSetInteger(0,track,OBJPROP_STYLE,STYLE_DASH);
         ObjectSetInteger(0,track,OBJPROP_RAY_RIGHT,false);
      }
      else
      {
         ObjectDelete(0,halfLine); ObjectDelete(0,trainText); ObjectDelete(0,track);
      }
   }
   if(PyramidShowReclaimAreas)
   {
      PyrRefreshReclaimAreas();
      datetime reclaimTime=iTime(Symbol(),SignalTF,0);
      for(int reclaimIndex=0;reclaimIndex<4;reclaimIndex++)
      {
         string lineName=Pfx()+"PYR_RECLAIM_LINE_"+IntegerToString(reclaimIndex);
         string textName=Pfx()+"PYR_RECLAIM_TEXT_"+IntegerToString(reclaimIndex);
         double reclaimLevel=gPyrReclaimLevel[reclaimIndex];
         if(reclaimLevel<=0.0)
         { ObjectDelete(0,lineName); ObjectDelete(0,textName); continue; }
         if(ObjectFind(0,lineName)<0) ObjectCreate(0,lineName,OBJ_HLINE,0,0,reclaimLevel);
         ObjectSetDouble(0,lineName,OBJPROP_PRICE1,reclaimLevel);
         ObjectSetInteger(0,lineName,OBJPROP_COLOR,HTCharcoalLight);
         ObjectSetInteger(0,lineName,OBJPROP_STYLE,STYLE_DOT);
         if(ObjectFind(0,textName)<0) ObjectCreate(0,textName,OBJ_TEXT,0,reclaimTime,reclaimLevel);
         ObjectMove(0,textName,0,reclaimTime,reclaimLevel);
         string reclaimState=(gPyrReclaimBuyArmed[reclaimIndex]?"BUY RECLAIM":
                              (gPyrReclaimSellArmed[reclaimIndex]?"SELL RECLAIM":"WAIT BREAK"));
         ObjectSetText(textName,"RECLAIM • "+PyrReclaimAreaName(reclaimIndex)+" • "+reclaimState,
                       7,"Arial Bold",gPyrReclaimBuyArmed[reclaimIndex]?HTGoldBright:
                       (gPyrReclaimSellArmed[reclaimIndex]?HTAlert:HTMuted));
      }
   }
   Comment("WISDO UNITY TRAIN  |  ",gPyrLowClass," -> ",gPyrHighClass,"  |  ",gPyrLeg,
           "\n",gPyrState,"  | RSI ",DoubleToString(gPyrRSI,1),"  | GRIP ",IntegerToString(gPyrGripTicks),
           "\nADV ",DoubleToString(gPyrProjectedAdvantage,2)," / ",DoubleToString(gPyrRequiredAdvantage,2),
           "  | ",gPyrLastAction,
           "\nIL TRAIN STATION | BUY ",(gPyrBuyStationArmed?"ARMED":"WAIT"),
           " | SELL ",(gPyrSellStationArmed?"ARMED":"WAIT"),
           " | TRAIL GATE ",(gPyrCampaignProven?"OPEN":"LOCKED UNTIL 50%"),
           "\nSTATION MIND | ",gPyrStationDecision);
}

void PyrPaintSwingHistory()
{
   if(HT6EinsteinEnabled())
   {
      DeleteObjectsWithPrefix(Pfx()+"PYR_LBL_");
      return;
   }
   if(!PyramidPaintSwingLabels) return;
   static datetime lastPaintedBar=0;
   datetime currentBar=iTime(Symbol(),SignalTF,0);
   if(currentBar==lastPaintedBar) return;
   lastPaintedBar=currentBar;

   string prefix=Pfx()+"PYR_LBL_";
   DeleteObjectsWithPrefix(prefix);
   int depth=MathMax(2,(int)PyramidSwingCharacter);
   int bars=iBars(Symbol(),SignalTF);
   int scan=MathMin(MathMax(30,(int)PyramidMapMemory),bars-depth-2);
   double previousHigh=0.0,previousLow=0.0;
   double atr=MathMax(Point,HTStableATR(SignalTF,14));

   // Walk oldest to newest so every label compares with the prior confirmed
   // swing of the same type. No future or developing candle is labeled.
   for(int s=scan;s>=depth+1;s--)
   {
      datetime t=iTime(Symbol(),SignalTF,s);
      if(PyrPivotHigh(s,depth))
      {
         double price=iHigh(Symbol(),SignalTF,s);
         if(previousHigh>0.0)
         {
            string label=(price>previousHigh ? "HH" : "LH");
            string name=prefix+"H_"+IntegerToString((int)t);
            ObjectCreate(0,name,OBJ_TEXT,0,t,price+atr*0.10);
            ObjectSetText(name,label,9,"Arial Bold",label=="HH"?HTGoldBright:HTAlert);
         }
         previousHigh=price;
      }
      if(PyrPivotLow(s,depth))
      {
         double price=iLow(Symbol(),SignalTF,s);
         if(previousLow>0.0)
         {
            string label=(price>previousLow ? "HL" : "LL");
            string name=prefix+"L_"+IntegerToString((int)t);
            ObjectCreate(0,name,OBJ_TEXT,0,t,price-atr*0.10);
            ObjectSetText(name,label,9,"Arial Bold",label=="HL"?HTGoldBright:HTAlert);
         }
         previousLow=price;
      }
   }
}


//====================================================================
// WISDO VOICE BRIDGE
// Contract: bridge writes validated MT4 Global Variables; EA consumes them.
// No language-model text or external process can bypass this validation layer.
//====================================================================
string WisdoSymbolKey(string base)
{
   return base+"_"+Symbol();
}

bool WisdoRead(string base,double &value)
{
   string symbolKey=WisdoSymbolKey(base);
   if(WisdoUseSymbolSpecificGV && GlobalVariableCheck(symbolKey))
   { value=GlobalVariableGet(symbolKey); return true; }
   if(GlobalVariableCheck(base))
   { value=GlobalVariableGet(base); return true; }
   return false;
}

void WisdoWrite(string base,double value)
{
   GlobalVariableSet(base,value);
   if(WisdoUseSymbolSpecificGV) GlobalVariableSet(WisdoSymbolKey(base),value);
}

void WisdoConsumePulse(string base)
{
   if(GlobalVariableCheck(base)) GlobalVariableSet(base,0.0);
   string symbolKey=WisdoSymbolKey(base);
   if(GlobalVariableCheck(symbolKey)) GlobalVariableSet(symbolKey,0.0);
}

bool WisdoCloseProfitableTickets()
{
   bool any=false;
   for(int pass=0;pass<3;pass++)
   {
      for(int i=OrdersTotal()-1;i>=0;i--)
      {
         if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;
         double net=OrderProfit()+OrderSwap()+OrderCommission();
         if(net<=0.0) continue;
         RefreshRates();
         double px=(OrderType()==OP_BUY?Bid:Ask);
         if(HT5CommanderOrderClose(OrderTicket(),OrderLots(),px,SlippagePoints,clrNONE)) any=true;
      }
   }
   return any;
}

void WisdoApplyRuntimeValueControls()
{
   double v=0.0;
   if(WisdoRead("WISDO_RISK_PERCENT",v) || WisdoRead("RISK_PERCENT",v))
      if(v>=1.0 && v<=100.0) RiskPerEntryPercent=v;

   if(WisdoRead("WISDO_CAMPAIGN_RISK_PERCENT",v) || WisdoRead("MAX_CAMPAIGN_RISK",v))
      if(v>=RiskPerEntryPercent && v<=100.0) MaximumCampaignRiskPercent=v;

   if(WisdoRead("WISDO_ARROW_CONFIRM_TICKS",v) || WisdoRead("CONFIRM_TICKS",v))
      if(v>=1.0 && v<=100.0)
      {
         ArrowConfirmationTicksValue=(int)MathRound(v);
         gUnityConfirmTicks=ArrowConfirmationTicksValue;
      }

   if(WisdoRead("WISDO_PARTIAL_PERCENT",v))
      if(v>=1.0 && v<=99.0) gUnityStationPartialPercent=v;

   if(WisdoRead("WISDO_GAIN_TARGET_PERCENT",v))
      if(v>0.0 && v<=100.0) gUnityGainTargetPercent=v;

   if(WisdoRead("WISDO_MAX_ENTRIES",v))
      if(v>=1.0 && v<=20.0) gUnityMaxEntries=(int)MathRound(v);

   if(WisdoRead("WISDO_STATION_MODE",v))
      if(v>=0.0 && v<=2.0) gUnityStationMode=(int)MathRound(v);

   if(WisdoRead("WISDO_DIRECTION_MODE",v))
      if(v>=0.0 && v<=3.0) gWisdoDirectionMode=(int)MathRound(v);
}

void WisdoProcessPulseCommands()
{
   double v=0.0;
   if(WisdoRead("WISDO_PAUSE_TRADING",v))
   {
      bool requestedPause=(v>0.5);
      if(requestedPause && !gWisdoPaused)
      {
         gWisdoPaused=true;
         gWisdoLastAction="PAUSE TRADING";
      }
      else if(!requestedPause && !gWisdoEmergencyLatched && gWisdoPaused)
      {
         gWisdoPaused=false;
         gWisdoLastAction="RESUME TRADING";
      }
   }

   if(WisdoRead("WISDO_RESET_EMERGENCY",v) && v>0.5)
   {
      gWisdoEmergencyLatched=false;
      gWisdoPaused=false;
      gWisdoLastAction="EMERGENCY RESET";
      WisdoConsumePulse("WISDO_RESET_EMERGENCY");
   }

   if(WisdoRead("WISDO_EMERGENCY_STOP",v) && v>0.5)
   {
      gWisdoPaused=true; gWisdoEmergencyLatched=true;
      gWisdoLastAction="EMERGENCY STOP";
      if(WisdoEmergencyClosesCampaign && TradeCount()>0) PyrCloseFullCampaign("WISDO EMERGENCY STOP");
      WisdoConsumePulse("WISDO_EMERGENCY_STOP");
   }

   double closeAllA=0.0,closeAllB=0.0;
   bool hasCloseAllA=WisdoRead("WISDO_CLOSE_ALL_TRADES",closeAllA);
   bool hasCloseAllB=WisdoRead("CLOSE_ALL_TRADES",closeAllB);
   if((hasCloseAllA && closeAllA>0.5) || (hasCloseAllB && closeAllB>0.5))
   {
      if(TradeCount()>0) PyrCloseFullCampaign("WISDO CLOSE ALL");
      gWisdoLastAction="CLOSE ALL TRADES";
      WisdoConsumePulse("WISDO_CLOSE_ALL_TRADES"); WisdoConsumePulse("CLOSE_ALL_TRADES");
   }

   double closeProfitA=0.0,closeProfitB=0.0;
   bool hasCloseProfitA=WisdoRead("WISDO_CLOSE_ALL_PROFITS",closeProfitA);
   bool hasCloseProfitB=WisdoRead("CLOSE_ALL_PROFITS",closeProfitB);
   if((hasCloseProfitA && closeProfitA>0.5) || (hasCloseProfitB && closeProfitB>0.5))
   {
      WisdoCloseProfitableTickets();
      gWisdoLastAction="CLOSE PROFITABLE TRADES";
      WisdoConsumePulse("WISDO_CLOSE_ALL_PROFITS"); WisdoConsumePulse("CLOSE_ALL_PROFITS");
   }
}

void WisdoProcessCommandId()
{
   double commandId=0.0,commandCode=0.0;
   if(!WisdoRead("WISDO_COMMAND_ID",commandId)) return;
   if(commandId<=0.0 || commandId==gWisdoLastCommandId) return;
   gWisdoLastCommandId=commandId;
   if(!WisdoRead("WISDO_LAST_COMMAND",commandCode)) commandCode=0.0;

   int code=(int)MathRound(commandCode);
   if(code==1){ gWisdoPaused=true; gWisdoLastAction="CMD PAUSE"; }
   else if(code==2){ gWisdoPaused=false; gWisdoEmergencyLatched=false; gWisdoLastAction="CMD RESUME"; }
   else if(code==3){ gWisdoPaused=true; gWisdoEmergencyLatched=true; gWisdoLastAction="CMD EMERGENCY"; if(WisdoEmergencyClosesCampaign && TradeCount()>0) PyrCloseFullCampaign("WISDO COMMAND EMERGENCY"); }
   else if(code==4){ if(TradeCount()>0) PyrCloseFullCampaign("WISDO COMMAND CLOSE ALL"); gWisdoLastAction="CMD CLOSE ALL"; }
   else if(code==5){ WisdoCloseProfitableTickets(); gWisdoLastAction="CMD CLOSE PROFITS"; }
   else if(code==6){ gWisdoDirectionMode=0; gWisdoLastAction="CMD AUTO DIRECTION"; }
   else if(code==7){ gWisdoDirectionMode=1; gWisdoLastAction="CMD BUY ONLY"; }
   else if(code==8){ gWisdoDirectionMode=2; gWisdoLastAction="CMD SELL ONLY"; }
   else if(code==9){ gWisdoDirectionMode=3; gWisdoLastAction="CMD MANAGE ONLY"; }
   else gWisdoLastAction="COMMAND ID RECEIVED";

   WisdoWrite("WISDO_EA_ACK_ID",commandId);
   WisdoWrite("WISDO_EA_ACK_CODE",code);
}

