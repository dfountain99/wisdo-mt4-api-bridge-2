{
   if(ArrowEntryControl==ARROW_ENTRY_EVERY_TICK) return "EVERY TICK";
   if(ArrowEntryControl==ARROW_ENTRY_FIRST_ONLY) return "FIRST ENTRY";
   return "LEGACY SETUPS";
}

