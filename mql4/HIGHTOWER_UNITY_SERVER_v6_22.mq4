void DrawMarketDNADashboard()
{
   if(HT6EinsteinEnabled()){ DrawEinsteinFlowDashboard(); return; }
   int width=440,height=1035;
   long chartWidth=0; ChartGetInteger(0,CHART_WIDTH_IN_PIXELS,0,chartWidth);
   int x=(DashboardDockRight?MathMax(0,(int)chartWidth-width-MathMax(0,DashboardRightMargin)):MathMax(0,DashboardX));
   int y=MathMax(0,DashboardY);
   int masterColorIndex=19;
   color master=MarketDNAStrandColor(masterColorIndex);
   if(gMDDesiredDirection==DIR_BUY) master=C'55,235,155';
   else if(gMDDesiredDirection==DIR_SELL) master=C'255,90,105';
   if(StringFind(gMDAction,"TRANSFER")>=0) master=C'255,70,180';
   else if(StringFind(gMDAction,"SUSPEND")>=0 || StringFind(gMDAction,"DEFEND")>=0) master=C'255,185,60';
   else if(StringFind(gMDAction,"HARVEST")>=0 || StringFind(gMDAction,"VAULT")>=0) master=C'255,205,70';

   UISetPanel("MD_BASE",x,y,width,height,C'4,8,14',master);
