//---------------------------------------------------------
void MarketDNARebuildLimitPlanFromLive()
{
   int foundDir=DIR_FLAT;
   int counts[4]; double sums[4];
   ArrayInitialize(counts,0);
   ArrayInitialize(sums,0.0);
   bool mixed=false;
   for(int i=OrdersTotal()-1;i>=0;i--)
      if(OrderSelect(i,SELECT_BY_POS,MODE_TRADES) && MarketDNAPendingSelected())
      {
         int d=(OrderType()==OP_BUYLIMIT?DIR_BUY:(OrderType()==OP_SELLLIMIT?DIR_SELL:DIR_FLAT));
         if(d==DIR_FLAT) continue;
         if(foundDir==DIR_FLAT) foundDir=d;
         else if(foundDir!=d) mixed=true;
         int level=MarketDNALimitLevelFromComment(OrderComment());
         if(level<0 || level>3) continue;
         counts[level]++;
         sums[level]+=OrderOpenPrice();
      }
   if(mixed)
   {
      MarketDNADeletePendingLimits("MIXED LEGACY LIMIT INVENTORY");
      return;
   }
   if(foundDir==DIR_FLAT) return;
   gMDLimitPlanDirection=foundDir;
   gMDLimitPlanCycle=gCompoundCycle;
   for(int l=0;l<4;l++)
   {
      gMDLimitPlannedCars[l]=counts[l];
      if(counts[l]>0)
      {
         gMDPulseAnchorPrice[l]=sums[l]/counts[l];
         gMDPulseCenterPrice[l]=gMDPulseAnchorPrice[l];
      }
   }
   gMDPulseState="PULSE GROW RESTORED LIVE LIMIT PLAN";
   MarketDNASave();
}

void MarketDNARevertV311LegacyPending()
{
   // v3.16 preserves the v3.12 reversion of the v3.11 SONIC/LIMIT role swap. Remove only pending orders
   // explicitly tagged by that temporary _SC cage so they cannot fill under the
   // old behavior after this EA is attached. Normal v3.10/v3.12-compatible limits remain.
   for(int i=OrdersTotal()-1;i>=0;i--)
      if(OrderSelect(i,SELECT_BY_POS,MODE_TRADES) && OurOrder())
      {
         int t=OrderType();
         if(t!=OP_BUYLIMIT && t!=OP_SELLLIMIT && t!=OP_BUYSTOP && t!=OP_SELLSTOP) continue;
         if(StringFind(OrderComment(),"_SC")<0) continue;
         int tk=OrderTicket();
         ResetLastError();
         if(!HT5CommanderOrderDelete(tk,clrNONE))
            Print("v3.16 legacy v3.11 cage cleanup failed ticket=",tk," err=",GetLastError());
         else
            Print("v3.16 removed legacy v3.11 SONIC cage pending ticket=",tk);
      }
}


