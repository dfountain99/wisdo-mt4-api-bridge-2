enum HT_ArithmeticSpacingStep
{
   ARITH_STEP_0_00_R=0,
   ARITH_STEP_0_05_R=5,
   ARITH_STEP_0_10_R=10,
   ARITH_STEP_0_25_R=25,
   ARITH_STEP_0_50_R=50,
   ARITH_STEP_1_00_R=100
};

// Margin safety controls whether an exact percentage-sized order may be opened.
