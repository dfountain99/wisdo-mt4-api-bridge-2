   UISetLabel("MD_SUB",Symbol()+"  v3.16  •  "+gMDAction,x+18,y+40,8,master,"Arial Bold",ANCHOR_LEFT_UPPER);
   string dir=(gMDDesiredDirection==DIR_BUY?"BUY":(gMDDesiredDirection==DIR_SELL?"SELL":"FLAT"));
