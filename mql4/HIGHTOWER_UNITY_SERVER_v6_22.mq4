}

string ATRStopText()
{
   return (EnableLiveATRExecution?"LIVE ATR(":"STABLE ATR(")+IntegerToString(StopATRPeriodValue)+") x"+
          DoubleToString(StopATRMultiplierValue,2);
}

//==============================================================================
// v3.16 LIVE ATR ENGINE
// Stable ATR = last completed bar. Live ATR = provisional Wilder ATR using the
// current bar true-range. This is mathematically live without inventing fake
// volatility: it moves when current true-range expands and rebases on a new bar.
// Tick pulse is tracked separately for diagnostics and is never added to ATR.
//==============================================================================
double HTStableATR(int tf,int period)
{
   int p=MathMax(1,period);
   double a=iATR(Symbol(),tf,p,1);
   if(a<=0.0) a=iATR(Symbol(),tf,p,0);
   return MathMax(Point,a);
}

double HTCurrentTrueRange(int tf)
{
   double h=iHigh(Symbol(),tf,0),l=iLow(Symbol(),tf,0),pc=iClose(Symbol(),tf,1);
   if(h<=0.0 || l<=0.0) return Point;
   if(LiveATRUseCurrentBidInTR)
   {
      RefreshRates();
      if(Bid>0.0){ h=MathMax(h,Bid); l=MathMin(l,Bid); }
   }
   if(pc<=0.0) pc=iOpen(Symbol(),tf,0);
   double tr=MathMax(h-l,MathMax(MathAbs(h-pc),MathAbs(l-pc)));
   return MathMax(Point,tr);
}

double HTLiveATRRaw(int tf,int period)
{
   int p=MathMax(1,period);
   double stable=HTStableATR(tf,p);
   if(!EnableLiveATRExecution) return stable;
   double tr=HTCurrentTrueRange(tf);
   // Provisional Wilder update: previous completed ATR plus current live TR.
   double live=((p-1.0)*stable+tr)/p;
   if(live<=0.0) live=stable;
   return MathMax(Point,live);
}

void HTUpdateLiveATR()
{
   double old=gATRLive14;
   gATRStable14=HTStableATR(SignalTF,14);
   gATRCurrentTR14=HTCurrentTrueRange(SignalTF);
   gATRLive14=HTLiveATRRaw(SignalTF,14);
   gATRStableStop=HTStableATR(SignalTF,StopATRPeriodValue);
   gATRLiveStop=HTLiveATRRaw(SignalTF,StopATRPeriodValue);

   RefreshRates();
   double mid=(Bid+Ask)*0.5;
   double tickMove=(gATRLastMid>0.0?MathAbs(mid-gATRLastMid):0.0);
   double alpha=MathMax(0.01,MathMin(0.80,LiveATRTickPulseAlpha));
   if(gATRTickPulseEWMA<=0.0) gATRTickPulseEWMA=tickMove;
   else gATRTickPulseEWMA=(1.0-alpha)*gATRTickPulseEWMA+alpha*tickMove;
   gATRLastMid=mid;
   gATRLastTickMs=(int)GetTickCount();

   gATRPrevLive14=(old>0.0?old:gATRLive14);
   gATRDelta14=gATRLive14-gATRPrevLive14;
   double eps=MathMax(Point*0.10,gATRLive14*0.000001);
   if(!EnableLiveATRExecution) gATRLiveState="STABLE ATR MODE";
   else if(gATRDelta14>eps) gATRLiveState="LIVE ATR EXPANDING";
   else if(gATRDelta14<-eps) gATRLiveState="LIVE ATR NEW-BAR REBASE";
   else if(tickMove>0.0) gATRLiveState="LIVE ATR HOLD • TICK PULSE";
   else gATRLiveState="LIVE ATR HOLD";
}

double HTExecutionATR(int tf,int period)
{
   if(!EnableLiveATRExecution) return HTStableATR(tf,period);
   if(tf==(int)SignalTF && period==14 && gATRLive14>0.0) return gATRLive14;
   if(tf==(int)SignalTF && period==StopATRPeriodValue && gATRLiveStop>0.0) return gATRLiveStop;
   return HTLiveATRRaw(tf,period);
}

double HTProtectiveStopATR()
{
   double live=HTExecutionATR(SignalTF,StopATRPeriodValue);
   if(LiveATRStopFloorToStable) live=MathMax(live,HTStableATR(SignalTF,StopATRPeriodValue));
   return MathMax(Point,live);
}

void ApplyStopControl()
{
   // DEADSHOT v1.31 has one protective stop model only: ATR.
   StopATRPeriodValue=14;
   StopATRMultiplierValue=(double)((int)ATRStopDistance)/100.0;

   // Broker validity may widen the ATR stop only to the broker-safe minimum.
   MinimumStopDistancePointsValue=50.0;
   if(TradeFrequencyControl==TRADE_MORE_OFTEN)
      MinimumStopDistancePointsValue=30.0;
   else if(TradeFrequencyControl==TRADE_SELECTIVE)
      MinimumStopDistancePointsValue=100.0;

   StructureStopBufferPointsValue=0.0;
   FixedStopDistancePointsValue=0.0;
}

void ApplyScaleInControl()
{
   if(ScaleInControl==SCALE_IN_OFF)
   {
      MaximumOpenTrades=1; MaximumAddsPerCampaign=0;
      MinimumSecondsBetweenAdds=300; MinimumAddSpacingPoints=999999.0;
      RequireNewestTradeWinning=true; AddRiskFraction=0.50;
      return;
   }
   if(ScaleInControl==SCALE_IN_BALANCED)
   {
      MaximumOpenTrades=4; MaximumAddsPerCampaign=3;
      MinimumSecondsBetweenAdds=45; MinimumAddSpacingPoints=120.0;
      RequireNewestTradeWinning=true; AddRiskFraction=0.50;
      return;
   }
   if(ScaleInControl==SCALE_IN_ACTIVE)
   {
      MaximumOpenTrades=6; MaximumAddsPerCampaign=5;
      MinimumSecondsBetweenAdds=20; MinimumAddSpacingPoints=60.0;
      RequireNewestTradeWinning=false; AddRiskFraction=0.50;
      return;
   }
   MaximumOpenTrades=2; MaximumAddsPerCampaign=1;
   MinimumSecondsBetweenAdds=60; MinimumAddSpacingPoints=150.0;
   RequireNewestTradeWinning=true; AddRiskFraction=0.50;
}

void ApplyExitControl()
{
   if(ExitControl==EXIT_QUICK)
   {
      TargetMode=HT_QUICK_CAPTURE;
      UseTriangleMovementTakeProfit=true;
      MovementTPArmPercent=0.25; MovementTPMinimumMoney=0.50;
      MovementTPMinimumFavorableWeight=0.10; MovementTPAngleReversalDegrees=3.0;
      MovementTPWeightGiveback=0.08; MovementTPAngleGivebackDegrees=5.0;
      MovementTPConfirmTicks=2;
      ExitOnProfitableDrawdownMode=true; ExitOnMidpointLossAfterProfit=true; ExitOnExtremeExtensionStall=true;
      ExtensionStallVelocity=0.50;
      UseCampaignProfitRail=true; RailArmPercent=0.40;
      RailGivebackPercentQuick=15.0; RailGivebackPercentBalanced=22.0; RailGivebackPercentMaximum=30.0;
      RailConfirmTicks=2;
      BasketTargetPercent=1.0; MinimumBasketTargetMoney=1.0;
      UsePeakGiveback=true; PeakArmPercent=0.60; PeakGivebackPercent=20.0; MinimumPeakGivebackMoney=0.75;
      CloseOnInvalidGeometry=false; CloseOnOppositeFVG=true; OppositeFVGRecentBars=3;
      CloseOnStructureBreak=true; StructureBreakBufferPoints=20.0;
      return;
   }
   if(ExitControl==EXIT_MAXIMUM_TREND)
   {
      TargetMode=HT_MAXIMUM_TREND;
      UseTriangleMovementTakeProfit=true;
      MovementTPArmPercent=0.75; MovementTPMinimumMoney=1.50;
