{
   WisdoWrite("WISDO_EA_ONLINE",1.0);
   WisdoWrite("WISDO_EA_HEARTBEAT",(double)TimeCurrent());
   WisdoWrite("WISDO_EA_ACCOUNT",(double)AccountNumber());
   WisdoWrite("WISDO_EA_MAGIC",(double)MagicNumber);
   WisdoWrite("WISDO_EA_TRADES",(double)TradeCount());
