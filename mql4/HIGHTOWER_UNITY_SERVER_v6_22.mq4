//===============================================================================
// COMMANDER MEMBRANE -- THE ONLY CODE ALLOWED TO MUTATE BROKER ORDERS
// Every organ may request; only this membrane touches MT4 trade functions.
//===============================================================================
int gHT5CommanderSendCount=0,gHT5CommanderCloseCount=0,gHT5CommanderModifyCount=0,gHT5CommanderDeleteCount=0;
int gHT5CommanderLastError=0;
string gHT5CommanderLastMutation="NONE";
datetime gHT5CommanderLastMutationTime=0;

bool HT6EinsteinCommanderSendAllows(int dir,string &reason)
{
   reason="OK";
   if(!HT6EinsteinEnabled()) return true;
   if(h620Phase==2 || (h620Phase==3 && !h620FlipContext)) {reason="H620 TRANSFER LOCK";return false;}
   if(dir==DIR_FLAT){ reason="EINSTEIN: FLAT ORDER"; return false; }
   if(dir!=gHT6Flow.primaryDirection){ reason="EINSTEIN: WRONG SIDE VS PRIMARY STRUCTURE"; return false; }

   if(gHT6StructureHoldOrderContext)
   {
      if(!gHT6Flow.structureEntryPending || gHT6Flow.pendingStructureDirection!=dir)
      { reason="EINSTEIN CORE: NO FRESH STRUCTURE CLOSE"; return false; }
      if(gHT6Flow.lastBreakDirection!=dir || gHT6Flow.lastBreakBar<=0)
      { reason="EINSTEIN CORE: STRUCTURE EVENT NOT CONFIRMED"; return false; }
      return true;
   }

   if(gHT6ContinuationAddOrderContext)
   {
      HT6EinsteinRefreshFlowMemories();
      if(gHT6SonicFlowOrderContext)
      {
         if(gHT6Flow.leg<1 || gHT6Flow.leg>5)
         { reason="EINSTEIN SONIC: NEED ACTIVE CORE LEG"; return false; }
         if(gHT6DoubleWaitFreshPrimary)
         { reason="EINSTEIN SONIC: WAIT FRESH PRIMARY"; return false; }
         if(HT6CampaignIntentScore(dir)<MathMax(0.0,DirectMinimumIntentToAdd))
         { reason="EINSTEIN SONIC: INTENT TOO WEAK"; return false; }
         if(gHT6Flow.continuationDefense || gHT6Flow.oppositionCharge>gHT6SonicMaximumOppositionCharge)
         { reason="EINSTEIN SONIC: OPPOSITION / DEFEND"; return false; }
         if(HT6EinsteinFlowVelocity(dir)<gHT6SonicMinimumVelocity)
         { reason="EINSTEIN SONIC: FLOW VELOCITY LOW"; return false; }
         return true;
      }

      if(gHT6Flow.leg<1 || gHT6Flow.leg>5)
      { reason="EINSTEIN ADD: NEED ACTIVE LEG"; return false; }
      gHT6Flow.energy=HT6EinsteinEnergy(dir);
      double req=HT6EinsteinRequiredPoints(gHT6Flow.leg);
      if(HT6CampaignIntentScore(dir)<MathMax(0.0,DirectMinimumIntentToAdd))
      { reason="EINSTEIN ADD: INTENT TOO WEAK"; return false; }
      if(gHT6Flow.continuationDefense || gHT6Flow.pressureBias<gHT6EinsteinMinimumPressureBias)
      { reason="EINSTEIN ADD: OPPOSITION PRESSURE / DEFEND"; return false; }
      if(gHT6Flow.pointBank+0.0001<req)
      { reason="EINSTEIN ADD: POINT CHARGE LOW"; return false; }
      if(gHT6Flow.energy<gHT6EinsteinEnergyThreshold)
      { reason="EINSTEIN ADD: ENERGY LOW"; return false; }
      return true;
   }

   reason="EINSTEIN: LEGACY ORDER SOURCE DISABLED";
   return false;
}

int HT5CommanderOrderSend(string symbol,int cmd,double volume,double price,int slippage,double stoploss,double takeprofit,string comment,int magic,datetime expiration,color arrowColor)
{
   if(!WBAllows(cmd)){gEntryStatus="WISDO SERVER ENTRY BLOCK";return -1;}
   gHT5CommanderSendCount++;
   gHT5CommanderLastMutationTime=TimeCurrent();
   gHT5CommanderLastMutation="SEND "+IntegerToString(cmd)+" "+DoubleToString(volume,2)+" @ "+DoubleToString(price,Digits);

   int dir=DIR_FLAT;
   if(cmd==OP_BUY || cmd==OP_BUYLIMIT || cmd==OP_BUYSTOP) dir=DIR_BUY;
   if(cmd==OP_SELL || cmd==OP_SELLLIMIT || cmd==OP_SELLSTOP) dir=DIR_SELL;
   bool einsteinOrder=(HT6EinsteinEnabled() && (gHT6StructureHoldOrderContext || gHT6ContinuationAddOrderContext));
   if(HT6EinsteinEnabled() && dir!=DIR_FLAT)
   {
      string einReason="";
      if(!HT6EinsteinCommanderSendAllows(dir,einReason))
      {
         gHT5CommanderLastError=0;
         gHT6LastBlockReason=einReason;
         gHT5CommanderLastMutation+=" BLOCKED • "+einReason;
         gEntryStatus=einReason;
         HT5HospitalObserveBlock(einReason);
         HT5SetOrgan(ORGAN_COMMANDER,0.82,gHT5CommanderLastMutation);
         return -1;
      }
   }
   else if(gHT6DoctrineOwnsEntry && dir!=DIR_FLAT && !einsteinOrder)
   {
      string doctrineReason="";
      if(!HT6DoctrineCommanderSendAllows(cmd,dir,doctrineReason))
      {
         gHT5CommanderLastError=0;
         gHT6LastBlockReason=doctrineReason;
         gHT5CommanderLastMutation+=" BLOCKED • "+doctrineReason;
         gEntryStatus=doctrineReason;
         HT5HospitalObserveBlock(doctrineReason);
         HT5SetOrgan(ORGAN_COMMANDER,0.82,gHT5CommanderLastMutation);
         return -1;
      }
   }

   if(stoploss>0.0 && dir!=DIR_FLAT)
   {
      RefreshRates();
      string sanity="";
      double live=(dir==DIR_BUY?Bid:Ask);
      if(!HT5StopSymbolSanityAllows(dir,price,live,(double)stoploss,(cmd==OP_BUYLIMIT || cmd==OP_BUYSTOP || cmd==OP_SELLLIMIT || cmd==OP_SELLSTOP),sanity))
      {
         gHT5CommanderLastError=130;
         gHT5CommanderLastMutation+=" BLOCKED • "+sanity;
         gEntryStatus="COMMANDER STOP SANITY: "+sanity;
         HT5HospitalObserveBlock(gEntryStatus);
         return -1;
      }
   }

   ResetLastError();
   // Native mutation lives here and nowhere else in the source.
   int ticket=OrderSend(symbol,cmd,volume,price,slippage,stoploss,takeprofit,comment,magic,expiration,arrowColor);
   gHT5CommanderLastError=(ticket<0?GetLastError():0);
   if(ticket<0)
   {
      gHT5CommanderLastMutation+=" FAILED "+IntegerToString(gHT5CommanderLastError);
      HT5HospitalObserveBlock("BROKER ORDER SEND "+IntegerToString(gHT5CommanderLastError));
   }
   else gHT5CommanderLastMutation+=" #"+IntegerToString(ticket);
   HT5SetOrgan(ORGAN_COMMANDER,(ticket>=0?1.0:0.45),gHT5CommanderLastMutation);
   return ticket;
}

bool HT5CommanderOrderClose(int ticket,double lots,double price,int slippage,color arrowColor)
{
   // v6.05 CORE-HOLD COVENANT: a primary structure position may not be
   // liquidated by arrows, stations, Q*, WILL, SURF, signal modules, or ordinary
   // profit logic. Only HT6EinsteinCloseDirection() (opposite completed structure
   // close) or the explicit emergency/full-close path grants this authority.
   if(HT6EinsteinEnabled() && OrderSelect(ticket,SELECT_BY_TICKET,MODE_TRADES))
   {
      string ht6c=OrderComment();
      if(StringFind(ht6c,"HT6_CORE_")==0 && !gHT6EinsteinCoreCloseAuthority)
      {
         gHT5CommanderLastError=0;
         gHT5CommanderLastMutation="CORE CLOSE BLOCKED #"+IntegerToString(ticket)+" • WAIT OPPOSITE STRUCTURE CLOSE";
         gEntryStatus=gHT5CommanderLastMutation;
         HT5SetOrgan(ORGAN_COMMANDER,0.92,gHT5CommanderLastMutation);
         return false;
      }
      if(StringFind(ht6c,"HT6_ADD_")==0 && !gHT6EinsteinAddonCloseAuthority && !gHT6EinsteinCoreCloseAuthority)
      {
         gHT5CommanderLastError=0;
         gHT5CommanderLastMutation="ADD CLOSE BLOCKED #"+IntegerToString(ticket)+" • WAIT COMPOUND OR STRUCTURE FLIP";
         gEntryStatus=gHT5CommanderLastMutation;
         HT5SetOrgan(ORGAN_COMMANDER,0.92,gHT5CommanderLastMutation);
         return false;
      }
   }
   gHT5CommanderCloseCount++;
   gHT5CommanderLastMutationTime=TimeCurrent();
   gHT5CommanderLastMutation="CLOSE #"+IntegerToString(ticket)+" "+DoubleToString(lots,2);
   ResetLastError();
   bool ok=OrderClose(ticket,lots,price,slippage,arrowColor);
   gHT5CommanderLastError=(ok?0:GetLastError());
   if(!ok)
   {
      gHT5CommanderLastMutation+=" FAILED "+IntegerToString(gHT5CommanderLastError);
      HT5HospitalObserveBlock("BROKER ORDER CLOSE "+IntegerToString(gHT5CommanderLastError));
   }
   HT5SetOrgan(ORGAN_COMMANDER,(ok?1.0:0.55),gHT5CommanderLastMutation);
   return ok;
}

bool HT5CommanderOrderModify(int ticket,double price,double stoploss,double takeprofit,datetime expiration,color arrowColor)
{
   if(H620Enabled() && OrderSelect(ticket,SELECT_BY_TICKET) && H620OwnedSelected() && !h620Mutation) return false;
   // Einstein orders keep the doctrine stop frozen at the structure box.
   // Old trailing/station/protection modules may observe them but cannot rewrite
   // the protective thesis after entry.
   if(HT6EinsteinEnabled() && OrderSelect(ticket,SELECT_BY_TICKET,MODE_TRADES))
   {
      string ht6m=OrderComment();
      if((StringFind(ht6m,"HT6_CORE_")==0 || StringFind(ht6m,"HT6_ADD_")==0) &&
          !gHT6EinsteinStopRatchetAuthority && !gHT6DirectProtectionModifyAuthority && !h620Mutation)
      {
         gHT5CommanderLastError=0;
         gHT5CommanderLastMutation="EINSTEIN STOP FROZEN #"+IntegerToString(ticket)+" • WAIT NEXT CORE RATCHET";
         HT5SetOrgan(ORGAN_COMMANDER,0.95,gHT5CommanderLastMutation);
         return false;
      }
   }
   gHT5CommanderModifyCount++;
   gHT5CommanderLastMutationTime=TimeCurrent();
   gHT5CommanderLastMutation="MODIFY #"+IntegerToString(ticket)+" SL "+DoubleToString(stoploss,Digits)+" TP "+DoubleToString(takeprofit,Digits);

   if(stoploss>0.0 && OrderSelect(ticket,SELECT_BY_TICKET))
   {
      int ot=OrderType();
      int dir=((ot==OP_BUY || ot==OP_BUYLIMIT || ot==OP_BUYSTOP)?DIR_BUY:
              ((ot==OP_SELL || ot==OP_SELLLIMIT || ot==OP_SELLSTOP)?DIR_SELL:DIR_FLAT));
      if(dir!=DIR_FLAT)
      {
         RefreshRates();
         string sanity="";
         double live=(dir==DIR_BUY?Bid:Ask);
         double ref=(price>0.0?price:OrderOpenPrice());
         if(!HT5StopSymbolSanityAllows(dir,ref,live,stoploss,(ot==OP_BUYLIMIT || ot==OP_BUYSTOP || ot==OP_SELLLIMIT || ot==OP_SELLSTOP),sanity))
         {
            gHT5CommanderLastError=130;
            gHT5CommanderLastMutation+=" BLOCKED • "+sanity;
            gEntryStatus="COMMANDER MODIFY STOP SANITY: "+sanity;
            HT5HospitalObserveBlock(gEntryStatus);
            return false;
         }
      }
   }

   ResetLastError();
   bool ok=OrderModify(ticket,price,stoploss,takeprofit,expiration,arrowColor);
   gHT5CommanderLastError=(ok?0:GetLastError());
   if(!ok && gHT5CommanderLastError!=1)
   {
      gHT5CommanderLastMutation+=" FAILED "+IntegerToString(gHT5CommanderLastError);
      HT5HospitalObserveBlock("BROKER ORDER MODIFY "+IntegerToString(gHT5CommanderLastError));
   }
   HT5SetOrgan(ORGAN_COMMANDER,(ok||gHT5CommanderLastError==1?1.0:0.65),gHT5CommanderLastMutation);
   return ok;
}

bool HT5CommanderOrderDelete(int ticket,color arrowColor)
{
   gHT5CommanderDeleteCount++;
   gHT5CommanderLastMutationTime=TimeCurrent();
   gHT5CommanderLastMutation="DELETE PENDING #"+IntegerToString(ticket);
   ResetLastError();
   bool ok=OrderDelete(ticket,arrowColor);
   gHT5CommanderLastError=(ok?0:GetLastError());
   if(!ok)
   {
      gHT5CommanderLastMutation+=" FAILED "+IntegerToString(gHT5CommanderLastError);
      HT5HospitalObserveBlock("BROKER ORDER DELETE "+IntegerToString(gHT5CommanderLastError));
   }
   HT5SetOrgan(ORGAN_COMMANDER,(ok?1.0:0.65),gHT5CommanderLastMutation);
   return ok;
}



//===============================================================================
// 64-GENE DEEP GENOME -- bounded behavioral DNA, context expression, rollback
//===============================================================================
#define HT5_GENE_COUNT 64
string gHT5GeneName[HT5_GENE_COUNT];
double gHT5Gene[HT5_GENE_COUNT];
double gHT5GenePrev[HT5_GENE_COUNT];
double gHT5GeneMin[HT5_GENE_COUNT];
double gHT5GeneMax[HT5_GENE_COUNT];
double gHT5GeneExpression[HT5_GENE_COUNT];
double gHT5GeneOutcomeCorr[HT5_GENE_COUNT];
double gHT5GeneSamples[HT5_GENE_COUNT];
bool gHT5GeneSnapshotAvailable=false;
string gHT5GeneState="GENOME CELLS INITIALIZING";
double gHT5GeneErrorEvidence[5];

void HT5InitializeGenes()
{
   for(int i=0;i<HT5_GENE_COUNT;i++)
   {
      gHT5GeneName[i]="GENE_"+IntegerToString(i);
      gHT5Gene[i]=1.0; gHT5GenePrev[i]=1.0; gHT5GeneMin[i]=0.70; gHT5GeneMax[i]=1.30;
      gHT5GeneExpression[i]=1.0; gHT5GeneOutcomeCorr[i]=0.0; gHT5GeneSamples[i]=0.0;
   }
   gHT5GeneName[0]="STRUCTURE_AUTHORITY";
   gHT5GeneName[1]="BOS_AUTHORITY";
   gHT5GeneName[2]="CHANNEL_AUTHORITY";
   gHT5GeneName[3]="PRESSURE_AUTHORITY";
   gHT5GeneName[4]="RHYTHM_AUTHORITY";
   gHT5GeneName[5]="LOCATION_AUTHORITY";
   gHT5GeneName[6]="ORACLE_AUTHORITY";
   gHT5GeneName[7]="MEMORY_AUTHORITY";
   gHT5GeneName[8]="FVG_TOUCH_ENVELOPE";
   gHT5GeneName[9]="FVG_INVALIDATION_DEPTH";
   gHT5GeneName[10]="OB_CONFLUENCE";
   gHT5GeneName[11]="DAY_EXTREME_AUTHORITY";
   gHT5GeneName[12]="BLACK_RAIL_AUTHORITY";
   gHT5GeneName[13]="STATION_AUTHORITY";
   gHT5GeneName[14]="RECLAIM_AUTHORITY";
   gHT5GeneName[15]="LIQUIDITY_POOL_AUTHORITY";
   gHT5GeneName[16]="SONIC_FIRST_STAGE";
   gHT5GeneName[17]="SONIC_STAGE_CURVE";
   gHT5GeneName[18]="SONIC_RISK_REUSE";
   gHT5GeneName[19]="SONIC_RHYTHM_REQUIREMENT";
   gHT5GeneName[20]="PROTECTION_CURVE";
   gHT5GeneName[21]="PROTECTION_LOCK";
   gHT5GeneName[22]="PULSE_ATTRACTION";
   gHT5GeneName[23]="PULSE_CRASH_BRAKE";
   gHT5GeneName[24]="COMPOUND_DRIVE";
   gHT5GeneName[25]="RED_CONTINUATION";
   gHT5GeneName[26]="TARGET_EXTENSION";
   gHT5GeneName[27]="MARGIN_RESERVE";
   gHT5GeneName[28]="UNCERTAINTY_PENALTY";
   gHT5GeneName[29]="ADVERSE_PENALTY";
   gHT5GeneName[30]="EXECUTION_COST_PENALTY";
   gHT5GeneName[31]="SESSION_QUALITY";
   gHT5GeneName[32]="ACCUM_STRUCTURE";
   gHT5GeneName[33]="ACCUM_FLOW";
   gHT5GeneName[34]="ACCUM_LOCATION";
   gHT5GeneName[35]="ACCUM_GROWTH";
   gHT5GeneName[36]="EXPANSION_STRUCTURE";
   gHT5GeneName[37]="EXPANSION_FLOW";
   gHT5GeneName[38]="EXPANSION_LOCATION";
   gHT5GeneName[39]="EXPANSION_GROWTH";
   gHT5GeneName[40]="DISTRIBUTION_STRUCTURE";
   gHT5GeneName[41]="DISTRIBUTION_FLOW";
   gHT5GeneName[42]="DISTRIBUTION_LOCATION";
   gHT5GeneName[43]="DISTRIBUTION_GROWTH";
   gHT5GeneName[44]="EXHAUSTION_STRUCTURE";
   gHT5GeneName[45]="EXHAUSTION_FLOW";
   gHT5GeneName[46]="EXHAUSTION_LOCATION";
   gHT5GeneName[47]="EXHAUSTION_GROWTH";
   gHT5GeneName[48]="REVERSAL_STRUCTURE";
   gHT5GeneName[49]="REVERSAL_FLOW";
   gHT5GeneName[50]="REVERSAL_LOCATION";
   gHT5GeneName[51]="REVERSAL_TRANSFER";
   gHT5GeneName[52]="SMALL_ACCOUNT_RISK";
   gHT5GeneName[53]="SMALL_ACCOUNT_GROWTH";
   gHT5GeneName[54]="BROKER_COST";
   gHT5GeneName[55]="SPREAD_SENSITIVITY";
   gHT5GeneName[56]="HOUR_LEARNING";
   gHT5GeneName[57]="SESSION_LEARNING";
   gHT5GeneName[58]="SOURCE_RELIABILITY";
   gHT5GeneName[59]="PATTERN_RELIABILITY";
   gHT5GeneName[60]="ORGAN_RELIABILITY";
   gHT5GeneName[61]="SHADOW_INFLUENCE";
   gHT5GeneName[62]="ROLLBACK_SENSITIVITY";
   gHT5GeneName[63]="MUTATION_TEMPO";

   // Specialized bounds for genes that represent ratios rather than authorities.
   gHT5GeneMin[8]=0.60; gHT5GeneMax[8]=1.35;
   gHT5GeneMin[9]=0.70; gHT5GeneMax[9]=1.35;
   gHT5GeneMin[16]=0.70; gHT5GeneMax[16]=1.40;
   gHT5GeneMin[18]=0.55; gHT5GeneMax[18]=1.00;
   gHT5GeneMin[20]=0.70; gHT5GeneMax[20]=1.35;
   gHT5GeneMin[22]=0.60; gHT5GeneMax[22]=1.35;
   gHT5GeneMin[23]=0.70; gHT5GeneMax[23]=1.40;
   gHT5GeneMin[24]=0.70; gHT5GeneMax[24]=1.35;
   gHT5GeneMin[27]=0.75; gHT5GeneMax[27]=1.20;
   gHT5GeneMin[62]=0.70; gHT5GeneMax[62]=1.30;
   gHT5GeneMin[63]=0.70; gHT5GeneMax[63]=1.30;
}

double HT5GeneValue(int idx)
{
   if(idx<0 || idx>=HT5_GENE_COUNT) return 1.0;
   return HT5Clamp(gHT5Gene[idx]*gHT5GeneExpression[idx],gHT5GeneMin[idx],gHT5GeneMax[idx]);
}

void HT5SnapshotGenes()
{
   for(int i=0;i<HT5_GENE_COUNT;i++) gHT5GenePrev[i]=gHT5Gene[i];
   gHT5GeneSnapshotAvailable=true;
}

void HT5RollbackGenes()
{
   if(!gHT5GeneSnapshotAvailable) return;
   for(int i=0;i<HT5_GENE_COUNT;i++) gHT5Gene[i]=gHT5GenePrev[i];
   gHT5GeneSnapshotAvailable=false;
   gHT5GeneState="GENE ROLLBACK • PREVIOUS PHYSIOLOGY RESTORED";
}

void HT5ExpressGenesForContext()
{
   for(int i=0;i<HT5_GENE_COUNT;i++) gHT5GeneExpression[i]=1.0;
   // Phase-expression blocks: genes 32..51 encode the body's context-specific
   // preference. They modulate only bounded authorities, never hard risk limits.
   if(gHT5BodyPhase==BODY_ACCUMULATION)
   {
      gHT5GeneExpression[0]*=HT5GeneValue(32); // structure
      gHT5GeneExpression[4]*=HT5GeneValue(33); // flow
      gHT5GeneExpression[5]*=HT5GeneValue(34); // location
      gHT5GeneExpression[18]*=HT5GeneValue(35); // growth
   }
   else if(gHT5BodyPhase==BODY_EXPANSION)
   {
      gHT5GeneExpression[0]*=HT5GeneValue(36);
      gHT5GeneExpression[4]*=HT5GeneValue(37);
      gHT5GeneExpression[5]*=HT5GeneValue(38);
      gHT5GeneExpression[18]*=HT5GeneValue(39);
   }
   else if(gHT5BodyPhase==BODY_DISTRIBUTION)
   {
      gHT5GeneExpression[0]*=HT5GeneValue(40);
      gHT5GeneExpression[4]*=HT5GeneValue(41);
      gHT5GeneExpression[5]*=HT5GeneValue(42);
      gHT5GeneExpression[18]*=HT5GeneValue(43);
   }
   else if(gHT5BodyPhase==BODY_EXHAUSTION)
   {
      gHT5GeneExpression[0]*=HT5GeneValue(44);
      gHT5GeneExpression[4]*=HT5GeneValue(45);
      gHT5GeneExpression[5]*=HT5GeneValue(46);
      gHT5GeneExpression[18]*=HT5GeneValue(47);
   }
   else if(gHT5BodyPhase==BODY_REVERSAL)
   {
      gHT5GeneExpression[0]*=HT5GeneValue(48);
      gHT5GeneExpression[4]*=HT5GeneValue(49);
      gHT5GeneExpression[5]*=HT5GeneValue(50);
      gHT5GeneExpression[12]*=HT5GeneValue(51);
   }

   // Small account epigenetics: less simultaneous growth, same selected campaign cap.
   if(AccountBalance()<=MathMax(100.0,MicroAccountThreshold))
   {
      gHT5GeneExpression[18]*=HT5GeneValue(53);
      gHT5GeneExpression[27]*=HT5GeneValue(52);
   }

   // Execution-weather epigenetics.
   double weather=HT5Clamp(gHT5Broker.executionQuality,0.0,1.0);
   gHT5GeneExpression[30]*=(1.0+0.20*(1.0-weather)*HT5GeneValue(54));
   gHT5GeneExpression[31]*=HT5Clamp(0.80+0.30*gHT5SessionQuality*HT5GeneValue(57),0.65,1.30);
}

void HT5ApplyGeneExpressionToPhysiology()
{
   HT5ExpressGenesForContext();
   gHT5ChannelAuthorityScale=HT5Clamp(gHT5ChannelAuthorityScale*HT5GeneValue(2),0.65,1.40);
   gHT5RiskReuseScale=HT5Clamp(gHT5RiskReuseScale*HT5GeneValue(18),0.50,1.0);
   gHT5FVGPrecisionScale=HT5Clamp(gHT5FVGPrecisionScale*HT5GeneValue(8),0.60,1.40);
   gHT5ProtectionAggression=HT5Clamp(gHT5ProtectionAggression*HT5GeneValue(20),0.70,1.30);
   // Gene values are translated into runtime multipliers; raw user risk and
   // campaign-risk cap are deliberately excluded from mutation.
   gHT5SessionQuality=HT5Clamp(gHT5SessionQuality*HT5GeneValue(31),0.50,1.35);
}

void HT5UpdateGeneOutcomeCorrelation(double r)
{
   for(int i=0;i<HT5_GENE_COUNT;i++)
   {
      gHT5GeneSamples[i]+=1.0;
      double x=(HT5GeneValue(i)-1.0)/MathMax(0.05,gHT5GeneMax[i]-gHT5GeneMin[i]);
      gHT5GeneOutcomeCorr[i]=0.97*gHT5GeneOutcomeCorr[i]+0.03*HT5Clamp(x*r,-4.0,4.0);
   }
}

void HT5MutateGeneToward(int idx,double direction,double step)
{
   if(idx<0 || idx>=HT5_GENE_COUNT) return;
   gHT5Gene[idx]=HT5Clamp(gHT5Gene[idx]+direction*step,gHT5GeneMin[idx],gHT5GeneMax[idx]);
}

void HT5DeepGenomeMutate(int errorClass)
{
   if(HowShouldTheGenomeEvolve<EVOLUTION_DEEP_SELF_EVOLVING_CREATURE) return;
   double step=(HowFastMayTheGenomeChange==LEARNING_SLOW_STABLE?0.012:(HowFastMayTheGenomeChange==LEARNING_FAST_RESPONSIVE?0.035:0.020));
   HT5SnapshotGenes();
   if(errorClass==EVO_ERROR_DIRECTION)
   {
      HT5MutateGeneToward(0,+1,step); // structure authority
      HT5MutateGeneToward(1,+1,step); // BOS
      HT5MutateGeneToward(2,+1,step); // channel
      HT5MutateGeneToward(3,-1,step*0.7); // short pressure less authority
      HT5MutateGeneToward(58,+1,step*0.5); // source reliability
   }
   else if(errorClass==EVO_ERROR_LOCATION)
   {
      HT5MutateGeneToward(5,+1,step);
      HT5MutateGeneToward(8,-1,step); // tighter FVG envelope
      HT5MutateGeneToward(10,+1,step); // OB confluence
      HT5MutateGeneToward(13,+1,step*0.6); // station
      HT5MutateGeneToward(14,+1,step*0.6); // reclaim
   }
   else if(errorClass==EVO_ERROR_TIMING)
   {
      HT5MutateGeneToward(4,+1,step); // RHYTHM authority
      HT5MutateGeneToward(19,+1,step*0.8); // sonic timing requirement
      HT5MutateGeneToward(31,+1,step*0.4); // session quality
      HT5MutateGeneToward(56,+1,step*0.4); // hour learning
   }
   else if(errorClass==EVO_ERROR_EXPOSURE)
   {
      HT5MutateGeneToward(16,+1,step); // later first stage
      HT5MutateGeneToward(18,-1,step); // recycle less released risk
      HT5MutateGeneToward(20,+1,step*0.8); // stronger protection
      HT5MutateGeneToward(22,-1,step*0.5); // less magnetic attraction
      HT5MutateGeneToward(27,+1,step*0.5); // more reserve
   }
   gHT5GeneState="DEEP GENOME MUTATED • "+EvolutionErrorName(errorClass);
}

void HT5DeepGenomeResolve(double r,int errorClass)
{
   HT5UpdateGeneOutcomeCorrelation(r);
   // Deep-gene evidence is intentionally independent of the legacy mutation
   // counters because the legacy genome may reset its category counter after a
   // promotion earlier in the same campaign-resolution pass.  This cell keeps
   // the living genome from silently losing the evidence that caused the loss.
   if(r<0.0 && errorClass!=EVO_ERROR_NONE)
   {
      if(errorClass>=0 && errorClass<5) gHT5GeneErrorEvidence[errorClass]+=1.0;
      int need=MathMax(2,EvolutionSimilarLossesForMutation);
      if(errorClass>=0 && errorClass<5 &&
         gHT5GeneErrorEvidence[errorClass]>=need &&
         gEvoCampaigns>=MathMax(need,EvolutionMinimumCampaignsBeforeMutation))
      {
         HT5DeepGenomeMutate(errorClass);
         gHT5GeneErrorEvidence[errorClass]=0.0;
      }
   }
   else if(r>0.0)
   {
      // Wins decay mutation pressure slowly instead of erasing memory.
      for(int e=1;e<5;e++) gHT5GeneErrorEvidence[e]*=0.92;
   }
   int best=HT5BestShadow();
   if(gHT5GeneSnapshotAvailable && gHT5Shadow[best].samples>=3 && gHT5Shadow[best].fitnessR<gEvoPromotionFitnessR-EvolutionRollbackFitnessDropR)
      HT5RollbackGenes();
}

void HT5SaveGenes()
{
   for(int i=0;i<HT5_GENE_COUNT;i++)
   {
      GlobalVariableSet(HT5Key("G"+IntegerToString(i)),gHT5Gene[i]);
      GlobalVariableSet(HT5Key("GC"+IntegerToString(i)),gHT5GeneOutcomeCorr[i]);
   }
}

void HT5LoadGenes()
{
   for(int i=0;i<HT5_GENE_COUNT;i++)
   {
      string k=HT5Key("G"+IntegerToString(i)),c=HT5Key("GC"+IntegerToString(i));
      if(GlobalVariableCheck(k)) gHT5Gene[i]=HT5Clamp(GlobalVariableGet(k),gHT5GeneMin[i],gHT5GeneMax[i]);
      if(GlobalVariableCheck(c)) gHT5GeneOutcomeCorr[i]=GlobalVariableGet(c);
   }
}

