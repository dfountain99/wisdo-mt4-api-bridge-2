   WisdoWrite("WISDO_EA_EQUITY",AccountEquity());
   WisdoWrite("WISDO_EA_BASKET_PROFIT",BasketProfit());
   if(EnableMarketDNA)
   {
      WisdoWrite("WISDO_MD_EXPECTED_ATR",gMDExpectedATR);
      WisdoWrite("WISDO_LIVE_ATR_PRICE",gATRLive14);
      WisdoWrite("WISDO_LIVE_ATR_POINTS",gATRLive14/Point);
      WisdoWrite("WISDO_STABLE_ATR_POINTS",gATRStable14/Point);
      WisdoWrite("WISDO_CURRENT_TRUE_RANGE_POINTS",gATRCurrentTR14/Point);
      WisdoWrite("WISDO_TICK_PULSE_POINTS",gATRTickPulseEWMA/Point);
      WisdoWrite("WISDO_MD_ADVERSE_ATR",gMDExpectedAdverseATR);
