      case 54: return "BROKER COST • bounded inherited behavior multiplier; mutation requires repeated campaign evidence and supports rollback.";
      case 55: return "SPREAD SENSITIVITY • bounded inherited behavior multiplier; mutation requires repeated campaign evidence and supports rollback.";
      case 56: return "HOUR LEARNING • bounded inherited behavior multiplier; mutation requires repeated campaign evidence and supports rollback.";
      case 57: return "SESSION LEARNING • bounded inherited behavior multiplier; mutation requires repeated campaign evidence and supports rollback.";
      case 58: return "SOURCE RELIABILITY • bounded inherited behavior multiplier; mutation requires repeated campaign evidence and supports rollback.";
      case 59: return "PATTERN RELIABILITY • bounded inherited behavior multiplier; mutation requires repeated campaign evidence and supports rollback.";
      case 60: return "ORGAN RELIABILITY • bounded inherited behavior multiplier; mutation requires repeated campaign evidence and supports rollback.";
      case 61: return "SHADOW INFLUENCE • bounded inherited behavior multiplier; mutation requires repeated campaign evidence and supports rollback.";
      case 62: return "ROLLBACK SENSITIVITY • bounded inherited behavior multiplier; mutation requires repeated campaign evidence and supports rollback.";
      case 63: return "MUTATION TEMPO • bounded inherited behavior multiplier; mutation requires repeated campaign evidence and supports rollback.";
   }
   return "Unknown genome cell";
}

void HT5LivingFormulaRegistryPulse()
{
   int idx=gHT5FormulaRegistryCursor%HT5_DEEP_FEATURE_COUNT;
   gHT5FormulaRegistryZ=HT5FeatureStandardizedValue(idx);
   gHT5FormulaRegistryReliability=HT5FeatureEvidenceReliability(idx);
   gHT5FormulaRegistryContribution=HT5FeatureOutcomeContribution(idx);
   gHT5FormulaRegistryState=gHT5DeepFeatureName[idx]+" • "+HT5DeepFeatureUnit(idx)+" • Z "+DoubleToString(gHT5FormulaRegistryZ,2)+" • REL "+DoubleToString(gHT5FormulaRegistryReliability,2)+" • OUT "+DoubleToString(gHT5FormulaRegistryContribution,2);
   gHT5FormulaRegistryCursor=(gHT5FormulaRegistryCursor+1)%HT5_DEEP_FEATURE_COUNT;
}

void HT5DrawAdvancedLifeDiagnostics()
{
   if(HowMuchOfTheLivingDashboardShouldShow!=VISUAL_FULL_DIAGNOSTIC_ORGANS) return;
   int x=390,y=520;
   HT5Label("ADV_LIFE","ENDOCRINE / BALANCE / ATP / MEMORY",x,y,8,C'120,210,255');
   HT5Label("ADV_ENDO",gHT5Endocrine.state,x,y+17,7,C'230,190,90');
   HT5Label("ADV_BAL",gHT5Vestibular.state,x,y+32,7,C'170,210,255');
   HT5Label("ADV_ATP",gHT5Mito.state,x,y+47,7,C'80,230,160');
   HT5Label("ADV_TIME",gHT5Cerebellum.state,x,y+62,7,C'180,160,255');
   HT5Label("ADV_SKIN",gHT5Skin.state,x,y+77,7,HT5HealthColor(gHT5Skin.surfaceQuality));
   HT5Label("ADV_LYMPH",gHT5Lymph.state,x,y+92,7,HT5HealthColor(gHT5Lymph.riskPurity));
   HT5Label("ADV_HIP",gHT5Hippocampus.state,x,y+107,7,C'180,160,255');
   HT5Label("ADV_REG",gHT5FormulaRegistryState,x,y+122,7,C'205,205,205');
}

