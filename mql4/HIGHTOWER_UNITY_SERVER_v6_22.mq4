//+------------------------------------------------------------------+
//| HIGHTOWER UNITY CAMPAIGN TASK ENGINE v6.20                      |
//| STRUCTURE FLOW • CONTINUATION POINTS • PRIMARY HOLD • ONE COMMANDER |
//+------------------------------------------------------------------+
#property strict
#property version "6.22"
#property description "v6.20: rail-held campaigns, section collectors, evidence-extended runners, realized milestones, bounded risk. Source release: requires MetaEditor compilation and demo validation."

// WISDO native server bridge. Use the SAME pairing code as the copier.
input bool WisdoServerControl=true;
input string WisdoPairingCode="";
input string WisdoServerBaseUrl=""; // HTTPS origin only, no /mt4-sync suffix.
input string WisdoServerApiKey="";  // Optional unless your server requires it.
input int WisdoServerPollSeconds=3;
input int WisdoServerTimeoutMs=1200;
input int WisdoServerStaleSeconds=15;
bool wbPaused=true,wbEmergency=false,wbLinked=false,wbFault=false;
int wbDirection=0,wbLock=INVALID_HANDLE,wbChanged=0,wbRequested=0;
uint wbLastSuccess=0,wbLastAttempt=0;
string wbIdentity="",wbReceiver="",wbAckId="",wbAckMessage="",wbStatus="NOT PAIRED";
bool wbAckSuccess=false;
string wbKeys[24],wbValues[24];int wbFields=0;

bool wbSetupOnly=false;
string wbSetupMessage="";

enum Direction { DIR_SELL=-1, DIR_FLAT=0, DIR_BUY=1 };
enum HT_OraclePhase { ORACLE_ACCUMULATION=0, ORACLE_EXPANSION=1, ORACLE_DISTRIBUTION=2 };
