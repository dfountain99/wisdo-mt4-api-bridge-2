   ARROW_REVERSAL_EXIT_5_TICKS=5,
   ARROW_REVERSAL_EXIT_8_TICKS=8,
   ARROW_REVERSAL_EXIT_10_TICKS=10
};

// Arithmetic progression controls the spacing of entries along the route to TP.
