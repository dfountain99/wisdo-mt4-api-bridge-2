      WisdoWrite("WISDO_MD_EGO",gMDEGO);
      WisdoWrite("WISDO_MD_DESIRED_LOTS",gMDDesiredLots);
      WisdoWrite("WISDO_MD_DESIRED_CARS",(double)gMDDesiredCars);
      WisdoWrite("WISDO_MD_RECOVERY_FEAS",gMDRecoveryFeasibility);
      WisdoWrite("WISDO_MD_INFLECTION_ATR",gMDInflectionATR);
      WisdoWrite("WISDO_MD_ACCEPTANCE_ATR",gMDAcceptanceATR);
      WisdoWrite("WISDO_MD_INFLECTION_BRAKE",1.0); // compatibility: reversal DNA never brakes Q* in v3.07
      WisdoWrite("WISDO_MD_REVERSAL_EDGE_ATR",gMDReversalTransferEdgeATR);
      WisdoWrite("WISDO_MD_INFLECTION_TRANSFER",gMDInflectionTransferReady?1.0:0.0);
      WisdoWrite("WISDO_MD_ORACLE_PHASE",(double)gMDOraclePhase);
      WisdoWrite("WISDO_MD_ORACLE_MICRO_ATR",gMDOracleMicroTrendATR);
      WisdoWrite("WISDO_MD_ORACLE_OBFVG_ATR",gMDOracleOBFVGATR);
      WisdoWrite("WISDO_MD_ORACLE_ORIGIN",gMDOracleOriginConfluence);
      WisdoWrite("WISDO_MD_ORACLE_LOCK_MONEY",gMDOracleLockedMoney);
      WisdoWrite("WISDO_MD_RHYTHM_SCORE",gMDRhythmScore);
      WisdoWrite("WISDO_MD_RHYTHM_FORCE",gMDRhythmForce);
      WisdoWrite("WISDO_MD_RHYTHM_ACCEL",gMDRhythmAcceleration);
      WisdoWrite("WISDO_MD_RHYTHM_PULLBACK",gMDRhythmPullback);
      WisdoWrite("WISDO_MD_RHYTHM_PACE",gMDRhythmPace);
      WisdoWrite("WISDO_MD_RHYTHM_CADENCE",gMDRhythmCadence);
      WisdoWrite("WISDO_MD_RHYTHM_MATURITY",gMDRhythmMaturity);
      WisdoWrite("WISDO_MD_RHYTHM_HISTORY_ATR",gMDRhythmHistoricalATR);
   }
   WisdoWrite("WISDO_EA_COMPOUND_ANCHOR",gCompoundAnchor);
   WisdoWrite("WISDO_EA_COMPOUND_TARGET",gCompoundTarget);
   WisdoWrite("WISDO_EA_COMPOUND_PROGRESS",gCompoundProgress);
   WisdoWrite("WISDO_EA_COMPOUND_BASE_GOAL",gCompoundBaseGoalMoney);
   WisdoWrite("WISDO_EA_COMPOUND_RECOVERY_DEBT",0.0);
   WisdoWrite("WISDO_EA_COMPOUND_REQUIRED_MONEY",gCompoundRequiredMoney);
   WisdoWrite("WISDO_EA_COMPOUND_REQUIRED_PERCENT",gCompoundRequiredPercent);
   WisdoWrite("WISDO_EA_COMPOUND_LIVE_REMAINING",gCompoundLiveRemaining);
   WisdoWrite("WISDO_EA_COMPOUND_CYCLE",(double)gCompoundCycle);
   WisdoWrite("WISDO_EA_COMPOUND_FROZEN",gCompoundEntryFreeze?1.0:0.0);
   WisdoWrite("WISDO_EA_TREND",(double)gPyrTrendDirection);
   WisdoWrite("WISDO_EA_ROUTE_DIRECTION",(double)gPyrRouteDirection);
   WisdoWrite("WISDO_EA_ROUTE_ACTIVE",gPyrRouteActive?1.0:0.0);
   WisdoWrite("WISDO_EA_ROUTE_STATION",(double)gPyrRouteStationIndex);
   WisdoWrite("WISDO_EA_ROUTE_STATION_PRICE",gPyrRouteLastStation);
