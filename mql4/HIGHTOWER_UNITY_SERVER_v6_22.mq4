enum HT_MarginSafetyControl
{
   MARGIN_SAFETY_CONSERVATIVE=0,
   MARGIN_SAFETY_BALANCED=1,
   MARGIN_SAFETY_ACTIVE=2,
   MARGIN_SAFETY_OFF_LEGACY=3
