   WisdoWrite("WISDO_EA_ARROW",(double)gConfirmedArrowDirection);
   WisdoWrite("WISDO_EA_PAUSED",gWisdoPaused?1.0:0.0);
   WisdoWrite("WISDO_EA_EMERGENCY",gWisdoEmergencyLatched?1.0:0.0);
   double progress=0.0;
   if(TradeCount()>0 && gPyrCampaignDirection!=DIR_FLAT)
   { RefreshRates(); progress=PyrDirectionalProgress(gPyrCampaignDirection,(gPyrCampaignDirection==DIR_BUY?Bid:Ask))*100.0; }
   WisdoWrite("WISDO_EA_ROUTE_PROGRESS",progress);
   WisdoWrite("WISDO_EA_HOT_WHEELS_ACTIVE",
              (gPyrBurstDirection!=DIR_FLAT && TimeCurrent()<=gPyrBurstExpires)?1.0:0.0);
}

void WisdoPollAndApply()
{
   if(WisdoServerControl || !EnableWisdoVoiceControl) return;
   // Runtime values are safe to refresh each tick; commands are idempotent/pulsed.
   WisdoApplyRuntimeValueControls();
   WisdoProcessPulseCommands();
   WisdoProcessCommandId();
   if(TimeCurrent()!=gWisdoLastPoll)
   { gWisdoLastPoll=TimeCurrent(); WisdoPublishState(); }
}

bool WillManageEnergyDrain()
{
   if(HT6EinsteinEnabled()) return false;
   // Market DNA owns campaign recovery/harvest authority in v3.03.
   if(EnableMarketDNA) return false;
   if(!EnableWillDNA || !EnableWillEnergyDrain || TradeCount()<2) return false;
   if(TimeCurrent()==gWillLastDrainTime || gCompoundEntryFreeze) return false;
   double minLot=MarketInfo(Symbol(),MODE_MINLOT),step=MarketInfo(Symbol(),MODE_LOTSTEP);
   if(minLot<=0.0 || step<=0.0) return false;

   int loserTicket=-1,winnerTicket=-1;
   datetime oldest=TimeCurrent()+86400,newest=0;
   double loserNet=0.0,loserLots=0.0,winnerNet=0.0,winnerLots=0.0;
   double losingUnits=0.0;
   for(int i=OrdersTotal()-1;i>=0;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;
      double net=OrderProfit()+OrderSwap()+OrderCommission();
      if(net<0.0)
      {
         losingUnits+=OrderLots()/minLot;
         if(OrderOpenTime()<oldest && TimeCurrent()-OrderOpenTime()>=MathMax(0,WillDrainMinimumAgeSeconds))
         { oldest=OrderOpenTime(); loserTicket=OrderTicket(); loserNet=net; loserLots=OrderLots(); }
      }
      else if(net>0.0 && OrderOpenTime()>newest)
      { newest=OrderOpenTime(); winnerTicket=OrderTicket(); winnerNet=net; winnerLots=OrderLots(); }
   }
   if(loserTicket<0 || winnerTicket<0 || losingUnits<=0.0) return false;

   double loserChunk=MathMin(minLot,loserLots);
   double lossChunk=MathAbs(loserNet)*(loserChunk/MathMax(minLot,loserLots));
   double targetShare=MathMax(0.0,gCompoundLiveRemaining)/losingUnits;
   double required=lossChunk+targetShare+MathMax(0.0,WillDrainCostBufferMoney);
   if(winnerNet+0.0001<required) return false;

   double profitPerLot=winnerNet/MathMax(minLot,winnerLots);
   double winnerCloseLots=MathCeil((required/profitPerLot)/step-0.0000001)*step;
   winnerCloseLots=NormalizeDouble(MathMin(winnerLots,winnerCloseLots),LotDigitsFromStep(step));
   double winnerLeft=winnerLots-winnerCloseLots;
   if(winnerLeft>0.0000001 && winnerLeft<minLot) winnerCloseLots=winnerLots;

   if(!OrderSelect(winnerTicket,SELECT_BY_TICKET)) return false;
   RefreshRates(); double winPrice=(OrderType()==OP_BUY?Bid:Ask);
   if(!HT5CommanderOrderClose(winnerTicket,winnerCloseLots,winPrice,SlippagePoints,clrNONE))
   { gWillLastLesson="DRAIN WINNER CLOSE RETRY"; return false; }

   if(!OrderSelect(loserTicket,SELECT_BY_TICKET)) return false;
   RefreshRates(); double losePrice=(OrderType()==OP_BUY?Bid:Ask);
   if(!HT5CommanderOrderClose(loserTicket,loserChunk,losePrice,SlippagePoints,clrNONE))
   { gWillLastLesson="ENERGY BANKED; OLD 0.01 RETRY"; return false; }

   gWillLastDrainTime=TimeCurrent();
   gWillLastLesson="DRAINED 0.01 | NET TARGET ENERGY";
   Print("HT WILL DNA DRAIN | oldTicket=",loserTicket," lossChunk=$",DoubleToString(lossChunk,2),
         " winnerTicket=",winnerTicket," energyRequired=$",DoubleToString(required,2),
         " targetShare=$",DoubleToString(targetShare,2));
   return true;
}


//====================================================================
// HIGHTOWER UNITY MARKET DNA v3.17
// One market equation -> one desired exposure. All feature formulas describe
// the market; only the master exposure layer is permitted to demand capital.
//====================================================================
double MDClamp(double v,double lo,double hi){ return MathMax(lo,MathMin(hi,v)); }
int MDSign(double v){ if(v>0.0000001) return DIR_BUY; if(v<-0.0000001) return DIR_SELL; return DIR_FLAT; }
double MDAbsMax(double a,double floorV){ return MathMax(floorV,MathAbs(a)); }


//====================================================================
// HISTORICAL CHANNEL DNA v3.10
// The scanner compresses up to 20,000 completed bars into major low/high
// level buckets, then chooses the support/resistance rails that maximize
// repeated touches while minimizing historical violations. Local LL/HH
// structure is interpreted INSIDE these rails; it cannot overrule them.
//====================================================================
double MarketDNAChannelRailAtShift(bool support,int shift)
{
   double x=-(double)MathMax(0,shift);
   if(support)
      return gMDChannelSupportIntercept+gMDChannelSupportSlope*x;
   return gMDChannelResistanceIntercept+gMDChannelResistanceSlope*x;
}

void MarketDNAChannelCollectLevels()
{
   gMDChannelLowCount=0; gMDChannelHighCount=0;
   int bars=iBars(Symbol(),SignalTF);
   int scan=MathMin(MathMax(200,MarketDNAChannelLookbackBars),MathMax(0,bars-5));
   if(scan<100) return;
   int buckets=MathMax(12,MathMin(MD_CHANNEL_MAX_LEVELS,MarketDNAChannelLevelBuckets));
   int bucketSize=MathMax(8,(int)MathCeil((double)scan/(double)buckets));
   for(int start=2;start<=scan && (gMDChannelLowCount<buckets || gMDChannelHighCount<buckets);start+=bucketSize)
   {
      int count=MathMin(bucketSize,scan-start+1);
      if(count<=1) break;
      int ls=iLowest(Symbol(),SignalTF,MODE_LOW,count,start);
      int hs=iHighest(Symbol(),SignalTF,MODE_HIGH,count,start);
      if(ls>=0 && gMDChannelLowCount<buckets)
      {
         gMDChannelLowShift[gMDChannelLowCount]=ls;
         gMDChannelLowPrice[gMDChannelLowCount]=iLow(Symbol(),SignalTF,ls);
         gMDChannelLowCount++;
      }
      if(hs>=0 && gMDChannelHighCount<buckets)
      {
         gMDChannelHighShift[gMDChannelHighCount]=hs;
         gMDChannelHighPrice[gMDChannelHighCount]=iHigh(Symbol(),SignalTF,hs);
         gMDChannelHighCount++;
      }
   }
}

bool MarketDNAChannelFindRail(bool support,double atr)
{
   int count=(support?gMDChannelLowCount:gMDChannelHighCount);
   if(count<2 || atr<=0.0) return false;
   double touchTol=atr*MathMax(0.03,MarketDNAChannelTouchATR);
   double violationTol=atr*MathMax(MarketDNAChannelTouchATR,MarketDNAChannelBreakBufferATR*1.5);
   int preferred=MathMax(2,MarketDNAChannelMinTouches);
   double mid=(Bid+Ask)*0.5;

   double bestActive=-1.0e100,bestStrong=-1.0e100,bestFallback=-1.0e100;
   double activeSlope=0,activeIntercept=0,strongSlope=0,strongIntercept=0,fallbackSlope=0,fallbackIntercept=0;
   int activeOld=0,activeNew=0,activeTouches=0;
   int strongOld=0,strongNew=0,strongTouches=0;
   int fallbackOld=0,fallbackNew=0,fallbackTouches=0;
   double activeMaxDist=MathMax(0.50,MarketDNAChannelActiveMaxDistanceATR);

   for(int ni=0;ni<count-1;ni++)
   {
      int newShift=(support?gMDChannelLowShift[ni]:gMDChannelHighShift[ni]);
      double newPrice=(support?gMDChannelLowPrice[ni]:gMDChannelHighPrice[ni]);
      for(int oi=ni+1;oi<count;oi++)
      {
         int oldShift=(support?gMDChannelLowShift[oi]:gMDChannelHighShift[oi]);
         double oldPrice=(support?gMDChannelLowPrice[oi]:gMDChannelHighPrice[oi]);
         int span=oldShift-newShift;
         if(span<MathMax(10,MarketDNAChannelMinAnchorSpanBars)) continue;
         double xNew=-(double)newShift,xOld=-(double)oldShift;
         double denom=xNew-xOld;
         if(MathAbs(denom)<0.5) continue;
         double slope=(newPrice-oldPrice)/denom;
         double intercept=newPrice-slope*xNew;
         int touches=0,violations=0,seen=0;
         double penetration=0.0;
         for(int k=0;k<count;k++)
         {
            int sh=(support?gMDChannelLowShift[k]:gMDChannelHighShift[k]);
            if(sh>oldShift) continue; // evaluate only the life of this candidate rail
            double pr=(support?gMDChannelLowPrice[k]:gMDChannelHighPrice[k]);
            double line=intercept+slope*(-(double)sh);
            double residual=pr-line;
            seen++;
            if(MathAbs(residual)<=touchTol) touches++;
            if(support && residual<-violationTol)
            { violations++; penetration+=(-residual)/atr; }
            if(!support && residual>violationTol)
            { violations++; penetration+=residual/atr; }
         }
         if(seen<2 || touches<2) continue;
         double projected=intercept;
         double dist=MathAbs(mid-projected)/atr;
         double coverage=(double)touches/MathMax(2,seen);
         double spanBonus=0.35*MathLog(1.0+span);
         double recencyBonus=2.0/(1.0+(double)newShift/300.0);
         double proximityBonus=3.0/(1.0+dist);
         // v3.08 ACTIVE-RAIL preference: the 20K map supplies memory, but the rail
         // currently projected near price outranks an ancient statistically strong rail
         // that is several ATR away. This keeps LL/HL bounce zones attached to the
         // corridor the market is actually trading inside now.
         double activeRecency=3.0/(1.0+(double)newShift/220.0);
         double activeProximity=8.0/(0.35+dist);
         double score=2.6*touches+5.0*coverage+spanBonus+recencyBonus+proximityBonus+
                      activeRecency+activeProximity-4.5*violations-1.4*penetration;
         if(touches>=preferred && dist<=activeMaxDist && score>bestActive)
         {
            bestActive=score; activeSlope=slope; activeIntercept=intercept;
            activeOld=oldShift; activeNew=newShift; activeTouches=touches;
         }
         if(score>bestFallback)
         {
            bestFallback=score; fallbackSlope=slope; fallbackIntercept=intercept;
            fallbackOld=oldShift; fallbackNew=newShift; fallbackTouches=touches;
         }
         if(touches>=preferred && score>bestStrong)
         {
            bestStrong=score; strongSlope=slope; strongIntercept=intercept;
            strongOld=oldShift; strongNew=newShift; strongTouches=touches;
         }
      }
   }

   bool active=(bestActive>-1.0e90);
   bool strong=(bestStrong>-1.0e90);
   if(!active && !strong && bestFallback<=-1.0e90) return false;
   double slope=(active?activeSlope:(strong?strongSlope:fallbackSlope));
   double intercept=(active?activeIntercept:(strong?strongIntercept:fallbackIntercept));
   int oldShift=(active?activeOld:(strong?strongOld:fallbackOld));
   int newShift=(active?activeNew:(strong?strongNew:fallbackNew));
   int touches=(active?activeTouches:(strong?strongTouches:fallbackTouches));
   double score=(active?bestActive:(strong?bestStrong:bestFallback));

   if(support)
   {
      gMDChannelSupportSlope=slope; gMDChannelSupportIntercept=intercept;
      gMDChannelSupportNow=intercept; gMDChannelSupportOldShift=oldShift;
      gMDChannelSupportNewShift=newShift; gMDChannelSupportTouches=touches;
      gMDChannelSupportScore=score;
   }
   else
   {
      gMDChannelResistanceSlope=slope; gMDChannelResistanceIntercept=intercept;
      gMDChannelResistanceNow=intercept; gMDChannelResistanceOldShift=oldShift;
      gMDChannelResistanceNewShift=newShift; gMDChannelResistanceTouches=touches;
      gMDChannelResistanceScore=score;
   }
   return true;
}

void MarketDNAChannelEvaluateLive(double atr)
{
   gMDChannelBounceDirection=DIR_FLAT;
   gMDChannelBreakDirection=DIR_FLAT;
   gMDChannelZoneDirection=DIR_FLAT;
   gMDChannelCompressionZone=false;
   gMDChannelSupportDistanceATR=999.0; gMDChannelResistanceDistanceATR=999.0;
   gMDChannelSupportBreakAccepted=false;
   gMDChannelResistanceBreakAccepted=false;
   gMDChannelBreakIdentity=0;
   if(!EnableMarketDNAHistoricalChannels || atr<=0.0) return;

   double minSlope=MathMax(0.0,MarketDNAChannelMinSlopeATRPer100Bars);
   gMDChannelSupportSlopeATR100=(gMDChannelSupportValid?100.0*gMDChannelSupportSlope/atr:0.0);
   gMDChannelResistanceSlopeATR100=(gMDChannelResistanceValid?100.0*gMDChannelResistanceSlope/atr:0.0);
   gMDChannelSupportArrow=(gMDChannelSupportValid && MathAbs(gMDChannelSupportSlopeATR100)>=minSlope ?
                           MDSign(gMDChannelSupportSlopeATR100):DIR_FLAT);
   gMDChannelResistanceArrow=(gMDChannelResistanceValid && MathAbs(gMDChannelResistanceSlopeATR100)>=minSlope ?
                              MDSign(gMDChannelResistanceSlopeATR100):DIR_FLAT);

   int acceptBars=MathMax(1,MathMin(5,MarketDNAChannelBreakAcceptanceBars));
   double breakBuffer=atr*MathMax(0.0,MarketDNAChannelBreakBufferATR);
   // Crossing either rail can be a real channel BOS regardless of slope. Arrow
   // direction is for bounce behavior; accepted closes beyond a boundary are
   // breakout behavior.
   bool belowSupport=gMDChannelSupportValid;
   bool aboveResistance=gMDChannelResistanceValid;
   if(belowSupport)
   {
      for(int k=1;k<=acceptBars;k++)
         if(iClose(Symbol(),SignalTF,k)>=MarketDNAChannelRailAtShift(true,k)-breakBuffer)
         { belowSupport=false; break; }
      gMDChannelSupportBreakAccepted=belowSupport;
   }
   if(aboveResistance)
   {
      for(int k=1;k<=acceptBars;k++)
         if(iClose(Symbol(),SignalTF,k)<=MarketDNAChannelRailAtShift(false,k)+breakBuffer)
         { aboveResistance=false; break; }
      gMDChannelResistanceBreakAccepted=aboveResistance;
   }

   if(gMDChannelSupportBreakAccepted && !gMDChannelResistanceBreakAccepted)
   { gMDChannelBreakDirection=DIR_SELL; gMDChannelBreakIdentity=iTime(Symbol(),SignalTF,1); }
   else if(gMDChannelResistanceBreakAccepted && !gMDChannelSupportBreakAccepted)
   { gMDChannelBreakDirection=DIR_BUY; gMDChannelBreakIdentity=iTime(Symbol(),SignalTF,1); }

   bool risingSupport=(gMDChannelSupportArrow==DIR_BUY && !gMDChannelSupportBreakAccepted);
   bool fallingResistance=(gMDChannelResistanceArrow==DIR_SELL && !gMDChannelResistanceBreakAccepted);
   double mid=(Bid+Ask)*0.5;
   double prox=MathMax(0.05,MarketDNAChannelBounceProximityATR);
   double zoneProx=MathMax(prox,MathMax(0.05,MarketDNAChannelCounterEntryBlockATR));
   gMDChannelSupportDistanceATR=(gMDChannelSupportValid?MathAbs(mid-gMDChannelSupportNow)/atr:999.0);
   gMDChannelResistanceDistanceATR=(gMDChannelResistanceValid?MathAbs(mid-gMDChannelResistanceNow)/atr:999.0);
   bool nearSupport=(risingSupport && gMDChannelSupportDistanceATR<=prox);
   bool nearResistance=(fallingResistance && gMDChannelResistanceDistanceATR<=prox);
   bool supportZone=(risingSupport && gMDChannelSupportDistanceATR<=zoneProx);
   bool resistanceZone=(fallingResistance && gMDChannelResistanceDistanceATR<=zoneProx);
   if(supportZone && !resistanceZone) gMDChannelZoneDirection=DIR_BUY;
   else if(resistanceZone && !supportZone) gMDChannelZoneDirection=DIR_SELL;
   else if(supportZone && resistanceZone)
   {
      gMDChannelCompressionZone=true;
      gMDChannelZoneDirection=DIR_FLAT;
   }

   int lowShift=(gPyrLowTime1>0?iBarShift(Symbol(),SignalTF,gPyrLowTime1,false):-1);
   int highShift=(gPyrHighTime1>0?iBarShift(Symbol(),SignalTF,gPyrHighTime1,false):-1);
   bool lowLevelNear=(risingSupport && lowShift>=0 &&
                      MathAbs(gPyrLow1-MarketDNAChannelRailAtShift(true,lowShift))/atr<=prox);
   bool highLevelNear=(fallingResistance && highShift>=0 &&
                       MathAbs(gPyrHigh1-MarketDNAChannelRailAtShift(false,highShift))/atr<=prox);

   // "There is another LL/HH to the left of me": count old major levels near
   // the newest local low/high. These repeats strengthen the rail bounce context.
   gMDChannelHistoricalLowMatches=0; gMDChannelHistoricalHighMatches=0;
   double levelTol=atr*MathMax(0.08,MarketDNAChannelTouchATR);
   for(int li=0;li<gMDChannelLowCount;li++)
      if(lowShift>=0 && gMDChannelLowShift[li]>lowShift+MathMax(3,MarketDNAChannelMinAnchorSpanBars/4) &&
         MathAbs(gMDChannelLowPrice[li]-gPyrLow1)<=levelTol) gMDChannelHistoricalLowMatches++;
   for(int hi=0;hi<gMDChannelHighCount;hi++)
      if(highShift>=0 && gMDChannelHighShift[hi]>highShift+MathMax(3,MarketDNAChannelMinAnchorSpanBars/4) &&
         MathAbs(gMDChannelHighPrice[hi]-gPyrHigh1)<=levelTol) gMDChannelHistoricalHighMatches++;

   double supportDistance=(gMDChannelSupportValid?MathAbs(mid-gMDChannelSupportNow)/atr:999.0);
   double resistanceDistance=(gMDChannelResistanceValid?MathAbs(mid-gMDChannelResistanceNow)/atr:999.0);
   bool repeatedLowContext=(lowLevelNear && gMDChannelHistoricalLowMatches>0 && supportDistance<=prox*2.5);
   bool repeatedHighContext=(highLevelNear && gMDChannelHistoricalHighMatches>0 && resistanceDistance<=prox*2.5);

   double support1=(gMDChannelSupportValid?MarketDNAChannelRailAtShift(true,1):0.0);
   double resistance1=(gMDChannelResistanceValid?MarketDNAChannelRailAtShift(false,1):0.0);
   bool falseDown=(risingSupport && iLow(Symbol(),SignalTF,1)<support1-breakBuffer &&
                   iClose(Symbol(),SignalTF,1)>=support1);
   bool falseUp=(fallingResistance && iHigh(Symbol(),SignalTF,1)>resistance1+breakBuffer &&
                 iClose(Symbol(),SignalTF,1)<=resistance1);

   if((nearSupport || repeatedLowContext || falseDown) && !(nearResistance || repeatedHighContext || falseUp))
      gMDChannelBounceDirection=DIR_BUY;
   else if((nearResistance || repeatedHighContext || falseUp) && !(nearSupport || repeatedLowContext || falseDown))
      gMDChannelBounceDirection=DIR_SELL;
   else if((nearSupport || repeatedLowContext || falseDown) && (nearResistance || repeatedHighContext || falseUp))
   {
      double sd=(gMDChannelSupportValid?MathAbs(mid-gMDChannelSupportNow):1.0e20);
      double rd=(gMDChannelResistanceValid?MathAbs(mid-gMDChannelResistanceNow):1.0e20);
      gMDChannelBounceDirection=(sd<=rd?DIR_BUY:DIR_SELL);
   }

   // Channel direction. A rising support rail owns BUY regime until accepted
   // below; a falling resistance rail mirrors that. Opposing arrows define a
   // compression channel where only rail-proximity bounce gets local authority.
   int regime=DIR_FLAT;
   if(gMDChannelBreakDirection!=DIR_FLAT) regime=gMDChannelBreakDirection;
   else if(risingSupport && !fallingResistance) regime=DIR_BUY;
   else if(fallingResistance && !risingSupport) regime=DIR_SELL;
   else if(risingSupport && fallingResistance) regime=DIR_FLAT;
   else
   {
      double avg=0.0; int n=0;
      if(gMDChannelSupportValid){ avg+=gMDChannelSupportSlopeATR100; n++; }
      if(gMDChannelResistanceValid){ avg+=gMDChannelResistanceSlopeATR100; n++; }
      if(n>0) regime=(MathAbs(avg/n)>=minSlope?MDSign(avg/n):DIR_FLAT);
   }
   gMDChannelDirection=regime;

   double touchConf=MathMin(1.0,(double)(gMDChannelSupportTouches+gMDChannelResistanceTouches)/
                                   MathMax(2.0,2.0*MarketDNAChannelMinTouches));
   double slopeStrength=0.0;
   if(regime==DIR_BUY)
      slopeStrength=MathMax(MathMax(0.0,gMDChannelSupportSlopeATR100),MathMax(0.0,gMDChannelResistanceSlopeATR100));
   else if(regime==DIR_SELL)
      slopeStrength=MathMax(MathMax(0.0,-gMDChannelResistanceSlopeATR100),MathMax(0.0,-gMDChannelSupportSlopeATR100));
   double magnitude=MDClamp(0.16+0.35*MathMin(1.0,slopeStrength/MathMax(0.03,minSlope*4.0))+0.20*touchConf,0.0,0.85);
   if(regime!=DIR_FLAT) gMDChannelATR=regime*magnitude;
   else if(gMDChannelBounceDirection!=DIR_FLAT)
      gMDChannelATR=gMDChannelBounceDirection*MathMax(0.32,0.75*magnitude);
   else gMDChannelATR=0.0;

   if(gMDChannelBreakDirection==DIR_BUY) gMDChannelState="RESISTANCE CHANNEL BROKEN + ACCEPTED | BUY BOS";
   else if(gMDChannelBreakDirection==DIR_SELL) gMDChannelState="SUPPORT CHANNEL BROKEN + ACCEPTED | SELL BOS";
   else if(gMDChannelBounceDirection==DIR_BUY) gMDChannelState="RISING SUPPORT CHANNEL | LL/HL BUY BOUNCE ZONE";
   else if(gMDChannelBounceDirection==DIR_SELL) gMDChannelState="FALLING RESISTANCE CHANNEL | HH/LH SELL BOUNCE ZONE";
   else if(gMDChannelCompressionZone) gMDChannelState="ACTIVE CHANNEL COMPRESSION | NEW ENTRIES FIREWALLED";
   else if(gMDChannelZoneDirection==DIR_BUY) gMDChannelState="SUPPORT APPROACH ZONE | SELL FIREWALL / WAIT BUY RHYTHM";
   else if(gMDChannelZoneDirection==DIR_SELL) gMDChannelState="RESISTANCE APPROACH ZONE | BUY FIREWALL / WAIT SELL RHYTHM";
   else if(risingSupport && fallingResistance) gMDChannelState="CHANNEL COMPRESSION | WAIT RAIL BOUNCE OR ACCEPTED BREAK";
   else if(regime==DIR_BUY) gMDChannelState="HISTORICAL UP CHANNEL | SUPPORT ARROW UP";
   else if(regime==DIR_SELL) gMDChannelState="HISTORICAL DOWN CHANNEL | RESISTANCE ARROW DOWN";
   else gMDChannelState="HISTORICAL CHANNEL NEUTRAL";
}



//==============================================================================
// v3.16 DAY HIGH/LOW DNA
//==============================================================================
datetime MarketDNADayStartBroker(datetime t)
{
   MqlDateTime d; TimeToStruct(t,d); d.hour=0; d.min=0; d.sec=0; return StructToTime(d);
}

void MarketDNADayHLRebuild()
{
   datetime ds=MarketDNADayStartBroker(TimeCurrent());
   int bars=iBars(Symbol(),SignalTF);
   if(bars<2){ gMDDayHLState="DAY RANGE WAIT HISTORY"; return; }
   double hi=-1.0e100,lo=1.0e100;
   int scanned=0;
   for(int i=0;i<MathMin(bars-1,3000);i++)
   {
      datetime bt=iTime(Symbol(),SignalTF,i);
      if(bt<=0 || bt<ds) break;
      hi=MathMax(hi,iHigh(Symbol(),SignalTF,i));
      lo=MathMin(lo,iLow(Symbol(),SignalTF,i));
      scanned++;
   }
   if(scanned<=0 || hi<=lo){ gMDDayHLState="DAY RANGE WAIT HISTORY"; return; }
   gMDDayStart=ds; gMDDayHigh=hi; gMDDayLow=lo;
   double atr=(LiveATRStableHistoricalMaps?HTStableATR(SignalTF,14):HTExecutionATR(SignalTF,14));
   double tol=atr*MathMax(0.01,MarketDNADayTouchATR);
   gMDDayHighTouches=0; gMDDayLowTouches=0;
   for(int j=1;j<MathMin(scanned,3000);j++)
   {
      if(MathAbs(iHigh(Symbol(),SignalTF,j)-hi)<=tol) gMDDayHighTouches++;
      if(MathAbs(iLow(Symbol(),SignalTF,j)-lo)<=tol) gMDDayLowTouches++;
   }
   gMDDayHighTouchBar=0; gMDDayLowTouchBar=0;
}

void MarketDNADayHLUpdate()
{
   if(!MarketDNADayHLGuard && !MarketDNADayHLDraw) return;
   datetime ds=MarketDNADayStartBroker(TimeCurrent());
   if(gMDDayStart!=ds || gMDDayHigh<=0.0 || gMDDayLow<=0.0) MarketDNADayHLRebuild();
   if(gMDDayHigh<=0.0 || gMDDayLow<=0.0) return;
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double tol=atr*MathMax(0.01,MarketDNADayTouchATR);
   double ch=iHigh(Symbol(),SignalTF,0),cl=iLow(Symbol(),SignalTF,0);
   datetime cb=iTime(Symbol(),SignalTF,0);
   if(ch>gMDDayHigh){ gMDDayHigh=ch; gMDDayHighTouches=1; gMDDayHighTouchBar=cb; }
   else if(MathAbs(ch-gMDDayHigh)<=tol && cb!=gMDDayHighTouchBar){ gMDDayHighTouches++; gMDDayHighTouchBar=cb; }
   if(cl<gMDDayLow){ gMDDayLow=cl; gMDDayLowTouches=1; gMDDayLowTouchBar=cb; }
   else if(MathAbs(cl-gMDDayLow)<=tol && cb!=gMDDayLowTouchBar){ gMDDayLowTouches++; gMDDayLowTouchBar=cb; }

   RefreshRates(); double mid=(Bid+Ask)*0.5;
   double range=MathMax(Point,gMDDayHigh-gMDDayLow);
   gMDDayRangePosition=MDClamp((mid-gMDDayLow)/range,0.0,1.0);
   double frac=MathMax(0.01,MathMin(0.49,MarketDNADayExtremeZoneFraction));
   double prox=atr*MathMax(0.05,MarketDNADayExtremeATR);
   gMDDayNearLow=(gMDDayRangePosition<=frac || MathAbs(mid-gMDDayLow)<=prox);
   gMDDayNearHigh=(gMDDayRangePosition>=1.0-frac || MathAbs(gMDDayHigh-mid)<=prox);
   if(gMDDayNearLow && !gMDDayNearHigh) gMDDayHLState="DAY LOW BUY-BOUNCE / SELL BREAK MUST PROVE";
   else if(gMDDayNearHigh && !gMDDayNearLow) gMDDayHLState="DAY HIGH SELL-BOUNCE / BUY BREAK MUST PROVE";
   else gMDDayHLState="DAY RANGE "+DoubleToString(gMDDayRangePosition*100.0,0)+"%";
}

bool MarketDNADayHLAllowsDirection(int dir)
{
   if(!MarketDNADayHLGuard || dir==DIR_FLAT) return true;
   if(!MarketDNADayRequireProvenBreakForCounter) return true;
   bool armedBreak=(gMDFVGArmed && gMDFVGDirection==dir &&
                     (gMDFVGSource==PYR_SOURCE_TRIGGER_RAIL_BREAK || gMDFVGSource==PYR_SOURCE_CHANNEL_BREAK));
   if(dir==DIR_SELL && gMDDayNearLow)
      return (gMDTriggerRailBreakDirection==DIR_SELL || gMDChannelBreakDirection==DIR_SELL || armedBreak);
   if(dir==DIR_BUY && gMDDayNearHigh)
      return (gMDTriggerRailBreakDirection==DIR_BUY || gMDChannelBreakDirection==DIR_BUY || armedBreak);
   return true;
}

void MarketDNADrawDayHL()
{
   string hi=Pfx()+"MD_DAY_HIGH",lo=Pfx()+"MD_DAY_LOW",hb=Pfx()+"MD_DAY_HIGH_ZONE",lb=Pfx()+"MD_DAY_LOW_ZONE";
   if(!MarketDNADayHLDraw || gMDDayHigh<=0.0 || gMDDayLow<=0.0)
   { ObjectDelete(0,hi); ObjectDelete(0,lo); ObjectDelete(0,hb); ObjectDelete(0,lb); return; }
   if(ObjectFind(0,hi)<0) ObjectCreate(0,hi,OBJ_HLINE,0,0,gMDDayHigh);
   if(ObjectFind(0,lo)<0) ObjectCreate(0,lo,OBJ_HLINE,0,0,gMDDayLow);
   ObjectSetDouble(0,hi,OBJPROP_PRICE1,gMDDayHigh); ObjectSetInteger(0,hi,OBJPROP_STYLE,STYLE_DOT); ObjectSetInteger(0,hi,OBJPROP_WIDTH,2); ObjectSetInteger(0,hi,OBJPROP_COLOR,HTAlert);
   ObjectSetDouble(0,lo,OBJPROP_PRICE1,gMDDayLow); ObjectSetInteger(0,lo,OBJPROP_STYLE,STYLE_DOT); ObjectSetInteger(0,lo,OBJPROP_WIDTH,2); ObjectSetInteger(0,lo,OBJPROP_COLOR,HTGoldBright);
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double z=MathMax(atr*MathMax(0.05,MarketDNADayExtremeATR),Point*10);
   datetime t1=gMDDayStart>0?gMDDayStart:iTime(Symbol(),SignalTF,0);
   datetime t2=TimeCurrent()+MathMax(60,PeriodSeconds(SignalTF))*120;
   if(ObjectFind(0,hb)<0) ObjectCreate(0,hb,OBJ_RECTANGLE,0,t1,gMDDayHigh+z*0.20,t2,gMDDayHigh-z);
   ObjectMove(0,hb,0,t1,gMDDayHigh+z*0.20); ObjectMove(0,hb,1,t2,gMDDayHigh-z); ObjectSetInteger(0,hb,OBJPROP_COLOR,HTAlert); ObjectSetInteger(0,hb,OBJPROP_BACK,true);
   if(ObjectFind(0,lb)<0) ObjectCreate(0,lb,OBJ_RECTANGLE,0,t1,gMDDayLow+z,t2,gMDDayLow-z*0.20);
   ObjectMove(0,lb,0,t1,gMDDayLow+z); ObjectMove(0,lb,1,t2,gMDDayLow-z*0.20); ObjectSetInteger(0,lb,OBJPROP_COLOR,HTGoldDark); ObjectSetInteger(0,lb,OBJPROP_BACK,true);
}

//==============================================================================
// v3.17 SIGNAL-FVG FINAL ENTRY GATE
//==============================================================================
void MarketDNASignalFVGReset(string why)
{
   gMDFVGArmed=false; gMDFVGReady=false; gMDFVGInZone=false; gMDFVGSeedUsed=false; gMDFVGDirection=DIR_FLAT;
   gMDFVGSource=PYR_SOURCE_NONE; gMDFVGSignalTime=0; gMDFVGZoneTime=0; gMDFVGTop=0.0; gMDFVGBot=0.0;
   gMDFVGLastMid=0.0; gMDFVGTouchLatchUntilSerial=0;
   gMDFVGSeedOrderContext=false;
   gMDFVGDirectSeedState="DIRECT FVG SEED IDLE"+(why==""?"":" | "+why);
   gMDFVGState="SIGNAL FVG IDLE"+(why==""?"":" | "+why);
}

void MarketDNASignalFVGArm(int dir,PyrSignalSource source)
{
   if(!MarketDNASignalFVGOnly || dir==DIR_FLAT || source==PYR_SOURCE_NONE) return;
   datetime bar=iTime(Symbol(),SignalTF,0);
   datetime eventTime=bar;
   if(source!=PYR_SOURCE_RHYTHM_ACCELERATOR && gPyrActiveSignalIdentity>0)
   {
      int sec=MathMax(60,PeriodSeconds(SignalTF));
      datetime oldest=bar-sec*MathMax(3,MarketDNASignalFVGExpiryBars);
      if(gPyrActiveSignalIdentity>=oldest && gPyrActiveSignalIdentity<=TimeCurrent()+sec) eventTime=gPyrActiveSignalIdentity;
   }
   // v3.17 QUEUE LAW: once a direction has earned an FVG queue, another
   // same-direction signal source may reinforce it but cannot reset the waiting
   // location. This prevents source churn from moving the goalposts before retest.
   if(gMDFVGArmed && gMDFVGDirection==dir)
   {
      if(!gMDFVGSeedUsed) return;
      if(gMDFVGSource==source && gMDFVGSignalTime==bar) return;
   }
   gMDFVGArmed=true; gMDFVGReady=false; gMDFVGInZone=false; gMDFVGSeedUsed=false; gMDFVGDirection=dir; gMDFVGSource=source;
   gMDFVGSignalTime=eventTime; gMDFVGZoneTime=0; gMDFVGTop=0.0; gMDFVGBot=0.0;
   gMDFVGLastMid=0.0; gMDFVGTouchLatchUntilSerial=0;
   gMDFVGState=(dir==DIR_BUY?"BUY":"SELL")+" SIGNAL ARMED / WAIT OWN FVG";
}

void MarketDNASignalFVGUpdate()
{
   if(!MarketDNASignalFVGOnly || !gMDFVGArmed || gMDFVGDirection==DIR_FLAT) return;
   int sigShift=iBarShift(Symbol(),SignalTF,gMDFVGSignalTime,false);
   if(sigShift<0) sigShift=0;
   if(sigShift>MathMax(3,MarketDNASignalFVGExpiryBars)) { MarketDNASignalFVGReset("EXPIRED"); return; }
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   if(!gMDFVGReady)
   {
      int bars=iBars(Symbol(),SignalTF);
      int maxI=MathMin(MathMax(4,MarketDNASignalFVGScanBars),bars-3);
      for(int i=3;i<=maxI;i++)
      {
         datetime creation=iTime(Symbol(),SignalTF,i-2);
         int sec=MathMax(60,PeriodSeconds(SignalTF));
         datetime earliest=gMDFVGSignalTime-sec*MathMax(0,MarketDNASignalFVGAssociationBars);
         if(creation<earliest) continue; // bind only the displacement FVG around this signal.
         double olderH=iHigh(Symbol(),SignalTF,i),olderL=iLow(Symbol(),SignalTF,i);
         double newerH=iHigh(Symbol(),SignalTF,i-2),newerL=iLow(Symbol(),SignalTF,i-2);
         double top=0.0,bot=0.0;
         if(gMDFVGDirection==DIR_BUY && newerL>olderH){ top=newerL; bot=olderH; }
         if(gMDFVGDirection==DIR_SELL && newerH<olderL){ top=olderL; bot=newerH; }
         if(top<=bot || top-bot<atr*MathMax(0.0,MarketDNASignalFVGMinATR)) continue;
         gMDFVGTop=top; gMDFVGBot=bot; gMDFVGZoneTime=creation; gMDFVGReady=true;
         gMDFVGState=(gMDFVGDirection==DIR_BUY?"BUY":"SELL")+" SIGNAL FVG READY "+DoubleToString(bot,Digits)+"-"+DoubleToString(top,Digits);
         break;
      }
   }
   RefreshRates(); double mid=(Bid+Ask)*0.5;
   double tol=atr*MathMax(0.0,MarketDNASignalFVGToleranceATR)*EvolutionFVGTouchMultiplier();

   // v3.17: detect the tick path through the FVG BEFORE evaluating a far-edge
   // violation. Gold can cross an entire narrow imbalance between two ticks; that
   // is a real retest and must not be erased before the execution loop sees it.
   bool inside=(gMDFVGReady && mid>=gMDFVGBot-tol && mid<=gMDFVGTop+tol);
   bool crossed=false;
   if(MarketDNASignalFVGUseCrossThroughLatch && gMDFVGReady && gMDFVGLastMid>0.0)
   {
      double segLo=MathMin(gMDFVGLastMid,mid),segHi=MathMax(gMDFVGLastMid,mid);
      crossed=(segHi>=gMDFVGBot-tol && segLo<=gMDFVGTop+tol);
   }
   if(inside || crossed) gMDFVGTouchLatchUntilSerial=gMDEntryTickSerial+MathMax(1,MarketDNASignalFVGTouchLatchTicks);
   bool touchEarned=(inside || crossed || gMDFVGTouchLatchUntilSerial>=gMDEntryTickSerial);

   // Persistent queue, but true hard invalidation still wins. A cross-through on
   // this tick receives its seed window first; subsequent continued travel beyond
   // the far edge can invalidate the queue if no seed was obtained.
   if(gMDFVGReady && MarketDNASignalFVGQueueAuthority)
   {
      bool oppositeHardBreak=(gMDFVGDirection==DIR_BUY ?
                              (gMDTriggerRailBreakDirection==DIR_SELL || gMDChannelBreakDirection==DIR_SELL) :
                              (gMDTriggerRailBreakDirection==DIR_BUY  || gMDChannelBreakDirection==DIR_BUY));
      double inv=atr*MathMax(0.02,MarketDNASignalFVGInvalidationATR);
      bool farViolation=(gMDFVGDirection==DIR_BUY ? mid<gMDFVGBot-inv : mid>gMDFVGTop+inv);
      if(oppositeHardBreak || (farViolation && !(MarketDNAFVGCrossBeforeInvalidation && touchEarned)))
      {
         MarketDNASignalFVGReset(oppositeHardBreak?"OPPOSITE HARD BREAK":"FAR EDGE INVALIDATED");
         return;
      }
   }

   bool latched=(gMDFVGTouchLatchUntilSerial>=gMDEntryTickSerial);
   gMDFVGInZone=(inside || latched);
   gMDFVGLastMid=mid;
   if(gMDFVGReady && !gMDFVGInZone)
      gMDFVGState=(gMDFVGDirection==DIR_BUY?"BUY":"SELL")+" FVG QUEUED / WAIT RETEST";
   if(gMDFVGInZone)
      gMDFVGState=(gMDFVGDirection==DIR_BUY?"BUY":"SELL")+(inside?" FVG LIVE / SEED WINDOW":" FVG CROSS-LATCHED / SEED WINDOW");
}

bool MarketDNASignalFVGEntryReady(int dir)
{
   if(!MarketDNASignalFVGOnly) return true;
   if(gMDRLadderEntryOverrideActive) return true;
   MarketDNASignalFVGUpdate();
   if(gMDPendingPlacementContext) return (gMDFVGArmed && gMDFVGReady && gMDFVGDirection==dir);
   if(gMDFVGSeedUsed) return false;
   if(!gMDFVGArmed || !gMDFVGReady || !gMDFVGInZone || gMDFVGDirection!=dir) return false;
   if(MarketDNASignalFVGQueueAuthority)
   {
      if(EnableMarketDNARhythmDNA && gMDRhythmScore<EvolutionQueuedRhythmFloor()) return false;
      return true;
   }
   if(MarketDNASignalFVGRequireRhythm && gMDRhythmScore<MathMax(0.0,MarketDNASignalFVGMinRhythm)) return false;
   return true;
}

bool MarketDNASignalFVGQueuedSeedReady(int dir)
{
   if(!MarketDNASignalFVGOnly || !MarketDNASignalFVGQueueAuthority || TradeCount()>0 || dir==DIR_FLAT) return false;
   return MarketDNASignalFVGEntryReady(dir);
}

int MarketDNASignalFVGQueuedDirection()
{
   if(!MarketDNASignalFVGOnly || !MarketDNASignalFVGQueueAuthority || TradeCount()>0) return DIR_FLAT;
   if(gMDFVGDirection==DIR_FLAT) return DIR_FLAT;
   return (MarketDNASignalFVGQueuedSeedReady(gMDFVGDirection)?gMDFVGDirection:DIR_FLAT);
}

bool MarketDNAQueuedFVGHardSafetyAllows(int dir,string &reason)
{
   reason="OK";
   if(dir==DIR_FLAT || TradeCount()>0) { reason="NOT FLAT / NO DIR"; return false; }
   if(!MarketDNASignalFVGEntryReady(dir)) { reason=gMDFVGState; return false; }
   if(gCompoundEntryFreeze || gPyrPeakObservationActive)
   { reason=(gCompoundEntryFreeze?"COMPOUND FREEZE":"PEAK OBSERVATION"); return false; }
   if(MarketDNADayHLGuard && !MarketDNADayHLAllowsDirection(dir))
   { reason="DAY HL: "+gMDDayHLState; return false; }
   bool oppositeHard=(dir==DIR_BUY ?
                      (gMDTriggerRailBreakDirection==DIR_SELL || gMDChannelBreakDirection==DIR_SELL) :
                      (gMDTriggerRailBreakDirection==DIR_BUY || gMDChannelBreakDirection==DIR_BUY));
   if(oppositeHard) { reason="OPPOSITE HARD BREAK"; return false; }
   return true;
}

bool MarketDNAExecuteQueuedFVGSeedDirect(int dir)
{
   // v6.05: FVG is location/context. It cannot create the primary structure trade.
   if(HT6EinsteinEnabled()) return false;
   if(!MarketDNAFVGDirectSeedAuthority || dir==DIR_FLAT || TradeCount()>0) return false;
   if(gMDEntryTickSerial==gMDFVGLastDirectSeedAttemptSerial) return false;
   string hardReason="";
   if(!MarketDNAQueuedFVGHardSafetyAllows(dir,hardReason))
   { gMDFVGDirectSeedState="DIRECT SEED WAIT | "+hardReason; return false; }

   gMDFVGLastDirectSeedAttemptSerial=gMDEntryTickSerial;
   PyrSignalSource oldSource=gPyrSignalSource;
   datetime oldIdentity=gPyrActiveSignalIdentity;
   bool oldBurst=gMDBurstOverride;
   gPyrSignalSource=gMDFVGSource;
   gPyrActiveSignalIdentity=gMDFVGSignalTime;
   gMDBurstOverride=true;
   gMDFVGDirectSeedState=(dir==DIR_BUY?"DIRECT BUY FVG SEED ATTEMPT":"DIRECT SELL FVG SEED ATTEMPT");
   bool opened=PyrTryEntry(dir);
   gMDBurstOverride=oldBurst;
   gPyrSignalSource=oldSource;
   gPyrActiveSignalIdentity=oldIdentity;

   if(!opened)
   {
      gMDFVGDirectSeedState="DIRECT FVG SEED BLOCKED | "+gEntryStatus+" | "+gPyrState;
      return false;
   }

   gMDFVGSeedUsed=true;
   gMDFVGDirectSeedState=(dir==DIR_BUY?"DIRECT BUY FVG SEED FILLED":"DIRECT SELL FVG SEED FILLED");
   if(MarketDNASonicRLadder && gMDFVGSource==PYR_SOURCE_TRIGGER_RAIL_BREAK && !gMDRLadderActive &&
      gLastOpenedPrice>0.0 && gPyrInvalidation>0.0)
      MarketDNARLadderArm(dir,gLastOpenedPrice,gPyrInvalidation);
   return true;
}

bool MarketDNASignalFVGClampPrice(int dir,double desired,double atr,double &result)
{
   result=desired;
   if(!MarketDNASignalFVGOnly || !MarketDNASignalFVGClampPulseLimits) return true;
   MarketDNASignalFVGUpdate();
   if(!gMDFVGReady || gMDFVGDirection!=dir) return false;
   RefreshRates(); double gap=MathMax(MarketInfo(Symbol(),MODE_STOPLEVEL)*Point+Point,atr*0.01);
   double lo=gMDFVGBot,hi=gMDFVGTop;
   result=MathMax(lo,MathMin(hi,desired));
   if(dir==DIR_BUY){ result=MathMin(result,Ask-gap); if(result<lo || result>hi) return false; }
   else { result=MathMax(result,Bid+gap); if(result<lo || result>hi) return false; }
   result=NormalizeDouble(result,Digits); return true;
}

void MarketDNADrawSignalFVG()
{
   string box=Pfx()+"MD_SIGNAL_FVG",txt=Pfx()+"MD_SIGNAL_FVG_TEXT";
   if(!MarketDNASignalFVGOnly || !gMDFVGReady || gMDFVGTop<=gMDFVGBot)
   { ObjectDelete(0,box); ObjectDelete(0,txt); return; }
   datetime t1=(gMDFVGZoneTime>0?gMDFVGZoneTime:gMDFVGSignalTime);
   datetime t2=TimeCurrent()+MathMax(60,PeriodSeconds(SignalTF))*80;
   if(ObjectFind(0,box)<0) ObjectCreate(0,box,OBJ_RECTANGLE,0,t1,gMDFVGTop,t2,gMDFVGBot);
   ObjectMove(0,box,0,t1,gMDFVGTop); ObjectMove(0,box,1,t2,gMDFVGBot);
   ObjectSetInteger(0,box,OBJPROP_BACK,true);
   ObjectSetInteger(0,box,OBJPROP_STYLE,STYLE_DOT);
   ObjectSetInteger(0,box,OBJPROP_COLOR,(gMDFVGDirection==DIR_BUY?C'20,120,80':C'135,35,45'));
   double mid=(gMDFVGTop+gMDFVGBot)*0.5;
   if(ObjectFind(0,txt)<0) ObjectCreate(0,txt,OBJ_TEXT,0,t2,mid);
   ObjectMove(0,txt,0,t2,mid);
   ObjectSetText(txt,(gMDFVGDirection==DIR_BUY?"BUY":"SELL")+" SIGNAL FVG",8,"Arial Bold",(gMDFVGInZone?C'45,220,120':HTMuted));
}

//==============================================================================
// v3.17 SONIC R-LADDER
//==============================================================================
void MarketDNARLadderReset(string why)
{
   gMDRLadderActive=false; gMDRLadderDirection=DIR_FLAT; gMDRLadderStageReached=0; gMDRLadderStageFilledMask=0;
   gMDRLadderLastFireSerial=0; gMDRLadderCycle=0; gMDRLadderSeedEntry=0.0; gMDRLadderOriginalStop=0.0; gMDRLadderR=0.0; gMDRLadderTarget=0.0;
   gMDRLadderRiskBudgetMoney=0.0; gMDRLadderEntryOverrideActive=false; gMDRLadderEntryStop=0.0; gMDRLadderEntryTarget=0.0; gMDRLadderEntryRiskFraction=0.0;
   gMDRLadderState="R-LADDER IDLE"+(why==""?"":" | "+why);
}

double MarketDNARLadderStageR(int stage)
{
   int n=MathMax(2,MathMin(12,MarketDNARLadderStages));
   int k=MathMax(1,MathMin(n,stage));
   double x=(double)(k-1)/MathMax(1,n-1);
   double curve=MathMax(0.20,MarketDNARLadderStageCurve);
   double first=EvolutionRLadderFirstR();
   double last=MathMax(first+0.05,MarketDNARLadderLastStageR);
   double base=first+(last-first)*MathPow(x,curve);
   if(HowShouldSonicAccelerateWinningTrades==SONIC_FULL_ADAPTIVE_COMPOUND_ACCELERATOR)
   {
      double need=HT5Clamp(HT5SafeDiv(gCompoundLiveRemaining,MathMax(0.01,gCompoundBaseGoalMoney)),0.0,1.5);
      double motion=HT5Clamp(MathMax(0.0,gMDRhythmScore)+0.50*MathMax(0.0,gMDRhythmForce),0.0,1.0);
      double uncertainty=HT5Clamp(gMDUncertaintyATR/1.0,0.0,1.0);
      // Strong proven movement + large remaining compound demand pulls the next
      // earned level slightly closer. Uncertainty pushes it farther away.
      double shift=-0.035*motion*MathMin(1.0,need)+0.045*uncertainty;
      base+=shift*(1.0-0.35*x);
   }
   return MDClamp(base,0.05,0.97);
}

double MarketDNARLadderProtectR(int stage)
{
   int n=MathMax(2,MathMin(12,MarketDNARLadderStages));
   int k=MathMax(1,MathMin(n,stage));
   double x=(double)(k-1)/MathMax(1,n-1);
   double curve=MathMax(0.20,MarketDNARLadderProtectCurve);
   return MarketDNARLadderFirstProtectR+(MarketDNARLadderLastProtectR-MarketDNARLadderFirstProtectR)*MathPow(x,curve);
}

void MarketDNARLadderArm(int dir,double entry,double stop)
{
   if(!MarketDNASonicRLadder || dir==DIR_FLAT || entry<=0.0 || stop<=0.0) return;
   double r=MathAbs(entry-stop); if(r<Point*2) return;
   gMDRLadderActive=true; gMDRLadderDirection=dir; gMDRLadderStageReached=0; gMDRLadderStageFilledMask=0;
   gMDRLadderLastFireSerial=gMDRTickSerial; gMDRLadderCycle=gCompoundCycle;
   gMDRLadderSeedEntry=entry; gMDRLadderOriginalStop=stop; gMDRLadderR=r;
   gMDRLadderTarget=NormalizeDouble(entry+dir*r*MathMax(0.10,MarketDNARLadderTargetR),Digits);
   double cap=AccountRiskBase()*MaximumCampaignRiskPercent/100.0;
   double one=SelectedRiskMoney();
   gMDRLadderRiskBudgetMoney=(MarketDNARLadderUseSingleRiskBudget?MathMin(cap,one):cap);
   MarketDNADeletePendingLimits("SONIC R-LADDER OWNS EXPANSION");
   gMDRLadderState=(dir==DIR_BUY?"SONIC BUY":"SONIC SELL")+" R-LADDER ARMED | R="+DoubleToString(r/Point,1)+"pt";
}

bool MarketDNARLadderApplyProtection(int stage)
{
   if(!gMDRLadderActive || stage<=0 || gMDRLadderR<=0.0) return false;
   if(HowShouldTheCreatureProtectEarnedProfit>=PROTECT_CAMPAIGN_WIDE_MONEY_SOLVER)
      return HT5CampaignProtectionSolver(stage);

   // Compatibility path for the lighter protection dropdowns.
   int dir=gMDRLadderDirection; double protectR=MarketDNARLadderProtectR(stage);
   double desired=NormalizeDouble(gMDRLadderSeedEntry+dir*gMDRLadderR*protectR,Digits);
   RefreshRates(); double stopLevel=MarketInfo(Symbol(),MODE_STOPLEVEL)*Point+Point;
   if(dir==DIR_BUY) desired=MathMin(desired,Bid-stopLevel);
   else desired=MathMax(desired,Ask+stopLevel);
   return HT5ApplyCommonCampaignStop(dir,desired,"LEGACY FORWARD RATCHET");
}

bool MarketDNARLadderManage()
{
   if(HT6EinsteinEnabled()) return false;
   if(!MarketDNASonicRLadder || !gMDRLadderActive) return false;
   if(gMDRLadderCycle!=gCompoundCycle || TradeCount()==0){ MarketDNARLadderReset("FLAT/COMPOUND RESET"); return false; }
   HT5UpdateOpenTicketTelemetry();
   if(gHT5DefenseMode)
   {
      gMDRLadderState="R-LADDER PAUSED • "+gHT5DefenseState;
      return false;
   }
   int dir=gMDRLadderDirection;
   bool hardOpposite=(dir==DIR_BUY ?
                      (gMDTriggerRailBreakDirection==DIR_SELL || gMDChannelBreakDirection==DIR_SELL || gMDTransferHandoffDirection==DIR_SELL) :
                      (gMDTriggerRailBreakDirection==DIR_BUY || gMDChannelBreakDirection==DIR_BUY || gMDTransferHandoffDirection==DIR_BUY));
   // NO SPINE / FLAT Q* is uncertainty, not automatic campaign invalidation. Once a
   // labelled seed is open, SONIC keeps its frozen R-coordinate system until the
   // campaign closes or a hard opposite structure transfer proves invalidation.
   if(dir==DIR_FLAT || (int)DetectDirection()!=dir || hardOpposite)
   { MarketDNARLadderReset(hardOpposite?"HARD OPPOSITE INVALIDATION":"CAMPAIGN DIRECTION INVALID"); return false; }
   RefreshRates(); double current=(dir==DIR_BUY?Bid:Ask);
   double progress=dir*(current-gMDRLadderSeedEntry)/MathMax(Point,gMDRLadderR);
   int maxStages=MathMax(2,MathMin(12,MarketDNARLadderStages));
   for(int stage=1;stage<=maxStages;stage++)
   {
      int bit=(1<<(stage-1));
      if((gMDRLadderStageFilledMask & bit)!=0) continue;
      double need=MarketDNARLadderStageR(stage);
      if(progress+0.0001<need) break;

      // Price earned this level. Protection moves first; only released risk may fund the add.
      MarketDNARLadderApplyProtection(stage);
      gMDRLadderStageReached=MathMax(gMDRLadderStageReached,stage);
      if(gMDRTickSerial-gMDRLadderLastFireSerial<MathMax(1,MarketDNARLadderCooldownTicks)) return false;
      if(MarketDNARLadderRequireRhythm && gMDRhythmScore<MathMax(0.0,MarketDNARLadderMinRhythm))
      { gMDRLadderState="R-LADDER STAGE "+IntegerToString(stage)+" PROTECTED / WAIT RHYTHM"; return false; }
      if(gHT6DoctrineOwnsEntry)
      {
         string seqReason="";
         if(!HT6DoctrineAllowsRequest(dir,DOCTRINE_REQUEST_ADD,seqReason))
         { gMDRLadderState="R-LADDER PROTECTED / "+seqReason; return false; }
      }
      gMDRLadderEntryOverrideActive=true;
      if(!MarketDNACanDeploy(dir))
      { gMDRLadderEntryOverrideActive=false; gMDRLadderState="R-LADDER STAGE "+IntegerToString(stage)+" PROTECTED / "+gMDDeployBlockReason; return false; }

      double cap=MathMax(0.0,gMDRLadderRiskBudgetMoney);
      double remaining=MathMax(0.0,cap-OpenCampaignRiskMoney()-MarketDNAPendingRiskMoney());
      double fullRisk=AccountRiskBase()*SovereignOxRiskPercent()/100.0;
      if(remaining<=0.01 || fullRisk<=0.0){ gMDRLadderEntryOverrideActive=false; gMDRLadderState="R-LADDER RISK FULL / PROTECTED"; return false; }
      double fraction=MathMax(0.0,MathMin(1.0,remaining/fullRisk))*EvolutionRLadderRiskScale();

      double stop=NormalizeDouble(gMDRLadderSeedEntry+dir*gMDRLadderR*MarketDNARLadderProtectR(stage),Digits);
      double stopLevel=MarketInfo(Symbol(),MODE_STOPLEVEL)*Point+Point;
      if(dir==DIR_BUY) stop=MathMin(stop,Bid-stopLevel); else stop=MathMax(stop,Ask+stopLevel);
      gMDRLadderEntryStop=stop; gMDRLadderEntryTarget=gMDRLadderTarget; gMDRLadderEntryRiskFraction=fraction;
      // A named setup may sponsor/label an earned SONIC stage, but it cannot bypass
      // the R-stage, protection-first law, released-risk budget, or margin checks.
      int sponsor=HT5BestReadySetupForDirection(dir);
      PyrSignalSource ladderSource=(sponsor>PYR_SOURCE_NONE?(PyrSignalSource)sponsor:PYR_SOURCE_TRIGGER_RAIL_BREAK);
      gMDBurstOverride=true; PyrSignalSource old=gPyrSignalSource; gPyrSignalSource=ladderSource;
      bool opened=PyrTryEntry(dir);
      gPyrSignalSource=old; gMDBurstOverride=false; gMDRLadderEntryOverrideActive=false;
      if(opened)
      {
         if(sponsor>PYR_SOURCE_NONE)
         {
            HT5RegisterFilledSetupSource(sponsor,false);
            gHT5SetupEvent[sponsor].consumed=true;
            gHT5SetupEvent[sponsor].ready=false;
            gHT5SetupEvent[sponsor].state=gHT5SetupEvent[sponsor].label+" SPONSORED R-LADDER STAGE "+IntegerToString(stage);
            gHT5SetupState=gHT5SetupEvent[sponsor].state;
         }
         gMDRLadderStageFilledMask|=bit; gMDRLadderLastFireSerial=gMDRTickSerial;
         gMDRLadderState="R-LADDER "+IntegerToString(stage)+"/"+IntegerToString(maxStages)+" FILLED @ "+DoubleToString(current,Digits)+" | risk $"+DoubleToString(OpenCampaignRiskMoney(),2)+"/$"+DoubleToString(cap,2);
         return true; // one earned grid mutation per tick
      }
      return false;
   }
   return false;
}

string MarketDNAOraclePhaseName()
{
   if(gMDOraclePhase==ORACLE_EXPANSION) return "EXPANSION";
   if(gMDOraclePhase==ORACLE_DISTRIBUTION) return "DISTRIBUTION";
   return "ACCUMULATION";
}

HT_OraclePhase MarketDNAOracleDetectPhase(double atr)
{
   if(atr<=0.0) return ORACLE_ACCUMULATION;
   double hi=iHigh(Symbol(),PERIOD_D1,0),lo=iLow(Symbol(),PERIOD_D1,0);
   RefreshRates(); double midPrice=(Bid+Ask)*0.5;
   double range=hi-lo;
   if(range<=Point) return ORACLE_ACCUMULATION;
   double pos=MDClamp((midPrice-lo)/range,0.0,1.0);
   if(range<atr*2.0 && MathAbs(pos-0.50)<0.20) return ORACLE_ACCUMULATION;
   if(range>=atr*2.0 && (pos>=0.85 || pos<=0.15)) return ORACLE_EXPANSION;
   return ORACLE_DISTRIBUTION;
}

double MarketDNAOracleMicroTrend(double atr)
{
   if(!EnableMarketDNAOracleFusion || atr<=0.0) return 0.0;
   int tf=(int)MarketDNAOracleMicroTF;
   int bars=iBars(Symbol(),tf);
   int lb=MathMax(10,MathMin(MarketDNAOracleMicroLookback,bars-3));
   if(lb<10) return 0.0;
   double atrTF=MathMax(Point,HTExecutionATR(tf,14));
   double newest=iClose(Symbol(),tf,1),oldest=iClose(Symbol(),tf,lb);
   int half=MathMax(2,lb/2);
   double middle=iClose(Symbol(),tf,half);
   double velocity=(newest-oldest)/atrTF;
   double accel=((newest-middle)-(middle-oldest))/atrTF;
   double path=0.0;
   for(int i=1;i<lb;i++) path+=MathAbs(iClose(Symbol(),tf,i)-iClose(Symbol(),tf,i+1));
   double efficiency=(path>Point?MathAbs(newest-oldest)/path:0.0);
   double sign=(velocity>0.0?1.0:(velocity<0.0?-1.0:0.0));
   return MDClamp(0.45*velocity+0.25*accel+0.30*sign*efficiency,-0.75,0.75);
}

bool MarketDNAOracleFindFVG(int dir,double &top,double &bot,int &shift)
{
   top=0.0; bot=0.0; shift=-1;
   int bars=iBars(Symbol(),SignalTF);
   int maxI=MathMin(MathMax(6,MarketDNAOracleFVGLookback),bars-3);
   for(int i=3;i<=maxI;i++)
   {
      double olderH=iHigh(Symbol(),SignalTF,i),olderL=iLow(Symbol(),SignalTF,i);
      double newerH=iHigh(Symbol(),SignalTF,i-2),newerL=iLow(Symbol(),SignalTF,i-2);
      if(dir==DIR_BUY && newerL>olderH)
      { top=newerL; bot=olderH; shift=i-1; return true; }
      if(dir==DIR_SELL && newerH<olderL)
      { top=olderL; bot=newerH; shift=i-1; return true; }
   }
   return false;
}

bool MarketDNAOracleFindOB(int dir,double atr,double &top,double &bot,int &shift)
{
   top=0.0; bot=0.0; shift=-1;
   int bars=iBars(Symbol(),SignalTF);
   int look=MathMax(12,MathMin(MarketDNAOracleOBLookback,bars-15));
   if(look<12) return false;
   double buffer=atr*0.03;
   for(int b=1;b<=MathMin(12,bars-look-3);b++)
   {
      int ex=(dir==DIR_BUY?iHighest(Symbol(),SignalTF,MODE_HIGH,look,b+1):
                              iLowest(Symbol(),SignalTF,MODE_LOW,look,b+1));
      if(ex<0) continue;
      double level=(dir==DIR_BUY?iHigh(Symbol(),SignalTF,ex):iLow(Symbol(),SignalTF,ex));
      double close=iClose(Symbol(),SignalTF,b);
      bool broke=(dir==DIR_BUY?close>level+buffer:close<level-buffer);
      if(!broke) continue;
      for(int k=b+1;k<=MathMin(b+10,bars-2);k++)
      {
         double o=iOpen(Symbol(),SignalTF,k),c=iClose(Symbol(),SignalTF,k);
         bool opposite=(dir==DIR_BUY?c<o:c>o);
         if(opposite)
         { top=iHigh(Symbol(),SignalTF,k); bot=iLow(Symbol(),SignalTF,k); shift=k; return true; }
      }
   }
   return false;
}

double MarketDNAOracleZoneScore(int dir,double atr,double &obTop,double &obBot,double &fvgTop,double &fvgBot)
{
   int os=-1,fs=-1;
   bool hasOB=MarketDNAOracleFindOB(dir,atr,obTop,obBot,os);
   bool hasFVG=MarketDNAOracleFindFVG(dir,fvgTop,fvgBot,fs);
   if(!hasOB && !hasFVG) return 0.0;
   RefreshRates(); double current=(Bid+Ask)*0.5;
   double score=0.0;
   if(hasOB) score+=0.28;
   if(hasFVG) score+=0.24;
   double center=0.0;
   if(hasOB && hasFVG)
   {
      double obMid=(obTop+obBot)*0.5,fvgMid=(fvgTop+fvgBot)*0.5;
      double separation=MathAbs(obMid-fvgMid)/atr;
      double confluence=MathExp(-separation/MathMax(0.05,MarketDNAOracleOBFVGNearATR));
      score+=0.30*confluence;
      center=(obMid+fvgMid)*0.5;
   }
   else center=(hasOB?(obTop+obBot)*0.5:(fvgTop+fvgBot)*0.5);
   double proximity=MathExp(-MathAbs(current-center)/MathMax(atr,Point));
   score+=0.18*proximity;
   return MDClamp(score,0.0,1.0);
}

double MarketDNAOracleOriginConfluence(int dir,int candidateShift,double atr)
{
   if(!EnableMarketDNAOracleFusion || candidateShift<3 || atr<=0.0) return 0.0;
   double o=iOpen(Symbol(),SignalTF,candidateShift),c=iClose(Symbol(),SignalTF,candidateShift);
   double h=iHigh(Symbol(),SignalTF,candidateShift),l=iLow(Symbol(),SignalTF,candidateShift);
   double range=MathMax(Point,h-l);
   bool opposite=(dir==DIR_BUY?c<o:c>o);
   double candleQuality=(opposite?1.0:0.35)*MDClamp(MathAbs(c-o)/range+0.25,0.25,1.0);
   int newest=MathMax(1,candidateShift-8);
   double extreme=(dir==DIR_BUY?h:l);
   for(int k=candidateShift-1;k>=newest;k--)
   {
      if(dir==DIR_BUY) extreme=MathMax(extreme,iHigh(Symbol(),SignalTF,k));
      else extreme=MathMin(extreme,iLow(Symbol(),SignalTF,k));
   }
   double displacement=(dir==DIR_BUY?(extreme-l):(h-extreme))/atr;
   double impulseQuality=MDClamp(displacement/MathMax(0.25,MarketDNATriggerRailMinImpulseATR),0.0,1.0);
   bool fvg=false;
   for(int i=candidateShift;i>=MathMax(3,candidateShift-8);i--)
   {
      if(dir==DIR_BUY && iLow(Symbol(),SignalTF,i-2)>iHigh(Symbol(),SignalTF,i)){ fvg=true; break; }
      if(dir==DIR_SELL && iHigh(Symbol(),SignalTF,i-2)<iLow(Symbol(),SignalTF,i)){ fvg=true; break; }
   }
   return MDClamp(0.40*candleQuality+0.40*impulseQuality+(fvg?0.20:0.0),0.0,1.0);
}

double MarketDNAOraclePatternEvidence(double atr)
{
   if(!EnableMarketDNAOracleFusion || atr<=0.0 || gPyrHigh1<=0.0 || gPyrHigh2<=0.0 || gPyrLow1<=0.0 || gPyrLow2<=0.0) return 0.0;
   double tol=MathMax(0.03,MarketDNAOraclePatternToleranceATR);
   double highGap=MathAbs(gPyrHigh1-gPyrHigh2)/atr;
   double lowGap=MathAbs(gPyrLow1-gPyrLow2)/atr;
   double bear=(highGap<=tol?1.0-highGap/tol:0.0);
   double bull=(lowGap<=tol?1.0-lowGap/tol:0.0);
   return MDClamp(0.35*(bull-bear),-0.35,0.35);
}

int MarketDNAOracleRedContinuation(double atr)
{
   if(!EnableMarketDNAOracleFusion || !MarketDNAOracleRedBreakContinuation || atr<=0.0) return DIR_FLAT;
   int barsNeed=MathMax(1,MathMin(4,MarketDNAOracleRedAcceptanceBars));
   double buffer=atr*MathMax(0.0,MarketDNAOracleRedBreakBufferATR);
   if(gMDChannelResistanceValid)
   {
      bool ok=true;
      for(int k=1;k<=barsNeed;k++) if(iClose(Symbol(),SignalTF,k)<=MarketDNAChannelRailAtShift(false,k)+buffer){ ok=false; break; }
      if(ok && (!EnableMarketDNARhythmDNA || gMDRhythmScore>=MarketDNARhythmLaunchThreshold)) return DIR_BUY;
   }
   if(gMDChannelSupportValid)
   {
      bool ok=true;
      for(int j=1;j<=barsNeed;j++) if(iClose(Symbol(),SignalTF,j)>=MarketDNAChannelRailAtShift(true,j)-buffer){ ok=false; break; }
      if(ok && (!EnableMarketDNARhythmDNA || gMDRhythmScore>=MarketDNARhythmLaunchThreshold)) return DIR_SELL;
   }
   return DIR_FLAT;
}

void MarketDNAOracleUpdateContext(double atr)
{
   if(!EnableMarketDNAOracleFusion)
   {
      gMDOracleMicroTrendATR=0.0; gMDOracleOBFVGATR=0.0; gMDOraclePhaseATR=0.0; gMDOraclePatternATR=0.0;
      gMDOracleDeploymentMultiplier=1.0; gMDOracleState="ORACLE OFF"; gMDOracleRedContinuationDirection=DIR_FLAT; return;
   }
   gMDOraclePhase=MarketDNAOracleDetectPhase(atr);
   datetime bar=iTime(Symbol(),SignalTF,0);
   if(bar>0 && bar!=gMDOracleLastBar)
   {
      gMDOracleLastBar=bar;
      gMDOracleMicroTrendATR=MarketDNAOracleMicroTrend(atr);
      gMDOracleBuyOBFVG=MarketDNAOracleZoneScore(DIR_BUY,atr,gMDOracleBuyOBTop,gMDOracleBuyOBBot,gMDOracleBuyFVGTop,gMDOracleBuyFVGBot);
      gMDOracleSellOBFVG=MarketDNAOracleZoneScore(DIR_SELL,atr,gMDOracleSellOBTop,gMDOracleSellOBBot,gMDOracleSellFVGTop,gMDOracleSellFVGBot);
      gMDOracleOBFVGATR=MDClamp(0.55*(gMDOracleBuyOBFVG-gMDOracleSellOBFVG),-0.55,0.55);
      gMDOraclePatternATR=MarketDNAOraclePatternEvidence(atr);
   }
   int regime=(gMDTriggerRailTrendDirection!=DIR_FLAT?gMDTriggerRailTrendDirection:
              (gMDChannelDirection!=DIR_FLAT?gMDChannelDirection:gPyrTrendDirection));
   double phaseMag=(gMDOraclePhase==ORACLE_EXPANSION?0.20:(gMDOraclePhase==ORACLE_ACCUMULATION?0.05:0.02));
   gMDOraclePhaseATR=(regime==DIR_FLAT?0.0:regime*phaseMag);
   gMDOracleDeploymentMultiplier=(gMDOraclePhase==ORACLE_EXPANSION?MarketDNAOracleExpansionAddMultiplier:
                                  (gMDOraclePhase==ORACLE_ACCUMULATION?MarketDNAOracleAccumulationAddMultiplier:
                                   MarketDNAOracleDistributionAddMultiplier));
   if(gMDTriggerRailBounceDirection!=DIR_FLAT || gMDTriggerRailBreakDirection!=DIR_FLAT)
      gMDOracleDeploymentMultiplier=MathMax(1.0,gMDOracleDeploymentMultiplier);
   gMDOracleRedContinuationDirection=MarketDNAOracleRedContinuation(atr);
   if(gMDOracleRedContinuationDirection!=DIR_FLAT)
   {
      gMDOracleDeploymentMultiplier=MathMax(gMDOracleDeploymentMultiplier,MarketDNAOracleExpansionAddMultiplier);
      gMDOracleRedState=(gMDOracleRedContinuationDirection==DIR_BUY?"RED PEAK ACCEPTED ABOVE | BUY CONTINUATION":"RED PEAK ACCEPTED BELOW | SELL CONTINUATION");
   }
   else gMDOracleRedState="RED PEAK WATCH";
   gMDOracleState=MarketDNAOraclePhaseName()+" | MICRO "+DoubleToString(gMDOracleMicroTrendATR,2)+"A | OB/FVG B"+
                  DoubleToString(gMDOracleBuyOBFVG,2)+" S"+DoubleToString(gMDOracleSellOBFVG,2);
   if(TradeCount()==0){ gMDOraclePeakBasketProfit=0.0; gMDOracleLockedMoney=0.0; gMDOracleRatchetStage=0; }
}

double MarketDNAOracleRatchetStop(int dir,double baseStop)
{
   if(!EnableMarketDNAOracleFusion || !MarketDNAOracleUseEquityRatchet || TradeCount()<=0 || dir==DIR_FLAT) return baseStop;
   double profit=BasketProfit();
   if(profit>gMDOraclePeakBasketProfit) gMDOraclePeakBasketProfit=profit;
   if(gMDOraclePeakBasketProfit<=0.0 || gPyrEntryAnchor<=0.0 || gPyrTarget<=0.0) return baseStop;
   RefreshRates(); double price=(dir==DIR_BUY?Bid:Ask);
   double progress=PyrDirectionalProgress(dir,price)*100.0;
   int stage=0; double secure=0.0;
   if(progress>=MarketDNAOracleRatchetStage1Pct) stage=1;
   if(progress>=MarketDNAOracleRatchetStage2Pct){ stage=2; secure=MarketDNAOracleSecureStage2Pct; }
   if(progress>=MarketDNAOracleRatchetStage3Pct){ stage=3; secure=MarketDNAOracleSecureStage3Pct; }
   gMDOracleRatchetStage=MathMax(gMDOracleRatchetStage,stage);
   if(secure<=0.0) return baseStop;
   double lockMoney=gMDOraclePeakBasketProfit*MDClamp(secure/100.0,0.0,0.95);
   gMDOracleLockedMoney=MathMax(gMDOracleLockedMoney,lockMoney);
   double lots=0.0,cashPerPrice=0.0;
   double tickSize=MathMax(Point,MarketInfo(Symbol(),MODE_TICKSIZE));
   double tickValue=MathMax(0.0,MarketInfo(Symbol(),MODE_TICKVALUE));
   for(int i=OrdersTotal()-1;i>=0;i--)
      if(OrderSelect(i,SELECT_BY_POS,MODE_TRADES) && OurOrder())
      {
         if(dir==DIR_BUY && OrderType()!=OP_BUY) continue;
         if(dir==DIR_SELL && OrderType()!=OP_SELL) continue;
         lots+=OrderLots();
      }
   if(lots<=0.0 || tickValue<=0.0) return baseStop;
   cashPerPrice=tickValue/tickSize*lots;
   if(cashPerPrice<=0.0) return baseStop;
   double avg=PyrAverageOpenPrice(dir);
   double offset=gMDOracleLockedMoney/cashPerPrice;
   double lockStop=(dir==DIR_BUY?avg+offset:avg-offset);
   if(baseStop<=0.0) return lockStop;
   return (dir==DIR_BUY?MathMax(baseStop,lockStop):MathMin(baseStop,lockStop));
}

bool MarketDNAOracleRedContinuationReady(int dir,double atr)
{
   return (EnableMarketDNAOracleFusion && gMDOracleRedContinuationDirection==dir && atr>0.0);
}

double MarketDNATriggerRailAtShift(int shift)
{
   double x=-(double)MathMax(0,shift);
   return gMDTriggerRailIntercept+gMDTriggerRailSlope*x;
}

bool MarketDNABuildTriggerRail(double atr)
{
   gMDTriggerRailValid=false;
   gMDTriggerRailTrendDirection=DIR_FLAT;
   gMDTriggerRailOriginPrice=0.0; gMDTriggerRailPeakPrice=0.0;
   gMDTriggerRailOriginShift=0; gMDTriggerRailPeakShift=0;
   if(!EnableMarketDNAThreeWayChannel || atr<=0.0) return false;

   int bars=iBars(Symbol(),SignalTF);
   int lookback=MathMin(MathMax(40,MarketDNATriggerRailLookbackBars),MathMax(0,bars-10));
   if(lookback<20) return false;

   int dir=gMDChannelDirection;
   if(dir==DIR_FLAT)
   {
      if(gPyrHighTime1>0 && gPyrLowTime1>0)
         dir=(gPyrHighTime1>gPyrLowTime1?DIR_BUY:DIR_SELL);
      else if(gMDChannelSupportSlopeATR100>0.0) dir=DIR_BUY;
      else if(gMDChannelResistanceSlopeATR100<0.0) dir=DIR_SELL;
   }
   if(dir==DIR_FLAT) return false;

   int depth=MathMax(2,(int)PyramidSwingCharacter);
   int extremeShift=-1;
   double extremePrice=0.0;
   if(dir==DIR_BUY)
   {
      extremeShift=(gPyrHighTime1>0?iBarShift(Symbol(),SignalTF,gPyrHighTime1,false):-1);
      extremePrice=gPyrHigh1;
      if(extremeShift<1 || extremeShift>=lookback || extremePrice<=0.0)
      {
         extremeShift=iHighest(Symbol(),SignalTF,MODE_HIGH,MathMin(96,lookback-2),1);
         if(extremeShift>=0) extremePrice=iHigh(Symbol(),SignalTF,extremeShift);
      }
   }
   else
   {
      extremeShift=(gPyrLowTime1>0?iBarShift(Symbol(),SignalTF,gPyrLowTime1,false):-1);
      extremePrice=gPyrLow1;
      if(extremeShift<1 || extremeShift>=lookback || extremePrice<=0.0)
      {
         extremeShift=iLowest(Symbol(),SignalTF,MODE_LOW,MathMin(96,lookback-2),1);
         if(extremeShift>=0) extremePrice=iLow(Symbol(),SignalTF,extremeShift);
      }
   }
   if(extremeShift<1 || extremePrice<=0.0) return false;

   int minSpan=MathMax(2,MarketDNATriggerRailMinSpanBars);
   int maxShift=MathMin(lookback-depth-2,extremeShift+MathMax(30,lookback/2));
   double best=-1.0e100,bestPrice=0.0,bestOracle=0.0; int bestShift=-1;
   for(int s=extremeShift+minSpan;s<=maxShift;s++)
   {
      bool pivot=(dir==DIR_BUY?PyrPivotLow(s,depth):PyrPivotHigh(s,depth));
      if(!pivot) continue;
      double pr=(dir==DIR_BUY?iLow(Symbol(),SignalTF,s):iHigh(Symbol(),SignalTF,s));
      double impulse=(dir==DIR_BUY?(extremePrice-pr):(pr-extremePrice))/atr;
      if(impulse<MathMax(0.10,MarketDNATriggerRailMinImpulseATR)) continue;
      int span=s-extremeShift;
      double recent=2.0/(1.0+(double)span/24.0);
      double oracleOrigin=MarketDNAOracleOriginConfluence(dir,s,atr);
      double score=impulse+recent+MathMax(0.0,MarketDNAOracleOriginWeight)*oracleOrigin;
      if(score>best)
      { best=score; bestPrice=pr; bestShift=s; bestOracle=oracleOrigin; }
   }
   if(bestShift<0 || bestPrice<=0.0)
   {
      int fallbackStart=extremeShift+minSpan;
      int fallbackCount=MathMax(0,maxShift-fallbackStart+1);
      if(fallbackCount>2)
      {
         bestShift=(dir==DIR_BUY?iLowest(Symbol(),SignalTF,MODE_LOW,fallbackCount,fallbackStart):
                                 iHighest(Symbol(),SignalTF,MODE_HIGH,fallbackCount,fallbackStart));
         if(bestShift>=0)
         {
            bestPrice=(dir==DIR_BUY?iLow(Symbol(),SignalTF,bestShift):iHigh(Symbol(),SignalTF,bestShift));
            double fallbackImpulse=(dir==DIR_BUY?(extremePrice-bestPrice):(bestPrice-extremePrice))/atr;
            if(fallbackImpulse<MathMax(0.10,MarketDNATriggerRailMinImpulseATR*0.50))
            { bestShift=-1; bestPrice=0.0; }
            else bestOracle=MarketDNAOracleOriginConfluence(dir,bestShift,atr);
         }
      }
   }
   if(bestShift<0 || bestPrice<=0.0) return false;

   double futureX=(double)MathMax(1,MarketDNAChannelProjectBars);
   double targetPrice=extremePrice;
   if(dir==DIR_BUY && gMDChannelResistanceValid)
      targetPrice=gMDChannelResistanceIntercept+gMDChannelResistanceSlope*futureX;
   else if(dir==DIR_SELL && gMDChannelSupportValid)
      targetPrice=gMDChannelSupportIntercept+gMDChannelSupportSlope*futureX;

   double originX=-(double)bestShift;
   double denom=futureX-originX;
   if(MathAbs(denom)<1.0) return false;
   double slope=(targetPrice-bestPrice)/denom;
   if((dir==DIR_BUY && slope<=0.0) || (dir==DIR_SELL && slope>=0.0)) return false;

   gMDTriggerRailSlope=slope;
   gMDTriggerRailIntercept=bestPrice-slope*originX;
   gMDTriggerRailNow=gMDTriggerRailIntercept;
   gMDTriggerRailOriginPrice=bestPrice;
   gMDTriggerRailPeakPrice=targetPrice;
   gMDOracleOriginConfluence=bestOracle;
   gMDTriggerRailOriginShift=bestShift;
   gMDTriggerRailPeakShift=extremeShift;
   gMDTriggerRailTrendDirection=dir;
   gMDTriggerRailIdentity=iTime(Symbol(),SignalTF,bestShift);
   gMDTriggerRailValid=true;
   gMDTriggerRailTouched=false;
   gMDTriggerRailBreakTicksSeen=0;
   gMDTriggerRailTouchSerial=0;
   gMDTriggerRailBounceExpiresSerial=0;
   gMDTriggerRailState=(dir==DIR_BUY?"BLACK TRIGGER RAIL ARMED | BUY TRIANGLE":"BLACK TRIGGER RAIL ARMED | SELL TRIANGLE");
   return true;
}

void MarketDNAEvaluateTriggerRail(double atr)
{
   gMDTriggerRailBounceDirection=DIR_FLAT;
   gMDTriggerRailApproachDirection=DIR_FLAT;
   if(!EnableMarketDNAThreeWayChannel || !gMDTriggerRailValid || atr<=0.0)
   {
      if(EnableMarketDNAThreeWayChannel) gMDTriggerRailState="TRIGGER RAIL WAITING FOR VALID TRIANGLE";
      gMDTriggerRailBreakDirection=DIR_FLAT;
      return;
   }

   RefreshRates();
   double mid=(Bid+Ask)*0.5;
   double rail=MarketDNATriggerRailAtShift(0);
   gMDTriggerRailNow=rail;
   gMDTriggerRailDistanceATR=MathAbs(mid-rail)/atr;
   double touch=atr*MathMax(0.005,MarketDNATriggerRailTouchATR);
   double reject=atr*MathMax(0.001,MarketDNATriggerRailRejectATR);
   double breakBuf=atr*MathMax(0.005,MarketDNATriggerRailBreakATR);

   int trend=gMDTriggerRailTrendDirection;
   int opposite=-trend;

   if(gMDTriggerRailDistanceATR<=MathMax(MarketDNATriggerRailTouchATR,MarketDNATriggerRailApproachATR))
      gMDTriggerRailApproachDirection=trend;

   // Tick-native touch only: do not reuse an old candle wick for the entire bar.
   bool touchedNow=(MathAbs(mid-rail)<=touch);

   if(touchedNow)
   {
      gMDTriggerRailTouched=true;
      gMDTriggerRailTouchSerial=gMDRTickSerial;
   }
   if(gMDTriggerRailTouched &&
      gMDRTickSerial-gMDTriggerRailTouchSerial>MathMax(2,MarketDNATriggerRailTouchMemoryTicks))
      gMDTriggerRailTouched=false;

   bool beyondBreak=(trend==DIR_BUY ? Bid<rail-breakBuf : Ask>rail+breakBuf);
   if(beyondBreak) gMDTriggerRailBreakTicksSeen++;
   else if(gMDTriggerRailBreakDirection==DIR_FLAT) gMDTriggerRailBreakTicksSeen=0;

   if(gMDTriggerRailBreakTicksSeen>=MathMax(1,MarketDNATriggerRailBreakTicks))
   {
      gMDTriggerRailBreakDirection=opposite;
      gMDTriggerRailBounceExpiresSerial=0;
      gMDTriggerRailTouched=false;
      gMDTriggerRailState=(opposite==DIR_SELL?"BLACK RAIL BROKEN | SONIC SELL EVERY TICK":"BLACK RAIL BROKEN | SONIC BUY EVERY TICK");
   }
   else if(gMDTriggerRailBreakDirection!=DIR_FLAT)
   {
      bool reclaimed=(trend==DIR_BUY ? Bid>rail+touch : Ask<rail-touch);
      if(reclaimed)
      {
         gMDTriggerRailBreakDirection=DIR_FLAT;
         gMDTriggerRailBreakTicksSeen=0;
         gMDTriggerRailState="BLACK RAIL RECLAIMED | WAIT NEXT TOUCH";
      }
   }

   if(gMDTriggerRailBreakDirection==DIR_FLAT && gMDTriggerRailTouched)
   {
      bool rejected=(trend==DIR_BUY ? Bid>=rail+reject : Ask<=rail-reject);
      if(rejected)
      {
         gMDTriggerRailBounceDirection=trend;
         gMDTriggerRailBounceExpiresSerial=gMDRTickSerial+MathMax(2,MarketDNATriggerRailBounceHoldTicks);
         gMDTriggerRailTouched=false;
         gMDTriggerRailState=(trend==DIR_BUY?"BLACK RAIL REJECTED | IMMEDIATE BUY TRANSFER":"BLACK RAIL REJECTED | IMMEDIATE SELL TRANSFER");
      }
   }
   if(gMDTriggerRailBreakDirection==DIR_FLAT &&
      gMDTriggerRailBounceExpiresSerial>gMDRTickSerial)
      gMDTriggerRailBounceDirection=trend;

   if(gMDTriggerRailBreakDirection==DIR_FLAT && gMDTriggerRailBounceDirection==DIR_FLAT)
   {
      if(gMDTriggerRailApproachDirection!=DIR_FLAT)
         gMDTriggerRailState=(trend==DIR_BUY?"BLACK RAIL APPROACH | SELL FIREWALL":"BLACK RAIL APPROACH | BUY FIREWALL");
      else
         gMDTriggerRailState=(trend==DIR_BUY?"BLACK TRIGGER RAIL ARMED | WAIT PULLBACK":"BLACK TRIGGER RAIL ARMED | WAIT RALLY");
   }
}

int MarketDNATriggerRailBounceGate()
{
   if(!EnableMarketDNAThreeWayChannel || gMDTriggerRailBounceDirection==DIR_FLAT) return DIR_FLAT;
   return gMDTriggerRailBounceDirection;
}

int MarketDNATriggerRailBreakGate()
{
   if(!EnableMarketDNAThreeWayChannel || gMDTriggerRailBreakDirection==DIR_FLAT) return DIR_FLAT;
   return gMDTriggerRailBreakDirection;
}

bool MarketDNAChannelBootstrap(bool force)
{
   if(!EnableMarketDNAHistoricalChannels)
   {
      gMDChannelReady=true;
      return true;
   }
   gMDChannelBootstrapAttempts++;
   RefreshRates();
   int bars=iBars(Symbol(),SignalTF);
   if(bars<100)
   {
      gMDChannelReady=false;
      gMDChannelState="CHANNEL INITIALIZING | WAIT HISTORY";
      return false;
   }
   if(force){ gMDChannelLastMapBar=0; gMDChannelLastEvalSerial=-1; }
   MarketDNAUpdateHistoricalChannels();
   MarketDNADrawHistoricalChannels();
   bool baseReady=(gMDChannelSupportValid || gMDChannelResistanceValid);
   bool triggerReady=(!EnableMarketDNAThreeWayChannel || gMDTriggerRailValid);
   bool degraded=(MarketDNAAllowDegradedChannelTrading && bars>=100 && gMDChannelBootstrapAttempts>=MathMax(1,MarketDNAChannelDegradedAfterAttempts));
   gMDChannelReady=((baseReady || degraded) && (!MarketDNARequireTriggerRailReadyBeforeTrading || triggerReady));
   if(gMDChannelReady && baseReady && !triggerReady)
      gMDChannelState="BASE CHANNEL READY | BLACK RAIL BUILDING";
   else if(gMDChannelReady && !baseReady)
      gMDChannelState="CHANNEL DEGRADED | FVG/STRUCTURE EXECUTION ENABLED";
   else if(!gMDChannelReady)
      gMDChannelState=(baseReady?"CHANNEL INITIALIZING | BUILD BLACK TRIGGER RAIL":"CHANNEL INITIALIZING | BUILD HISTORICAL RAILS");
   ChartRedraw(0);
   return gMDChannelReady;
}

void MarketDNADrawTriggerRail()
{
   string line=Pfx()+"MD_CH_TRIGGER",arr=Pfx()+"MD_CH_TRIGGER_ARROW",txt=Pfx()+"MD_CH_TRIGGER_TEXT";
   if(!EnableMarketDNAHistoricalChannels || !EnableMarketDNAThreeWayChannel || !MarketDNAChannelDraw || !gMDTriggerRailValid)
   {
      ObjectDelete(0,line); ObjectDelete(0,arr); ObjectDelete(0,txt); return;
   }
   int sec=MathMax(60,PeriodSeconds(SignalTF));
   datetime originT=iTime(Symbol(),SignalTF,gMDTriggerRailOriginShift);
   datetime future=iTime(Symbol(),SignalTF,0)+sec*MathMax(1,MarketDNAChannelProjectBars);
   double originP=gMDTriggerRailOriginPrice;
   double futureP=gMDTriggerRailIntercept+gMDTriggerRailSlope*(double)MathMax(1,MarketDNAChannelProjectBars);
   color black=C'5,5,5';
   if(ObjectFind(0,line)<0) ObjectCreate(0,line,OBJ_TREND,0,originT,originP,future,futureP);
   ObjectMove(0,line,0,originT,originP); ObjectMove(0,line,1,future,futureP);
   ObjectSetInteger(0,line,OBJPROP_COLOR,black); ObjectSetInteger(0,line,OBJPROP_WIDTH,3);
   ObjectSetInteger(0,line,OBJPROP_RAY_RIGHT,false);
   if(ObjectFind(0,arr)<0) ObjectCreate(0,arr,OBJ_ARROW,0,future,futureP);
   ObjectMove(0,arr,0,future,futureP);
   ObjectSetInteger(0,arr,OBJPROP_ARROWCODE,(gMDTriggerRailTrendDirection==DIR_BUY?233:234));
   ObjectSetInteger(0,arr,OBJPROP_COLOR,black); ObjectSetInteger(0,arr,OBJPROP_WIDTH,3);
   if(ObjectFind(0,txt)<0) ObjectCreate(0,txt,OBJ_TEXT,0,future,futureP);
   ObjectMove(0,txt,0,future,futureP);
   ObjectSetText(txt,"BLACK TRIGGER RAIL | "+(gMDTriggerRailTrendDirection==DIR_BUY?"REJECT=BUY / BREAK=SONIC SELL":"REJECT=SELL / BREAK=SONIC BUY")+
                 " | ORACLE ORIGIN "+DoubleToString(gMDOracleOriginConfluence,2),8,"Arial Bold",black);
}

void MarketDNAUpdateHistoricalChannels()
{
   // v3.16 snapshot law: every subsystem on one tick reads the same channel/ATR state.
   // Bootstrap/new-bar rebuild may reset gMDChannelLastEvalSerial to force a fresh pass.
   if(gMDRTickSerial>0 && gMDChannelLastEvalSerial==gMDRTickSerial) return;
   if(gMDRTickSerial>0) gMDChannelLastEvalSerial=gMDRTickSerial;
   if(!EnableMarketDNAHistoricalChannels)
   {
      gMDChannelDirection=DIR_FLAT; gMDChannelBounceDirection=DIR_FLAT;
      gMDChannelBreakDirection=DIR_FLAT; gMDChannelATR=0.0;
      gMDChannelState="CHANNEL DNA OFF"; return;
   }
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double mapAtr=(LiveATRStableHistoricalMaps?HTStableATR(SignalTF,14):atr);
   datetime bar=iTime(Symbol(),SignalTF,0);
   // Heavy 20K history reconstruction uses completed ATR for stable geometry.
   // Tick calls evaluate rail distance/breaks with the live provisional ATR.
   bool rebuilt=false;
   if(bar>0 && bar!=gMDChannelLastMapBar)
   {
      gMDChannelLastMapBar=bar;
      MarketDNAChannelCollectLevels();
      gMDChannelSupportValid=MarketDNAChannelFindRail(true,mapAtr);
      gMDChannelResistanceValid=MarketDNAChannelFindRail(false,mapAtr);
      if(gMDChannelSupportValid && gMDChannelResistanceValid &&
         gMDChannelSupportNow>=gMDChannelResistanceNow-mapAtr*0.10)
      {
         if(gMDChannelSupportScore>=gMDChannelResistanceScore) gMDChannelResistanceValid=false;
         else gMDChannelSupportValid=false;
      }
      rebuilt=true;
   }
   MarketDNAChannelEvaluateLive(atr);
   MarketDNAOracleUpdateContext(atr);
   if(EnableMarketDNAThreeWayChannel && (rebuilt || !gMDTriggerRailValid))
      MarketDNABuildTriggerRail(rebuilt?mapAtr:atr);
   MarketDNAEvaluateTriggerRail(atr);
   bool liveBaseReady=(gMDChannelSupportValid || gMDChannelResistanceValid);
   bool liveTriggerReady=(!EnableMarketDNAThreeWayChannel || gMDTriggerRailValid);
   bool liveDegraded=(MarketDNAAllowDegradedChannelTrading && iBars(Symbol(),SignalTF)>=100 && gMDChannelBootstrapAttempts>=MathMax(1,MarketDNAChannelDegradedAfterAttempts));
   gMDChannelReady=((liveBaseReady || liveDegraded) && (!MarketDNARequireTriggerRailReadyBeforeTrading || liveTriggerReady));
   if(!gPyrRouteActive && gMDChannelDirection!=DIR_FLAT)
      gPyrTrendDirection=gMDChannelDirection;
}

bool MarketDNAHistoricalChannelAllowsDirection(int dir)
{
   if(!EnableMarketDNAHistoricalChannels || dir==DIR_FLAT) return true;
   // Black trigger rail is the earliest three-way authority.
   if(EnableMarketDNAThreeWayChannel)
   {
      if(gMDTriggerRailBreakDirection!=DIR_FLAT) return (dir==gMDTriggerRailBreakDirection);
      if(gMDTriggerRailBounceDirection!=DIR_FLAT) return (dir==gMDTriggerRailBounceDirection);
      if(gMDTriggerRailApproachDirection!=DIR_FLAT && dir!=gMDTriggerRailApproachDirection) return false;
   }
   // Once a rail is truly broken/accepted, only the accepted break side owns this zone.
   if(gMDChannelBreakDirection!=DIR_FLAT) return (dir==gMDChannelBreakDirection);
   if(MarketDNAChannelBounceHardAuthority)
   {
      // Actual bounce is strongest. Approach zone fires the counter-entry brake early
      // so rapid-fire cannot SELL into rising support while waiting for BUY rhythm.
      if(gMDChannelBounceDirection!=DIR_FLAT) return (dir==gMDChannelBounceDirection);
      if(gMDChannelCompressionZone) return false;
      if(gMDChannelZoneDirection!=DIR_FLAT) return (dir==gMDChannelZoneDirection);
   }
   else if(gMDChannelBounceDirection!=DIR_FLAT && dir!=gMDChannelBounceDirection) return false;
   if(gMDChannelDirection==DIR_BUY && dir==DIR_SELL && !gMDChannelSupportBreakAccepted) return false;
   if(gMDChannelDirection==DIR_SELL && dir==DIR_BUY && !gMDChannelResistanceBreakAccepted) return false;
   return true;
}

bool MarketDNAHistoricalChannelAllowsBOS(int dir)
{
   if(!EnableMarketDNAHistoricalChannels || !MarketDNAChannelVetoCounterBOS) return true;
   return MarketDNAHistoricalChannelAllowsDirection(dir);
}

int MarketDNAHistoricalChannelBreakGate()
{
   if(!EnableMarketDNAHistoricalChannels || gMDChannelBreakDirection==DIR_FLAT || gMDChannelBreakIdentity<=0) return DIR_FLAT;
   if(gMDChannelBreakIdentity==gMDChannelLastUsedBreakIdentity) return DIR_FLAT;
   return gMDChannelBreakDirection;
}

int MarketDNAHistoricalChannelBounceGate()
{
   if(!EnableMarketDNAHistoricalChannels || gMDChannelBounceDirection==DIR_FLAT) return DIR_FLAT;
   if(gMDChannelBreakDirection!=DIR_FLAT && gMDChannelBreakDirection!=gMDChannelBounceDirection) return DIR_FLAT;
   return gMDChannelBounceDirection;
}

void MarketDNADrawHistoricalChannels()
{
   string sup=Pfx()+"MD_CH_SUPPORT",res=Pfx()+"MD_CH_RESIST";
   string supA=Pfx()+"MD_CH_SUPPORT_ARROW",resA=Pfx()+"MD_CH_RESIST_ARROW";
   string supT=Pfx()+"MD_CH_SUPPORT_TEXT",resT=Pfx()+"MD_CH_RESIST_TEXT";
   if(!EnableMarketDNAHistoricalChannels || !MarketDNAChannelDraw)
   {
      ObjectDelete(0,sup); ObjectDelete(0,res); ObjectDelete(0,supA); ObjectDelete(0,resA);
      ObjectDelete(0,supT); ObjectDelete(0,resT); return;
   }
   int sec=MathMax(60,PeriodSeconds(SignalTF));
   datetime now=iTime(Symbol(),SignalTF,0);
   datetime future=now+sec*MathMax(1,MarketDNAChannelProjectBars);

   if(gMDChannelSupportValid)
   {
      datetime oldT=iTime(Symbol(),SignalTF,gMDChannelSupportOldShift);
      double oldP=MarketDNAChannelRailAtShift(true,gMDChannelSupportOldShift);
      double futureP=gMDChannelSupportIntercept+gMDChannelSupportSlope*(double)MathMax(1,MarketDNAChannelProjectBars);
      if(ObjectFind(0,sup)<0) ObjectCreate(0,sup,OBJ_TREND,0,oldT,oldP,future,futureP);
      ObjectMove(0,sup,0,oldT,oldP); ObjectMove(0,sup,1,future,futureP);
      ObjectSetInteger(0,sup,OBJPROP_COLOR,HTGoldBright); ObjectSetInteger(0,sup,OBJPROP_WIDTH,2);
      ObjectSetInteger(0,sup,OBJPROP_RAY_RIGHT,false);
      if(ObjectFind(0,supA)<0) ObjectCreate(0,supA,OBJ_ARROW,0,future,futureP);
      ObjectMove(0,supA,0,future,futureP); ObjectSetInteger(0,supA,OBJPROP_ARROWCODE,(gMDChannelSupportSlope>=0?233:234));
      ObjectSetInteger(0,supA,OBJPROP_COLOR,HTGoldBright); ObjectSetInteger(0,supA,OBJPROP_WIDTH,2);
      if(ObjectFind(0,supT)<0) ObjectCreate(0,supT,OBJ_TEXT,0,future,futureP);
      ObjectMove(0,supT,0,future,futureP);
      ObjectSetText(supT,"SUPPORT CHANNEL | "+IntegerToString(gMDChannelSupportTouches)+" TOUCH | "+
                    DoubleToString(gMDChannelSupportSlopeATR100,2)+" ATR/100",8,"Arial Bold",HTGoldBright);
   }
   else { ObjectDelete(0,sup); ObjectDelete(0,supA); ObjectDelete(0,supT); }

   if(gMDChannelResistanceValid)
   {
      datetime oldT=iTime(Symbol(),SignalTF,gMDChannelResistanceOldShift);
      double oldP=MarketDNAChannelRailAtShift(false,gMDChannelResistanceOldShift);
      double futureP=gMDChannelResistanceIntercept+gMDChannelResistanceSlope*(double)MathMax(1,MarketDNAChannelProjectBars);
      if(ObjectFind(0,res)<0) ObjectCreate(0,res,OBJ_TREND,0,oldT,oldP,future,futureP);
      ObjectMove(0,res,0,oldT,oldP); ObjectMove(0,res,1,future,futureP);
      ObjectSetInteger(0,res,OBJPROP_COLOR,HTAlert); ObjectSetInteger(0,res,OBJPROP_WIDTH,2);
      ObjectSetInteger(0,res,OBJPROP_RAY_RIGHT,false);
      if(ObjectFind(0,resA)<0) ObjectCreate(0,resA,OBJ_ARROW,0,future,futureP);
      ObjectMove(0,resA,0,future,futureP); ObjectSetInteger(0,resA,OBJPROP_ARROWCODE,(gMDChannelResistanceSlope>=0?233:234));
      ObjectSetInteger(0,resA,OBJPROP_COLOR,HTAlert); ObjectSetInteger(0,resA,OBJPROP_WIDTH,2);
      if(ObjectFind(0,resT)<0) ObjectCreate(0,resT,OBJ_TEXT,0,future,futureP);
      ObjectMove(0,resT,0,future,futureP);
      ObjectSetText(resT,"PEAK TP / BREAKOUT CONTINUATION | "+IntegerToString(gMDChannelResistanceTouches)+" TOUCH | "+
                    DoubleToString(gMDChannelResistanceSlopeATR100,2)+" ATR/100",8,"Arial Bold",HTAlert);
   }
   else { ObjectDelete(0,res); ObjectDelete(0,resA); ObjectDelete(0,resT); }
   MarketDNADrawTriggerRail();
}

double MDRhythmElapsedMs(double newerMs,double olderMs)
{
   double d=newerMs-olderMs;
   if(d<0.0) d+=4294967296.0; // GetTickCount() wrap.
   return MathMax(0.0,d);
}

int MDRhythmIndexBack(int back)
{
   if(gMDRTickCount<=0) return 0;
   back=MathMax(0,MathMin(gMDRTickCount-1,back));
   int idx=gMDRTickHead-1-back;
   while(idx<0) idx+=MD_RHYTHM_MAX_TICKS;
   return idx%MD_RHYTHM_MAX_TICKS;
}

void MarketDNARhythmCaptureTick()
{
   if(!EnableMarketDNA || !EnableMarketDNARhythmDNA) return;
   RefreshRates();
   double mid=(Bid+Ask)*0.5;
   if(mid<=0.0) return;
   gMDRTickPrice[gMDRTickHead]=mid;
   gMDRTickMs[gMDRTickHead]=(double)GetTickCount();
   gMDRTickHead=(gMDRTickHead+1)%MD_RHYTHM_MAX_TICKS;
   if(gMDRTickCount<MD_RHYTHM_MAX_TICKS) gMDRTickCount++;
   gMDRTickSerial++;
}

void MarketDNARhythmFinishBurst()
{
   if(gMDRhythmBurstDirection!=DIR_FLAT && gMDRhythmBurstStartTime>0)
   {
      double age=MathMax(0.0,(double)(TimeCurrent()-gMDRhythmBurstStartTime));
      if(age>=2.0 && age<=600.0)
      {
         double alpha=0.12;
         if(gMDRhythmExpectedBurstSeconds<=0.0) gMDRhythmExpectedBurstSeconds=age;
         else gMDRhythmExpectedBurstSeconds=(1.0-alpha)*gMDRhythmExpectedBurstSeconds+alpha*age;
      }
   }
   gMDRhythmBurstDirection=DIR_FLAT;
   gMDRhythmBurstStartTime=0;
   gMDRhythmBurstAgeSeconds=0.0;
}

void MarketDNARhythmStartBurst(int dir)
{
   if(dir==DIR_FLAT) return;
   if(gMDRhythmBurstDirection==dir && gMDRhythmBurstStartTime>0) return;
   MarketDNARhythmFinishBurst();
   gMDRhythmBurstDirection=dir;
   gMDRhythmBurstStartTime=TimeCurrent();
   gMDRhythmBurstAgeSeconds=0.0;
}

void MarketDNARhythmStoreHistory(double outcomeATR)
{
   int i=gMDRhythmHistoryHead;
   gMDRHistFlow[i]=gMDRPendingFlow;
   gMDRHistBias[i]=gMDRPendingBias;
   gMDRHistVelocity[i]=gMDRPendingVelocity;
   gMDRHistAccel[i]=gMDRPendingAccel;
   gMDRHistPullbackQ[i]=gMDRPendingPullbackQ;
   gMDRHistEfficiency[i]=gMDRPendingEfficiency;
   gMDRHistPace[i]=gMDRPendingPace;
   gMDRHistCadence[i]=gMDRPendingCadence;
   gMDRHistMaturity[i]=gMDRPendingMaturity;
   gMDRHistOutcomeATR[i]=MDClamp(outcomeATR,-3.0,3.0);
   gMDRhythmHistoryHead=(gMDRhythmHistoryHead+1)%MD_RHYTHM_MAX_HISTORY;
   if(gMDRhythmHistoryCount<MD_RHYTHM_MAX_HISTORY) gMDRhythmHistoryCount++;
}

double MarketDNARhythmHistoricalPrediction(double f0,double f1,double f2,double f3,double f4,
                                           double f5,double f6,double f7,double f8)
{
   if(gMDRhythmHistoryCount<MathMax(1,MarketDNARhythmHistoryMinSamples)) return 0.0;
   double sigma=MathMax(0.10,MarketDNARhythmSimilaritySigma);
   double denom2=2.0*sigma*sigma;
   double wsum=0.0,ysum=0.0;
   for(int i=0;i<gMDRhythmHistoryCount;i++)
   {
      double d=0.0,z=0.0;
      z=f0-gMDRHistFlow[i]; d+=z*z;
      z=f1-gMDRHistBias[i]; d+=z*z;
      z=f2-gMDRHistVelocity[i]; d+=z*z;
      z=f3-gMDRHistAccel[i]; d+=z*z;
      z=f4-gMDRHistPullbackQ[i]; d+=z*z;
      z=f5-gMDRHistEfficiency[i]; d+=z*z;
      z=f6-gMDRHistPace[i]; d+=z*z;
      z=f7-gMDRHistCadence[i]; d+=z*z;
      z=f8-gMDRHistMaturity[i]; d+=z*z;
      double w=MathExp(-d/denom2);
      wsum+=w; ysum+=w*gMDRHistOutcomeATR[i];
   }
   if(wsum<=0.000001) return 0.0;
   return MDClamp(ysum/wsum,-2.0,2.0);
}

void MarketDNARhythmHistoryStep(int dir,double atr,double mid,
                                double f0,double f1,double f2,double f3,double f4,
                                double f5,double f6,double f7,double f8)
{
   int horizon=MathMax(4,MathMin(128,MarketDNARhythmHistoryHorizonTicks));
   if(gMDRPendingHistory && gMDRTickSerial-gMDRPendingSerial>=horizon)
   {
      if(gMDRPendingATR>0.0 && gMDRPendingDirection!=DIR_FLAT)
      {
         double outcome=gMDRPendingDirection*(mid-gMDRPendingPrice)/gMDRPendingATR;
         MarketDNARhythmStoreHistory(outcome);
      }
      gMDRPendingHistory=false;
   }
   if(!gMDRPendingHistory && dir!=DIR_FLAT && atr>0.0 && gMDRTickCount>=MarketDNARhythmMinimumTicks)
   {
      gMDRPendingHistory=true;
      gMDRPendingSerial=gMDRTickSerial;
      gMDRPendingDirection=dir;
      gMDRPendingPrice=mid;
      gMDRPendingATR=atr;
      gMDRPendingFlow=f0; gMDRPendingBias=f1; gMDRPendingVelocity=f2; gMDRPendingAccel=f3;
      gMDRPendingPullbackQ=f4; gMDRPendingEfficiency=f5; gMDRPendingPace=f6;
      gMDRPendingCadence=f7; gMDRPendingMaturity=f8;
   }
}

void MarketDNARhythmUpdate(int dir,double atr)
{
   if(!EnableMarketDNA || !EnableMarketDNARhythmDNA || atr<=0.0)
   {
      gMDRhythmScore=0.0; gMDRhythmState="RHYTHM DNA OFF"; return;
   }
   int minTicks=MathMax(4,MathMin(MD_RHYTHM_MAX_TICKS,MarketDNARhythmMinimumTicks));
   int window=MathMax(minTicks,MathMin(MD_RHYTHM_MAX_TICKS,MarketDNARhythmTickWindow));
   int n=MathMin(window,gMDRTickCount);
   gMDRhythmTicksUsed=n;
   if(n<minTicks)
   {
      gMDRhythmScore=0.0;
      gMDRhythmState="LISTENING "+IntegerToString(n)+"/"+IntegerToString(minTicks)+" TICKS";
      return;
   }

   int newestIdx=MDRhythmIndexBack(0);
   int oldestIdx=MDRhythmIndexBack(n-1);
   double newest=gMDRTickPrice[newestIdx],oldest=gMDRTickPrice[oldestIdx];
   double totalUp=0.0,totalDown=0.0,totalAbs=0.0,dtSum=0.0,dtSq=0.0;
   int upTicks=0,downTicks=0,dtN=0;
   for(int b=n-2;b>=0;b--)
   {
      int olderIdx=MDRhythmIndexBack(b+1),newerIdx=MDRhythmIndexBack(b);
      double dp=gMDRTickPrice[newerIdx]-gMDRTickPrice[olderIdx];
      if(dp>0.0){ totalUp+=dp; upTicks++; }
      else if(dp<0.0){ totalDown+=-dp; downTicks++; }
      totalAbs+=MathAbs(dp);
      double dt=MDRhythmElapsedMs(gMDRTickMs[newerIdx],gMDRTickMs[olderIdx])/1000.0;
      if(dt>0.0 && dt<60.0){ dtSum+=dt; dtSq+=dt*dt; dtN++; }
   }
   double eps=MathMax(Point,atr*0.000001);
   double flowRaw=(totalUp-totalDown)/(totalUp+totalDown+eps);
   double biasRaw=(double)(upTicks-downTicks)/MathMax(1,upTicks+downTicks);
   double netEff=(newest-oldest)/(totalAbs+eps);
   int velocityTicks=MathMax(2,MathMin(n-1,MarketDNARhythmVelocityTicks));
   int shortOldIdx=MDRhythmIndexBack(velocityTicks);
   double shortSec=MDRhythmElapsedMs(gMDRTickMs[newestIdx],gMDRTickMs[shortOldIdx])/1000.0;
   double shortRate=0.0; // signed ATR per second
   if(shortSec>0.0001) shortRate=((newest-gMDRTickPrice[shortOldIdx])/atr)/shortSec;

   double prevRate=shortRate;
   if(n>velocityTicks+1)
   {
      int prevNew=MDRhythmIndexBack(1),prevOld=MDRhythmIndexBack(velocityTicks+1);
      double prevSec=MDRhythmElapsedMs(gMDRTickMs[prevNew],gMDRTickMs[prevOld])/1000.0;
      if(prevSec>0.0001) prevRate=((gMDRTickPrice[prevNew]-gMDRTickPrice[prevOld])/atr)/prevSec;
   }

   double elapsedSec=MDRhythmElapsedMs(gMDRTickMs[newestIdx],gMDRTickMs[oldestIdx])/1000.0;
   elapsedSec=MathMax(0.001,elapsedSec);
   double paceAbs=(totalAbs/atr)/elapsedSec;
   double paceAlpha=MDClamp(MarketDNARhythmPaceEWMAAlpha,0.001,0.50);
   if(gMDRhythmPaceEWMA<=0.0) gMDRhythmPaceEWMA=MathMax(0.000001,paceAbs);
   else gMDRhythmPaceEWMA=(1.0-paceAlpha)*gMDRhythmPaceEWMA+paceAlpha*MathMax(0.000001,paceAbs);
   double paceRatio=MDClamp(paceAbs/MathMax(0.000001,gMDRhythmPaceEWMA),0.0,3.0);
   // Velocity is normalized by the market's own live absolute pace rather than
   // by candle duration. This prevents ordinary fast ticks from saturating the
   // accelerator simply because the SignalTF bar is several minutes long.
   double velRaw=MDClamp(shortRate/MathMax(0.000001,gMDRhythmPaceEWMA),-3.0,3.0);
   double prevVelRaw=MDClamp(prevRate/MathMax(0.000001,gMDRhythmPaceEWMA),-3.0,3.0);

   double cadence=0.0;
   if(dtN>0)
   {
      double mean=dtSum/dtN;
      double variance=MathMax(0.0,dtSq/dtN-mean*mean);
      double cv=MathSqrt(variance)/MathMax(0.001,mean);
      cadence=1.0/(1.0+cv);
   }

   // Finalize old historical sample even while the spine is temporarily flat.
   if(gMDRPendingHistory && gMDRTickSerial-gMDRPendingSerial>=MathMax(4,MarketDNARhythmHistoryHorizonTicks))
   {
      if(gMDRPendingATR>0.0 && gMDRPendingDirection!=DIR_FLAT)
         MarketDNARhythmStoreHistory(gMDRPendingDirection*(newest-gMDRPendingPrice)/gMDRPendingATR);
      gMDRPendingHistory=false;
   }

   if(dir==DIR_FLAT)
   {
      MarketDNARhythmFinishBurst();
      gMDRhythmFlow=0.0; gMDRhythmTickBias=0.0; gMDRhythmVelocity=0.0;
      gMDRhythmAcceleration=0.0; gMDRhythmPullback=1.0; gMDRhythmEfficiency=0.0;
      gMDRhythmPace=paceRatio; gMDRhythmCadence=cadence; gMDRhythmMaturity=0.0;
      gMDRhythmForce=0.0; gMDRhythmHistoricalATR=0.0; gMDRhythmScore=0.0;
      gMDRhythmState="WAIT DIRECTIONAL SPINE";
      return;
   }

   MarketDNARhythmStartBurst(dir);
   gMDRhythmBurstAgeSeconds=MathMax(0.0,(double)(TimeCurrent()-gMDRhythmBurstStartTime));
   if(gMDRhythmExpectedBurstSeconds<=0.0) gMDRhythmExpectedBurstSeconds=MathMax(5.0,MarketDNARhythmDefaultBurstSeconds);
   double maturity=gMDRhythmBurstAgeSeconds/MathMax(2.0,gMDRhythmExpectedBurstSeconds);

   double flowAlong=dir*flowRaw;
   double biasAlong=dir*biasRaw;
   double velocityAlong=dir*velRaw;
   double accelAlong=dir*(velRaw-prevVelRaw);
   double favorable=(dir==DIR_BUY?totalUp:totalDown);
   double adverse=(dir==DIR_BUY?totalDown:totalUp);
   double pullback=adverse/(favorable+eps);
   double efficiencyAlong=dir*netEff;
   double paceDirectional=paceRatio*MDClamp(flowAlong,-1.0,1.0);
   double pullbackQuality=1.0-MDClamp(pullback/1.25,0.0,1.0);

   // Fingerprint normalized to roughly [-1,1] / [0,1] for similarity search.
   double f0=MDClamp(flowAlong,-1.0,1.0);
   double f1=MDClamp(biasAlong,-1.0,1.0);
   double f2=MDClamp(velocityAlong/3.0,-1.0,1.0);
   double f3=MDClamp(accelAlong/3.0,-1.0,1.0);
   double f4=MDClamp(pullbackQuality,0.0,1.0);
   double f5=MDClamp(efficiencyAlong,-1.0,1.0);
   double f6=MDClamp(paceDirectional/2.0,-1.0,1.0);
   double f7=MDClamp(cadence,0.0,1.0);
   double f8=MDClamp(maturity/2.0,0.0,1.0);

   double history=MarketDNARhythmHistoricalPrediction(f0,f1,f2,f3,f4,f5,f6,f7,f8);
   double force=0.30*f0+0.15*f1+0.25*MDClamp(velocityAlong/2.0,-1.0,1.0)+
                0.15*f5+0.15*MDClamp(paceDirectional/1.50,-1.0,1.0);
   double accelState=MDClamp(accelAlong,-2.0,2.0)*cadence;
   double raw=force*cadence*(0.35+0.65*pullbackQuality)+0.20*accelState+
              MathMax(0.0,MarketDNARhythmHistoryWeight)*MDClamp(history,-1.0,1.0);
   double maturityMod=1.0;
   if(maturity<0.10) maturityMod=0.85;
   if(maturity>1.0 && accelState<0.0)
      maturityMod=1.0/(1.0+0.60*(maturity-1.0));
   else if(maturity>1.0 && accelState>0.0)
      maturityMod=MathMin(1.10,1.0+0.04*(maturity-1.0));
   double score=MDClamp(raw*maturityMod,-2.0,2.0);

   gMDRhythmFlow=f0; gMDRhythmTickBias=f1; gMDRhythmVelocity=velocityAlong;
   gMDRhythmAcceleration=accelAlong; gMDRhythmPullback=MDClamp(pullback,0.0,3.0);
   gMDRhythmEfficiency=f5; gMDRhythmPace=paceRatio; gMDRhythmCadence=cadence;
   gMDRhythmMaturity=maturity; gMDRhythmForce=force; gMDRhythmHistoricalATR=history;
   gMDRhythmScore=score;

   MarketDNARhythmHistoryStep(dir,atr,newest,f0,f1,f2,f3,f4,f5,f6,f7,f8);

   if(score>=MathMax(MarketDNARhythmRapidThreshold,MarketDNARhythmLaunchThreshold))
      gMDRhythmState="TRAIN LEAVING / RAPID FIRE";
   else if(score>=MarketDNARhythmLaunchThreshold)
      gMDRhythmState=(pullback>0.45?"PULLBACK RESOLVING / LAUNCH":"FORCE BUILDING / LAUNCH");
   else if(score>=0.05)
      gMDRhythmState=(pullback>0.65?"BREATHING / PULLBACK":"BREATHING / HOLD");
   else if(score>-0.15)
      gMDRhythmState="STALLING / WAIT";
   else
      gMDRhythmState="RHYTHM AGAINST SPINE";

   // A deeply adverse rhythm ends the current burst clock. Direction stays with
   // the spine; only Inflection+Acceptance can transfer it.
   if(score<-0.20 && pullback>1.0 && gMDRhythmBurstAgeSeconds>2.0)
   {
      MarketDNARhythmFinishBurst();
      MarketDNARhythmStartBurst(dir);
   }
}

bool MarketDNARhythmLaunchReady(int dir)
{
   if(!EnableMarketDNARhythmDNA) return true;
   if(dir==DIR_FLAT || gMDDirectionalDirection!=dir) return false;
   if(gMDRhythmTicksUsed<MathMax(4,MarketDNARhythmMinimumTicks)) return false;
   return gMDRhythmScore>=MathMax(0.0,MarketDNARhythmLaunchThreshold);
}

bool MarketDNARhythmRapidReady(int dir)
{
   if(!EnableMarketDNARhythmDNA) return false;
   if(dir==DIR_FLAT || gMDDirectionalDirection!=dir) return false;
   return gMDRhythmScore>=MathMax(MarketDNARhythmLaunchThreshold,MarketDNARhythmRapidThreshold);
}

bool MarketDNARhythmILBoostActive(int dir)
{
   if(dir==DIR_FLAT || gMDRhythmILBoostDirection!=dir) return false;
   if(gMDRTickSerial-gMDRhythmILBoostStartSerial>MathMax(1,MarketDNAILBoostMaxTicks))
   { gMDRhythmILBoostDirection=DIR_FLAT; return false; }
   if(!MarketDNARhythmLaunchReady(dir))
   { gMDRhythmILBoostDirection=DIR_FLAT; return false; }
   return true;
}

void MarketDNARhythmArmILBoost(int dir)
{
   if(dir==DIR_FLAT) return;
   gMDRhythmILBoostDirection=dir;
   gMDRhythmILBoostStartSerial=gMDRTickSerial;
}

string EvolutionKey(string suffix)
{
   return "HTEVO500_"+IntegerToString(AccountNumber())+"_"+Symbol()+"_"+
          IntegerToString(MagicNumber)+"_"+suffix;
}

string EvolutionErrorName(int e)
{
   if(e==EVO_ERROR_DIRECTION) return "DIRECTION";
   if(e==EVO_ERROR_LOCATION) return "LOCATION";
   if(e==EVO_ERROR_TIMING) return "TIMING";
   if(e==EVO_ERROR_EXPOSURE) return "EXPOSURE";
   return "NONE";
}

void EvolutionDefaults()
{
   gEvoGenome=1; gEvoCampaigns=0; gEvoWins=0; gEvoLosses=0;
   gEvoDirectionLosses=0; gEvoLocationLosses=0; gEvoTimingLosses=0; gEvoExposureLosses=0;
   gEvoCampaignsSincePromotion=0; gEvoLastError=EVO_ERROR_NONE; gEvoFitnessR=0.0; gEvoPromotionFitnessR=0.0;
   gEvoFVGTouchMult=1.0; gEvoQueuedRhythmFloor=MarketDNASignalFVGHardOpposingRhythm;
   gEvoRLadderFirstOffsetR=0.0; gEvoRLadderRiskScale=1.0;
   gEvoStructWeightMult=1.0; gEvoBOSWeightMult=1.0; gEvoPressureWeightMult=1.0; gEvoRouteWeightMult=1.0; gEvoChannelWeightMult=1.0;
   gEvoRollbackAvailable=false; gEvoState="GENOME 1 • OBSERVING"; gEvoLastAutopsy="NONE";
}

void EvolutionSave()
{
   if(!EnableSelfEvolvingGenome || !EvolutionPersistGenome) return;
   GlobalVariableSet(EvolutionKey("GEN"),gEvoGenome); GlobalVariableSet(EvolutionKey("CAMP"),gEvoCampaigns);
   GlobalVariableSet(EvolutionKey("WIN"),gEvoWins); GlobalVariableSet(EvolutionKey("LOSS"),gEvoLosses);
   GlobalVariableSet(EvolutionKey("DL"),gEvoDirectionLosses); GlobalVariableSet(EvolutionKey("LL"),gEvoLocationLosses);
   GlobalVariableSet(EvolutionKey("TL"),gEvoTimingLosses); GlobalVariableSet(EvolutionKey("EL"),gEvoExposureLosses);
   GlobalVariableSet(EvolutionKey("FIT"),gEvoFitnessR); GlobalVariableSet(EvolutionKey("PFIT"),gEvoPromotionFitnessR);
   GlobalVariableSet(EvolutionKey("PCS"),gEvoCampaignsSincePromotion);
   GlobalVariableSet(EvolutionKey("FVGM"),gEvoFVGTouchMult); GlobalVariableSet(EvolutionKey("RFL"),gEvoQueuedRhythmFloor);
   GlobalVariableSet(EvolutionKey("R1"),gEvoRLadderFirstOffsetR); GlobalVariableSet(EvolutionKey("RS"),gEvoRLadderRiskScale);
   GlobalVariableSet(EvolutionKey("WS"),gEvoStructWeightMult); GlobalVariableSet(EvolutionKey("WB"),gEvoBOSWeightMult);
   GlobalVariableSet(EvolutionKey("WP"),gEvoPressureWeightMult); GlobalVariableSet(EvolutionKey("WR"),gEvoRouteWeightMult);
   GlobalVariableSet(EvolutionKey("WC"),gEvoChannelWeightMult);
   GlobalVariableSet(EvolutionKey("RB"),(gEvoRollbackAvailable?1.0:0.0));
   if(gEvoRollbackAvailable)
   {
      GlobalVariableSet(EvolutionKey("PFVGM"),gEvoPrevFVGTouchMult); GlobalVariableSet(EvolutionKey("PRFL"),gEvoPrevQueuedRhythmFloor);
      GlobalVariableSet(EvolutionKey("PR1"),gEvoPrevRLadderFirstOffsetR); GlobalVariableSet(EvolutionKey("PRS"),gEvoPrevRLadderRiskScale);
      GlobalVariableSet(EvolutionKey("PWS"),gEvoPrevStructWeightMult); GlobalVariableSet(EvolutionKey("PWB"),gEvoPrevBOSWeightMult);
      GlobalVariableSet(EvolutionKey("PWP"),gEvoPrevPressureWeightMult); GlobalVariableSet(EvolutionKey("PWR"),gEvoPrevRouteWeightMult);
      GlobalVariableSet(EvolutionKey("PWC"),gEvoPrevChannelWeightMult);
   }
}

void EvolutionLoad()
{
   EvolutionDefaults();
   if(!EnableSelfEvolvingGenome) return;
   if(EvolutionResetGenomeNow)
   {
      string keys[25]={"GEN","CAMP","WIN","LOSS","DL","LL","TL","EL","FIT","PFIT","PCS","FVGM","RFL","R1","RS","WS","WB","WP","WR","WC","RB","PFVGM","PRFL","PR1","PRS"};
      for(int i=0;i<25;i++) GlobalVariableDel(EvolutionKey(keys[i]));
      GlobalVariableDel(EvolutionKey("PWS")); GlobalVariableDel(EvolutionKey("PWB")); GlobalVariableDel(EvolutionKey("PWP"));
      GlobalVariableDel(EvolutionKey("PWR")); GlobalVariableDel(EvolutionKey("PWC"));
      return;
   }
   if(GlobalVariableCheck(EvolutionKey("GEN"))) gEvoGenome=MathMax(1,(int)GlobalVariableGet(EvolutionKey("GEN")));
   if(GlobalVariableCheck(EvolutionKey("CAMP"))) gEvoCampaigns=MathMax(0,(int)GlobalVariableGet(EvolutionKey("CAMP")));
   if(GlobalVariableCheck(EvolutionKey("WIN"))) gEvoWins=MathMax(0,(int)GlobalVariableGet(EvolutionKey("WIN")));
   if(GlobalVariableCheck(EvolutionKey("LOSS"))) gEvoLosses=MathMax(0,(int)GlobalVariableGet(EvolutionKey("LOSS")));
   if(GlobalVariableCheck(EvolutionKey("DL"))) gEvoDirectionLosses=MathMax(0,(int)GlobalVariableGet(EvolutionKey("DL")));
   if(GlobalVariableCheck(EvolutionKey("LL"))) gEvoLocationLosses=MathMax(0,(int)GlobalVariableGet(EvolutionKey("LL")));
   if(GlobalVariableCheck(EvolutionKey("TL"))) gEvoTimingLosses=MathMax(0,(int)GlobalVariableGet(EvolutionKey("TL")));
   if(GlobalVariableCheck(EvolutionKey("EL"))) gEvoExposureLosses=MathMax(0,(int)GlobalVariableGet(EvolutionKey("EL")));
   if(GlobalVariableCheck(EvolutionKey("FIT"))) gEvoFitnessR=GlobalVariableGet(EvolutionKey("FIT"));
   if(GlobalVariableCheck(EvolutionKey("PFIT"))) gEvoPromotionFitnessR=GlobalVariableGet(EvolutionKey("PFIT"));
   if(GlobalVariableCheck(EvolutionKey("PCS"))) gEvoCampaignsSincePromotion=MathMax(0,(int)GlobalVariableGet(EvolutionKey("PCS")));
   if(GlobalVariableCheck(EvolutionKey("FVGM"))) gEvoFVGTouchMult=GlobalVariableGet(EvolutionKey("FVGM"));
   if(GlobalVariableCheck(EvolutionKey("RFL"))) gEvoQueuedRhythmFloor=GlobalVariableGet(EvolutionKey("RFL"));
   if(GlobalVariableCheck(EvolutionKey("R1"))) gEvoRLadderFirstOffsetR=GlobalVariableGet(EvolutionKey("R1"));
   if(GlobalVariableCheck(EvolutionKey("RS"))) gEvoRLadderRiskScale=GlobalVariableGet(EvolutionKey("RS"));
   if(GlobalVariableCheck(EvolutionKey("WS"))) gEvoStructWeightMult=GlobalVariableGet(EvolutionKey("WS"));
   if(GlobalVariableCheck(EvolutionKey("WB"))) gEvoBOSWeightMult=GlobalVariableGet(EvolutionKey("WB"));
   if(GlobalVariableCheck(EvolutionKey("WP"))) gEvoPressureWeightMult=GlobalVariableGet(EvolutionKey("WP"));
   if(GlobalVariableCheck(EvolutionKey("WR"))) gEvoRouteWeightMult=GlobalVariableGet(EvolutionKey("WR"));
   if(GlobalVariableCheck(EvolutionKey("WC"))) gEvoChannelWeightMult=GlobalVariableGet(EvolutionKey("WC"));
   gEvoRollbackAvailable=(GlobalVariableCheck(EvolutionKey("RB")) && GlobalVariableGet(EvolutionKey("RB"))>0.5);
   if(gEvoRollbackAvailable)
   {
      if(GlobalVariableCheck(EvolutionKey("PFVGM"))) gEvoPrevFVGTouchMult=GlobalVariableGet(EvolutionKey("PFVGM"));
      if(GlobalVariableCheck(EvolutionKey("PRFL"))) gEvoPrevQueuedRhythmFloor=GlobalVariableGet(EvolutionKey("PRFL"));
      if(GlobalVariableCheck(EvolutionKey("PR1"))) gEvoPrevRLadderFirstOffsetR=GlobalVariableGet(EvolutionKey("PR1"));
      if(GlobalVariableCheck(EvolutionKey("PRS"))) gEvoPrevRLadderRiskScale=GlobalVariableGet(EvolutionKey("PRS"));
      if(GlobalVariableCheck(EvolutionKey("PWS"))) gEvoPrevStructWeightMult=GlobalVariableGet(EvolutionKey("PWS"));
      if(GlobalVariableCheck(EvolutionKey("PWB"))) gEvoPrevBOSWeightMult=GlobalVariableGet(EvolutionKey("PWB"));
      if(GlobalVariableCheck(EvolutionKey("PWP"))) gEvoPrevPressureWeightMult=GlobalVariableGet(EvolutionKey("PWP"));
      if(GlobalVariableCheck(EvolutionKey("PWR"))) gEvoPrevRouteWeightMult=GlobalVariableGet(EvolutionKey("PWR"));
      if(GlobalVariableCheck(EvolutionKey("PWC"))) gEvoPrevChannelWeightMult=GlobalVariableGet(EvolutionKey("PWC"));
   }
   gEvoState="GENOME "+IntegerToString(gEvoGenome)+" • LOADED";
}

double EvolutionFVGTouchMultiplier(){ return (EnableSelfEvolvingGenome?MDClamp(gEvoFVGTouchMult,EvolutionMinFVGTouchMultiplier,EvolutionMaxFVGTouchMultiplier):1.0); }
double EvolutionQueuedRhythmFloor(){ return (EnableSelfEvolvingGenome?MathMin(EvolutionMaxQueuedRhythmFloor,gEvoQueuedRhythmFloor):MarketDNASignalFVGHardOpposingRhythm); }
double EvolutionRLadderFirstR(){ return MathMax(0.03,MarketDNARLadderFirstStageR+(EnableSelfEvolvingGenome?gEvoRLadderFirstOffsetR:0.0)); }
double EvolutionRLadderRiskScale()
{
   double evo=(EnableSelfEvolvingGenome?MDClamp(gEvoRLadderRiskScale,EvolutionMinRLadderRiskScale,1.0):1.0);
   return MDClamp(evo*gHT5RiskReuseScale,MathMax(0.40,EvolutionMinRLadderRiskScale),1.0);
}

void EvolutionCaptureSeed(int dir,double entry,double stop,double target)
{
   if(!EnableSelfEvolvingGenome || dir==DIR_FLAT || gEvoCampaignActive) return;
   gEvoCampaignActive=true; gEvoCampaignStartTime=TimeCurrent(); gEvoCampaignDirection=dir;
   gEvoCampaignEntry=entry; gEvoCampaignStop=stop; gEvoCampaignTarget=target;
   gEvoCampaignRiskMoney=MathMax(0.01,OrderRiskMoneyFromPrices(entry,stop,MathMax(MarketInfo(Symbol(),MODE_MINLOT),0.01)));
   double selected=SelectedRiskMoney(); if(selected>0.0) gEvoCampaignRiskMoney=selected;
   gEvoEntryRhythm=gMDRhythmScore; gEvoEntryChannel=gMDChannelATR; gEvoEntrySpine=gMDDirectionalSpineATR;
   gEvoEntryPressure=gMDPressureATR; gEvoEntryDayPos=gMDDayRangePosition;
   double span=MathMax(Point,gMDFVGTop-gMDFVGBot);
   gEvoEntryFVGDepth=(dir==DIR_BUY?(gMDFVGTop-entry)/span:(entry-gMDFVGBot)/span);
   gEvoEntryFVGDepth=MDClamp(gEvoEntryFVGDepth,0.0,1.0);
   HT5CaptureEntryOrganSnapshot();
   HT5CaptureEntrySubunits();
   gEvoMaxFavorableR=0.0; gEvoMaxAdverseR=0.0; gEvoPeakCars=MathMax(1,TradeCount());
}

void EvolutionTrackCampaign()
{
   if(!EnableSelfEvolvingGenome || !gEvoCampaignActive || gEvoCampaignDirection==DIR_FLAT || gEvoCampaignEntry<=0.0) return;
   RefreshRates(); double mid=(Bid+Ask)*0.5; double R=MathMax(Point,MathAbs(gEvoCampaignEntry-gEvoCampaignStop));
   double move=gEvoCampaignDirection*(mid-gEvoCampaignEntry)/R;
   if(move>gEvoMaxFavorableR) gEvoMaxFavorableR=move;
   if(-move>gEvoMaxAdverseR) gEvoMaxAdverseR=-move;
   gEvoPeakCars=MathMax(gEvoPeakCars,TradeCountByDirection(gEvoCampaignDirection));
}

double EvolutionClosedCampaignNet()
{
   if(gEvoCampaignStartTime<=0) return 0.0;
   double net=0.0;
   for(int i=OrdersHistoryTotal()-1;i>=0;i--)
   {
      if(!OrderSelect(i,SELECT_BY_POS,MODE_HISTORY)) continue;
      if(OrderSymbol()!=Symbol() || OrderMagicNumber()!=MagicNumber) continue;
      if(OrderType()!=OP_BUY && OrderType()!=OP_SELL) continue;
      if(OrderCloseTime()<gEvoCampaignStartTime) continue;
      net+=OrderProfit()+OrderSwap()+OrderCommission();
   }
   return net;
}

int EvolutionClassifyLoss()
{
   int dir=gEvoCampaignDirection;
   bool oppositeNow=(dir==DIR_BUY?(gMDTriggerRailBreakDirection==DIR_SELL || gMDChannelBreakDirection==DIR_SELL):
                                  (gMDTriggerRailBreakDirection==DIR_BUY || gMDChannelBreakDirection==DIR_BUY));
   if(oppositeNow || dir*gEvoEntryChannel<-0.08 || dir*gEvoEntrySpine<-0.08) return EVO_ERROR_DIRECTION;
   if(gEvoPeakCars>=3 && gEvoMaxFavorableR>=0.12) return EVO_ERROR_EXPOSURE;
   if(dir*gEvoEntryRhythm<0.02 || dir*gEvoEntryPressure<0.0 || gEvoMaxFavorableR<0.08) return EVO_ERROR_TIMING;
   return EVO_ERROR_LOCATION;
}

void EvolutionSnapshotPrevious()
{
   gEvoPrevFVGTouchMult=gEvoFVGTouchMult; gEvoPrevQueuedRhythmFloor=gEvoQueuedRhythmFloor;
   gEvoPrevRLadderFirstOffsetR=gEvoRLadderFirstOffsetR; gEvoPrevRLadderRiskScale=gEvoRLadderRiskScale;
   gEvoPrevStructWeightMult=gEvoStructWeightMult; gEvoPrevBOSWeightMult=gEvoBOSWeightMult;
   gEvoPrevPressureWeightMult=gEvoPressureWeightMult; gEvoPrevRouteWeightMult=gEvoRouteWeightMult; gEvoPrevChannelWeightMult=gEvoChannelWeightMult;
   gEvoPromotionFitnessR=gEvoFitnessR; gEvoRollbackAvailable=true; gEvoCampaignsSincePromotion=0;
}

void EvolutionMutate(int cls)
{
   if(!EnableSelfEvolvingGenome) return;
   double m=MDClamp(EvolutionMutationRate,0.005,0.20);
   EvolutionSnapshotPrevious();
   if(cls==EVO_ERROR_DIRECTION)
   {
      gEvoChannelWeightMult=MDClamp(gEvoChannelWeightMult+m,0.80,EvolutionMaxChannelWeightMultiplier);
      gEvoPressureWeightMult=MDClamp(gEvoPressureWeightMult-m*0.60,EvolutionMinPressureWeightMultiplier,1.20);
   }
   else if(cls==EVO_ERROR_LOCATION)
      gEvoFVGTouchMult=MDClamp(gEvoFVGTouchMult-m*1.5,EvolutionMinFVGTouchMultiplier,EvolutionMaxFVGTouchMultiplier);
   else if(cls==EVO_ERROR_TIMING)
      gEvoQueuedRhythmFloor=MathMin(EvolutionMaxQueuedRhythmFloor,gEvoQueuedRhythmFloor+m*0.60);
   else if(cls==EVO_ERROR_EXPOSURE)
   {
      gEvoRLadderFirstOffsetR=MathMin(EvolutionMaxRLadderFirstStageOffsetR,gEvoRLadderFirstOffsetR+m*0.50);
      gEvoRLadderRiskScale=MathMax(EvolutionMinRLadderRiskScale,gEvoRLadderRiskScale-m);
   }
   gEvoGenome++; gEvoCampaignsSincePromotion=0;
   if(cls==EVO_ERROR_DIRECTION) gEvoDirectionLosses=0;
   if(cls==EVO_ERROR_LOCATION) gEvoLocationLosses=0;
   if(cls==EVO_ERROR_TIMING) gEvoTimingLosses=0;
   if(cls==EVO_ERROR_EXPOSURE) gEvoExposureLosses=0;
   gEvoState="GENOME "+IntegerToString(gEvoGenome)+" • PROMOTED "+EvolutionErrorName(cls)+" MUTATION";
   EvolutionSave();
}

void EvolutionRollback()
{
   if(!gEvoRollbackAvailable) return;
   HT5RollbackGenes();
   gEvoFVGTouchMult=gEvoPrevFVGTouchMult; gEvoQueuedRhythmFloor=gEvoPrevQueuedRhythmFloor;
   gEvoRLadderFirstOffsetR=gEvoPrevRLadderFirstOffsetR; gEvoRLadderRiskScale=gEvoPrevRLadderRiskScale;
   gEvoStructWeightMult=gEvoPrevStructWeightMult; gEvoBOSWeightMult=gEvoPrevBOSWeightMult;
   gEvoPressureWeightMult=gEvoPrevPressureWeightMult; gEvoRouteWeightMult=gEvoPrevRouteWeightMult; gEvoChannelWeightMult=gEvoPrevChannelWeightMult;
   gEvoGenome++; gEvoRollbackAvailable=false; gEvoCampaignsSincePromotion=0;
   gEvoState="GENOME "+IntegerToString(gEvoGenome)+" • ROLLBACK";
   EvolutionSave();
}

void EvolutionResolveCampaign()
{
   if(!EnableSelfEvolvingGenome || !gEvoCampaignActive) return;
   double net=EvolutionClosedCampaignNet();
   double risk=MathMax(0.01,gEvoCampaignRiskMoney); double r=net/risk;
   double a=MDClamp(EvolutionFitnessAlpha,0.02,0.50);
   if(gEvoCampaigns==0) gEvoFitnessR=r; else gEvoFitnessR=(1.0-a)*gEvoFitnessR+a*r;
   gEvoCampaigns++; gEvoCampaignsSincePromotion++;
   if(net>0.0){ gEvoWins++; gEvoLastError=EVO_ERROR_NONE; gEvoLastAutopsy="WIN "+DoubleToString(r,2)+"R"; }
   else if(net<0.0)
   {
      gEvoLosses++; int cls=EvolutionClassifyLoss(); gEvoLastError=cls;
      if(cls==EVO_ERROR_DIRECTION) gEvoDirectionLosses++;
      if(cls==EVO_ERROR_LOCATION) gEvoLocationLosses++;
      if(cls==EVO_ERROR_TIMING) gEvoTimingLosses++;
      if(cls==EVO_ERROR_EXPOSURE) gEvoExposureLosses++;
      gEvoLastAutopsy="LOSS "+DoubleToString(r,2)+"R • "+EvolutionErrorName(cls)+" • MFE "+DoubleToString(gEvoMaxFavorableR,2)+"R / MAE "+DoubleToString(gEvoMaxAdverseR,2)+"R";
      int need=MathMax(2,EvolutionSimilarLossesForMutation);
      if(gEvoCampaigns>=MathMax(need,EvolutionMinimumCampaignsBeforeMutation))
      {
         int count=(cls==EVO_ERROR_DIRECTION?gEvoDirectionLosses:(cls==EVO_ERROR_LOCATION?gEvoLocationLosses:(cls==EVO_ERROR_TIMING?gEvoTimingLosses:gEvoExposureLosses)));
         if(count>=need) EvolutionMutate(cls);
      }
   }
   HT5AutopsyResolvedCampaign(net,r,gEvoLastError);
   HT5DeepOnCampaignResolved(net,r,gEvoLastError);
   if(gEvoRollbackAvailable && gEvoCampaignsSincePromotion>=MathMax(3,EvolutionRollbackWindowCampaigns) &&
      gEvoFitnessR<gEvoPromotionFitnessR-MathMax(0.05,EvolutionRollbackFitnessDropR)) EvolutionRollback();
   else { gEvoState="GENOME "+IntegerToString(gEvoGenome)+" • "+gEvoLastAutopsy; EvolutionSave(); }
   gEvoCampaignActive=false; gEvoCampaignStartTime=0; gEvoCampaignDirection=DIR_FLAT;
}

string MarketDNAKey(string suffix)
{
   return "HTMD500_"+IntegerToString(AccountNumber())+"_"+Symbol()+"_"+
          IntegerToString(MagicNumber)+"_"+suffix;
}

void MarketDNASave()
{
   if(!EnableMarketDNA) return;
   for(int i=0;i<MD_BASE_FEATURES;i++) GlobalVariableSet(MarketDNAKey("W"+IntegerToString(i)),gMDWeight[i]);
   GlobalVariableSet(MarketDNAKey("ERRVAR"),gMDErrorVariance);
   GlobalVariableSet(MarketDNAKey("AE"),gMDExpectedAdverseATR);
   GlobalVariableSet(MarketDNAKey("RPACE"),gMDRhythmPaceEWMA);
   GlobalVariableSet(MarketDNAKey("RBURST"),gMDRhythmExpectedBurstSeconds);
   GlobalVariableSet(MarketDNAKey("LPDIR"),(double)gMDLimitPlanDirection);
   GlobalVariableSet(MarketDNAKey("LPCYCLE"),(double)gMDLimitPlanCycle);
   for(int l=0;l<4;l++) GlobalVariableSet(MarketDNAKey("LPC"+IntegerToString(l)),(double)gMDLimitPlannedCars[l]);
}

void MarketDNALoad()
{
   for(int i=0;i<MD_BASE_FEATURES;i++) gMDWeight[i]=0.0;
   for(int l=0;l<4;l++) gMDLimitPlannedCars[l]=0;
   gMDLimitPlanDirection=DIR_FLAT; gMDLimitPlanCycle=0;
   gMDErrorVariance=0.0625;
   gMDExpectedAdverseATR=0.35;
   if(!EnableMarketDNA) return;
   if(MarketDNAResetLearningNow)
   {
      for(int j=0;j<MD_BASE_FEATURES;j++) GlobalVariableDel(MarketDNAKey("W"+IntegerToString(j)));
      GlobalVariableDel(MarketDNAKey("ERRVAR"));
      GlobalVariableDel(MarketDNAKey("AE"));
      GlobalVariableDel(MarketDNAKey("RPACE"));
      GlobalVariableDel(MarketDNAKey("RBURST"));
      GlobalVariableDel(MarketDNAKey("LPDIR"));
      GlobalVariableDel(MarketDNAKey("LPCYCLE"));
      for(int r=0;r<4;r++) GlobalVariableDel(MarketDNAKey("LPC"+IntegerToString(r)));
      return;
   }
   for(int k=0;k<MD_BASE_FEATURES;k++)
      if(GlobalVariableCheck(MarketDNAKey("W"+IntegerToString(k))))
         gMDWeight[k]=GlobalVariableGet(MarketDNAKey("W"+IntegerToString(k)));
   if(GlobalVariableCheck(MarketDNAKey("ERRVAR"))) gMDErrorVariance=MathMax(0.0001,GlobalVariableGet(MarketDNAKey("ERRVAR")));
   if(GlobalVariableCheck(MarketDNAKey("AE"))) gMDExpectedAdverseATR=MathMax(0.01,GlobalVariableGet(MarketDNAKey("AE")));
   if(GlobalVariableCheck(MarketDNAKey("RPACE"))) gMDRhythmPaceEWMA=MathMax(0.0,GlobalVariableGet(MarketDNAKey("RPACE")));
   if(GlobalVariableCheck(MarketDNAKey("RBURST"))) gMDRhythmExpectedBurstSeconds=MathMax(2.0,GlobalVariableGet(MarketDNAKey("RBURST")));
   else gMDRhythmExpectedBurstSeconds=MathMax(2.0,MarketDNARhythmDefaultBurstSeconds);
   if(GlobalVariableCheck(MarketDNAKey("LPDIR"))) gMDLimitPlanDirection=(int)GlobalVariableGet(MarketDNAKey("LPDIR"));
   if(GlobalVariableCheck(MarketDNAKey("LPCYCLE"))) gMDLimitPlanCycle=(int)GlobalVariableGet(MarketDNAKey("LPCYCLE"));
   for(int q=0;q<4;q++)
      if(GlobalVariableCheck(MarketDNAKey("LPC"+IntegerToString(q))))
         gMDLimitPlannedCars[q]=MathMax(0,(int)GlobalVariableGet(MarketDNAKey("LPC"+IntegerToString(q))));
}

bool MarketDNAPendingSelected()
{
   if(OrderSymbol()!=Symbol() || OrderMagicNumber()!=MagicNumber) return false;
   int t=OrderType();
   return (t==OP_BUYLIMIT || t==OP_SELLLIMIT);
}

int MarketDNAPendingCountByDirection(int dir)
{
   int n=0;
   for(int i=OrdersTotal()-1;i>=0;i--)
      if(OrderSelect(i,SELECT_BY_POS,MODE_TRADES) && MarketDNAPendingSelected())
      {
         if(dir==DIR_BUY && OrderType()==OP_BUYLIMIT) n++;
         if(dir==DIR_SELL && OrderType()==OP_SELLLIMIT) n++;
      }
   return n;
}

double MarketDNAPendingLotsByDirection(int dir)
{
   double lots=0.0;
   for(int i=OrdersTotal()-1;i>=0;i--)
      if(OrderSelect(i,SELECT_BY_POS,MODE_TRADES) && MarketDNAPendingSelected())
      {
         if(dir==DIR_BUY && OrderType()==OP_BUYLIMIT) lots+=OrderLots();
         if(dir==DIR_SELL && OrderType()==OP_SELLLIMIT) lots+=OrderLots();
      }
   return lots;
}

double MarketDNAPendingRiskMoney()
{
   double risk=0.0;
   for(int i=OrdersTotal()-1;i>=0;i--)
      if(OrderSelect(i,SELECT_BY_POS,MODE_TRADES) && MarketDNAPendingSelected())
      {
         if(OrderStopLoss()<=0.0) return AccountRiskBase()*100.0;
         risk+=OrderRiskMoneyFromPrices(OrderOpenPrice(),OrderStopLoss(),OrderLots());
      }
   return risk;
}

void MarketDNAResetLimitPlanMemory()
{
   gMDLimitPlanDirection=DIR_FLAT;
   gMDLimitPlanCycle=0;
   for(int l=0;l<4;l++)
   {
      gMDLimitPlannedCars[l]=0;
      gMDPulseAnchorPrice[l]=0.0;
      gMDPulseCenterPrice[l]=0.0;
      gMDPulseStrength[l]=0.0;
      gMDPulseLastModifySerial[l]=0;
   }
   gMDPulseState="PULSE GROW RESET";
}

void MarketDNADeletePendingLimits(string reason)
{
   if(!EnableMarketDNA) return;
   for(int pass=0;pass<2;pass++)
      for(int i=OrdersTotal()-1;i>=0;i--)
         if(OrderSelect(i,SELECT_BY_POS,MODE_TRADES) && MarketDNAPendingSelected())
         {
            int ticket=OrderTicket();
            if(!HT5CommanderOrderDelete(ticket,clrNONE))
               Print("MARKET DNA pending delete retry ticket=",ticket," err=",GetLastError()," reason=",reason);
         }
   // v3.09: deletes also occur when the historical rail firewall invalidates the pending side.
   // Reset the consumed-level memory so the next campaign may build a fresh plan.
   MarketDNAResetLimitPlanMemory();
   if(StringFind(reason,"TARGET")>=0 || StringFind(reason,"CAMPAIGN")>=0 || StringFind(reason,"REVERSAL")>=0 ||
      StringFind(reason,"EMERGENCY")>=0 || StringFind(reason,"REBASE")>=0)
      MarketDNAResetSonicPlugBurst("BOUNDARY");
   MarketDNASave();
}

int MarketDNACarCeiling()
{
   if(EnableCompoundStaircase && AccountBalance()<=MathMax(1.0,MicroAccountThreshold))
      return MathMax(1,MathMin(MathMin(20,MarketDNAMaxCars),MicroMaximumSimultaneousCars));
   return MathMax(1,MathMin(20,MarketDNAMaxCars));
}

double MarketDNAEntryRiskFraction(bool first)
{
   if(!EnableMarketDNA || !MarketDNASplitCampaignRiskAcrossCars) return 1.0;
   // v3.03: the anchor entry always receives the user's selected ATR risk.
   // v3.00 divided the first order across all 20 possible cars, which could
   // push XAUUSD below the broker's 0.01 minimum and deadlock DesiredCars at zero.
   if(first || TradeCount()==0) return 1.0;

   int carsRemaining=MathMax(1,MarketDNACarCeiling()-TradeCount());
   double perEntryPct=MathMax(0.01,SovereignOxRiskPercent());
   double capMoney=AccountRiskBase()*MaximumCampaignRiskPercent/100.0;
   double remainingMoney=MathMax(0.0,capMoney-OpenCampaignRiskMoney()-MarketDNAPendingRiskMoney());
   double selectedMoney=MathMax(0.01,AccountRiskBase()*perEntryPct/100.0);
   double sharedMoney=remainingMoney/MathMax(1,carsRemaining);
   double fraction=sharedMoney/selectedMoney;
   // Add-ons share the remaining campaign budget, but never exceed the user's
   // selected per-entry risk. The campaign cap remains the hard redline.
   return MDClamp(fraction,0.05,1.0);
}

double MarketDNABaseLotForDirection(int dir)
{
   if(dir==DIR_FLAT) return 0.0;
   RefreshRates();
   double price=(dir==DIR_BUY?Ask:Bid);
   double stop=SelectedStopPrice(dir,price);
   return CalculateRiskLot(price,stop,MarketDNAEntryRiskFraction(TradeCount()==0),false,false);
}

double MarketDNASafeTotalLots(int dir)
{
   if(dir==DIR_FLAT) return 0.0;
   RefreshRates();
   double price=(dir==DIR_BUY?Ask:Bid);
   double stop=SelectedStopPrice(dir,price);
   double lossPerLot=CashLossPerLot(price,stop);
   if(lossPerLot<=0.0) return TotalLots();
   double cap=AccountRiskBase()*MaximumCampaignRiskPercent/100.0;
   double used=OpenCampaignRiskMoney()+MarketDNAPendingRiskMoney();
   double remaining=MathMax(0.0,cap-used);
   double pendingLots=MarketDNAPendingLotsByDirection(dir);
   double current=LotsByDirection(dir)+pendingLots;
   return current+remaining/lossPerLot;
}

double MarketDNAFeatureStructure(double atr)
{
   if(gPyrHigh1<=0.0 || gPyrLow1<=0.0 || atr<=0.0) return 0.0;
   double dh=(gPyrHigh2>0.0 ? (gPyrHigh1-gPyrHigh2)/atr : 0.0);
   double dl=(gPyrLow2>0.0 ? (gPyrLow1-gPyrLow2)/atr : 0.0);
   double structural=0.50*(dh+dl);
   if(gPyrHighClass=="HH" && gPyrLowClass=="HL") structural+=0.15;
   if(gPyrHighClass=="LH" && gPyrLowClass=="LL") structural-=0.15;
   return MDClamp(structural,-1.50,1.50);
}

double MarketDNAFeatureBOS(double atr)
{
   if(atr<=0.0) return 0.0;
   double o=iOpen(Symbol(),SignalTF,1),c=iClose(Symbol(),SignalTF,1);
   double h=iHigh(Symbol(),SignalTF,1),l=iLow(Symbol(),SignalTF,1);
   double range=MathMax(Point,h-l);
   int dir=(gPyrBreakDirection!=DIR_FLAT?gPyrBreakDirection:gPyrTrendDirection);
   double level=(gPyrBreakLevel>0.0?gPyrBreakLevel:(dir==DIR_BUY?gPyrHigh1:gPyrLow1));
   if(dir==DIR_FLAT || level<=0.0) return 0.0;
   double dist=(dir==DIR_BUY?c-level:level-c)/atr;
   if(dist<=0.0) return 0.0;
   double efficiency=MathAbs(c-o)/range;
   double acceptance=(dir==DIR_BUY?(c-l)/range:(h-c)/range);
   int accepted=0;
   for(int k=1;k<=3;k++)
   {
      double ck=iClose(Symbol(),SignalTF,k);
      if((dir==DIR_BUY && ck>level) || (dir==DIR_SELL && ck<level)) accepted++;
   }
   double persistence=(double)accepted/3.0;
   return dir*MDClamp(dist*efficiency*acceptance*persistence,0.0,1.25);
}

double MarketDNAFeaturePressure(double atr)
{
   if(atr<=0.0) return 0.0;
   int span=MathMax(1,MathMin(6,MarketDNABurstLearningBars));
   double c1=iClose(Symbol(),SignalTF,1),c2=iClose(Symbol(),SignalTF,2);
   double cFar=iClose(Symbol(),SignalTF,1+span),cPrevFar=iClose(Symbol(),SignalTF,2+span);
   double o1=iOpen(Symbol(),SignalTF,1),h1=iHigh(Symbol(),SignalTF,1),l1=iLow(Symbol(),SignalTF,1);
   double velocity=(c1-cFar)/atr;
   double previousVelocity=(c2-cPrevFar)/atr;
   double acceleration=velocity-previousVelocity;
   double efficiency=(c1-o1)/MathMax(Point,h1-l1);
   return MDClamp(0.45*velocity+0.35*acceleration+0.20*efficiency,-1.50,1.50);
}

double MarketDNAFeatureWick(double atr)
{
   if(atr<=0.0) return 0.0;
   double o=iOpen(Symbol(),SignalTF,1),c=iClose(Symbol(),SignalTF,1);
   double h=iHigh(Symbol(),SignalTF,1),l=iLow(Symbol(),SignalTF,1);
   double range=MathMax(Point,h-l);
   double lower=MathMin(o,c)-l;
   double upper=h-MathMax(o,c);
   double rejection=(lower-upper)/range;
   double follow=(iClose(Symbol(),SignalTF,0)-c)/atr;
   double followMagnitude=MDClamp(MathAbs(follow)+0.10,0.10,0.65);
   return MDClamp(rejection*followMagnitude,-0.65,0.65);
}

double MarketDNAPriorHigh(int startShift,int lookback)
{
   int bars=iBars(Symbol(),SignalTF);
   int count=MathMax(3,MathMin(MathMax(3,lookback),MathMax(3,bars-startShift-1)));
   int shift=iHighest(Symbol(),SignalTF,MODE_HIGH,count,startShift);
   if(shift<0) return 0.0;
   return iHigh(Symbol(),SignalTF,shift);
}

double MarketDNAPriorLow(int startShift,int lookback)
{
   int bars=iBars(Symbol(),SignalTF);
   int count=MathMax(3,MathMin(MathMax(3,lookback),MathMax(3,bars-startShift-1)));
   int shift=iLowest(Symbol(),SignalTF,MODE_LOW,count,startShift);
   if(shift<0) return 0.0;
   return iLow(Symbol(),SignalTF,shift);
}

double MarketDNAFeatureAcceptance(double atr)
{
   gMDAcceptanceState="NEUTRAL";
   gMDAcceptancePersistence=0.0;
   if(!EnableInflectionAcceptanceDNA || atr<=0.0) return 0.0;

   int lookback=MathMax(4,MathMin(30,MarketDNAInflectionLookbackBars));
   int acceptBars=MathMax(1,MathMin(4,MarketDNAAcceptanceBars));
   double buffer=atr*MathMax(0.0,MarketDNAAcceptanceBufferATR);
   double priorHigh=MarketDNAPriorHigh(2,lookback);
   double priorLow=MarketDNAPriorLow(2,lookback);
   double olderHigh=MarketDNAPriorHigh(3,lookback);
   double olderLow=MarketDNAPriorLow(3,lookback);
   if(priorHigh<=0.0 || priorLow<=0.0 || olderHigh<=0.0 || olderLow<=0.0) return 0.0;

   double o1=iOpen(Symbol(),SignalTF,1),c1=iClose(Symbol(),SignalTF,1);
   double h1=iHigh(Symbol(),SignalTF,1),l1=iLow(Symbol(),SignalTF,1);
   double c2=iClose(Symbol(),SignalTF,2);
   double range=MathMax(Point,h1-l1);
   double bullCloseQuality=MDClamp((c1-l1)/range,0.0,1.0);
   double bearCloseQuality=MDClamp((h1-c1)/range,0.0,1.0);

   int above=0,below=0;
   for(int k=1;k<=acceptBars;k++)
   {
      double ck=iClose(Symbol(),SignalTF,k);
      if(ck>priorHigh+buffer) above++;
      if(ck<priorLow-buffer) below++;
   }
   double bullPersistence=(double)above/acceptBars;
   double bearPersistence=(double)below/acceptBars;

   double bullOutside=MathMax(0.0,c1-priorHigh-buffer)/atr;
   double bearOutside=MathMax(0.0,priorLow-buffer-c1)/atr;
   double bullSweep=MathMax(0.0,priorLow-l1-buffer)/atr;
   double bearSweep=MathMax(0.0,h1-priorHigh-buffer)/atr;
   double bullReclaim=(bullSweep>0.0 && c1>=priorLow ?
                       MathMax(0.0,c1-priorLow)/atr+0.35*bullSweep : 0.0);
   double bearReclaim=(bearSweep>0.0 && c1<=priorHigh ?
                       MathMax(0.0,priorHigh-c1)/atr+0.35*bearSweep : 0.0);

   bool failedDown=(c2<olderLow-buffer && c1>=olderLow);
   bool failedUp=(c2>olderHigh+buffer && c1<=olderHigh);
   double bullFailed=(failedDown ?
                      MathMax(0.0,olderLow-c2)/atr+MathMax(0.0,c1-olderLow)/atr : 0.0);
   double bearFailed=(failedUp ?
                      MathMax(0.0,c2-olderHigh)/atr+MathMax(0.0,olderHigh-c1)/atr : 0.0);

   double bull=0.60*bullOutside*MathMax(0.25,bullPersistence)*bullCloseQuality+
               0.55*bullReclaim*bullCloseQuality+
               0.60*bullFailed*bullCloseQuality;
   double bear=0.60*bearOutside*MathMax(0.25,bearPersistence)*bearCloseQuality+
               0.55*bearReclaim*bearCloseQuality+
               0.60*bearFailed*bearCloseQuality;

   if(bull>=bear && bull>0.0)
   {
      if(failedDown) gMDAcceptanceState="BULL FAILED-BREAK RECLAIM";
      else if(bullReclaim>bullOutside) gMDAcceptanceState="BULL RECLAIM ACCEPTED";
      else gMDAcceptanceState="BULL TERRITORY ACCEPTED";
      gMDAcceptancePersistence=MathMax(bullPersistence,MDClamp(bullCloseQuality,0.0,1.0));
   }
   else if(bear>0.0)
   {
      if(failedUp) gMDAcceptanceState="BEAR FAILED-BREAK RECLAIM";
      else if(bearReclaim>bearOutside) gMDAcceptanceState="BEAR RECLAIM ACCEPTED";
      else gMDAcceptanceState="BEAR TERRITORY ACCEPTED";
      gMDAcceptancePersistence=MathMax(bearPersistence,MDClamp(bearCloseQuality,0.0,1.0));
   }

   return MDClamp(bull-bear,-1.50,1.50);
}

double MarketDNAFeatureInflection(double atr)
{
   gMDInflectionState="NORMAL";
   gMDInflectionDirection=DIR_FLAT;
   gMDSweepDepthATR=0.0;
   gMDReclaimDepthATR=0.0;
   if(!EnableInflectionAcceptanceDNA || atr<=0.0) return 0.0;

   int lookback=MathMax(4,MathMin(30,MarketDNAInflectionLookbackBars));
   int span=MathMax(2,MathMin(6,MarketDNABurstLearningBars+1));
   double buffer=atr*MathMax(0.0,MarketDNAAcceptanceBufferATR);
   double priorHigh=MarketDNAPriorHigh(2,lookback);
   double priorLow=MarketDNAPriorLow(2,lookback);
   double olderHigh=MarketDNAPriorHigh(3,lookback);
   double olderLow=MarketDNAPriorLow(3,lookback);
   if(priorHigh<=0.0 || priorLow<=0.0 || olderHigh<=0.0 || olderLow<=0.0) return 0.0;

   double o1=iOpen(Symbol(),SignalTF,1),c1=iClose(Symbol(),SignalTF,1);
   double h1=iHigh(Symbol(),SignalTF,1),l1=iLow(Symbol(),SignalTF,1);
   double c2=iClose(Symbol(),SignalTF,2);
   double range=MathMax(Point,h1-l1);
   double bodyEfficiency=MathAbs(c1-o1)/range;
   double lowerReject=MDClamp((MathMin(o1,c1)-l1)/range,0.0,1.0);
   double upperReject=MDClamp((h1-MathMax(o1,c1))/range,0.0,1.0);

   double bullSweep=MathMax(0.0,priorLow-l1-buffer)/atr;
   double bearSweep=MathMax(0.0,h1-priorHigh-buffer)/atr;
   bool failedDown=(c2<olderLow-buffer && c1>=olderLow);
   bool failedUp=(c2>olderHigh+buffer && c1<=olderHigh);
   double bullFailed=(failedDown?MathMax(0.0,olderLow-c2)/atr:0.0);
   double bearFailed=(failedUp?MathMax(0.0,c2-olderHigh)/atr:0.0);
   double bullFailure=MathMax(bullSweep,bullFailed);
   double bearFailure=MathMax(bearSweep,bearFailed);

   double bullReclaim=(bullFailure>0.0 ?
                       MathMax(0.0,c1-(bullSweep>0.0?priorLow:olderLow))/atr : 0.0);
   double bearReclaim=(bearFailure>0.0 ?
                       MathMax(0.0,(bearSweep>0.0?priorHigh:olderHigh)-c1)/atr : 0.0);

   double preVelocity=(iClose(Symbol(),SignalTF,2)-iClose(Symbol(),SignalTF,2+span))/atr;
   double bullExhaust=MathMax(0.0,-preVelocity)*(1.0-bodyEfficiency);
   double bearExhaust=MathMax(0.0,preVelocity)*(1.0-bodyEfficiency);

   RefreshRates();
   double live=(Bid+Ask)*0.5;
   double bullImpulse=MathMax(0.0,live-c1)/atr+0.35*MathMax(0.0,c1-o1)/atr;
   double bearImpulse=MathMax(0.0,c1-live)/atr+0.35*MathMax(0.0,o1-c1)/atr;

   double bullBase=bullFailure*(0.55+0.45*lowerReject)+0.30*bullReclaim+
                   0.22*bullImpulse+0.10*bullExhaust;
   double bearBase=bearFailure*(0.55+0.45*upperReject)+0.30*bearReclaim+
                   0.22*bearImpulse+0.10*bearExhaust;

   bool bullSweepEvent=(bullSweep>=MathMax(0.0,MarketDNAInflectionSweepMinATR) &&
                        lowerReject>=MathMax(0.0,MarketDNAInflectionRejectionMin) && c1>=priorLow);
   bool bearSweepEvent=(bearSweep>=MathMax(0.0,MarketDNAInflectionSweepMinATR) &&
                        upperReject>=MathMax(0.0,MarketDNAInflectionRejectionMin) && c1<=priorHigh);
   bool bullEvent=(bullSweepEvent || failedDown);
   bool bearEvent=(bearSweepEvent || failedUp);

   bool bullTrue=(bullEvent &&
                  bullBase>=MathMax(0.0,MarketDNAInflectionTransferATR) &&
                  gMDAcceptanceATR>=MathMax(0.0,MarketDNAInflectionAcceptanceATR) &&
                  gMDPressureATR>=MathMax(0.0,MarketDNATrueReversalPressureATR) &&
                  live>h1+buffer);
   bool bearTrue=(bearEvent &&
                  bearBase>=MathMax(0.0,MarketDNAInflectionTransferATR) &&
                  -gMDAcceptanceATR>=MathMax(0.0,MarketDNAInflectionAcceptanceATR) &&
                  -gMDPressureATR>=MathMax(0.0,MarketDNATrueReversalPressureATR) &&
                  live<l1-buffer);

   double inflection=MDClamp(bullBase-bearBase,-1.50,1.50);
   if(bullTrue)
   {
      gMDInflectionState="BULL TRUE REVERSAL";
      gMDInflectionDirection=DIR_BUY;
   }
   else if(bearTrue)
   {
      gMDInflectionState="BEAR TRUE REVERSAL";
      gMDInflectionDirection=DIR_SELL;
   }
   else if(failedDown && bullBase>=bearBase)
   {
      gMDInflectionState="BULL FAILED BREAKOUT";
      gMDInflectionDirection=DIR_BUY;
   }
   else if(failedUp && bearBase>bullBase)
   {
      gMDInflectionState="BEAR FAILED BREAKOUT";
      gMDInflectionDirection=DIR_SELL;
   }
   else if(bullSweepEvent && bullBase>=bearBase)
   {
      gMDInflectionState="BULL LIQUIDITY SWEEP";
      gMDInflectionDirection=DIR_BUY;
   }
   else if(bearSweepEvent && bearBase>bullBase)
   {
      gMDInflectionState="BEAR LIQUIDITY SWEEP";
      gMDInflectionDirection=DIR_SELL;
   }
   else if(gPyrRouteActive && gPyrRouteDirection!=DIR_FLAT &&
           gPyrRouteDirection*gMDPressureATR<0.0)
   {
      gMDInflectionState="NORMAL PULLBACK";
      gMDInflectionDirection=DIR_FLAT;
   }

   if(MathAbs(bullFailure)>=MathAbs(bearFailure))
   {
      gMDSweepDepthATR=bullFailure;
      gMDReclaimDepthATR=bullReclaim;
   }
   else
   {
      gMDSweepDepthATR=-bearFailure;
      gMDReclaimDepthATR=-bearReclaim;
   }
   return inflection;
}

double MarketDNAFeatureArrow()
{
   int dir=gConfirmedArrowDirection;
   if(dir==DIR_FLAT) return 0.0;
   double denom=MathMax(0.000001,ArrowMinimumSlopeValue);
   double relative=MathAbs(gArrowSlope)/denom;
   return dir*MDClamp(0.07+0.06*relative,0.07,0.55);
}

double MarketDNAFeatureStation(double atr)
{
   if(atr<=0.0) return 0.0;
   int dir=(gPyrRouteActive?gPyrRouteDirection:gPyrTrendDirection);
   double level=0.0;
   if(gPyrSignalSource==PYR_SOURCE_TRAIN_STATION)
      level=(dir==DIR_BUY?gPyrBuyStation:gPyrSellStation);
   else if(gPyrSignalSource==PYR_SOURCE_DIRECTIONAL_RETEST || gPyrSignalSource==PYR_SOURCE_ROUTE_ACCELERATOR)
      level=(gPyrRouteLastStation>0.0?gPyrRouteLastStation:gPyrRetestStation);
   else if(gPyrRouteLastStation>0.0) level=gPyrRouteLastStation;
   if(dir==DIR_FLAT || level<=0.0) return 0.0;
   double current=(dir==DIR_BUY?Bid:Ask);
   double proximity=1.0-MDClamp(MathAbs(current-level)/atr,0.0,1.0);
   return dir*0.32*proximity;
}

double MarketDNAFeatureReclaim(double atr)
{
   if(atr<=0.0 || gPyrActiveReclaimLevel<=0.0) return 0.0;
   int dir=(gPyrSignalSource==PYR_SOURCE_RECLAIM_AREA?gPyrRawSignal:(gPyrRouteActive?gPyrRouteDirection:gPyrTrendDirection));
   if(dir==DIR_FLAT) dir=(gPyrRouteActive?gPyrRouteDirection:gPyrTrendDirection);
   if(dir==DIR_FLAT) return 0.0;
   double current=(dir==DIR_BUY?Bid:Ask);
   double proximity=1.0-MDClamp(MathAbs(current-gPyrActiveReclaimLevel)/atr,0.0,1.0);
   return dir*0.28*proximity;
}

double MarketDNAFeatureRoute(double atr)
{
   if(!gPyrRouteActive || gPyrRouteDirection==DIR_FLAT || atr<=0.0) return 0.0;
   RefreshRates();
   double current=(gPyrRouteDirection==DIR_BUY?Bid:Ask);
   double room=0.0;
   if(gPyrRouteInvalidation>0.0)
      room=(gPyrRouteDirection==DIR_BUY?current-gPyrRouteInvalidation:gPyrRouteInvalidation-current)/atr;
   double survival=(gPyrRouteInvalidTicks>0?0.25:MDClamp(0.25+0.15*MathMax(0.0,room),0.15,0.70));
   return gPyrRouteDirection*survival;
}

double MarketDNAFeatureWill()
{
   int dir=(gPyrRouteActive?gPyrRouteDirection:gPyrTrendDirection);
   if(dir==DIR_FLAT || !EnableWillDNA) return 0.0;
   double magnitude=gWillPulseATREWMA*gWillEdge*gWillConfidence;
   return MDClamp(dir*magnitude,-0.50,0.50);
}

double MarketDNADirectionalSpine()
{
   // v3.07: Historical Channel DNA is now a fifth core strand and a regime gate.
   // Local structure cannot authorize a counter-channel direction until the rail
   // itself is broken and accepted beyond.
   double s=MDClamp(gMDStructureATR,-1.0,1.0);
   double b=MDClamp(gMDBOSATR,-1.0,1.0);
   double p=MDClamp(gMDPressureATR,-1.0,1.0);
   double r=MDClamp(gMDRouteATR,-1.0,1.0);
   double c=MDClamp(gMDChannelATR,-1.0,1.0);

   double ws=0.26*(EnableSelfEvolvingGenome?gEvoStructWeightMult:1.0);
   double wb=0.18*(EnableSelfEvolvingGenome?gEvoBOSWeightMult:1.0);
   double wp=0.20*(EnableSelfEvolvingGenome?gEvoPressureWeightMult:1.0);
   double wr=0.10*(EnableSelfEvolvingGenome?gEvoRouteWeightMult:1.0);
   double wc=0.26*(EnableSelfEvolvingGenome?gEvoChannelWeightMult:1.0);
   double wsum=MathMax(0.0001,ws+wb+wp+wr+wc);
   ws/=wsum; wb/=wsum; wp/=wsum; wr/=wsum; wc/=wsum;
   double rawSpine=ws*s+wb*b+wp*p+wr*r+wc*c;
   double spine=rawSpine;
   int dir=MDSign(spine);
   int triggerOverride=(gMDTriggerRailBreakDirection!=DIR_FLAT?gMDTriggerRailBreakDirection:gMDTriggerRailBounceDirection);
   if(triggerOverride!=DIR_FLAT)
   {
      double forced=MathMax(MathAbs(spine),MathMax(0.12,MarketDNADirectionFloorATR*1.50));
      gMDDirectionalSpineATR=triggerOverride*forced;
      gMDDirectionalAgreement=5;
      gMDDirectionalDirection=triggerOverride;
      gMDDirectionalState=(gMDTriggerRailBreakDirection!=DIR_FLAT?
                           (triggerOverride==DIR_SELL?"SONIC SELL - BLACK RAIL BROKEN":"SONIC BUY - BLACK RAIL BROKEN"):
                           (triggerOverride==DIR_BUY?"IMMEDIATE BUY - BLACK RAIL REJECT":"IMMEDIATE SELL - BLACK RAIL REJECT"));
      return gMDDirectionalSpineATR;
   }
   double component=MathMax(0.0,MarketDNADirectionComponentMinATR);

   // v3.09: a confirmed rail bounce owns SIDE, not exposure size. Local SELL
   // structure at a rising support bounce can no longer leave the spine bearish/flat.
   // RHYTHM/pressure still decide whether the BUY actually launches.
   if(MarketDNAChannelBounceHardAuthority && gMDChannelBreakDirection==DIR_FLAT &&
      gMDChannelBounceDirection!=DIR_FLAT)
   {
      dir=gMDChannelBounceDirection;
      double alignedCore=ws*MathMax(0.0,dir*s)+wb*MathMax(0.0,dir*b)+
                         wp*MathMax(0.0,dir*p)+wr*MathMax(0.0,dir*r)+
                         wc*MathMax(0.0,dir*c);
      double bounceFloor=MathMax(MathMax(0.0,MarketDNADirectionFloorATR),MathAbs(c)*0.85);
      spine=dir*MathMax(bounceFloor,alignedCore);
   }
   int agree=0;
   if(dir!=DIR_FLAT)
   {
      if(dir*s>=component) agree++;
      if(dir*b>=component) agree++;
      if(dir*p>=component) agree++;
      if(dir*r>=component) agree++;
      if(dir*c>=component) agree++;
   }

   bool channelBreakAnchor=(dir!=DIR_FLAT && gMDChannelBreakDirection==dir);
   bool structuralAnchor=(dir!=DIR_FLAT &&
                          (dir*s>=component || dir*b>=component || dir*r>=component || dir*c>=component || channelBreakAnchor));
   bool motionAnchor=(dir!=DIR_FLAT &&
                      (dir*p>=component || dir*b>=component || channelBreakAnchor));
   bool pressureSafe=(dir==DIR_FLAT ? false :
                      dir*p>=-MathMax(0.0,MarketDNADirectionMaxOpposingPressureATR));
   bool channelSafe=(dir!=DIR_FLAT && MarketDNAHistoricalChannelAllowsDirection(dir));
   bool enough=(MathAbs(spine)>=MathMax(0.0,MarketDNADirectionFloorATR) &&
                agree>=MathMax(1,MathMin(5,MarketDNADirectionMinAgreement)) &&
                structuralAnchor && motionAnchor && pressureSafe && channelSafe);

   gMDDirectionalSpineATR=spine;
   gMDDirectionalAgreement=agree;
   gMDDirectionalDirection=(EnableMarketDNADirectionalSpine && enough ? dir :
                            (!EnableMarketDNADirectionalSpine ? dir : DIR_FLAT));
   if(gMDDirectionalDirection==DIR_BUY)
      gMDDirectionalState="BUY SPINE + HIST CHANNEL";
   else if(gMDDirectionalDirection==DIR_SELL)
      gMDDirectionalState="SELL SPINE + HIST CHANNEL";
   else if(dir!=DIR_FLAT && !channelSafe)
      gMDDirectionalState=(dir==DIR_SELL?"NO SELL - RISING SUPPORT CHANNEL HOLDS":"NO BUY - FALLING RESISTANCE CHANNEL HOLDS");
   else if(dir!=DIR_FLAT && !pressureSafe)
      gMDDirectionalState="NO SPINE - PRESSURE OPPOSES";
   else if(dir!=DIR_FLAT && agree<MathMax(1,MathMin(5,MarketDNADirectionMinAgreement)))
      gMDDirectionalState="NO SPINE - CORE/CHANNEL DISAGREE";
   else
      gMDDirectionalState="NO SPINE - WAIT CORE + CHANNEL DISPLACEMENT";
   return spine;
}

bool MarketDNADirectionalLaunchReady(int dir,int confirmedTurn)
{
   gMDDirectionalLaunchATR=0.0;
   if(dir==DIR_FLAT) return false;
   if(EnableMarketDNAThreeWayChannel &&
      (gMDTriggerRailBounceDirection==dir || gMDTriggerRailBreakDirection==dir))
   {
      gMDDirectionalLaunchATR=MathMax(0.18,MathAbs(gMDDirectionalSpineATR));
      return true;
   }
   if(gMDInflectionTransferReady || gMDTransferHandoffDirection==dir)
   {
      gMDDirectionalLaunchATR=MathMax(gMDReversalTransferEdgeATR,gMDTransferSeedATR);
      return true;
   }

   bool queuedFVGSeed=MarketDNASignalFVGQueuedSeedReady(dir);
   if(queuedFVGSeed)
   {
      gMDDirectionalLaunchATR=MathMax(0.08,MathMax(MathAbs(gMDPressureATR),MathAbs(gMDOracleOBFVGATR)));
      return true;
   }

   if(EnableMarketDNADirectionalSpine && gMDDirectionalDirection!=dir) return false;

   double pressure=MathMax(0.0,dir*gMDPressureATR);
   double bos=MathMax(0.0,dir*gMDBOSATR);
   double structure=MathMax(0.0,dir*gMDStructureATR);
   double route=MathMax(0.0,dir*gMDRouteATR);
   gMDDirectionalLaunchATR=MathMax(MathMax(pressure,bos),MathMax(0.0,gMDRhythmScore));

   bool signalFVGRetest=(MarketDNASignalFVGOnly && gMDFVGArmed && gMDFVGReady && gMDFVGInZone &&
                         !gMDFVGSeedUsed && gMDFVGDirection==dir);
   bool freshStructuralEvent=(confirmedTurn==dir || signalFVGRetest);
   bool channelBounceAnchor=(EnableMarketDNAHistoricalChannels && gMDChannelBounceDirection==dir &&
                            gMDChannelBreakDirection==DIR_FLAT);
   bool structuralAnchor=(structure>=MathMax(0.0,MarketDNADirectionComponentMinATR) ||
                          bos>=MathMax(0.0,MarketDNADirectionComponentMinATR) || route>0.0 || channelBounceAnchor);
   bool movementEvidence=(pressure>=0.50*MathMax(0.0,MarketDNADirectionLaunchPressureATR) ||
                          bos>=MathMax(0.0,MarketDNADirectionComponentMinATR));
   bool rhythmLaunch=MarketDNARhythmLaunchReady(dir);
   bool rhythmRapid=MarketDNARhythmRapidReady(dir);

   // v3.09: every market entry must have live tick rhythm unless it is a proven
   // reversal handoff. A candle/IL/BOS event may identify location, but RHYTHM
   // confirms that the train is actually moving now.
   if(EnableMarketDNARhythmDNA)
   {
      if(TradeCount()==0)
         return rhythmLaunch && (freshStructuralEvent || (structuralAnchor && movementEvidence));

      if(MarketDNARhythmRapidEveryValidTick && rhythmRapid && structuralAnchor)
         return true; // Every live tick may request another rapid-fire burst.

      return rhythmLaunch && (freshStructuralEvent || (structuralAnchor && movementEvidence));
   }

   bool freshImpulse=(pressure>=MathMax(0.0,MarketDNADirectionLaunchPressureATR) && structuralAnchor);
   bool rapidContinuation=(TradeCount()>0 && gPyrRouteActive && gPyrRouteDirection==dir &&
                           gMDRapidBurstCars>=2 && gMDFavorablePush>=1.0 &&
                           pressure>=0.50*MathMax(0.0,MarketDNADirectionLaunchPressureATR) && route>0.0);
   if(TradeCount()==0) return (freshStructuralEvent || freshImpulse);
   return (freshStructuralEvent || rapidContinuation);
}

double MarketDNAAnalyticEquation()
{
   // v3.09: channel-aware market-production strands determine normal Q*.
   // Inflection + Acceptance are REVERSAL-TRANSFER DNA only and cannot shrink,
   // trim, or bias a productive winning campaign before reversal is proven.
   double mu=0.24*gMDStructureATR+0.20*gMDBOSATR+0.22*gMDPressureATR+
             0.04*gMDWickATR+0.04*gMDArrowATR+0.04*gMDStationATR+
             0.03*gMDReclaimATR+0.14*gMDRouteATR+0.05*gMDWillATR;
   double bp=MDClamp(gMDBOSATR,-1.0,1.0)*MDClamp(gMDPressureATR,-1.0,1.0);
   double sr=MDClamp(gMDStructureATR,-1.0,1.0)*MDClamp(gMDRouteATR,-1.0,1.0);
   double ws=MDClamp(gMDWickATR,-1.0,1.0)*MDClamp(gMDStationATR,-1.0,1.0);
   double rr=MDClamp(gMDReclaimATR,-1.0,1.0)*MDClamp(gMDRouteATR,-1.0,1.0);
   mu+=0.10*bp+0.08*sr+0.05*ws+0.05*rr;
   if(EnableMarketDNAOracleFusion)
      mu+=0.07*gMDOracleMicroTrendATR+0.08*gMDOracleOBFVGATR+0.04*gMDOraclePhaseATR;
   return MDClamp(mu,-2.50,2.50);
}

void MarketDNALearnIfNewBar(double atr)
{
   datetime bar=iTime(Symbol(),SignalTF,0);
   if(bar<=0 || bar==gMDLastLearnBar) return;
   gMDLastLearnBar=bar;
   double decay=MDClamp(MarketDNAMemoryDecay,0.50,0.999);
   double errDecay=MDClamp(MarketDNAErrorDecay,0.50,0.999);
   double lr=MDClamp(MarketDNALearningRate,0.001,0.50);
   if(gMDPrevPredictionTime>0 && gMDPrevPredictionATRSize>0.0)
   {
      double actual=(iClose(Symbol(),SignalTF,1)-gMDPrevPredictionBasePrice)/gMDPrevPredictionATRSize;
      double error=actual-gMDPrevPredictionATR;
      double norm=0.0001;
      for(int i=0;i<MD_BASE_FEATURES;i++) norm+=gMDPrevFeature[i]*gMDPrevFeature[i];
      for(int j=0;j<MD_BASE_FEATURES;j++)
         gMDWeight[j]=decay*gMDWeight[j]+lr*(error*gMDPrevFeature[j])/norm;
      gMDErrorVariance=errDecay*gMDErrorVariance+(1.0-errDecay)*error*error;
      int d=gMDPrevPredictionDirection;
      double adverse=0.0;
      if(d==DIR_BUY) adverse=MathMax(0.0,gMDPrevPredictionBasePrice-iLow(Symbol(),SignalTF,1))/gMDPrevPredictionATRSize;
      else if(d==DIR_SELL) adverse=MathMax(0.0,iHigh(Symbol(),SignalTF,1)-gMDPrevPredictionBasePrice)/gMDPrevPredictionATRSize;
      else adverse=(iHigh(Symbol(),SignalTF,1)-iLow(Symbol(),SignalTF,1))/(2.0*gMDPrevPredictionATRSize);
      gMDExpectedAdverseATR=decay*gMDExpectedAdverseATR+(1.0-decay)*MDClamp(adverse,0.0,3.0);
      MarketDNASave();
   }
}

double MarketDNASurfResidual()
{
   double residual=0.0;
   for(int i=0;i<MD_BASE_FEATURES;i++) residual+=gMDWeight[i]*gMDFeature[i];
   return MDClamp(residual,-1.50,1.50);
}

double MarketDNAThesisValidity(int intendedDir,double atr)
{
   if(intendedDir==DIR_FLAT) return 0.0;
   if(EnableMarketDNADirectionalSpine && gMDDirectionalDirection!=intendedDir) return 0.0;

   double floor=MathMax(0.01,MarketDNADirectionFloorATR);
   double spineStrength=MDClamp(MathAbs(gMDDirectionalSpineATR)/floor,0.0,2.0);
   double validity=0.30+0.18*MathMin(1.0,spineStrength)+
                   0.06*MathMax(0,gMDDirectionalAgreement-1);

   if(gPyrRouteActive)
   {
      if(gPyrRouteDirection==intendedDir) validity=MathMax(validity,0.76);
      else validity=0.08;
      if(gPyrRouteInvalidTicks>0) validity*=0.40;
      if(gPyrRouteInvalidation>0.0 && atr>0.0)
      {
         RefreshRates();
         double current=(intendedDir==DIR_BUY?Bid:Ask);
         double room=(intendedDir==DIR_BUY?current-gPyrRouteInvalidation:gPyrRouteInvalidation-current)/atr;
         validity*=MDClamp(0.45+0.18*MathMax(0.0,room),0.20,1.0);
      }
   }
   if(gPyrTrendDirection==intendedDir) validity=MathMin(1.0,validity+0.08);
   if(gConfirmedArrowDirection==intendedDir) validity=MathMin(1.0,validity+0.05);
   else if(gConfirmedArrowDirection!=DIR_FLAT && gConfirmedArrowDirection!=intendedDir) validity*=0.75;
   if(intendedDir*gMDPressureATR<0.0) validity*=0.55;
   if(EnableMarketDNAHistoricalChannels)
   {
      if(gMDChannelDirection==intendedDir || gMDChannelBreakDirection==intendedDir)
         validity=MathMin(1.0,validity+0.14);
      else if(!MarketDNAHistoricalChannelAllowsDirection(intendedDir))
         validity*=0.15;
   }
   if(EnableMarketDNAOracleFusion)
   {
      double microAlong=intendedDir*gMDOracleMicroTrendATR;
      double zoneAlong=intendedDir*gMDOracleOBFVGATR;
      if(microAlong>0.0) validity=MathMin(1.0,validity+0.04*MathMin(1.0,microAlong/0.25));
      if(zoneAlong>0.0) validity=MathMin(1.0,validity+0.06*MathMin(1.0,zoneAlong/0.25));
      if(gMDOraclePhase==ORACLE_EXPANSION) validity=MathMin(1.0,validity+0.04);
   }
   return MDClamp(validity,0.0,1.0);
}

double MarketDNAFavorablePush(int dir)
{
   if(dir==DIR_FLAT) return 0.0;
   double favorable=MathMax(0.0,dir*gMDPressureATR);
   double adverse=MathMax(0.0,-dir*gMDPressureATR)+MathMax(0.03,gMDExpectedAdverseATR);
   datetime now=TimeCurrent();
   double profitVelocity=0.0;
   if(gMDLastProfitVelocityTime>0 && now>gMDLastProfitVelocityTime)
      profitVelocity=(BasketProfit()-gMDLastBasketProfit)/MathMax(1.0,(double)(now-gMDLastProfitVelocityTime));
   gMDLastBasketProfit=BasketProfit();
   gMDLastProfitVelocityTime=now;
   double moneyScale=MathMax(0.25,gCompoundBaseGoalMoney);
   double flow=MathMax(0.0,profitVelocity)/moneyScale*20.0;
   double rhythmBoost=(EnableMarketDNARhythmDNA ? MDClamp(0.70+0.55*MathMax(0.0,gMDRhythmScore),0.70,1.80) : 1.0);
   return MDClamp((0.15+favorable+flow)/(0.15+adverse)*MathMax(0.25,gMDThesisValidity)*rhythmBoost,0.20,3.00);
}

void MarketDNAComputeExposure(int confirmedTurn)
{
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   gMDExecutionCostATR=MDClamp((Ask-Bid)/atr+MathMax(0.0,MarketDNAExecutionBufferATR),0.0,1.0);
   // Living broker weather raises cost when spread/metadata/margin conditions degrade.
   gMDExecutionCostATR=MDClamp(gMDExecutionCostATR+(1.0-gHT5Broker.executionQuality)*0.05,0.0,1.0);
   double baseUncertainty=MathSqrt(MathMax(0.0001,gMDErrorVariance));
   gMDUncertaintyATR=MathMax(baseUncertainty,MathMax(0.0,gHT5Brain.uncertainty)*0.20);
   double uncertainty=gMDUncertaintyATR;

   int predictedDir=(EnableMarketDNADirectionalSpine?gMDDirectionalDirection:MDSign(gMDExpectedATR));
   int triggerOverride=(gMDTriggerRailBreakDirection!=DIR_FLAT?gMDTriggerRailBreakDirection:gMDTriggerRailBounceDirection);
   if(triggerOverride!=DIR_FLAT) predictedDir=triggerOverride;
   if(!EnableMarketDNADirectionalSpine &&
      MathAbs(gMDExpectedATR)<MathMax(0.0,MarketDNAEdgeFloorATR) && triggerOverride==DIR_FLAT) predictedDir=DIR_FLAT;
   gMDReversalReady=false;
   gMDInflectionTransferReady=false;
   gMDInflectionSuspendAdds=false;
   gMDInflectionBrake=1.0;
   gMDReversalTransferEdgeATR=0.0;
   int openDir=(int)DetectDirection();

   // REVERSAL-ONLY DNA: Inflection + Acceptance have zero authority over normal
   // position sizing. Their only execution authority is a fully confirmed
   // close-old -> handoff -> enter-opposite transfer.
   int transferDir=gMDInflectionDirection;
   if(openDir!=DIR_FLAT && transferDir!=DIR_FLAT && transferDir!=openDir)
   {
      double infProof=transferDir*gMDInflectionATR;
      double accProof=transferDir*gMDAcceptanceATR;
      double pressureProof=transferDir*gMDPressureATR;
      double wickProof=MathMax(0.0,transferDir*gMDWickATR);
      double reclaimProof=MathMax(0.0,transferDir*gMDReclaimATR);
      double oraclePatternProof=(EnableMarketDNAOracleFusion?MathMax(0.0,transferDir*gMDOraclePatternATR):0.0);
      gMDReversalTransferEdgeATR=MathMax(0.0,0.42*infProof+0.28*accProof+
                                             0.15*pressureProof+0.05*wickProof+0.05*reclaimProof+
                                             0.05*oraclePatternProof);
      bool trueState=(StringFind(gMDInflectionState,"TRUE REVERSAL")>=0);
      bool infOK=(infProof>=MathMax(0.0,MarketDNAInflectionTransferATR));
      bool accOK=(accProof>=MathMax(0.0,MarketDNAInflectionAcceptanceATR));
      bool pressureOK=(pressureProof>=MathMax(0.0,MarketDNATrueReversalPressureATR));
      bool acceptancePersistent=(gMDAcceptancePersistence>=0.50);
      gMDInflectionTransferReady=(EnableInflectionAcceptanceDNA && trueState && infOK && accOK &&
                                  pressureOK && acceptancePersistent);
      if(gMDInflectionTransferReady)
      {
         predictedDir=transferDir;
         gMDReversalReady=true;
      }
   }

   // Traditional confirmed structural reversal remains available, but no ordinary
   // opposite prediction is allowed to flip an active campaign without proof.
   if(openDir!=DIR_FLAT && triggerOverride!=DIR_FLAT && triggerOverride!=openDir)
      gMDReversalReady=true;
   if(openDir!=DIR_FLAT && predictedDir!=DIR_FLAT && predictedDir!=openDir &&
      !gMDInflectionTransferReady && triggerOverride==DIR_FLAT)
   {
      bool structuralFlip=(gPyrSignalSource==PYR_SOURCE_CONFIRMED_TREND_FLIP && confirmedTurn==predictedDir);
      bool pressureConfirms=(predictedDir*gMDPressureATR>=MathMax(0.0,MarketDNATrueReversalPressureATR));
      bool routeAllows=(!gPyrRouteActive || gPyrRouteDirection==predictedDir || gPyrRouteInvalidTicks>0);
      gMDReversalReady=(structuralFlip && pressureConfirms && routeAllows);
      if(!gMDReversalReady) predictedDir=DIR_FLAT;
   }

   // A successful reversal close carries a short seed handoff. This is the only
   // circumstance where reversal DNA may temporarily provide the new campaign's edge.
   if(openDir==DIR_FLAT && gMDTransferHandoffDirection!=DIR_FLAT)
   {
      int handoffLife=MathMax(30,PeriodSeconds(SignalTF)*2);
      if(TimeCurrent()-gMDTransferHandoffTime<=handoffLife)
      {
         predictedDir=gMDTransferHandoffDirection;
         gMDInflectionTransferReady=true;
         gMDReversalReady=true;
      }
      else
      {
         gMDTransferHandoffDirection=DIR_FLAT;
         gMDTransferHandoffTime=0;
         gMDTransferSeedATR=0.0;
      }
   }
   gMDDesiredDirection=predictedDir;
   gMDThesisValidity=MarketDNAThesisValidity(gMDDesiredDirection,atr);
   gMDFavorablePush=MarketDNAFavorablePush(gMDDesiredDirection);

   // v3.09: reversal DNA never contracts Q* or suspends a winning direction.
   double signedExpected=(gMDDesiredDirection==DIR_FLAT?0.0:gMDDesiredDirection*gMDExpectedATR);
   if((gMDInflectionTransferReady || gMDTransferHandoffDirection==gMDDesiredDirection) && gMDDesiredDirection!=DIR_FLAT)
      signedExpected=MathMax(signedExpected,MathMax(gMDTransferSeedATR,gMDReversalTransferEdgeATR));
   // v3.08 calibration: uncertainty and adverse excursion DISCOUNT a valid
   // prediction instead of subtracting nearly half an ATR from every setup.
   // This preserves the original master-equation idea: expected movement is
   // divided by uncertainty/adverse drag rather than being permanently erased.
   double rawNetExpected=MathMax(0.0,signedExpected-gMDExecutionCostATR);
   double edgeDrag=1.0+MathMax(0.0,MarketDNAUncertaintyPenalty)*uncertainty+
                       MathMax(0.0,MarketDNAAdversePenalty)*gMDExpectedAdverseATR;
   gMDExploitableEdgeATR=(edgeDrag>0.0?rawNetExpected/edgeDrag:rawNetExpected);

   gMDCurrentSignedLots=LotsByDirection(DIR_BUY)-LotsByDirection(DIR_SELL);
   double currentDirLots=(gMDDesiredDirection==DIR_FLAT?TotalLots():LotsByDirection(gMDDesiredDirection));
   gMDBaseCarLot=MarketDNABaseLotForDirection(gMDDesiredDirection);
   gMDSafeLotCeiling=MarketDNASafeTotalLots(gMDDesiredDirection);
   double lotCap=(gMDBaseCarLot>0.0?gMDBaseCarLot*MarketDNACarCeiling():gMDSafeLotCeiling);
   double qSafe=MathMax(0.0,MathMin(gMDSafeLotCeiling,lotCap));

   double cashPerLotATR=0.0;
   if(gMDDesiredDirection!=DIR_FLAT)
   {
      RefreshRates(); double px=(gMDDesiredDirection==DIR_BUY?Ask:Bid);
      cashPerLotATR=CashLossPerLot(px,px-gMDDesiredDirection*atr);
   }
   gMDRecoveryGapMoney=MathMax(0.0,gCompoundLiveRemaining)+MathMax(0.0,-BasketProfit());
   double recoveryLots=MathMax(gMDBaseCarLot,currentDirLots+gMDBaseCarLot);
   double atrMoney=MathMax(0.01,cashPerLotATR*recoveryLots);
   gMDRecoveryRequiredATR=(BasketProfit()<0.0?gMDRecoveryGapMoney/atrMoney:0.0);
   double recoveryNumerator=MathMax(0.0,signedExpected-gMDExecutionCostATR);
   double recoveryDenom=MathMax(0.01,gMDRecoveryRequiredATR+uncertainty+gMDExpectedAdverseATR);
   gMDRecoveryFeasibility=(BasketProfit()<0.0?MDClamp(recoveryNumerator/recoveryDenom,0.0,1.0):1.0);

   gMDNegativeAddAllowed=(BasketProfit()>=0.0);
   if(BasketProfit()<0.0)
   {
      gMDNegativeAddAllowed=(MarketDNAAllowNegativeAdds && gMDDesiredDirection==openDir &&
                             gMDThesisValidity>=MarketDNAThesisMinimum &&
                             gMDRecoveryFeasibility>=MarketDNARecoveryMinimum &&
                             signedExpected>=gMDRecoveryRequiredATR+MathMax(0.0,MarketDNARecoveryBufferATR));
   }

   double needRatio=1.0;
   if(EnableCompoundStaircase && gCompoundBaseGoalMoney>0.0)
      needRatio=MDClamp(gCompoundLiveRemaining/gCompoundBaseGoalMoney,0.0,1.50);
   double compoundDrive=1.0+MathMax(0.0,MarketDNACompoundDrive)*needRatio*
                        (BasketProfit()<0.0?gMDRecoveryFeasibility:1.0);

   gMDExpectedFutureMoney=MathMax(0.0,signedExpected-gMDExecutionCostATR)*cashPerLotATR*MathMax(gMDBaseCarLot,currentDirLots);
   gMDExpectedGivebackMoney=gMDExpectedAdverseATR*cashPerLotATR*currentDirLots;
   double profitProtection=1.0;
   if(BasketProfit()>0.0 && currentDirLots>0.0)
      profitProtection=MDClamp(gMDExpectedFutureMoney/
                              MathMax(0.01,gMDExpectedGivebackMoney+0.25*BasketProfit()),0.18,1.0);

   double ego=0.0;
   if(EnableEGOOverdrive && gMDDesiredDirection!=DIR_FLAT && gMDExploitableEdgeATR>0.0)
      ego=(gMDExploitableEdgeATR/MathMax(0.01,MarketDNAEdgeScaleATR))*
          gMDFavorablePush*gMDThesisValidity*compoundDrive*profitProtection;
   else if(gMDDesiredDirection!=DIR_FLAT && gMDExploitableEdgeATR>0.0)
      ego=(gMDExploitableEdgeATR/MathMax(0.01,MarketDNAEdgeScaleATR))*gMDThesisValidity;
   gMDEGO=MDClamp(ego,0.0,6.0);

   double exposureRatio=(gMDEGO>0.0?1.0-MathExp(-gMDEGO):0.0);
   gMDDesiredLots=qSafe*exposureRatio;
   gMDRhythmTargetDemandLots=0.0;

   // FULL TARGET DRIVE: "attempt 100% compound" means attempt to size the
   // currently proven move to produce the entire remaining compound step. It
   // never means 100% free margin. qSafe remains the hard campaign-risk ceiling.
   if(EnableMarketDNARhythmDNA && MarketDNARhythmFullCompoundTargetDrive &&
      gMDDesiredDirection!=DIR_FLAT && gMDRhythmScore>=MathMax(MarketDNARhythmLaunchThreshold,MarketDNARhythmTargetDriveThreshold) &&
      gCompoundLiveRemaining>0.0 && cashPerLotATR>0.0)
   {
      double expectedForTarget=MathMax(MathMax(0.03,MarketDNAEdgeFloorATR),signedExpected-gMDExecutionCostATR);
      double expectedMoneyPerLot=MathMax(0.01,cashPerLotATR*expectedForTarget);
      double needLots=gCompoundLiveRemaining/expectedMoneyPerLot;
      gMDRhythmTargetDemandLots=MathMin(qSafe,MathMax(currentDirLots,needLots));
      gMDDesiredLots=MathMax(gMDDesiredLots,gMDRhythmTargetDemandLots);
   }

   if(triggerOverride!=DIR_FLAT && gMDDesiredDirection==triggerOverride)
   {
      if(gMDTriggerRailBreakDirection==triggerOverride && MarketDNATriggerRailSonicEveryTick)
         gMDDesiredLots=qSafe;
      else if(gMDTriggerRailBounceDirection==triggerOverride && gMDBaseCarLot>0.0)
         gMDDesiredLots=MathMax(gMDDesiredLots,MathMin(qSafe,gMDBaseCarLot*MathMax(1,MarketDNATriggerRailBounceCars)));
   }

   // Oracle Phase controls only NEW deployment. It may accelerate or slow adds,
   // but can never shrink the already-open winning basket or trigger harvesting.
   if(EnableMarketDNAOracleFusion && gMDDesiredLots>currentDirLots)
   {
      double addDemand=gMDDesiredLots-currentDirLots;
      gMDDesiredLots=MathMin(qSafe,currentDirLots+addDemand*MDClamp(gMDOracleDeploymentMultiplier,0.50,1.50));
   }
   if((gMDExploitableEdgeATR<MarketDNAEdgeFloorATR || gMDThesisValidity<MarketDNAThesisMinimum) &&
      triggerOverride==DIR_FLAT)
      gMDDesiredLots=0.0;
   if(BasketProfit()<0.0 && !gMDNegativeAddAllowed)
      gMDDesiredLots=MathMin(gMDDesiredLots,currentDirLots);
   if(gMDDesiredDirection==DIR_FLAT) gMDDesiredLots=0.0;

   double minLot=MarketInfo(Symbol(),MODE_MINLOT);
   if(minLot<=0.0) minLot=0.01;
   gMDDesiredCars=(gMDBaseCarLot>0.0?(int)MathCeil(gMDDesiredLots/gMDBaseCarLot-0.0000001):0);
   gMDDesiredCars=MathMax(0,MathMin(MarketDNACarCeiling(),gMDDesiredCars));
   gMDExposureDeltaLots=gMDDesiredLots-currentDirLots-MarketDNAPendingLotsByDirection(gMDDesiredDirection);
   gMDStackDemandLots=MathMax(0.0,gMDExposureDeltaLots);
   gMDRapidFireDemandLots=MathMax(0.0,gMDExposureDeltaLots)*gMDFavorablePush*
                          gMDExploitableEdgeATR/MathMax(0.03,uncertainty+gMDExpectedAdverseATR);
   gMDRapidBurstCars=(gMDBaseCarLot>0.0?(int)MathCeil(gMDRapidFireDemandLots/gMDBaseCarLot):0);
   if(EnableMarketDNARhythmDNA && MarketDNARhythmRapidEveryValidTick && MarketDNARhythmLaunchReady(gMDDesiredDirection) &&
      gMDExposureDeltaLots>=minLot*0.50)
      gMDRapidBurstCars=MathMax(gMDRapidBurstCars,MathMax(1,MarketDNARhythmMinimumBurstCars));
   if(gMDTriggerRailBreakDirection==gMDDesiredDirection && MarketDNATriggerRailSonicEveryTick &&
      gMDExposureDeltaLots>=minLot*0.50)
      gMDRapidBurstCars=MathMax(gMDRapidBurstCars,MathMax(1,MarketDNATriggerRailSonicBurstCars));
   if(gMDTriggerRailBounceDirection==gMDDesiredDirection && gMDExposureDeltaLots>=minLot*0.50)
      gMDRapidBurstCars=MathMax(gMDRapidBurstCars,MathMax(1,MarketDNATriggerRailBounceCars));
   if(EnableMarketDNAOracleFusion && gMDOraclePhase==ORACLE_EXPANSION &&
      MarketDNARhythmRapidReady(gMDDesiredDirection) && gMDExposureDeltaLots>=minLot*0.50)
      gMDRapidBurstCars=MathMax(gMDRapidBurstCars,MathMin(MarketDNARhythmMaxBurstCarsPerTick,MarketDNARhythmMinimumBurstCars+1));
   gMDRapidBurstCars=MathMax(0,MathMin(MathMin(20,MathMax(1,MarketDNARhythmMaxBurstCarsPerTick)),gMDRapidBurstCars));

   if(gCompoundEntryFreeze || gCompoundPhase==CMP_COLLECTING || gCompoundPhase==CMP_GUARDING)
      gMDAction="VAULT / COMPOUND GUARD";
   else if(gMDTriggerRailBreakDirection==gMDDesiredDirection)
      gMDAction=(gMDDesiredDirection==DIR_SELL?"SONIC SELL / EVERY TICK FIRE":"SONIC BUY / EVERY TICK FIRE");
   else if(gMDTriggerRailBounceDirection==gMDDesiredDirection)
      gMDAction=(gMDDesiredDirection==DIR_BUY?"BLACK RAIL REJECT / IMMEDIATE BUY":"BLACK RAIL REJECT / IMMEDIATE SELL");
   else if(gMDInflectionTransferReady && openDir!=DIR_FLAT && gMDDesiredDirection!=openDir)
      gMDAction="TRANSFER / TRUE REVERSAL";
   else if(BasketProfit()<0.0 && gMDNegativeAddAllowed && gMDExposureDeltaLots>=minLot*0.5)
      gMDAction="RECOVER / ASSISTED STACK";
   else if(BasketProfit()>0.0 && gMDDesiredLots+MarketDNAFullHarvestLotTolerance<currentDirLots)
      gMDAction=(MarketDNAHarvestProfitableExcess?"HARVEST / PROTECT PUSH":"HOLD / COMPOUND RUNNER");
   else if(gMDRapidBurstCars>=MathMin(2,MarketDNARapidBurstCars) && gMDExposureDeltaLots>=minLot*0.5)
      gMDAction="ATTACK / RAPID FIRE";
   else if(gMDExposureDeltaLots>=minLot*0.5)
      gMDAction=(TradeCount()==0?"SEED / ENTER":"STACK / BUILD");
   else if(TradeCount()>0)
      gMDAction=(gMDInflectionState=="NORMAL PULLBACK"?"HOLD / NORMAL PULLBACK":"HOLD / PRODUCTIVE EXPOSURE");
   else gMDAction="HUNT / WAIT FOR EDGE";

   gMDReason="SPINE "+DoubleToString(gMDDirectionalSpineATR,2)+"A "+IntegerToString(gMDDirectionalAgreement)+"/5 | TRI "+gMDTriggerRailState+" | ORA "+
             MarketDNAOraclePhaseName()+"/"+DoubleToString(gMDOracleOriginConfluence,2)+" | RHY "+DoubleToString(gMDRhythmScore,2)+
             " | PULSE "+DoubleToString(MathMax(MathMax(gMDPulseStrength[0],gMDPulseStrength[1]),MathMax(gMDPulseStrength[2],gMDPulseStrength[3])),2)+
             " | MU "+DoubleToString(gMDExpectedATR,2)+"A | EDGE "+DoubleToString(gMDExploitableEdgeATR,2)+
             "A | Q* "+DoubleToString(gMDDesiredLots,2)+" | REV "+DoubleToString(gMDReversalTransferEdgeATR,2)+"A";
}

void MarketDNAUpdate(int confirmedTurn)
{
   if(!EnableMarketDNA) return;
   if(gMDRhythmLastCompoundCycle!=gCompoundCycle)
   {
      gMDRhythmLastCompoundCycle=gCompoundCycle;
      gMDRhythmILBoostDirection=DIR_FLAT;
      gMDRhythmILBoostStartSerial=0;
   }
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   MarketDNAUpdateHistoricalChannels();
   MarketDNALearnIfNewBar(atr);
   gMDStructureATR=MarketDNAFeatureStructure(atr);
   gMDBOSATR=MarketDNAFeatureBOS(atr);
   gMDPressureATR=MarketDNAFeaturePressure(atr);
   gMDWickATR=MarketDNAFeatureWick(atr);
   gMDAcceptanceATR=MarketDNAFeatureAcceptance(atr);
   gMDInflectionATR=MarketDNAFeatureInflection(atr);
   gMDArrowATR=MarketDNAFeatureArrow();
   gMDStationATR=MarketDNAFeatureStation(atr);
   gMDReclaimATR=MarketDNAFeatureReclaim(atr);
   gMDRouteATR=MarketDNAFeatureRoute(atr);
   gMDWillATR=MarketDNAFeatureWill();
   if(!EnableMarketDNAHistoricalChannels) MarketDNAOracleUpdateContext(atr);
   gMDFeature[0]=MDClamp(gMDStructureATR,-1.0,1.0);
   gMDFeature[1]=MDClamp(gMDBOSATR,-1.0,1.0);
   gMDFeature[2]=MDClamp(gMDPressureATR,-1.0,1.0);
   gMDFeature[3]=MDClamp(gMDWickATR,-1.0,1.0);
   gMDFeature[4]=MDClamp(gMDArrowATR,-1.0,1.0);
   gMDFeature[5]=MDClamp(gMDStationATR,-1.0,1.0);
   gMDFeature[6]=MDClamp(gMDReclaimATR,-1.0,1.0);
   gMDFeature[7]=MDClamp(gMDRouteATR,-1.0,1.0);
   gMDFeature[8]=MDClamp(gMDWillATR,-1.0,1.0);
   // Reversal-only strands are deliberately excluded from normal SURF/Q* learning.
   gMDFeature[9]=0.0;
   gMDFeature[10]=0.0;
   // Oracle donor intelligence participates in residual learning but never owns side.
   gMDFeature[11]=MDClamp(gMDOracleMicroTrendATR,-1.0,1.0);
   gMDFeature[12]=MDClamp(gMDOracleOBFVGATR,-1.0,1.0);
   gMDFeature[13]=MDClamp(gMDOraclePhaseATR,-1.0,1.0);
   MarketDNADirectionalSpine();
   MarketDNARhythmUpdate(gMDDirectionalDirection,atr);
   gMDAnalyticATR=MarketDNAAnalyticEquation();
   gMDSurfATR=MarketDNASurfResidual();

   if(EnableMarketDNADirectionalSpine)
   {
      int d=gMDDirectionalDirection;
      if(d==DIR_FLAT)
         gMDExpectedATR=0.0;
      else
      {
         double spineBase=MathAbs(gMDDirectionalSpineATR);
         double analyticAlong=MathMax(0.0,d*gMDAnalyticATR);
         double baseExpected=0.70*spineBase+0.30*analyticAlong;

         // SURF is now an accelerator/brake inside the already-proven direction.
         // It can no longer change BUY to SELL or SELL to BUY.
         double surfAlong=d*gMDSurfATR;
         double surfCap=MathMax(0.02,baseExpected*MathMax(0.0,MarketDNASurfDirectionCap));
         double surfAdjust=MDClamp(surfAlong,-surfCap,surfCap);

         // RHYTHM predicts continuation magnitude from every live tick and similar
         // recent tick bursts. It may accelerate/brake travel inside the spine,
         // but it cannot invert direction.
         double rhythmAdjust=0.0;
         if(EnableMarketDNARhythmDNA)
         {
            double rhythmCap=MathMax(0.02,baseExpected*MathMax(0.0,MarketDNARhythmMagnitudeCap));
            double rhythmSignal=0.70*gMDRhythmScore+0.30*MDClamp(gMDRhythmHistoricalATR,-1.0,1.0);
            rhythmAdjust=MDClamp(rhythmSignal*baseExpected,-rhythmCap,rhythmCap);
         }
         gMDExpectedATR=d*MDClamp(MathMax(0.0,baseExpected+surfAdjust+rhythmAdjust),0.0,3.0);
      }
   }
   else
      gMDExpectedATR=MDClamp(gMDAnalyticATR+gMDSurfATR,-3.0,3.0);

   MarketDNAComputeExposure(confirmedTurn);

   // Snapshot current equation for the next completed-bar lesson.
   datetime bar=iTime(Symbol(),SignalTF,0);
   if(bar>0 && bar==gMDLastLearnBar)
   {
      for(int i=0;i<MD_BASE_FEATURES;i++) gMDPrevFeature[i]=gMDFeature[i];
      gMDPrevPredictionATR=gMDExpectedATR;
      gMDPrevPredictionBasePrice=iClose(Symbol(),SignalTF,1);
      gMDPrevPredictionATRSize=atr;
      gMDPrevPredictionDirection=MDSign(gMDExpectedATR);
      gMDPrevPredictionTime=bar;
   }
}

bool MarketDNACanDeploy(int dir)
{
   gMDDeployBlockReason="NONE";
   if(!EnableMarketDNA) return true;

   // v5.02 UNIVERSAL ENTRY TRIBUNAL: when the user selects the named-setup law,
   // no legacy Q*/spine/rhythm path may create an unlabelled FIRST trade. The
   // setup tribunal must prove a named source + independent witness, then it calls
   // PyrTryEntry directly. Existing campaigns and earned R-ladder adds keep their
   // normal growth authorities.
   if(WhereMayFreshEntriesBegin==ENTRY_ANY_NAMED_SETUP_WITH_AGREEMENT &&
      TradeCount()==0 && !gHT5SetupEntryContext && !gMDRLadderEntryOverrideActive)
   {
      gMDDeployBlockReason="NAMED SETUP TRIBUNAL OWNS FRESH ENTRY / WAIT SETUP + AGREEMENT";
      return false;
   }
   if(MarketDNARequireChannelReadyBeforeTrading && EnableMarketDNAHistoricalChannels && !gMDChannelReady)
   { gMDDeployBlockReason="CHANNEL INITIALIZING - ENTRIES LOCKED"; HT5HospitalObserveBlock(gMDDeployBlockReason); return false; }
   bool queuedFVGSeed=MarketDNASignalFVGQueuedSeedReady(dir);
   bool sequenceAuthority=(gHT6DoctrineOwnsEntry && gHT6Seq.active && gHT6Seq.direction==dir &&
                           gHT6Seq.phase>=SEQ_PHASE_ATTACK && gHT6Seq.phase<=SEQ_PHASE_ACCELERATE);
   bool earnedExpansion=(queuedFVGSeed || gMDRLadderEntryOverrideActive || gHT5SetupEntryContext || sequenceAuthority);
   if(dir==DIR_FLAT || (dir!=gMDDesiredDirection && !earnedExpansion))
   { gMDDeployBlockReason="NO MASTER DIRECTION / NO EARNED SETUP OR R-STAGE"; return false; }
   if(gCompoundEntryFreeze || gPyrPeakObservationActive)
   { gMDDeployBlockReason=(gCompoundEntryFreeze?"COMPOUND FREEZE":"PEAK OBSERVATION"); return false; }
   if(MarketDNASonicRLadder && gMDRLadderActive && !gMDRLadderEntryOverrideActive)
   { gMDDeployBlockReason="R-LADDER OWNS ALL NEW ADDS"; return false; }
   if(MarketDNADayHLGuard && !MarketDNADayHLAllowsDirection(dir))
   { gMDDeployBlockReason="DAY HIGH/LOW FIREWALL: "+gMDDayHLState; return false; }
   string deployTrendReason="";
   int deploySource=(gHT5SetupEntryContext && gHT5ActiveSetupSource!=PYR_SOURCE_NONE?gHT5ActiveSetupSource:(int)gPyrSignalSource);
   if(!HT5TrendFortificationAllows(deploySource,dir,TradeCount()>0,deployTrendReason))
   { gMDDeployBlockReason="TRAIN/ARROW FORTIFICATION: "+deployTrendReason; gHT5TrendFortificationState=gMDDeployBlockReason; return false; }
   if(WhereMayFreshEntriesBegin==ENTRY_ONLY_AT_SIGNAL_FVG && !gMDRLadderEntryOverrideActive && !MarketDNASignalFVGEntryReady(dir))
   { gMDDeployBlockReason="STRICT SIGNAL FVG GATE: "+gMDFVGState; return false; }
   if(!earnedExpansion && EnableMarketDNAHistoricalChannels && !gMDInflectionTransferReady &&
      gMDTransferHandoffDirection!=dir && !MarketDNAHistoricalChannelAllowsDirection(dir))
   { gMDDeployBlockReason="HIST CHANNEL VETO: "+gMDChannelState; return false; }
   if(!earnedExpansion && EnableMarketDNADirectionalSpine && !gMDInflectionTransferReady &&
      gMDTransferHandoffDirection!=dir && gMDDirectionalDirection!=dir)
   { gMDDeployBlockReason="DIRECTIONAL SPINE NOT PROVEN: "+gMDDirectionalState; return false; }
   if(!earnedExpansion && EnableMarketDNADirectionalSpine && !gMDInflectionTransferReady &&
      gMDTransferHandoffDirection!=dir &&
      MathAbs(gMDDirectionalSpineATR)<MathMax(0.0,MarketDNADirectionFloorATR))
   { gMDDeployBlockReason="SPINE BELOW FLOOR "+DoubleToString(MathAbs(gMDDirectionalSpineATR),3); return false; }
   if(!earnedExpansion && gMDExploitableEdgeATR<MarketDNAEdgeFloorATR)
   { gMDDeployBlockReason="EDGE BELOW FLOOR "+DoubleToString(gMDExploitableEdgeATR,3)+"<"+DoubleToString(MarketDNAEdgeFloorATR,3); return false; }
   if(!earnedExpansion && gMDThesisValidity<MarketDNAThesisMinimum)
   { gMDDeployBlockReason="THESIS TOO WEAK "+DoubleToString(gMDThesisValidity,2); return false; }
   if(BasketProfit()<0.0 && !gMDNegativeAddAllowed)
   { gMDDeployBlockReason="NEGATIVE ADD NOT EARNED"; return false; }
   double minLot=MarketInfo(Symbol(),MODE_MINLOT); if(minLot<=0.0) minLot=0.01;
   if(!earnedExpansion && !(gMDExposureDeltaLots>=minLot*0.50 || TradeCount()==0))
   { gMDDeployBlockReason="Q* ALREADY SATISFIED"; return false; }
   if(TradeCount()==0 && gMDBaseCarLot<=0.0 && !sequenceAuthority)
   {
      double queuedBase=(queuedFVGSeed?MarketDNABaseLotForDirection(dir):0.0);
      if(queuedBase<=0.0)
      { gMDDeployBlockReason="ANCHOR LOT BELOW BROKER/RISK LIMIT"; return false; }
   }
   // Sequence-owned seeds calculate the actual lot after a concrete stop plan
   // exists in PyrTryEntry/SendOrder. A zero Q* base lot is not a valid pre-veto.
   return true;
}


bool MarketDNATriggerRailTransferIfRequired()
{
   if(!EnableMarketDNA || !EnableMarketDNAThreeWayChannel || !MarketDNATriggerRailCloseOpposite) return false;
   int dir=(gMDTriggerRailBreakDirection!=DIR_FLAT?gMDTriggerRailBreakDirection:gMDTriggerRailBounceDirection);
   if(dir==DIR_FLAT) return false;
   int openDir=(int)DetectDirection();
   if(openDir==DIR_FLAT || openDir==dir) return false;

   MarketDNADeletePendingLimits("TRIGGER RAIL TRANSFER");
   if(BasketProfit()<0.0 && NeverSoftwareCloseNegativeCampaign && !MarketDNATriggerRailTransferAllowNegative)
   {
      gPyrState="BLACK RAIL TRANSFER ARMED - NEGATIVE HOLD COVENANT BLOCKS CLOSE";
      return false;
   }

   string why=(gMDTriggerRailBreakDirection!=DIR_FLAT?"TRIGGER RAIL TRANSFER - SONIC BREAK":
                                                      "TRIGGER RAIL TRANSFER - REJECTION BOUNCE");
   bool closed=PyrCloseFullCampaign(why);
   if(closed)
   {
      gMDTransferHandoffDirection=dir;
      gMDTransferHandoffTime=TimeCurrent();
      gMDTransferSeedATR=MathMax(MarketDNAEdgeFloorATR,MathMax(0.18,MathAbs(gMDDirectionalSpineATR)));
      gPyrTrendDirection=dir;
      gPyrSignalSource=(gMDTriggerRailBreakDirection!=DIR_FLAT?PYR_SOURCE_TRIGGER_RAIL_BREAK:PYR_SOURCE_TRIGGER_RAIL_BOUNCE);
      gPyrActiveSignalIdentity=TimeCurrent();
      gPyrState=(dir==DIR_BUY?"BLACK RAIL TRANSFER COMPLETE -> BUY":"BLACK RAIL TRANSFER COMPLETE -> SELL");
   }
   else
      gPyrState="BLACK RAIL TRANSFER - WAIT OLD CAMPAIGN CLOSE";
   return true;
}

bool MarketDNAChannelBounceTransferIfRequired()
{
   if(!EnableMarketDNA || !EnableMarketDNAHistoricalChannels || !MarketDNAChannelBounceTransfer ||
      gMDChannelBounceDirection==DIR_FLAT || gMDChannelBreakDirection!=DIR_FLAT) return false;
   int bounceDir=gMDChannelBounceDirection;
   int openDir=(int)DetectDirection();
   if(openDir==DIR_FLAT || openDir==bounceDir) return false;

   // Bounce location alone does not close the train. Live RHYTHM must show the
   // bounce side actually taking control. Approach-zone firewall only blocks adds.
   if(EnableMarketDNARhythmDNA && !MarketDNARhythmLaunchReady(bounceDir)) return false;
   if(!MarketDNAHistoricalChannelAllowsDirection(bounceDir)) return false;

   if(BasketProfit()<0.0 && NeverSoftwareCloseNegativeCampaign && !MarketDNAChannelBounceTransferAllowNegative)
   {
      gPyrState=(bounceDir==DIR_BUY ?
                 "BUY BOUNCE OWNS ZONE - RED SELL CAMPAIGN HELD / SELL ADDS BLOCKED" :
                 "SELL BOUNCE OWNS ZONE - RED BUY CAMPAIGN HELD / BUY ADDS BLOCKED");
      return false;
   }

   MarketDNADeletePendingLimits("HIST CHANNEL BOUNCE TRANSFER");
   double seed=MathMax(MarketDNAEdgeFloorATR,MathMax(MathAbs(gMDChannelATR),MathMax(0.0,bounceDir*gMDRhythmHistoricalATR)));
   bool closed=PyrCloseFullCampaign("HIST CHANNEL BOUNCE TRANSFER");
   if(closed)
   {
      gMDTransferSeedATR=seed;
      gMDTransferHandoffDirection=bounceDir;
      gMDTransferHandoffTime=TimeCurrent();
      gPyrTrendDirection=bounceDir;
      gPyrSignalSource=PYR_SOURCE_CHANNEL_BOUNCE;
      gPyrActiveSignalIdentity=TimeCurrent();
      gMDAction=(bounceDir==DIR_BUY?"CHANNEL TRANSFER COMPLETE / SEED BUY BOUNCE":
                                      "CHANNEL TRANSFER COMPLETE / SEED SELL BOUNCE");
      Print("MARKET DNA CHANNEL BOUNCE TRANSFER old=",openDir," new=",bounceDir,
            " channel=",DoubleToString(gMDChannelATR,3)," rhythm=",DoubleToString(gMDRhythmScore,3));
   }
   else
      gMDAction="CHANNEL BOUNCE TRANSFER / WAIT OLD CAMPAIGN CLOSE";
   return true;
}

bool MarketDNATransferExposureIfRequired()
{
   if(!EnableMarketDNA || !EnableInflectionAcceptanceDNA || !gMDInflectionTransferReady ||
      !gMDReversalReady || gMDDesiredDirection==DIR_FLAT) return false;
   int openDir=(int)DetectDirection();
   if(openDir==DIR_FLAT || openDir==gMDDesiredDirection) return false;

   MarketDNADeletePendingLimits("TRUE REVERSAL TRANSFER");
   gPyrState="MARKET DNA TRUE REVERSAL - TRANSFERRING EXPOSURE";
   double transferSeed=MathMax(MarketDNAEdgeFloorATR,MathMax(gMDReversalTransferEdgeATR,
                              MathMax(0.0,gMDDesiredDirection*gMDExpectedATR)));
   bool closed=PyrCloseFullCampaign("CONFIRMED STRUCTURAL INVALIDATION - MARKET DNA INFLECTION TRANSFER");
   if(closed)
   {
      gMDTransferSeedATR=transferSeed;
      gPyrTrendDirection=gMDDesiredDirection;
      gPyrSignalSource=PYR_SOURCE_INFLECTION_TRANSFER;
      gPyrActiveSignalIdentity=TimeCurrent();
      gMDTransferHandoffDirection=gMDDesiredDirection;
      gMDTransferHandoffTime=TimeCurrent();
      gMDAction="TRANSFER COMPLETE / HUNT NEW DIRECTION";
      Print("MARKET DNA INFLECTION TRANSFER old=",openDir," new=",gMDDesiredDirection,
            " infATR=",DoubleToString(gMDInflectionATR,3),
            " accATR=",DoubleToString(gMDAcceptanceATR,3));
   }
   else
      gMDAction="TRANSFER / WAIT OLD CAMPAIGN CLOSE";
   return true; // Transfer owns this tick even when broker close must retry.
}

void MarketDNAResetSonicPlugBurst(string why)
{
   gMDSonicPlugActive=false;
   gMDSonicPlugDirection=DIR_FLAT;
   gMDSonicPlugUsedMask=0;
   gMDSonicPlugStartSerial=0;
   gMDSonicPlugLastFireSerial=0;
   gMDSonicPlugAnchorPrice=0.0;
   gMDSonicPlugLastPrice=0.0;
   gMDSonicPlugCycle=0;
   gMDSonicPlugState="SONIC CAGE IDLE"+(why==""?"":" | "+why);
}

void MarketDNAArmSonicPlugBurst(int dir,double anchor)
{
   if(!MarketDNASonicCagePlug || dir==DIR_FLAT || anchor<=0.0) return;
   gMDSonicPlugActive=true;
   gMDSonicPlugDirection=dir;
   gMDSonicPlugUsedMask=0;
   gMDSonicPlugStartSerial=gMDRTickSerial;
   gMDSonicPlugLastFireSerial=gMDRTickSerial;
   gMDSonicPlugAnchorPrice=anchor;
   gMDSonicPlugLastPrice=anchor;
   gMDSonicPlugCycle=gCompoundCycle;
   gMDSonicPlugState=(dir==DIR_BUY?"SONIC BUY CAGE ARMED":"SONIC SELL CAGE ARMED");
}

double MarketDNASonicPlugNodePrice(int dir,int idx,double atr)
{
   int pair=idx/2+1;
   bool continuation=((idx%2)==0);
   double spacing=atr*MathMax(0.01,MarketDNASonicPlugSpacingATR)*pair;
   if(!continuation) spacing*=MathMax(0.20,MarketDNASonicPullbackSpacingFactor);
   double signedDistance=(continuation?spacing:-spacing);
   return NormalizeDouble(gMDSonicPlugAnchorPrice+dir*signedDistance,Digits);
}

bool MarketDNASonicNodeTouched(double lastPrice,double current,double node,double tol)
{
   if(MathAbs(current-node)<=tol) return true;
   return ((lastPrice-node)*(current-node)<=0.0);
}

bool MarketDNAManageSonicPlugBurst()
{
   if(HT6EinsteinEnabled()) return false;
   if(MarketDNASonicRLadder) return false;
   if(gHT6DoctrineOwnsEntry)
   {
      string seqReason=""; int d=(gMDSonicPlugDirection!=DIR_FLAT?gMDSonicPlugDirection:gHT6Seq.direction);
      if(!HT6DoctrineAllowsRequest(d,DOCTRINE_REQUEST_ADD,seqReason))
      { gMDSonicPlugState="SONIC SEQUENCE HOLD • "+seqReason; return false; }
   }
   HT5UpdateOpenTicketTelemetry();
   if(gHT5DefenseMode){ gMDSonicPlugState="SONIC PLUG PAUSED • "+gHT5DefenseState; return false; }
   if(!EnableMarketDNA || !MarketDNASonicCagePlug || !gMDSonicPlugActive) return false;
   if(gCompoundEntryFreeze || gMDSonicPlugCycle!=gCompoundCycle)
   { MarketDNAResetSonicPlugBurst("COMPOUND RESET"); return false; }
   int dir=gMDSonicPlugDirection;
   if(dir==DIR_FLAT || gMDDesiredDirection!=dir || !MarketDNAHistoricalChannelAllowsDirection(dir))
   { MarketDNAResetSonicPlugBurst("DIRECTION INVALID"); return false; }
   if(gMDRTickSerial-gMDSonicPlugStartSerial>MathMax(8,MarketDNASonicPlugLifeTicks))
   { MarketDNAResetSonicPlugBurst("CAGE EXPIRED"); return false; }
   if(gMDRTickSerial-gMDSonicPlugLastFireSerial<MathMax(1,MarketDNASonicPlugCooldownTicks)) return false;

   int maxPlugs=MathMax(0,MathMin(MD_SONIC_MAX_PLUGS,MarketDNASonicMaxPlugCars));
   if(maxPlugs<=0) return false;
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   RefreshRates();
   double current=(dir==DIR_BUY?Ask:Bid);
   double tol=atr*MathMax(0.005,MarketDNASonicPlugTouchATR);
   int room=MathMax(0,MarketDNACarCeiling()-TradeCountByDirection(dir));
   int desiredRoom=MathMax(0,gMDDesiredCars-TradeCountByDirection(dir)-MarketDNAPendingCountByDirection(dir));
   if(room<=0 || desiredRoom<=0) return false;

   for(int idx=0;idx<maxPlugs;idx++)
   {
      int bit=(1<<idx);
      if((gMDSonicPlugUsedMask & bit)!=0) continue;
      double node=MarketDNASonicPlugNodePrice(dir,idx,atr);
      if(!MarketDNASonicNodeTouched(gMDSonicPlugLastPrice,current,node,tol)) continue;

      // Pullback-side plugs require the direction to remain structurally valid and
      // RHYTHM not to be in a hard reversal. Continuation plugs require live launch.
      bool continuation=((idx%2)==0);
      if(continuation && !MarketDNARhythmLaunchReady(dir)) continue;
      if(!continuation && gMDRhythmScore<-0.10) continue;
      if(!MarketDNACanDeploy(dir)) break;

      gMDBurstOverride=true;
      PyrSignalSource oldSource=gPyrSignalSource;
      gPyrSignalSource=PYR_SOURCE_TRIGGER_RAIL_BREAK;
      bool opened=PyrTryEntry(dir);
      gPyrSignalSource=oldSource;
      gMDBurstOverride=false;
      if(opened)
      {
         gMDSonicPlugUsedMask|=bit;
         gMDSonicPlugLastFireSerial=gMDRTickSerial;
         gMDSonicPlugState=(dir==DIR_BUY?"SONIC BUY PLUG ":"SONIC SELL PLUG ")+IntegerToString(idx+1)+
                           " @ "+DoubleToString(node,Digits);
         gMDSonicPlugLastPrice=current;
         return true; // One mutation per tick; next plug must earn another price/tick location.
      }
      break;
   }
   gMDSonicPlugLastPrice=current;
   int used=0;
   for(int j=0;j<maxPlugs;j++) if((gMDSonicPlugUsedMask & (1<<j))!=0) used++;
   if(used>=maxPlugs) MarketDNAResetSonicPlugBurst("ALL PLUGS FILLED");
   return false;
}

bool MarketDNAExecuteBurst(int dir)
{
   if(HT6EinsteinEnabled() && !gHT6ContinuationAddOrderContext) return false;
   if(gHT6DoctrineOwnsEntry)
   {
      string seqReason="";
      int seqKind=(TradeCount()==0?DOCTRINE_REQUEST_SEED:DOCTRINE_REQUEST_ADD);
      if(!HT6DoctrineAllowsRequest(dir,seqKind,seqReason))
      { gMDDeployBlockReason=seqReason; gMDAction="SEQUENCE HOLD"; return false; }
   }
   if(!MarketDNACanDeploy(dir)) return false;
   int room=MathMax(0,MarketDNACarCeiling()-TradeCountByDirection(dir));
   bool queuedFVGSeed=MarketDNASignalFVGQueuedSeedReady(dir);
   int desiredRoom=(queuedFVGSeed ?
                    MathMax(1,MathMin(MarketDNASignalFVGSeedCars,room)) :
                    MathMax(0,gMDDesiredCars-TradeCountByDirection(dir)-MarketDNAPendingCountByDirection(dir)));
   bool sequenceEarlyAuthority=(gHT6DoctrineOwnsEntry && gHT6Seq.active && gHT6Seq.direction==dir &&
                                gHT6Seq.phase>=SEQ_PHASE_ATTACK && gHT6Seq.phase<=SEQ_PHASE_ACCELERATE);
   if(desiredRoom<=0 && sequenceEarlyAuthority && room>0)
      desiredRoom=(gHT6Seq.phase==SEQ_PHASE_ATTACK?1:MathMin(2,room));
   if(desiredRoom<=0)
   {
      gMDDeployBlockReason="DESIRED CARS ZERO / SATISFIED | BASE="+DoubleToString(gMDBaseCarLot,2)+
                           " Q*="+DoubleToString(gMDDesiredLots,2);
      return false;
   }

   bool sonicEvent=(gPyrSignalSource==PYR_SOURCE_TRIGGER_RAIL_BREAK && (gMDTriggerRailBreakDirection==dir || (gMDFVGArmed && gMDFVGSource==PYR_SOURCE_TRIGGER_RAIL_BREAK && gMDFVGDirection==dir)));
   if(sonicEvent && MarketDNASonicRLadder && gMDRLadderActive && gMDRLadderDirection==dir)
   { gMDAction="SONIC R-LADDER / WAIT EARNED GRID"; return false; }
   if(sonicEvent && !MarketDNASonicRLadder && MarketDNASonicCagePlug && gMDSonicPlugActive && gMDSonicPlugDirection==dir)
   { gMDAction="SONIC CAGE PLUG / WAIT NEXT NODE"; return false; }

   bool ilEvent=(gPyrSignalSource==PYR_SOURCE_TRAIN_STATION);
   if(ilEvent && EnableMarketDNARhythmDNA) MarketDNARhythmArmILBoost(dir);
   bool ilBoost=(EnableMarketDNARhythmDNA && (ilEvent || MarketDNARhythmILBoostActive(dir)));

   int burst=1;
   if(MarketDNAAllowRapidFire && gMDRapidBurstCars>0) burst=gMDRapidBurstCars;
   if(EnableMarketDNARhythmDNA && MarketDNARhythmRapidEveryValidTick && MarketDNARhythmLaunchReady(dir))
      burst=MathMax(burst,MathMax(1,MarketDNARhythmMinimumBurstCars));
   if(ilBoost) burst*=MathMax(1,MarketDNAILBurstMultiplier);
   if(MarketDNASignalFVGOnly && !gMDRLadderEntryOverrideActive) burst=MathMin(burst,MathMax(1,MarketDNASignalFVGSeedCars));
   if(queuedFVGSeed) burst=1;
   if(sonicEvent && MarketDNASonicRLadder) burst=1;
   else if(sonicEvent && MarketDNASonicCagePlug) burst=MathMax(1,MathMin(2,MarketDNASonicSeedCars));
   int tickCap=MathMax(1,MathMin(20,MarketDNARhythmMaxBurstCarsPerTick));
   if(gHT6DoctrineOwnsEntry) tickCap=MathMin(tickCap,HT6PhaseBurstCap());
   if(tickCap<=0) return false;
   burst=MathMax(1,MathMin(MathMin(room,desiredRoom),MathMin(tickCap,burst)));
   if(burst<=0) return false;

   bool any=false;
   gMDBurstOverride=true;
   for(int i=0;i<burst;i++)
   {
      if(TradeCountByDirection(dir)>=MarketDNACarCeiling()) break;
      // Each car recalculates remaining campaign risk and projected margin inside
      // PyrTryEntry/SendOrder. One failed safety check ends this tick's burst.
      if(!PyrTryEntry(dir)) break;
      any=true;
   }
   gMDBurstOverride=false;
   if(any)
   {
      if(MarketDNASignalFVGOnly && !gMDRLadderEntryOverrideActive && gMDFVGArmed && gMDFVGDirection==dir) gMDFVGSeedUsed=true;
      if(sonicEvent && MarketDNASonicRLadder && !gMDRLadderActive)
      {
         double seed=gLastOpenedPrice; double seedStop=gPyrInvalidation;
         if(seed>0.0 && seedStop>0.0) MarketDNARLadderArm(dir,seed,seedStop);
      }
      else if(sonicEvent && MarketDNASonicCagePlug && !gMDSonicPlugActive)
      {
         RefreshRates(); double seed=(dir==DIR_BUY?Ask:Bid); MarketDNAArmSonicPlugBurst(dir,seed);
      }
      if(gPyrSignalSource==PYR_SOURCE_INFLECTION_TRANSFER)
      {
         gMDTransferHandoffDirection=DIR_FLAT;
         gMDTransferHandoffTime=0;
         gMDTransferSeedATR=0.0;
      }
      gPyrState=gMDAction+" | "+IntegerToString(burst)+"-CAR ENTRY"+(sonicEvent?(MarketDNASonicRLadder?" • SONIC R-LADDER ARMED":" • SONIC CAGE ARMED"):" • RHYTHM BURST")+(ilBoost?" • IL x"+IntegerToString(MathMax(1,MarketDNAILBurstMultiplier)):"")+" | "+gMDReason;
      Print("MARKET DNA RHYTHM ",gMDAction," dir=",dir," burst=",burst,
            " rhythm=",DoubleToString(gMDRhythmScore,3)," force=",DoubleToString(gMDRhythmForce,3),
            " pullback=",DoubleToString(gMDRhythmPullback,2)," desiredLots=",DoubleToString(gMDDesiredLots,2),
            " targetDemand=",DoubleToString(gMDRhythmTargetDemandLots,2)," recovery=",DoubleToString(gMDRecoveryFeasibility,2));
   }
   return any;
}

double MarketDNALimitFactor(int level)
{
   if(level<=0) return MarketDNALimitAEFactor1;
   if(level==1) return MarketDNALimitAEFactor2;
   if(level==2) return MarketDNALimitAEFactor3;
   return MarketDNALimitAEFactor4;
}

double MarketDNALimitPrice(int dir,int level,double atr)
{
   RefreshRates();
   double current=(dir==DIR_BUY?Bid:Ask);
   double learnedAE=MathMax(0.08,gMDExpectedAdverseATR);
   double distance=atr*learnedAE*MathMax(0.10,MarketDNALimitFactor(level));
   double price=(dir==DIR_BUY?current-distance:current+distance);

   // Structural price remains the anchor. Station/reclaim and Oracle OB/FVG may
   // improve the location, but live PULSE GROW is not allowed to redefine history.
   double structural=0.0;
   if(level==0 && gPyrRouteLastStation>0.0) structural=gPyrRouteLastStation;
   else if(level==1 && gPyrActiveReclaimLevel>0.0) structural=gPyrActiveReclaimLevel;
   if(structural>0.0 && MathAbs(structural-price)<=atr*0.30)
   {
      if(dir==DIR_BUY && structural<Ask) price=structural;
      if(dir==DIR_SELL && structural>Bid) price=structural;
   }

   if(EnableMarketDNAOracleFusion && MarketDNAPulseUseOracleConfluence)
   {
      double obTop=(dir==DIR_BUY?gMDOracleBuyOBTop:gMDOracleSellOBTop);
      double obBot=(dir==DIR_BUY?gMDOracleBuyOBBot:gMDOracleSellOBBot);
      double fTop=(dir==DIR_BUY?gMDOracleBuyFVGTop:gMDOracleSellFVGTop);
      double fBot=(dir==DIR_BUY?gMDOracleBuyFVGBot:gMDOracleSellFVGBot);
      double oracle=0.0; int n=0;
      if(obTop>0.0 && obBot>0.0){ oracle+=(obTop+obBot)*0.5; n++; }
      if(fTop>0.0 && fBot>0.0){ oracle+=(fTop+fBot)*0.5; n++; }
      if(n>0)
      {
         oracle/=n;
         bool legal=(dir==DIR_BUY?oracle<Ask:oracle>Bid);
         if(legal && MathAbs(oracle-price)<=atr*0.45)
            price=0.55*price+0.45*oracle;
      }
   }
   double tick=TickSizePrice();
   if(tick>0.0) price=MathRound(price/tick)*tick;
   return NormalizeDouble(price,Digits);
}

int MarketDNALimitLevelFromComment(string comment)
{
   for(int l=0;l<4;l++)
      if(StringFind(comment,"_MDL"+IntegerToString(l+1))>=0) return l;
   return -1;
}

int MarketDNALimitSlotFromComment(string comment)
{
   int mdl=StringFind(comment,"_MDL");
   if(mdl<0) return 0;
   int p=StringFind(comment,"S",mdl+4);
   if(p<0) return 0;
   int v=(int)StringToInteger(StringSubstr(comment,p+1));
   return MathMax(0,v-1);
}

int MarketDNAPendingCountAtLevel(int dir,int level)
{
   int n=0;
   for(int i=OrdersTotal()-1;i>=0;i--)
      if(OrderSelect(i,SELECT_BY_POS,MODE_TRADES) && MarketDNAPendingSelected())
      {
         bool same=(dir==DIR_BUY?OrderType()==OP_BUYLIMIT:OrderType()==OP_SELLLIMIT);
         if(same && MarketDNALimitLevelFromComment(OrderComment())==level) n++;
      }
   return n;
}

double MarketDNAPulseConfluence(int dir,int level,double atr)
{
   double q=0.20;
   if(gMDTriggerRailApproachDirection==dir || gMDTriggerRailBounceDirection==dir) q+=0.25;
   if(gMDChannelZoneDirection==dir || gMDChannelBounceDirection==dir) q+=0.20;
   if(EnableMarketDNAOracleFusion)
   {
      double o=(dir==DIR_BUY?gMDOracleBuyOBFVG:gMDOracleSellOBFVG);
      q+=0.25*MDClamp(o,0.0,1.0);
   }
   if(level==0 && gPyrRouteLastStation>0.0) q+=0.10;
   if(level==1 && gPyrActiveReclaimLevel>0.0) q+=0.10;
   return MDClamp(q,0.0,1.0);
}

double MarketDNAPulseMagnetStrength(int dir,int level,double anchor,double atr)
{
   if(!MarketDNAPulseGrowLimits || dir==DIR_FLAT || anchor<=0.0 || atr<=0.0) return 0.0;
   RefreshRates();
   double mid=(Bid+Ask)*0.5;
   double dist=MathAbs(mid-anchor)/atr;
   double proximity=1.0-MDClamp(dist/MathMax(0.05,MarketDNAPulseActivationATR),0.0,1.0);

   // RHYTHM velocity is already expressed along the desired direction. Negative
   // velocity therefore means price is pulling toward a directional LIMIT.
   double toward=MDClamp(MathMax(0.0,-gMDRhythmVelocity)/1.50,0.0,1.0);
   double pb=gMDRhythmPullback;
   double controlledPullback=MathExp(-MathPow((pb-0.58)/0.42,2.0));
   if(pb>MarketDNAPulseCrashBrake)
      controlledPullback*=1.0/(1.0+3.0*(pb-MarketDNAPulseCrashBrake));
   double cadence=MDClamp(gMDRhythmCadence,0.0,1.0);
   double confluence=MarketDNAPulseConfluence(dir,level,atr);

   double crashSafety=1.0;
   if(pb>MarketDNAPulseCrashBrake) crashSafety=1.0/(1.0+4.0*(pb-MarketDNAPulseCrashBrake));
   double atlas=MathMax(0.0,dir*(0.35*HT5LiquidityDirectionalField()+0.30*HT5FVGAtlasDirectionalField()+0.20*HT5OBAtlasDirectionalField()+0.15*HT5StationDirectionalField()));
   double persistence=HT5Clamp(gHT5DirectionalPersistence,0.0,1.0);
   double raw=proximity*(0.20+0.20*toward+0.16*controlledPullback+0.10*cadence+0.16*confluence+0.10*atlas+0.08*persistence)*crashSafety;
   return MDClamp(raw,0.0,1.0);
}

double MarketDNAPulseZonePrice(int dir,int level,int slot,double atr)
{
   if(level<0 || level>3) return 0.0;
   if(gMDPulseAnchorPrice[level]<=0.0)
      gMDPulseAnchorPrice[level]=MarketDNALimitPrice(dir,level,atr);
   double anchor=gMDPulseAnchorPrice[level];
   double strength=MarketDNAPulseMagnetStrength(dir,level,anchor,atr);
   gMDPulseStrength[level]=strength;
   RefreshRates();
   double mid=(Bid+Ask)*0.5;
   double attraction=MDClamp(MarketDNAPulseMaxAttraction,0.0,0.85)*strength;
   double center=anchor+(mid-anchor)*attraction;

   int per=MathMax(1,MathMin(4,MarketDNALimitCarsPerLevel));
   double slotCenter=((double)slot-0.5*(per-1));
   double zoneStep=atr*MathMax(0.0,MarketDNAPulseZoneSpreadATR)/MathMax(1,per-1);
   // Shallow slots sit nearer market; deeper slots remain closer to structural anchor.
   double zoneOffset=(dir==DIR_BUY?slotCenter:-slotCenter)*zoneStep;
   double price=center+zoneOffset;

   double stopLevel=MarketInfo(Symbol(),MODE_STOPLEVEL)*Point;
   double minGap=MathMax(stopLevel,atr*MathMax(0.005,MarketDNAPulseBrokerGapATR));
   if(dir==DIR_BUY) price=MathMin(price,Ask-minGap);
   else price=MathMax(price,Bid+minGap);
   // Magnet may move toward live price but never through the structural anchor by more
   // than the configured attraction envelope.
   double maxTravel=MathAbs(mid-anchor)*MDClamp(MarketDNAPulseMaxAttraction,0.0,0.85)+atr*MarketDNAPulseZoneSpreadATR;
   if(MathAbs(price-anchor)>maxTravel)
      price=anchor+(price>anchor?1.0:-1.0)*maxTravel;

   double tick=TickSizePrice();
   if(tick>0.0) price=MathRound(price/tick)*tick;
   gMDPulseCenterPrice[level]=center;
   return NormalizeDouble(price,Digits);
}

bool MarketDNAPulseModifySelected(int dir,int level,int slot,double atr)
{
   if(!MarketDNAPulseGrowLimits || level<0 || level>3 || atr<=0.0) return false;
   int ticket=OrderTicket();
   double oldPrice=OrderOpenPrice();
   double oldSL=OrderStopLoss();
   double target=MarketDNAPulseZonePrice(dir,level,slot,atr);
   if(target<=0.0) return false;
   if(gMDRTickSerial-gMDPulseLastModifySerial[level]<MathMax(1,MarketDNAPulseModifyCooldownTicks)) return false;
   if(MathAbs(target-oldPrice)<atr*MathMax(0.005,MarketDNAPulseMinModifyATR)) return false;

   RefreshRates();
   double stopLevel=MarketInfo(Symbol(),MODE_STOPLEVEL)*Point;
   if(dir==DIR_BUY && target>=Ask-stopLevel) return false;
   if(dir==DIR_SELL && target<=Bid+stopLevel) return false;

   double stopDistance=(oldSL>0.0?MathAbs(oldPrice-oldSL):MathMax(atr*StopATRMultiplierValue,stopLevel));
   double newSL=(dir==DIR_BUY?target-stopDistance:target+stopDistance);
   newSL=NormalizeDouble(newSL,Digits);
   ResetLastError();
   bool ok=HT5CommanderOrderModify(ticket,target,newSL,OrderTakeProfit(),OrderExpiration(),clrNONE);
   if(ok)
   {
      gMDPulseLastModifySerial[level]=gMDRTickSerial;
      gMDPulseState="PULSE GROW L"+IntegerToString(level+1)+" "+DoubleToString(gMDPulseStrength[level],2)+" MAGNET";
      return true;
   }
   return false;
}

void MarketDNAPulseGrowUpdate()
{
   if(!EnableMarketDNA || !MarketDNAPulseGrowLimits || gCompoundEntryFreeze) return;
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   int dir=gMDLimitPlanDirection;
   if(dir==DIR_FLAT) return;

   for(int i=OrdersTotal()-1;i>=0;i--)
      if(OrderSelect(i,SELECT_BY_POS,MODE_TRADES) && MarketDNAPendingSelected())
      {
         bool same=(dir==DIR_BUY?OrderType()==OP_BUYLIMIT:OrderType()==OP_SELLLIMIT);
         if(!same) continue;
         int level=MarketDNALimitLevelFromComment(OrderComment());
         if(level<0 || level>3) continue;
         int slot=MarketDNALimitSlotFromComment(OrderComment());
         if(gMDPulseAnchorPrice[level]<=0.0)
            gMDPulseAnchorPrice[level]=OrderOpenPrice();
         MarketDNAPulseModifySelected(dir,level,slot,atr);
      }
}

void MarketDNAEnsurePersistentLimitPlan(int dir)
{
   if(!MarketDNAPersistentLimitPlan || dir==DIR_FLAT) return;
   if(gMDLimitPlanCycle!=gCompoundCycle)
   {
      // A new compound cycle gets a new inventory plan. Old pending orders are normally
      // already cleared by the compound collector; never churn them merely from Q* noise.
      gMDLimitPlanCycle=gCompoundCycle;
      gMDLimitPlanDirection=dir;
      for(int l=0;l<4;l++) gMDLimitPlannedCars[l]=0;
      MarketDNASave();
      return;
   }
   if(gMDLimitPlanDirection==DIR_FLAT)
   {
      gMDLimitPlanDirection=dir;
      MarketDNASave();
   }
}

bool MarketDNAPlaceLimitSlot(int dir,int level,int slot)
{
   if(dir==DIR_FLAT || level<0 || level>3 || !MarketDNAAllowLimitStacks) return false;
   gMDPendingPlacementContext=true; bool pendingAllowed=MarketDNACanDeploy(dir); gMDPendingPlacementContext=false;
   if(!pendingAllowed) return false;
   MarketDNAEnsurePersistentLimitPlan(dir);
   if(MarketDNAPersistentLimitPlan && gMDLimitPlanDirection!=DIR_FLAT && gMDLimitPlanDirection!=dir) return false;
   int type=(dir==DIR_BUY?OP_BUYLIMIT:OP_SELLLIMIT);
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   if(gMDPulseAnchorPrice[level]<=0.0) gMDPulseAnchorPrice[level]=MarketDNALimitPrice(dir,level,atr);
   double price=(MarketDNAPulseGrowLimits?MarketDNAPulseZonePrice(dir,level,slot,atr):gMDPulseAnchorPrice[level]);
   if(MarketDNASignalFVGOnly && MarketDNASignalFVGClampPulseLimits)
   { double fvgPrice=price; if(!MarketDNASignalFVGClampPrice(dir,price,atr,fvgPrice)) return false; price=fvgPrice; }
   RefreshRates();
   double stopLevel=MarketInfo(Symbol(),MODE_STOPLEVEL)*Point;
   if(dir==DIR_BUY && price>=Ask-stopLevel) return false;
   if(dir==DIR_SELL && price<=Bid+stopLevel) return false;
   double stopDistance=MathMax(atr*StopATRMultiplierValue,MathMax(stopLevel,Point));
   double stop=(dir==DIR_BUY?price-stopDistance:price+stopDistance);
   if(gPyrRouteInvalidation>0.0)
   {
      if(dir==DIR_BUY && gPyrRouteInvalidation<price) stop=MathMin(stop,gPyrRouteInvalidation);
      if(dir==DIR_SELL && gPyrRouteInvalidation>price) stop=MathMax(stop,gPyrRouteInvalidation);
   }
   stop=NormalizeDouble(stop,Digits);
   double lot=CalculateRiskLot(price,stop,MarketDNAEntryRiskFraction(false),false,false);
   if(lot<=0.0) return false;
   double newRisk=OrderRiskMoneyFromPrices(price,stop,lot);
   double cap=AccountRiskBase()*MaximumCampaignRiskPercent/100.0;
   if(OpenCampaignRiskMoney()+MarketDNAPendingRiskMoney()+newRisk>cap+0.01) return false;
   lot=FitLotToMarginSafety(dir==DIR_BUY?OP_BUY:OP_SELL,lot);
   if(lot<=0.0) return false;
   datetime expiry=(MarketDNALimitExpiryMinutes>0?TimeCurrent()+MarketDNALimitExpiryMinutes*60:0);
   string comment=TradeComment+"_MDL"+IntegerToString(level+1)+"S"+IntegerToString(slot+1);
   ResetLastError();
   int ticket=HT5CommanderOrderSend(Symbol(),type,lot,price,SlippagePoints,stop,0,comment,MagicNumber,expiry,
                        dir==DIR_BUY?C'0,190,220':C'220,70,100');
   if(ticket<0 && GetLastError()==147)
   {
      ResetLastError();
      ticket=HT5CommanderOrderSend(Symbol(),type,lot,price,SlippagePoints,stop,0,comment,MagicNumber,0,
                       dir==DIR_BUY?C'0,190,220':C'220,70,100');
   }
   if(ticket<0) return false;
   if(MarketDNAPersistentLimitPlan)
   {
      gMDLimitPlanDirection=dir;
      gMDLimitPlanCycle=gCompoundCycle;
      gMDLimitPlannedCars[level]++;
      MarketDNASave();
   }
   Print("MARKET DNA PULSE LIMIT level=",level+1," slot=",slot+1," ticket=",ticket," lot=",DoubleToString(lot,2),
         " anchor=",DoubleToString(gMDPulseAnchorPrice[level],Digits)," price=",DoubleToString(price,Digits),
         " pulse=",DoubleToString(gMDPulseStrength[level],2));
   return true;
}

bool MarketDNAPlaceLimit(int dir,int level)
{
   int slot=MarketDNAPendingCountAtLevel(dir,level);
   return MarketDNAPlaceLimitSlot(dir,level,slot);
}

void MarketDNAPrunePendingToDesired()
{
   if(!EnableMarketDNA) return;
   // v3.08 persistent inventory law:
   // Q* fluctuation, temporary FLAT predictions, profit giveback, and ordinary pullbacks
   // are NOT reasons to delete/recreate pending limits. Real campaign boundary functions
   // (compound collection, full close/invalidation, emergency, true reversal transfer)
   // call MarketDNADeletePendingLimits explicitly.
   if(!MarketDNAPersistentLimitPlan)
   {
      if(gCompoundEntryFreeze) return;
      return;
   }

   // v3.08 BOUNCE-ZONE FIREWALL: persistent inventory may survive Q* noise, but it
   // may NOT survive into a historical rail zone that explicitly belongs to the
   // opposite side. Cancel it before the full Directional Spine has to flip.
   if(MarketDNAChannelCancelOppositePending && EnableMarketDNAHistoricalChannels &&
      gMDLimitPlanDirection!=DIR_FLAT && gMDChannelBreakDirection==DIR_FLAT)
   {
      int railOwner=(gMDTriggerRailBreakDirection!=DIR_FLAT?gMDTriggerRailBreakDirection:
                     (gMDTriggerRailBounceDirection!=DIR_FLAT?gMDTriggerRailBounceDirection:
                     (gMDTriggerRailApproachDirection!=DIR_FLAT?gMDTriggerRailApproachDirection:
                     (gMDChannelBounceDirection!=DIR_FLAT?gMDChannelBounceDirection:gMDChannelZoneDirection))));
      if(gMDChannelCompressionZone || (railOwner!=DIR_FLAT && railOwner!=gMDLimitPlanDirection))
      {
         MarketDNADeletePendingLimits(gMDChannelCompressionZone?"ACTIVE CHANNEL COMPRESSION FIREWALL":
                                      "HIST CHANNEL BOUNCE/APPROACH FLIP");
         return;
      }
   }

   // A temporary FLAT spine does not churn inventory. A fully proven opposite spine
   // does invalidate old-direction pending inventory because the directional thesis
   // itself has changed.
   if(EnableMarketDNADirectionalSpine && gMDLimitPlanDirection!=DIR_FLAT &&
      gMDDirectionalDirection!=DIR_FLAT && gMDDirectionalDirection!=gMDLimitPlanDirection)
   {
      MarketDNADeletePendingLimits("DIRECTIONAL SPINE FLIP");
      return;
   }

   // Safety remains authoritative. If balance/risk changes after the plan was placed,
   // remove only the farthest pending cars until campaign risk is legal again. Planned
   // slots remain consumed, so this safety action cannot create delete/re-add spam.
   double capMoney=AccountRiskBase()*MaximumCampaignRiskPercent/100.0;
   for(int safetyPass=0;safetyPass<20 && OpenCampaignRiskMoney()+MarketDNAPendingRiskMoney()>capMoney+0.01;safetyPass++)
   {
      int farTicket=-1; double farDistance=-1.0;
      RefreshRates(); double mid=(Bid+Ask)*0.5;
      for(int sidx=OrdersTotal()-1;sidx>=0;sidx--)
         if(OrderSelect(sidx,SELECT_BY_POS,MODE_TRADES) && MarketDNAPendingSelected())
         {
            double d=MathAbs(OrderOpenPrice()-mid);
            if(d>farDistance){ farDistance=d; farTicket=OrderTicket(); }
         }
      if(farTicket<0) break;
      if(!OrderSelect(farTicket,SELECT_BY_TICKET) || !HT5CommanderOrderDelete(farTicket,clrNONE)) break;
   }

   // If a broker/user removed a pending order, its planned slot remains consumed unless
   // explicit rearming is requested. This prevents filled/expired levels from spamming back in.
   if(MarketDNARearmFilledLimitLevels)
   {
      int planDir=gMDLimitPlanDirection;
      if(planDir!=DIR_FLAT)
      {
         int perLevel=MathMax(1,MathMin(4,MarketDNALimitCarsPerLevel));
         for(int l=0;l<4;l++)
         {
            int liveCount=MarketDNAPendingCountAtLevel(planDir,l);
            if(liveCount<gMDLimitPlannedCars[l])
               gMDLimitPlannedCars[l]=MathMax(0,MathMin(perLevel,liveCount));
         }
      }
   }
}

void MarketDNAManagePendingLimits()
{
   if(HT6EinsteinEnabled()) return;
   if(!EnableMarketDNA || !MarketDNAAllowLimitStacks || gCompoundEntryFreeze) return;
   if(gHT6DoctrineOwnsEntry)
   {
      string seqReason=""; int d=(gMDDesiredDirection!=DIR_FLAT?gMDDesiredDirection:gHT6Seq.direction);
      if(!HT6DoctrineAllowsRequest(d,DOCTRINE_REQUEST_PENDING,seqReason))
      { gMDPulseState="PULSE SEQUENCE HOLD • "+seqReason; return; }
   }
   HT5UpdateOpenTicketTelemetry();
   if(gHT5DefenseMode){ HT5PrunePendingForDefense(); return; }
   // In universal tribunal mode, PULSE is a growth organ after a labelled seed, not
   // an alternative way to sneak an unlabelled first trade onto a flat account.
   if(WhereMayFreshEntriesBegin==ENTRY_ANY_NAMED_SETUP_WITH_AGREEMENT && TradeCount()==0) return;
   if(MarketDNASonicRLadder && gMDRLadderActive) return;
   MarketDNAPrunePendingToDesired();
   MarketDNAPulseGrowUpdate();
   // When live rhythm says the train is leaving, market rapid-fire owns new
   // inventory first. Do not let a fresh 4x4 limit plan consume all desired-car
   // slots immediately after the first burst. Existing persistent limits stay.
   if(EnableMarketDNARhythmDNA && MarketDNARhythmRapidReady(gMDDesiredDirection)) return;
   if(gMDDesiredDirection==DIR_FLAT) return;
   gMDPendingPlacementContext=true; bool planAllowed=MarketDNACanDeploy(gMDDesiredDirection); gMDPendingPlacementContext=false;
   if(!planAllowed) return;

   MarketDNAEnsurePersistentLimitPlan(gMDDesiredDirection);
   if(MarketDNAPersistentLimitPlan && gMDLimitPlanDirection!=gMDDesiredDirection) return;

   int marketCars=TradeCountByDirection(gMDDesiredDirection);
   int pendingCars=MarketDNAPendingCountByDirection(gMDDesiredDirection);
   int missing=MathMax(0,gMDDesiredCars-marketCars-pendingCars);
   if(missing<=0) return;

   int levels=MathMax(0,MathMin(4,MarketDNALimitLevels));
   int perLevel=MathMax(1,MathMin(4,MarketDNALimitCarsPerLevel));
   for(int level=0;level<levels && missing>0;level++)
   {
      if(gMDPulseAnchorPrice[level]<=0.0)
         gMDPulseAnchorPrice[level]=MarketDNALimitPrice(gMDDesiredDirection,level,MathMax(Point,HTExecutionATR(SignalTF,14)));
      double pulse=(MarketDNAPulseGrowLimits?MarketDNAPulseMagnetStrength(gMDDesiredDirection,level,gMDPulseAnchorPrice[level],MathMax(Point,HTExecutionATR(SignalTF,14))):1.0);
      gMDPulseStrength[level]=pulse;
      // PULSE GROW inventory: one scout exists far away; proximity/rhythm/confluence
      // unlock the remaining cars progressively. Once a slot is consumed it is not
      // deleted merely because pulse contracts; its price breathes back toward anchor.
      int pulseCars=perLevel;
      if(MarketDNAPulseGrowLimits)
      {
         pulseCars=1;
         if(perLevel>=2 && pulse>=0.28) pulseCars=2;
         if(perLevel>=3 && pulse>=0.58) pulseCars=3;
         if(perLevel>=4 && pulse>=0.82) pulseCars=4;
      }
      int alreadyPlanned=(MarketDNAPersistentLimitPlan?gMDLimitPlannedCars[level]:MarketDNAPendingCountAtLevel(gMDDesiredDirection,level));
      int capacity=MathMax(0,pulseCars-alreadyPlanned);
      int place=MathMin(capacity,missing);
      for(int c=0;c<place;c++)
      {
         int slot=alreadyPlanned+c;
         if(!MarketDNAPlaceLimitSlot(gMDDesiredDirection,level,slot)) break;
         missing--;
      }
   }
}

bool MarketDNAHarvestTowardDesired()
{
   if(!EnableMarketDNA || !MarketDNAHarvestProfitableExcess || BasketProfit()<=0.0 || TradeCount()<=0) return false;
   if(gHT6DoctrineOwnsEntry && gHT6Seq.phase<SEQ_PHASE_DEFEND) return false;
   int openDir=(int)DetectDirection();
   if(openDir==DIR_FLAT) return false;
   double current=LotsByDirection(openDir);
   double desired=(gMDDesiredDirection==openDir?gMDDesiredLots:0.0);
   double excess=current-desired;
   double minLot=MarketInfo(Symbol(),MODE_MINLOT); if(minLot<=0.0) minLot=0.01;
   if(excess<minLot*0.50) return false;
   if(gHT6DoctrineOwnsEntry && BasketProfit()>0.0)
      return PyrCloseFullCampaign(gHT6Seq.phase==SEQ_PHASE_HARVEST?"PHASE 5 FULL-BASKET HARVEST":"PHASE 4 FULL-BASKET DEFENSE HARVEST");
   if(desired<=MarketDNAFullHarvestLotTolerance && BasketProfit()>0.0)
      return PyrCloseFullCampaign("MARKET DNA MASTER HARVEST");

   int maxOps=MathMax(1,MathMin(20,MarketDNAHarvestCarsPerTick));
   int ops=0; bool any=false;
   double step=MarketInfo(Symbol(),MODE_LOTSTEP); if(step<=0.0) step=0.01;
   for(int pass=0;pass<2 && excess>=minLot*0.50 && ops<maxOps;pass++)
      for(int i=OrdersTotal()-1;i>=0 && excess>=minLot*0.50 && ops<maxOps;i--)
      {
         if(!OrderSelect(i,SELECT_BY_POS,MODE_TRADES) || !OurOrder()) continue;
         if((openDir==DIR_BUY && OrderType()!=OP_BUY) || (openDir==DIR_SELL && OrderType()!=OP_SELL)) continue;
         double net=OrderProfit()+OrderSwap()+OrderCommission();
         if(net<=0.0) continue; // Harvest profits; never manufacture a recovery by realizing another loss.
         double closeLots=MathMin(OrderLots(),excess);
         closeLots=MathFloor(closeLots/step+0.0000001)*step;
         closeLots=NormalizeDouble(closeLots,LotDigitsFromStep(step));
         if(closeLots<minLot-0.0000001) continue;
         double left=OrderLots()-closeLots;
         if(left>0.0000001 && left<minLot) closeLots=OrderLots();
         RefreshRates(); double px=(OrderType()==OP_BUY?Bid:Ask);
         double closed=closeLots;
         if(HT5CommanderOrderClose(OrderTicket(),closeLots,px,SlippagePoints,clrNONE))
         { excess=MathMax(0.0,excess-closed); ops++; any=true; }
      }
   if(any)
   {
      gMDAction="HARVEST / EXPOSURE CONTRACT";
      gPyrState=gMDAction+" | MASTER Q* "+DoubleToString(desired,2)+" LOT";
   }
   return any;
}

color MarketDNAStrandColor(int idx)
{
   if(idx==0) return C'40,125,255';    // structure electric blue
   if(idx==1) return C'255,195,55';    // BOS gold
   if(idx==2) return C'40,230,105';    // pressure green
   if(idx==3) return C'175,80,255';    // wick violet
   if(idx==4) return C'255,70,180';    // inflection hot magenta
   if(idx==5) return C'255,225,105';   // acceptance amber-white
   if(idx==6) return C'40,220,235';    // arrow cyan
   if(idx==7) return C'255,130,35';    // station orange
   if(idx==8) return C'20,190,165';    // reclaim teal
   if(idx==9) return C'240,220,150';   // route white-gold
   if(idx==10) return C'55,235,245';   // SURF aqua
   if(idx==11) return C'155,95,255';   // WILL royal purple
   if(idx==12) return C'255,75,35';    // rapid fire
   if(idx==13) return C'210,165,35';   // stack deep gold
   if(idx==14) return C'220,45,75';    // recovery crimson
   if(idx==15) return C'45,220,120';   // compound emerald
   if(idx==16) return C'225,235,245';  // risk white
   if(idx==17) return C'160,170,180';  // execution silver
   if(idx==18) return C'40,235,235';    // RHYTHM cyan
   if(idx==20) return C'55,155,255';    // historical channel blue
   if(idx==21) return C'255,155,45';     // ORACLE fusion amber
   return C'255,215,90';               // DIRECTION/EGO/master gold
}

void UIDrawMarketDNAStrand(string id,string label,double activity,string value,int idx,int x,int y,int width)
{
   int cells=12,gap=2,cellW=MathMax(3,(width-(cells-1)*gap)/cells);
   int live=(int)MathRound(MDClamp(activity,0.0,1.0)*cells);
   int pulse=(gUIFrame/MathMax(1,DNAAnimationSpeed))%cells;
   color base=MarketDNAStrandColor(idx);
   UISetLabel("MDNA_"+id+"_L",label,x,y-1,7,base,"Arial Bold",ANCHOR_LEFT_UPPER);
   for(int i=0;i<cells;i++)
   {
      color c=(i<live?base:HTCharcoal);
      if(i<live && i==pulse) c=HTText;
      UISetPanel("MDNA_"+id+"_"+IntegerToString(i),x+82+i*(cellW+gap),y,cellW,7,c,c);
   }
   UISetLabel("MDNA_"+id+"_V",value,x+width+88,y-2,7,base,"Arial Bold",ANCHOR_RIGHT_UPPER);
}

void DrawEinsteinFlowDashboard()
{
   int width=430,height=655;
   int x=MathMax(0,DashboardX);
   int y=MathMax(0,DashboardY);
   HT6EinsteinRefreshFlowMemories();
   gHT6Flow.energy=HT6EinsteinEnergy(gHT6Flow.primaryDirection);
   string side=(gHT6Flow.primaryDirection==DIR_BUY?"BUY":(gHT6Flow.primaryDirection==DIR_SELL?"SELL":"WAIT"));
   color master=(gHT6Flow.primaryDirection==DIR_BUY?C'55,235,155':(gHT6Flow.primaryDirection==DIR_SELL?C'255,90,105':HTGold));
   if(gHT6Flow.continuationDefense) master=C'255,185,60';

   UISetPanel("EIN_BASE",x,y,width,height,C'4,8,14',master);
   UISetPanel("EIN_HEAD",x+7,y+7,width-14,60,C'7,14,24',master);
   UISetLabel("EIN_TITLE","HIGHTOWER • DOUBLE CAMPAIGN FLOW",x+18,y+18,12,HTText,"Arial Bold",ANCHOR_LEFT_UPPER);
   UISetLabel("EIN_SUB",Symbol()+"  v6.10 REWIRED  • PRIMARY "+side,x+18,y+42,8,master,"Arial Bold",ANCHOR_LEFT_UPPER);

   UIDataRow("EIN_1","PRIMARY MEMORY",gHT6Flow.primaryMemory,x+18,y+84,master);
   UIDataRow("EIN_2","LEG MEMORY",gHT6Flow.legMemory,x+18,y+106,HTText);
   UIDataRow("EIN_3","PRESSURE MEMORY",UIShortText(gHT6Flow.pressureMemory,39),x+18,y+128,gHT6Flow.continuationDefense?HTGoldBright:HTText);
   UIDataRow("EIN_4","LL RAIL",DoubleToString(gHT6Flow.lowerRail,Digits),x+18,y+150,clrTomato);
   UIDataRow("EIN_5","LEFT HIGH",DoubleToString(gHT6Flow.upperRail,Digits),x+18,y+172,clrLimeGreen);
   UIDataRow("EIN_6","SWITCH CONFIRM","B "+IntegerToString(gHT6Flow.buySwitchConfirmCount)+"/"+IntegerToString(MathMax(1,DirectBuySwitchClosedCandles))+" • S "+IntegerToString(gHT6Flow.sellSwitchConfirmCount)+"/"+IntegerToString(MathMax(1,DirectSellSwitchClosedCandles)),x+18,y+194,clrTomato);
   UIDataRow("EIN_7","STRUCTURE HOLDS",IntegerToString(HT6StructureHoldCount(DIR_FLAT)),x+18,y+216,master);
   UIDataRow("EIN_8","SONIC / POINT ADDS",IntegerToString(HT6ContinuationAddCount(DIR_FLAT))+"  • $"+DoubleToString(HT6ContinuationProfit(DIR_FLAT),2),x+18,y+238,HTText);
   UIDataRow("EIN_9","SONIC NODES",IntegerToString(gHT6Flow.sonicNodesFired)+" / "+IntegerToString(gHT6SonicNodesPerCore)+" • NEXT "+DoubleToString(gHT6SonicNodeStepR*gHT6Flow.sonicNextNode,2)+"R",x+18,y+260,HTText);
   UIDataRow("EIN_10","CORE SL RATCHET",(gHT6Flow.coreRatchetPrice>0.0?DoubleToString(gHT6Flow.coreRatchetPrice,Digits):"WAIT NEXT CORE"),x+18,y+282,HTText);
   string slTxt=(DirectStopLossMode==DIRECT_STOP_ATR?"ATR "+IntegerToString(DirectATRStopPeriod)+" x "+DoubleToString(DirectATRStopMultiplier,2):
                 (DirectStopLossMode==DIRECT_STOP_FIXED_POINTS?"FIXED "+DoubleToString(DirectFixedStopDistancePoints,0)+" pts":"ATR/STRUCT WIDER"));
   string tpTxt=(DirectTakeProfitMode==DIRECT_TP_COMPOUND_PERCENT?DoubleToString(DirectCompoundTargetPercentPerTrade,2)+"% / TRADE":
                 (DirectTakeProfitMode==DIRECT_TP_R_MULTIPLE?DoubleToString(DirectTakeProfitRMultiple,2)+"R":
                 (DirectTakeProfitMode==DIRECT_TP_ATR_MULTIPLE?DoubleToString(DirectTakeProfitATRMultiplier,2)+" ATR":
                 (DirectTakeProfitMode==DIRECT_TP_INTENT_ADAPTIVE?"INTENT "+DoubleToString(DirectAdaptiveTPMinimumR,2)+"-"+DoubleToString(DirectAdaptiveTPMaximumR,2)+"R":DoubleToString(DirectTakeProfitFixedPoints,0)+" pts"))));
   UIDataRow("EIN_11","SL / TP",slTxt+" • TP "+tpTxt,x+18,y+304,HTText);
   UIDataRow("EIN_12","TRAIL / COMPOUND",(DirectUseATRTrailingStop?"ATR "+DoubleToString(DirectTrailStartATR,2)+"?"+DoubleToString(DirectTrailDistanceATR,2):"TRAIL OFF")+
             " • "+(DirectCompoundEveryTradeFromCurrentAccount?"EVERY TRADE":"CYCLE"),x+18,y+326,HTText);
