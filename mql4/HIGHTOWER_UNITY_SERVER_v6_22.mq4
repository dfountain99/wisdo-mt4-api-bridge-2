HT5_EndocrineState gHT5Endocrine;
HT5_VestibularState gHT5Vestibular;
HT5_MitochondriaState gHT5Mito;
HT5_CerebellumState gHT5Cerebellum;
HT5_SkinState gHT5Skin;
HT5_LymphState gHT5Lymph;
HT5_HippocampusState gHT5Hippocampus;
HT5_DreamScenario gHT5Dream[5];
string gHT5AdvancedLifeState="ADVANCED SYSTEMS AWAKENING";
string gHT5FormulaRegistryState="FORMULA REGISTRY AWAKENING";
int gHT5FormulaRegistryCursor=0;
double gHT5FormulaRegistryZ=0.0,gHT5FormulaRegistryReliability=0.0,gHT5FormulaRegistryContribution=0.0;

double HT5SignedCoherence(double a,double b,double c,double d,double e)
{
   double sum=a+b+c+d+e;
   double mag=MathAbs(a)+MathAbs(b)+MathAbs(c)+MathAbs(d)+MathAbs(e);
   if(mag<=0.000001) return 0.0;
   return HT5Clamp(MathAbs(sum)/mag,0.0,1.0);
}

void HT5VestibularSense()
{
   double d0=gHT5TF[0].direction,d1=gHT5TF[1].direction,d2=gHT5TF[2].direction,d3=gHT5TF[3].direction,d4=gHT5TF[4].direction;
   double weighted=0.08*d0+0.17*d1+0.25*d2+0.28*d3+0.22*d4;
   gHT5Vestibular.dominantDirection=(weighted>0.12?DIR_BUY:(weighted<-0.12?DIR_SELL:DIR_FLAT));
   gHT5Vestibular.directionalCoherence=HT5SignedCoherence(d0,d1,d2,d3,d4);
   gHT5Vestibular.timeframeConflict=1.0-gHT5Vestibular.directionalCoherence;
   double slopes=0.10*gHT5TF[0].emaSlopeATR+0.15*gHT5TF[1].emaSlopeATR+0.20*gHT5TF[2].emaSlopeATR+0.30*gHT5TF[3].emaSlopeATR+0.25*gHT5TF[4].emaSlopeATR;
   gHT5Vestibular.slopeBalance=HT5Clamp(slopes/1.5,-1.0,1.0);
   gHT5Vestibular.channelBalance=HT5Clamp(gMDChannelATR/1.5,-1.0,1.0);
   gHT5Vestibular.locationBalance=HT5Clamp(gHT5Location.netDirectionalField,-1.0,1.0);
   int reference=(gMDDesiredDirection!=DIR_FLAT?gMDDesiredDirection:gHT5Brain.direction);
   gHT5Vestibular.tilt=HT5Clamp(0.35*weighted+0.25*gHT5Vestibular.slopeBalance+0.20*gHT5Vestibular.channelBalance+0.20*gHT5Vestibular.locationBalance,-1.0,1.0);
   string side=(gHT5Vestibular.dominantDirection==DIR_BUY?"BUY":(gHT5Vestibular.dominantDirection==DIR_SELL?"SELL":"BALANCED"));
   gHT5Vestibular.state="BALANCE "+side+" • COH "+DoubleToString(gHT5Vestibular.directionalCoherence,2)+" • TILT "+DoubleToString(gHT5Vestibular.tilt,2);
   if(reference!=DIR_FLAT && reference*gHT5Vestibular.tilt<-0.25) gHT5Vestibular.state+=" • BODY LEAN OPPOSITE";
}

void HT5SkinSense()
{
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double spread=MathMax(0.0,MarketInfo(Symbol(),MODE_SPREAD)*Point);
   double stop=MathMax(0.0,MarketInfo(Symbol(),MODE_STOPLEVEL)*Point);
   double freeze=MathMax(0.0,MarketInfo(Symbol(),MODE_FREEZELEVEL)*Point);
   gHT5Skin.spreadFriction=HT5Clamp(spread/MathMax(Point,atr),0.0,1.0);
   gHT5Skin.stopFriction=HT5Clamp(stop/MathMax(Point,atr),0.0,1.0);
   gHT5Skin.freezeFriction=HT5Clamp(freeze/MathMax(Point,atr),0.0,1.0);
   double ml=(AccountMargin()>0.0?AccountEquity()/MathMax(0.01,AccountMargin()):10.0);
   gHT5Skin.marginFriction=HT5Clamp(1.0-ml/5.0,0.0,1.0);
   gHT5Skin.quoteQuality=HT5Clamp(1.0-0.55*gHT5Skin.spreadFriction-0.25*gHT5Skin.stopFriction-0.20*gHT5Skin.freezeFriction,0.0,1.0);
   gHT5Skin.surfaceQuality=HT5Clamp(0.65*gHT5Skin.quoteQuality+0.35*gHT5Broker.executionQuality,0.0,1.0);
   gHT5Skin.state="SKIN Q "+DoubleToString(gHT5Skin.surfaceQuality,2)+" • SPR "+DoubleToString(gHT5Skin.spreadFriction,2)+" • STOP "+DoubleToString(gHT5Skin.stopFriction,2);
}

void HT5LymphSense()
{
   double cap=MathMax(0.01,AccountRiskBase()*MaximumCampaignRiskPercent/100.0);
   double open=OpenCampaignRiskMoney(),pending=MarketDNAPendingRiskMoney();
   gHT5Lymph.openRiskToxin=HT5Clamp(open/cap,0.0,2.0);
   gHT5Lymph.pendingRiskToxin=HT5Clamp(pending/cap,0.0,2.0);
   gHT5Lymph.adverseToxin=HT5Clamp(gMDExpectedAdverseATR/MathMax(0.10,MathAbs(gMDExpectedATR)+0.10),0.0,2.0);
   gHT5Lymph.correlationToxin=HT5Clamp(gHT5Vestibular.timeframeConflict*gHT5FlowEntropy,0.0,1.0);
   double locked=MathMax(0.0,gHT5Immune.lockedProfit);
   gHT5Lymph.detoxRate=HT5Clamp(0.35+0.35*locked/MathMax(0.01,cap)+0.30*gHT5ProtectionAggression,0.0,1.5);
   double toxin=0.38*gHT5Lymph.openRiskToxin+0.18*gHT5Lymph.pendingRiskToxin+0.24*gHT5Lymph.adverseToxin+0.20*gHT5Lymph.correlationToxin;
   gHT5Lymph.riskPurity=HT5Clamp(1.0-toxin/(1.0+gHT5Lymph.detoxRate),0.0,1.0);
   gHT5Lymph.state="LYMPH PURITY "+DoubleToString(gHT5Lymph.riskPurity,2)+" • TOX "+DoubleToString(toxin,2);
}

void HT5HippocampusSense()
{
   int source=(int)gPyrSignalSource;
   gHT5Hippocampus.episodeConfidence=HT5Clamp(gHT5DeepPredictionConfidence,0.0,1.0);
   gHT5Hippocampus.expectedR=HT5Clamp(gHT5DeepPredictionR,-6.0,6.0);
   gHT5Hippocampus.similarity=HT5Clamp(gHT5PatternConfidence,0.0,1.0);
   gHT5Hippocampus.sourceMemory=HT5SourceReliability(source);
   int ses=MathMax(0,MathMin(5,gHT5Session));
   int ph=MathMax(0,MathMin(5,gHT5BodyPhase));
   gHT5Hippocampus.sessionMemory=HT5Clamp(0.50+0.10*gHT5SessionExpectancyR[ses],0.0,1.0);
   gHT5Hippocampus.phaseMemory=HT5Clamp(0.50+0.10*gHT5PhaseExpectancyR[ph],0.0,1.0);
   gHT5Hippocampus.recallStrength=HT5Clamp(0.25*gHT5Hippocampus.episodeConfidence+0.20*gHT5Hippocampus.similarity+0.20*gHT5Hippocampus.sourceMemory+0.18*gHT5Hippocampus.sessionMemory+0.17*gHT5Hippocampus.phaseMemory,0.0,1.0);
   gHT5Hippocampus.state="MEMORY R "+DoubleToString(gHT5Hippocampus.expectedR,2)+" • RECALL "+DoubleToString(gHT5Hippocampus.recallStrength,2);
}

void HT5CerebellumSense()
{
   double cadence=HT5Clamp(1.0-MathAbs(gMDRhythmCadence-1.0),0.0,1.0);
   double entropy=HT5Clamp(1.0-gHT5FlowEntropy,0.0,1.0);
   gHT5Cerebellum.tickTiming=HT5Clamp(0.55*cadence+0.45*entropy,0.0,1.0);
   gHT5Cerebellum.cadenceStability=HT5Clamp(0.60*cadence+0.40*(1.0-MathMin(1.0,MathAbs(gMDRhythmAcceleration))),0.0,1.0);
   double atr=MathMax(Point,HTExecutionATR(SignalTF,14));
   double width=(gMDFVGReady?MathMax(Point,gMDFVGTop-gMDFVGBot):atr);
   double mid=(Bid+Ask)*0.5;
   double center=(gMDFVGReady?(gMDFVGTop+gMDFVGBot)*0.5:mid);
   gHT5Cerebellum.fvgTouchPrecision=(gMDFVGReady?HT5Clamp(1.0-MathAbs(mid-center)/MathMax(width,atr*0.02),0.0,1.0):0.45);
   int dir=(gMDFVGDirection!=DIR_FLAT?gMDFVGDirection:gMDDesiredDirection);
   gHT5Cerebellum.directionalTiming=(dir==DIR_FLAT?0.4:HT5Clamp(0.50+0.35*dir*gMDRhythmScore+0.15*dir*gMDRhythmForce,0.0,1.0));
   gHT5Cerebellum.crossThroughQuality=(gMDFVGTouchLatchUntilSerial>=gMDEntryTickSerial?0.90:(gMDFVGInZone?1.0:0.35));
   gHT5Cerebellum.entryTimingHealth=HT5Clamp(0.20*gHT5Cerebellum.tickTiming+0.20*gHT5Cerebellum.cadenceStability+0.25*gHT5Cerebellum.fvgTouchPrecision+0.20*gHT5Cerebellum.directionalTiming+0.15*gHT5Cerebellum.crossThroughQuality,0.0,1.0);
   gHT5Cerebellum.state="TIMING "+DoubleToString(gHT5Cerebellum.entryTimingHealth,2)+" • FVG "+DoubleToString(gHT5Cerebellum.fvgTouchPrecision,2);
}

void HT5MitochondriaSense()
{
   double cap=MathMax(0.01,AccountRiskBase()*MaximumCampaignRiskPercent/100.0);
   double used=OpenCampaignRiskMoney()+MarketDNAPendingRiskMoney();
   gHT5Mito.availableRiskEnergy=HT5Clamp((cap-used)/cap,0.0,1.0);
   gHT5Mito.lockedProfitEnergy=HT5Clamp(MathMax(0.0,gHT5Immune.lockedProfit)/cap,0.0,2.0);
   gHT5Mito.compoundDemand=HT5Clamp(gHT5Metabolism.remainingMoney/MathMax(0.01,SelectedRiskMoney()*10.0),0.0,1.5);
   gHT5Mito.marginOxygen=HT5Clamp(AccountFreeMargin()/MathMax(1.0,AccountEquity()),0.0,2.0);
   gHT5Mito.conversionEfficiency=HT5Clamp(0.40*gHT5Metabolism.capitalEfficiency+0.25*gHT5Skin.surfaceQuality+0.20*gHT5Lymph.riskPurity+0.15*gHT5Hippocampus.recallStrength,0.0,1.0);
   gHT5Mito.metabolicLoad=HT5Clamp(0.55*(used/cap)+0.25*gHT5VolOfVol+0.20*gHT5FlowEntropy,0.0,1.5);
   gHT5Mito.growthCapacity=HT5Clamp(gHT5Mito.availableRiskEnergy*(0.35+0.65*gHT5Mito.conversionEfficiency)*(1.0-0.45*MathMin(1.0,gHT5Mito.metabolicLoad)),0.0,1.0);
   gHT5Mito.state="ATP GROWTH "+DoubleToString(gHT5Mito.growthCapacity,2)+" • RISK ENERGY "+DoubleToString(gHT5Mito.availableRiskEnergy,2);
}

void HT5EndocrineSense()
{
   double expansion=HT5Clamp(gHT5TF[2].expansion/2.0,0.0,1.0);
   double riskUse=HT5Clamp((OpenCampaignRiskMoney()+MarketDNAPendingRiskMoney())/MathMax(0.01,AccountRiskBase()*MaximumCampaignRiskPercent/100.0),0.0,1.5);
   double compound=HT5Clamp(gHT5Metabolism.remainingMoney/MathMax(0.01,SelectedRiskMoney()*8.0),0.0,1.0);
   double positiveFlow=HT5Clamp(MathMax(0.0,MathAbs(gMDRhythmScore)),0.0,1.0);
   gHT5Endocrine.compoundUrgency=compound;
   gHT5Endocrine.caution=HT5Clamp(0.28*riskUse+0.20*gHT5VolOfVol+0.18*gHT5FlowEntropy+0.18*(1.0-gHT5Skin.surfaceQuality)+0.16*(1.0-gHT5Lymph.riskPurity),0.0,1.0);
   gHT5Endocrine.growth=HT5Clamp(0.24*compound+0.20*expansion+0.18*gHT5Mito.growthCapacity+0.15*positiveFlow+0.13*gHT5Vestibular.directionalCoherence+0.10*gHT5Hippocampus.recallStrength-0.35*gHT5Endocrine.caution,0.0,1.0);
   gHT5Endocrine.protection=HT5Clamp(0.35*gHT5Endocrine.caution+0.25*riskUse+0.20*gHT5Lymph.detoxRate+0.20*MathMax(0.0,gMDRhythmMaturity),0.0,1.0);
   gHT5Endocrine.recovery=HT5Clamp(0.45*gHT5GenomeMutationPressure+0.25*(1.0-gHT5Lymph.riskPurity)+0.30*MathMax(0.0,-gEvoFitnessR),0.0,1.0);
   gHT5Endocrine.exploration=HT5Clamp(0.40*(1.0-gHT5Hippocampus.recallStrength)+0.30*(1.0-gHT5Vestibular.directionalCoherence)+0.30*(1.0-gHT5Cerebellum.entryTimingHealth),0.0,1.0);
   gHT5Endocrine.focus=HT5Clamp(0.30*gHT5Vestibular.directionalCoherence+0.25*gHT5Cerebellum.entryTimingHealth+0.25*gHT5Hippocampus.recallStrength+0.20*gHT5Skin.surfaceQuality,0.0,1.0);
   gHT5Endocrine.state="HORMONES G "+DoubleToString(gHT5Endocrine.growth,2)+" • C "+DoubleToString(gHT5Endocrine.caution,2)+" • P "+DoubleToString(gHT5Endocrine.protection,2);
}

void HT5DreamLabSense()
{
   string names[5];
   names[0]="DEFENSIVE"; names[1]="CURRENT"; names[2]="GROWTH"; names[3]="LOCATION"; names[4]="TIMING";
   double gs[5],ps[5],ts[5],ls[5];
   gs[0]=0.70; ps[0]=1.20; ts[0]=1.05; ls[0]=1.10;
   gs[1]=1.00; ps[1]=1.00; ts[1]=1.00; ls[1]=1.00;
   gs[2]=1.20; ps[2]=0.95; ts[2]=0.95; ls[2]=0.95;
   gs[3]=0.95; ps[3]=1.05; ts[3]=1.00; ls[3]=1.20;
   gs[4]=1.00; ps[4]=1.00; ts[4]=1.20; ls[4]=1.00;
   double base=gHT5Hippocampus.expectedR*gHT5Hippocampus.episodeConfidence;
   double timing=gHT5Cerebellum.entryTimingHealth;
   double location=HT5Clamp(0.50+0.30*MathAbs(gHT5Location.netDirectionalField)+0.20*gHT5Hippocampus.recallStrength,0.0,1.2);
   for(int i=0;i<5;i++)
   {
      gHT5Dream[i].name=names[i]; gHT5Dream[i].growthScale=gs[i]; gHT5Dream[i].protectionScale=ps[i]; gHT5Dream[i].timingScale=ts[i]; gHT5Dream[i].locationScale=ls[i];
      gHT5Dream[i].projectedR=base*(0.55+0.20*timing*ts[i]+0.15*location*ls[i]+0.10*gHT5Vestibular.directionalCoherence)*gs[i];
      gHT5Dream[i].riskStress=HT5Clamp((1.0-gHT5Lymph.riskPurity)*gs[i]/MathMax(0.5,ps[i]),0.0,2.0);
      gHT5Dream[i].fitness=gHT5Dream[i].projectedR-0.65*gHT5Dream[i].riskStress;
   }
}

int HT5BestDream()
{
   int best=0; for(int i=1;i<5;i++) if(gHT5Dream[i].fitness>gHT5Dream[best].fitness) best=i; return best;
}

void HT5AdvancedOrganSense()
{
   HT5VestibularSense();
   HT5SkinSense();
   HT5LymphSense();
   HT5HippocampusSense();
   HT5CerebellumSense();
   HT5MitochondriaSense();
   HT5EndocrineSense();
   HT5DreamLabSense();
   // Hormones can modulate HOW FAST the creature uses already-approved risk,
   // but cannot increase the user-selected seed or campaign risk ceilings.
   double growthMod=HT5Clamp(0.82+0.18*gHT5Endocrine.growth-0.12*gHT5Endocrine.caution,0.65,1.0);
   gHT5RiskReuseScale=HT5Clamp(gHT5RiskReuseScale*growthMod,0.45,1.0);
   gHT5ProtectionAggression=HT5Clamp(gHT5ProtectionAggression*(0.92+0.18*gHT5Endocrine.protection),0.70,1.35);
   gHT5FVGPrecisionScale=HT5Clamp(gHT5FVGPrecisionScale*(0.92+0.16*gHT5Endocrine.focus),0.60,1.40);
   int best=HT5BestDream();
   gHT5AdvancedLifeState="ENDO "+DoubleToString(gHT5Endocrine.growth,2)+" • BAL "+DoubleToString(gHT5Vestibular.directionalCoherence,2)+" • ATP "+DoubleToString(gHT5Mito.growthCapacity,2)+" • DREAM "+gHT5Dream[best].name;
}

//===============================================================================
// LIVING FORMULA REGISTRY
// Every deep sensor has an explicit physical meaning, unit and live evidence cell.
//===============================================================================
double HT5FeatureStandardizedValue(int idx)
{
   if(idx<0 || idx>=HT5_DEEP_FEATURE_COUNT) return 0.0;
   double sd=MathSqrt(MathMax(0.0001,gHT5DeepVar[idx]));
   return HT5Clamp((gHT5DeepFeature[idx]-gHT5DeepMean[idx])/sd,-6.0,6.0);
}
double HT5FeatureEvidenceReliability(int idx)
{
   if(idx<0 || idx>=HT5_DEEP_FEATURE_COUNT) return 0.0;
   return HT5Clamp(gHT5DeepSamples[idx]/40.0,0.0,1.0);
}
double HT5FeatureOutcomeContribution(int idx)
{
   if(idx<0 || idx>=HT5_DEEP_FEATURE_COUNT) return 0.0;
   return HT5Clamp(HT5FeatureStandardizedValue(idx)*gHT5DeepOutcomeCorr[idx]*HT5FeatureEvidenceReliability(idx),-4.0,4.0);
}

