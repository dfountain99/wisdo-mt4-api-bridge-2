WISDO_CLOUD_BASE_URL=https://wisdo-mt4-api-bridge.onrender.com
WISDO_DEVICE_ID=derrion-trading-laptop
WISDO_DEVICE_NAME=Derrion Trading Laptop
WISDO_DEVICE_TOKEN_FILE=data/device-token
WISDO_DEVICE_ENROLLMENT_CODE=

# Required for PREPARE_TRADING_WORKSPACE to be advertised and executed.
# Example: C:\Program Files\MetaTrader 4\terminal.exe
WISDO_MT4_EXE=
# Optional; defaults to the connected cloud's /app/command-center.
WISDO_LIVE_MANAGER_URL=

# Set only on an actual Windows VPS. Telemetry is observed, not synthetic.
WISDO_NODE_ROLE=desktop
# For an approved Windows service whose name begins with WISDO.
WISDO_OPS_OPERATOR=false
WISDO_ALLOW_WORKER_RESTART=false
WISDO_WORKER_SERVICE_NAME=
