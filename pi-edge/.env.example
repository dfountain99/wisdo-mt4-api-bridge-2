WISDO_CLOUD_BASE_URL=https://your-wisdo-host.example
WISDO_DEVICE_ID=pi-office
WISDO_DEVICE_NAME=Wisdo Office Pi
WISDO_DEVICE_ENROLLMENT_CODE=
# Leave blank on Windows to use pi-edge\data\device-token.
WISDO_DEVICE_TOKEN_FILE=
WISDO_ROOM_ID=office
WISDO_AUDIO_OUTPUT=default
WISDO_MIC_DEVICE_INDEX=
# AUTO uses the selected device native rate/channels/format when possible.
WISDO_MIC_SAMPLE_RATE=
WISDO_MIC_CHANNELS=
WISDO_MIC_SAMPLE_FORMAT=AUTO
WISDO_MIC_CHANNEL_SELECT=0
# S32_LE interfaces such as the PreSonus Studio 24c can use 12.
WISDO_MIC_S32_SHIFT=12
WISDO_STT_SAMPLE_RATE=16000
WISDO_WAKE_WORDS=hey coach,hey wisdom,hey wisdo
# PocketSphinx thresholds are tiny numbers. 1.0 is overly permissive and can
# interpret room noise as "coach". Start here, then tune between 1e-15 and 1e-30.
WISDO_WAKE_SENSITIVITY=1e-20
WISDO_WAKE_COOLDOWN_SECONDS=2.5
WISDO_POST_PLAYBACK_GUARD_SECONDS=1.5
WISDO_CONSOLE_MODE=false
WISDO_AUDIO_MAX_BYTES=2500000
WISDO_TTS_MAX_BYTES=2097152
WISDO_RECORD_MAX_SECONDS=20
WISDO_LISTEN_TIMEOUT_SECONDS=8
WISDO_VAD_PAUSE_SECONDS=0.8
WISDO_VAD_PADDING_SECONDS=0.5
WISDO_VAD_ENERGY_THRESHOLD=300
WISDO_SESSION_IDLE_SECONDS=90
WISDO_UPLOAD_RETRIES=3
# Leave these blank on Windows. Linux service installs may use /opt/wisdo-edge/data/...
WISDO_MUTE_FILE=
WISDO_LED_STATE_FILE=
WISDO_PLAYED_DELIVERIES_FILE=
# Optional argv-style command; {state} is replaced with idle/listening/processing/speaking/muted/error.
WISDO_LED_COMMAND=

# Optional ambient workstation wake. Set the Ethernet/Wi-Fi adapter MAC only
# after Wake-on-LAN is enabled in the workstation BIOS/adapter.
WISDO_TRADING_WORKSTATION_MAC=
WISDO_WOL_BROADCAST=255.255.255.255

# Optional physical-presence adapter. Command must exit 0 and print one of:
# 1, true, present, occupied, home when presence is detected.
# Example: python /opt/wisdo-edge/read_presence_sensor.py
WISDO_PRESENCE_COMMAND=
WISDO_PRESENCE_ROOM_ID=trading-room
WISDO_PRESENCE_POLL_SECONDS=2

# Optional Home Assistant bridge. Prefer pairing from Website Settings; the Pi
# stores the verified URL/token locally in a chmod-600 JSON file.
WISDO_HOME_ASSISTANT_URL=
WISDO_HOME_ASSISTANT_TOKEN=
WISDO_HOME_ASSISTANT_CONFIG_FILE=
WISDO_HOME_ASSISTANT_SYNC_SECONDS=60
