{
  "name": "culture-coin-operator-desks-bot",
  "version": "7.1.0",
  "description": "WISDO Culture Lane OS v7.1.0 with secure Live Desk screen broadcasting and launch-hardened trading controls.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "register-commands": "node scripts/registerCommands.js",
    "start:web": "node scripts/startWebOnly.js",
    "dev:web": "node --watch scripts/startWebOnly.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/checkBuild.js && npm test",
    "lint": "node scripts/checkBuild.js",
    "test:unit": "node --test tests/majorStabilityCore.test.js tests/conversationalTradingOs.test.js tests/wisdoPhysicalVoice.test.js",
    "test:integration": "node --test tests/commandBusContract.test.js tests/major-product.test.js tests/v708-database-first-trading.test.js",
    "test:commands": "node --test tests/v701-runtime-repair.test.js tests/commandBusContract.test.js",
    "smoke": "node --test tests/majorStabilityCore.test.js tests/kernelRouteRegistryContract.test.js tests/runtime-lifecycle-stability.test.js tests/wisdoWorldContract.test.js tests/worldSmartHome.test.js tests/worldLivingSystems.test.js",
    "migrate:postgres": "node scripts/migratePostgres.js",
    "postinstall": "node scripts/patchWsHandshake.js",
    "pressure:v706": "node --max-old-space-size=64 --expose-gc scripts/pressureSnapshotChurn.js 1000",
    "pressure:v707": "node --max-old-space-size=64 --expose-gc scripts/pressureSectionPersistence.js 5000 20000",
    "pressure:v708": "node --max-old-space-size=64 --expose-gc scripts/pressureDatabaseFirstTrading.js 5000 100",
    "pressure:mt4": "node --max-old-space-size=128 --expose-gc scripts/pressureMt4.js",
    "audit:runtime": "node scripts/auditRuntime.js",
    "audit:commands": "node scripts/auditCommands.js",
    "audit:stubs": "node scripts/auditStubs.js",
    "test:command-bus": "node --test tests/commandBusContract.test.js",
    "test:adaptive": "node --test tests/adaptiveFabricContract.test.js",
    "audit:secrets": "node scripts/auditSecrets.js"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "discord.js": "^14.27.0",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "redis": "^5.8.2",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "ws": "8.21.1",
    "body-parser": "2.3.0",
    "qs": "6.15.3",
    "undici": "6.28.0"
  }
}
